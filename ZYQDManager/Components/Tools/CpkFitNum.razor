<input class="cpk-fit-input cpk-fit-num @CssClass"
       type="text"
       inputmode="decimal"
       value="@Display"
       size="@FitSize"
       disabled="@Disabled"
       readonly="@ReadOnly"
       @onfocus="OnFocus"
       @oninput="OnInput"
       @onblur="OnBlur"/>

<style>
    .cpk-fit-input {
        box-sizing: content-box;
        height: 28px;
        margin: 0;
        padding: 2px 8px;
        border: 1px solid var(--mud-palette-lines-default, #e0e0e0);
        border-radius: 4px;
        background: #fff;
        color: inherit;
        font: inherit;
        line-height: 1.2;
        white-space: nowrap;
        min-width: 3ch;
        max-width: none;
        vertical-align: middle;
        text-align: center;
    }

    .cpk-fit-num {
        text-align: center;
    }

    .cpk-fit-input:focus {
        outline: 2px solid var(--mud-palette-primary, #594ae2);
        outline-offset: 0;
        border-color: transparent;
    }

    .cpk-fit-input:disabled,
    .cpk-fit-input[readonly] {
        background: #f5f5f5;
        color: var(--mud-palette-text-secondary, #666);
    }
</style>

@code {
    [Parameter] public double Value { get; set; }
    [Parameter] public EventCallback<double> ValueChanged { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public string CssClass { get; set; } = "";
    [Parameter] public int MinChars { get; set; } = 5;

    private string _edit = "";
    private bool _editing;

    private string Display => _editing ? _edit : Format(Value);

    private int FitSize
    {
        get
        {
            var n = Display.Length + 2;
            return Math.Clamp(n, MinChars, 40);
        }
    }

    private static string Format(double v) => v.ToString("0.##");

    private void OnFocus()
    {
        if (ReadOnly || Disabled) return;
        _editing = true;
        // 值为 0 时聚焦清空，避免输入变成 01、05
        var f = Format(Value);
        _edit = f == "0" ? "" : f;
    }

    private async Task OnInput(ChangeEventArgs e)
    {
        _editing = true;
        var raw = e.Value?.ToString() ?? "";
        // 若浏览器仍拼出 01/05（光标在末尾敲数字），只保留末位有效数字
        if (raw.Length >= 2
            && raw[0] == '0'
            && raw[1] != '.'
            && raw.Skip(1).All(char.IsDigit))
        {
            raw = raw.TrimStart('0');
            if (raw.Length == 0) raw = "0";
        }

        _edit = raw;
        // 输入过程中可解析则立刻回写，驱动箱数/汇总等即时计算
        if (TryParseNum(_edit, out var n))
        {
            Value = n;
            await ValueChanged.InvokeAsync(n);
        }
        else if (string.IsNullOrWhiteSpace(_edit))
        {
            Value = 0;
            await ValueChanged.InvokeAsync(0);
        }
    }

    private async Task OnBlur()
    {
        if (!_editing) return;
        _editing = false;
        if (TryParseNum(_edit, out var n))
        {
            Value = n;
            await ValueChanged.InvokeAsync(n);
        }
        _edit = Format(Value);
    }

    private static bool TryParseNum(string? text, out double n)
    {
        var s = (text ?? "").Trim();
        if (s.Length == 0)
        {
            n = 0;
            return false;
        }

        return double.TryParse(s, System.Globalization.NumberStyles.Float,
                   System.Globalization.CultureInfo.InvariantCulture, out n)
               || double.TryParse(s, System.Globalization.NumberStyles.Float,
                   System.Globalization.CultureInfo.CurrentCulture, out n);
    }
}
