@inject ILogger<PageErrorDetail> Logger
@inject IJSRuntime JS

<MudAlert Severity="Severity.Error" Class="ma-4" Variant="Variant.Filled">
    页面出错：@Exception.Message
    <div style="font-weight:400;margin-top:4px;">完整异常已输出到浏览器控制台。</div>
</MudAlert>

@code {
    [Parameter, EditorRequired] public Exception Exception { get; set; } = default!;

    private bool _reported;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _reported) return;
        _reported = true;
        var detail = Exception.ToString();
        Logger.LogError(Exception, "页面渲染失败");
        try
        {
            await JS.InvokeVoidAsync("zyqdConsoleError", detail);
        }
        catch (JSDisconnectedException)
        {
        }
        catch (JSException)
        {
        }
        catch (InvalidOperationException)
        {
        }
    }
}
