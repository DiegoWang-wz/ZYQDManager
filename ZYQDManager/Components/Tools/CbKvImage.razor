@inject CotractBaseService CotractBase

<div class="cb-img-field">
    <div class="cb-img-field-label">
        @Label
        @if (Required && !ReadOnly)
        {
            <span class="cb-img-field-req">*</span>
        }
    </div>

    <div class="cb-img-field-row">
        @if (HasImage)
        {
            <div class="cb-img-slot cb-img-slot-filled">
                <LegacyRemoteImg Path="@Value" CssClass="cb-img-slot-img"/>
                @if (!ReadOnly && !_uploading)
                {
                    <button type="button"
                            class="cb-img-slot-x"
                            title="删除图片"
                            @onclick="DeleteAsync"
                            @onclick:stopPropagation="true">×</button>
                }
            </div>
        }
        else if (IsNa)
        {
            <div class="cb-img-slot cb-img-slot-na">
                <span>N/A</span>
                @if (!ReadOnly && !_uploading)
                {
                    <button type="button"
                            class="cb-img-slot-x"
                            title="清除 N/A"
                            @onclick="ClearAsync"
                            @onclick:stopPropagation="true">×</button>
                }
            </div>
        }
        else if (ReadOnly)
        {
            <div class="cb-img-slot cb-img-slot-empty-ro">
                <span>—</span>
            </div>
        }
        else
        {
            <label class="cb-img-slot cb-img-slot-add @(_uploading ? "cb-img-slot-disabled" : null)">
                <InputFile OnChange="OnFile"
                           accept=".png,.jpg,.jpeg,.gif,.bmp,image/*"
                           disabled="@_uploading"/>
                <span class="cb-img-slot-add-inner">
                    @if (_uploading)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true"/>
                        <span>上传中…</span>
                    }
                    else
                    {
                        <MudIcon Icon="@Icons.Material.Filled.Add" Class="cb-img-slot-add-icon"/>
                        <span>上传</span>
                    }
                </span>
            </label>
        }

        @if (!ReadOnly && AllowNa && !IsNa && !HasImage)
        {
            <MudButton Size="Size.Small"
                       Variant="Variant.Outlined"
                       Class="cb-img-na-btn"
                       Disabled="_uploading"
                       OnClick="SetNa">
                设为 N/A
            </MudButton>
        }
    </div>
</div>

<style>
    .cb-img-field {
        display: flex;
        flex-direction: column;
        gap: 8px;
        min-width: 0;
    }

    .cb-img-field-label {
        font-size: 12px;
        color: var(--mud-palette-text-secondary);
        line-height: 1.3;
    }

    .cb-img-field-req {
        color: var(--mud-palette-error);
        margin-left: 2px;
    }

    .cb-img-field-row {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 10px;
    }

    .cb-img-slot {
        width: 160px;
        height: 110px;
        border-radius: 8px;
        flex: 0 0 auto;
        position: relative;
        box-sizing: border-box;
    }

    .cb-img-slot-filled {
        border: 1px solid var(--mud-palette-lines-default);
        background: #fff;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .cb-img-slot-img {
        width: 100%;
        height: 100%;
        object-fit: contain;
        display: block;
        padding: 6px;
        box-sizing: border-box;
    }

    .cb-img-slot-na,
    .cb-img-slot-empty-ro {
        border: 1px solid var(--mud-palette-lines-default);
        background: #f9fafb;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--mud-palette-text-secondary);
        font-size: 15px;
        font-weight: 500;
    }

    .cb-img-slot-empty-ro {
        color: var(--mud-palette-text-disabled);
        font-weight: 400;
    }

    .cb-img-slot-add {
        border: 1px dashed #c4c4c4;
        background: #f3f4f6;
        color: #6b7280;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        margin: 0;
        user-select: none;
    }

    .cb-img-slot-add:hover {
        background: #eaecef;
        border-color: #9ca3af;
        color: #4b5563;
    }

    .cb-img-slot-disabled {
        opacity: 0.55;
        pointer-events: none;
        cursor: not-allowed;
    }

    .cb-img-slot-add input[type=file] {
        position: absolute;
        width: 1px;
        height: 1px;
        opacity: 0;
        overflow: hidden;
        z-index: -1;
    }

    .cb-img-slot-add-inner {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 4px;
        font-size: 0.9rem;
        line-height: 1.1;
    }

    .cb-img-slot-add-icon {
        width: 28px !important;
        height: 28px !important;
        font-size: 28px !important;
    }

    .cb-img-slot-x {
        position: absolute;
        top: 2px;
        right: 2px;
        width: 22px;
        height: 22px;
        border: 0;
        border-radius: 50%;
        background: rgba(0, 0, 0, 0.55);
        color: #fff;
        font-size: 16px;
        line-height: 22px;
        text-align: center;
        cursor: pointer;
        padding: 0;
    }

    .cb-img-slot-x:hover {
        background: rgba(211, 47, 47, 0.9);
    }

    .cb-img-na-btn {
        flex: 0 0 auto;
    }
</style>

@code {
    private const long MaxBytes = 8L * 1024 * 1024;

    [Parameter] public string Label { get; set; } = "";
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public bool AllowNa { get; set; }
    [Parameter] public bool Required { get; set; }

    private bool _uploading;
    private bool IsNa => string.Equals(Value?.Trim(), "N/A", StringComparison.OrdinalIgnoreCase);
    private bool HasImage => !string.IsNullOrWhiteSpace(Value) && !IsNa && !LegacyFileUrl.IsBlankOrPlaceholder(Value);

    private async Task SetNa()
    {
        Value = "N/A";
        await ValueChanged.InvokeAsync(Value);
    }

    private async Task ClearAsync()
    {
        Value = null;
        await ValueChanged.InvokeAsync(null);
    }

    private async Task DeleteAsync()
    {
        var ok = await DialogService.ShowMessageBoxAsync(
            "删除图片",
            $"确定删除「{Label}」这张图片吗？",
            yesText: "删除",
            cancelText: "取消");
        if (ok != true) return;

        await ClearAsync();
    }

    private async Task OnFile(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null) return;
        if (file.Size > MaxBytes)
        {
            Notify.Show("图片不能超过 8MB", Severity.Warning);
            return;
        }

        _uploading = true;
        try
        {
            await using var stream = file.OpenReadStream(MaxBytes);
            var path = await CotractBase.UploadImageAsync(stream, file.Name);
            Value = path;
            await ValueChanged.InvokeAsync(path);
            Notify.Show("图片已上传", Severity.Success);
        }
        catch (Exception ex)
        {
            Notify.Show("上传失败：" + ex.Message, Severity.Error);
        }
        finally
        {
            _uploading = false;
        }
    }
}
