<MudDialog Class="zyqd-force-pwd-dialog">
    <DialogContent>
        <div class="fpwd-card">
            <div class="fpwd-header">
                <span class="fpwd-title">修改密码</span>
                <div class="fpwd-line" aria-hidden="true"></div>
            </div>

            <MudText Typo="Typo.body2" Class="fpwd-hint">
                当前为初始密码，请设置新密码后再进入系统。@CentralAuthService.PasswordComplexityHint。
            </MudText>

            <div class="fpwd-fields">
                <MudTextField Value="@EmpNo"
                              Label="工号"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Disabled="true"
                              ReadOnly="true"/>
                <MudTextField @bind-Value="_newPassword"
                              Label="新密码"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              InputType="@PwdType(_pwdVisible)"
                              Adornment="Adornment.End"
                              AdornmentIcon="@PwdIcon(_pwdVisible)"
                              OnAdornmentClick="@(() => _pwdVisible = !_pwdVisible)"
                              Disabled="_busy"
                              Immediate="true"
                              AutoFocus="true"
                              OnKeyDown="OnKeyDown"/>
                <MudTextField @bind-Value="_confirmPassword"
                              Label="确认新密码"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              InputType="@PwdType(_pwd2Visible)"
                              Adornment="Adornment.End"
                              AdornmentIcon="@PwdIcon(_pwd2Visible)"
                              OnAdornmentClick="@(() => _pwd2Visible = !_pwd2Visible)"
                              Disabled="_busy"
                              Immediate="true"
                              OnKeyDown="OnKeyDown"/>
            </div>

            @if (!string.IsNullOrEmpty(_error))
            {
                <MudAlert Severity="Severity.Error" Dense="true" Variant="Variant.Filled">@_error</MudAlert>
            }

            <MudButton Variant="Variant.Outlined"
                       Color="Color.Primary"
                       Class="fpwd-submit"
                       FullWidth="true"
                       Disabled="_busy"
                       OnClick="SubmitAsync">
                @(_busy ? "提交中…" : "确认修改")
            </MudButton>

            <div class="fpwd-footer">
                <button type="button" class="fpwd-back" disabled="@_busy" @onclick="BackToLoginAsync">
                    <MudIcon Icon="@Icons.Material.Filled.KeyboardArrowLeft" Size="Size.Small"/>
                    <span>返回登录</span>
                </button>
            </div>
        </div>
    </DialogContent>
</MudDialog>

<style>
    .mud-dialog.zyqd-force-pwd-dialog {
        border-radius: 14px;
        overflow: hidden;
        width: 420px;
        max-width: calc(100vw - 32px);
        background: #fff;
        border: 2px solid #1976d2;
        box-shadow: 0 0 0 1px rgba(25, 118, 210, 0.12), 0 8px 24px rgba(13, 71, 161, 0.18);
    }

    .mud-dialog.zyqd-force-pwd-dialog .mud-dialog-content {
        padding: 28px 32px 24px;
    }

    .fpwd-header {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        width: 100%;
        color: #1976d2;
        margin-bottom: 16px;
    }

    .fpwd-title {
        flex: 0 0 auto;
        font-size: 1.25rem;
        font-weight: 700;
        letter-spacing: 0.02em;
        white-space: nowrap;
        line-height: 1.4;
    }

    .fpwd-line {
        flex: 1 1 auto;
        height: 2px;
        background-color: currentColor;
        border-radius: 1px;
        min-width: 0;
    }

    .fpwd-hint {
        color: #546e7a !important;
        margin-bottom: 12px !important;
        line-height: 1.5;
    }

    .fpwd-fields {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        margin-bottom: 12px;
    }

    .fpwd-fields .mud-input-outlined-border {
        border-width: 2px !important;
        border-color: #1976d2 !important;
    }

    .fpwd-fields .mud-input:focus-within .mud-input-outlined-border {
        border-color: #1565c0 !important;
    }

    .fpwd-fields .mud-input.mud-disabled .mud-input-outlined-border,
    .fpwd-fields .mud-disabled .mud-input-outlined-border {
        border-color: #bdbdbd !important;
        background-color: #f5f5f5 !important;
    }

    .fpwd-fields .mud-disabled .mud-input-slot,
    .fpwd-fields .mud-disabled .mud-input-label,
    .fpwd-fields .mud-disabled .mud-input-adornment {
        color: #9e9e9e !important;
    }

    .fpwd-submit.mud-button-root {
        height: 48px !important;
        min-height: 48px !important;
        margin-top: 8px;
        font-size: 0.95rem !important;
        font-weight: 600 !important;
        color: rgba(0, 0, 0, 0.87) !important;
        background-color: #ffffff !important;
        border: 2px solid #1976d2 !important;
        border-radius: 10px !important;
        text-transform: none !important;
        box-shadow: 0 0 0 1px rgba(25, 118, 210, 0.12) !important;
    }

    .fpwd-submit:hover:not(:disabled) {
        background-color: #f5f9ff !important;
        border-color: #1565c0 !important;
    }

    .fpwd-footer {
        display: flex;
        justify-content: flex-start;
        margin-top: 12px;
    }

    .fpwd-back {
        background: none;
        border: none;
        padding: 4px 2px;
        color: #1976d2;
        font-size: 0.875rem;
        font-weight: 600;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 2px;
    }

    .fpwd-back:hover:not(:disabled) {
        color: #0d47a1;
        text-decoration: underline;
    }

    .fpwd-back:disabled {
        opacity: 0.5;
        cursor: default;
    }
</style>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public string EmpNo { get; set; } = "";

    private string _newPassword = "";
    private string _confirmPassword = "";
    private string? _error;
    private bool _busy;
    private bool _pwdVisible;
    private bool _pwd2Visible;

    public static async Task<bool> ShowAsync(IDialogService dialog, string empNo)
    {
        var parameters = new DialogParameters<ForceChangePasswordDialog>
        {
            { x => x.EmpNo, empNo }
        };
        var options = new DialogOptions
        {
            CloseButton = false,
            CloseOnEscapeKey = false,
            BackdropClick = false,
            NoHeader = true,
            MaxWidth = MaxWidth.ExtraSmall,
            FullWidth = true
        };
        var instance = await dialog.ShowAsync<ForceChangePasswordDialog>("修改密码", parameters, options);
        var result = await instance.Result;
        return result is { Canceled: false, Data: true };
    }

    private static InputType PwdType(bool visible) => visible ? InputType.Text : InputType.Password;
    private static string PwdIcon(bool visible) => visible ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility;

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await SubmitAsync();
    }

    private async Task SubmitAsync()
    {
        if (_busy) return;
        _error = null;

        if (string.IsNullOrEmpty(_newPassword))
        {
            _error = "请输入新密码";
            return;
        }

        if (string.Equals(_newPassword, CentralAuthService.InitialPassword, StringComparison.Ordinal))
        {
            _error = "新密码不能仍为初始密码";
            return;
        }

        if (!CentralAuthService.MeetsPasswordComplexity(_newPassword))
        {
            _error = CentralAuthService.PasswordComplexityHint;
            return;
        }

        if (!string.Equals(_newPassword, _confirmPassword, StringComparison.Ordinal))
        {
            _error = "两次输入的新密码不一致";
            return;
        }

        _busy = true;
        try
        {
            var (ok, msg) = await Auth.ChangePasswordAsync(_newPassword);
            if (!ok)
            {
                _error = msg ?? "修改密码失败";
                return;
            }

            Notify.Show(string.IsNullOrWhiteSpace(msg) ? "密码已修改" : msg, Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task BackToLoginAsync()
    {
        if (_busy) return;
        _busy = true;
        try
        {
            await Auth.LogoutAsync();
        }
        catch
        {
            // 退出失败也关掉窗口，避免卡在改密框里
        }

        MudDialog.Close(DialogResult.Ok(false));
    }
}
