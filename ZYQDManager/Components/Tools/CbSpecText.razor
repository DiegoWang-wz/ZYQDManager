<div class="cb-spec-item @(ReadOnly ? null : "cb-spec-edit")">
    <div class="cb-spec-label">
        @Label
        @if (Required && !ReadOnly)
        {
            <span class="cb-spec-req">*</span>
        }
    </div>
    @if (ReadOnly)
    {
        <div class="cb-spec-value @(IsBlank(Value) ? "cb-spec-empty" : null)">@Display(Value)</div>
    }
    else
    {
        <MudTextField T="string"
                      Value="@(Value ?? "")"
                      ValueChanged="OnMudChanged"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Required="@Required"
                      Disabled="@Disabled"/>
    }
</div>

<style>
    .cb-spec-item {
        min-width: 0;
        padding: 12px 14px;
        border-radius: 8px;
        background: rgba(0, 0, 0, 0.025);
        border: 1px solid var(--mud-palette-lines-default);
    }

    .cb-spec-item.cb-spec-edit {
        padding-bottom: 6px;
    }

    .cb-spec-item .mud-input-control {
        margin-top: 0;
        margin-bottom: 0;
    }

    .cb-spec-label {
        font-size: 12px;
        color: var(--mud-palette-text-secondary);
        margin-bottom: 4px;
        line-height: 1.3;
    }

    .cb-spec-req {
        color: var(--mud-palette-error);
        margin-left: 2px;
    }

    .cb-spec-value {
        font-size: 15px;
        font-weight: 500;
        word-break: break-word;
        line-height: 1.4;
    }

    .cb-spec-value.cb-spec-empty {
        color: var(--mud-palette-text-disabled);
        font-weight: 400;
    }
</style>

@code {
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public bool Required { get; set; }
    [Parameter] public bool Disabled { get; set; }

    private Task OnMudChanged(string v) => ValueChanged.InvokeAsync(v);

    private static bool IsBlank(string? value) => string.IsNullOrWhiteSpace(value);
    private static string Display(string? value) => IsBlank(value) ? "—" : value!.Trim();
}
