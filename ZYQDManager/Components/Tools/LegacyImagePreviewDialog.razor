<MudDialog Class="legacy-img-lightbox"
           ContentClass="legacy-img-lightbox-content">
    <DialogContent>
        <div class="legacy-preview-wrap"
             @onwheel="OnWheel"
             @onwheel:preventDefault="true">
            <img src="@Url"
                 alt="预览"
                 loading="eager"
                 decoding="async"
                 style="@ImgStyle"/>
            <button type="button"
                    class="legacy-preview-close"
                    title="关闭"
                    aria-label="关闭"
                    @onclick="Close"
                    @onclick:stopPropagation="true">
                <MudIcon Icon="@Icons.Material.Filled.Close" Size="Size.Medium"/>
            </button>
        </div>
    </DialogContent>
</MudDialog>

<style>
    .mud-overlay.legacy-img-lightbox-overlay {
        background-color: rgba(0, 0, 0, 0.55) !important;
    }

    .mud-dialog.legacy-img-lightbox {
        background: transparent !important;
        box-shadow: none !important;
        width: auto !important;
        min-width: 0 !important;
        max-width: none !important;
        height: auto !important;
        overflow: visible !important;
        border-radius: 0;
        padding: 0 !important;
        border: none !important;
    }

    .mud-dialog.legacy-img-lightbox .mud-dialog-title,
    .mud-dialog.legacy-img-lightbox .mud-dialog-actions {
        display: none !important;
    }

    .legacy-img-lightbox-content.mud-dialog-content,
    .mud-dialog.legacy-img-lightbox .mud-dialog-content {
        padding: 0 !important;
        margin: 0 !important;
        overflow: visible !important;
        background: transparent !important;
        position: relative;
    }

    .legacy-preview-wrap {
        position: relative;
        display: inline-flex;
        line-height: 0;
        cursor: default;
        background: transparent;
        overflow: visible;
    }

    .legacy-preview-close {
        position: absolute;
        top: 0;
        left: 100%;
        margin-left: 10px;
        z-index: 2;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        padding: 0;
        border: none;
        border-radius: 50%;
        cursor: pointer;
        color: #fff;
        background: rgba(0, 0, 0, 0.62);
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.35);
    }

    .legacy-preview-close:hover {
        background: rgba(0, 0, 0, 0.82);
    }

    .legacy-preview-wrap img {
        display: block;
        width: auto;
        height: auto;
        max-width: 86vw;
        max-height: 82vh;
        object-fit: contain;
        transform-origin: center center;
        user-select: none;
        -webkit-user-drag: none;
        background: transparent;
    }
</style>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public string Url { get; set; } = "";

    private double _scale = 1;

    private string ImgStyle => $"transform: scale({_scale.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture)});";

    private void Close() => MudDialog.Close();

    private void OnWheel(WheelEventArgs e)
    {
        var factor = e.DeltaY < 0 ? 1.12 : 1 / 1.12;
        _scale = Math.Clamp(_scale * factor, 0.2, 8);
    }
}
