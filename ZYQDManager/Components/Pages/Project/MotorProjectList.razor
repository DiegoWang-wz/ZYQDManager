        // 业务字段
        Customer = x.Customer,
        DemandPerson = x.DemandPerson,
        CustomerPartCode = x.CustomerPartCode,
        MotorModelSpec = x.MotorModelSpec,
        Description = x.Description,

        // 人：负责人 / 研发工程师 / 当前处理人
        OwnerEmpNo = x.OwnerEmpNo,
        OwnerName = x.OwnerName,
        EngineerEmpNo = x.EngineerEmpNo,
        EngineerName = x.EngineerName,
        PendingEmpNo = x.PendingEmpNo,
        PendingRole = x.PendingRole,
        PendingName = x.PendingName,
        IsMyTodo = x.IsMyTodo,
        UpdatePersonCode = x.UpdatePersonCode,
        UpdatePersonName = x.UpdatePersonName,
        UpdateTime = x.UpdateTime,
        CreatePersonCode = x.CreatePersonCode,
        CreatePersonName = x.CreatePersonName,
