@page "/project"
@page "/project-list"
@rendermode InteractiveServer
@inject MotorLxService LxSvc
@inject RemoteLxService RemoteLxSvc
@inject MotorFlowService FlowSvc
@inject LastListReturnService LastListReturn
@inject UserDirectoryService People

<PageTitle>项目列表</PageTitle>

<div class="motor-project-page">
    <MudPaper Class="pa-3" Outlined="true">
        <div class="mpl-toolbar-grid">
            <div class="mpl-toolbar-left">
                <MudSelect T="string"
                           Value="_productType"
                           ValueChanged="OnProductTypeChanged"
                           Label="产品类型"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Class="mpl-type-select">
                    @foreach (var type in ProductTypes)
                    {
                        <MudSelectItem Value="@type">@type</MudSelectItem>
                    }
                </MudSelect>
                <MudSelect T="string"
                           Value="_filterColumn"
                           ValueChanged="OnFilterColumnChanged"
                           Label="条件"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Class="mpl-filter-select">
                    @foreach (var field in MotorLxFilterColumns.All)
                    {
                        <MudSelectItem Value="@field.Value">@field.Label</MudSelectItem>
                    }
                </MudSelect>
                <MudTextField @bind-Value="_keyword"
                              Label="内容"
                              Placeholder="输入查询内容"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Immediate="true"
                              Class="mpl-filter-input"
                              OnKeyUp="OnKeyUp"/>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Search" OnClick="SearchAsync" Disabled="_busy">搜索</MudButton>
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Clear" OnClick="ClearAsync" Disabled="_busy">清空</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                           OnClick="OpenCreateDialog">新建</MudButton>
            </div>
            <div class="mpl-toolbar-right">
                @if (_todoCount > 0)
                {
                    <span class="mpl-todo-badge" title="有 @_todoCount 个项目当前节点等你处理">
                        <MudIcon Icon="@Icons.Material.Filled.AssignmentLate" Style="font-size:15px"/>
                        我的待办 @_todoCount
                    </span>
                }
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Deselect"
                           OnClick="ClearSelection" Disabled="_selected.Count == 0 || IsUnsupported">取消选择</MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete"
                           OnClick="DeleteSelectedAsync" Disabled="_selected.Count == 0 || _busy || IsUnsupported">删除</MudButton>
            </div>
        </div>
    </MudPaper>

    <MudPaper Class="motor-project-table-wrap pa-0" Outlined="true">
        @if (_ready)
        {
            <MudTable @ref="_table"
                      T="MotorLxListDto"
                      ServerData="LoadServerData"
                      @bind-CurrentPage="_currentPage"
                      RowsPerPage="@_rowsPerPage"
                      Dense="true"
                      Hover="true"
                      Striped="true"
                      Bordered="true"
                      Loading="_busy"
                      MultiSelection="true"
                      SelectOnRowClick="false"
                      @bind-SelectedItems="_selected"
                      Breakpoint="Breakpoint.None"
                      FixedHeader="true"
                      SortMode="SortMode.Single"
                      OnRowClick="OnRowClick"
                      RowClassFunc="RowCssClass"
                      Class="motor-project-table">
                <HeaderContent>
                    <MudTh Class="mpl-no-cell">序号</MudTh>
                    <MudTh><MudTableSortLabel T="MotorLxListDto" SortLabel="Customer">客户</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel T="MotorLxListDto" SortLabel="CustomerPartCode">客户产品编号</MudTableSortLabel></MudTh>
                    <MudTh Class="mpl-type-cell" title="这个项目属于电机还是遥控器">产品类型</MudTh>
                    <MudTh><MudTableSortLabel T="MotorLxListDto" SortLabel="MotorModelSpec">产品型号</MudTableSortLabel></MudTh>
                    <MudTh>品名</MudTh>
                    <MudTh Class="mpl-stage-cell">阶段</MudTh>
                    <MudTh Class="mpl-pending-cell" title="当前流程停在谁那里处理">当前处理人</MudTh>
                    <MudTh Class="mpl-owner-cell">负责人</MudTh>
                    <MudTh Class="mpl-createtime-cell">
                        <MudTableSortLabel T="MotorLxListDto" SortLabel="CreateTime" InitialDirection="SortDirection.Descending">创建时间</MudTableSortLabel>
                    </MudTh>
                    <MudTh Class="mpl-ops-cell">操作</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd Class="mpl-no-cell">@RowNo(context)</MudTd>
                    <MudTd>@Dash(context.Customer)</MudTd>
                    <MudTd>@Dash(context.CustomerPartCode)</MudTd>
                    <MudTd Class="mpl-type-cell">
                        <span class="mpl-type-tag @TypeClass(context)">@TypeText(context)</span>
                    </MudTd>
                    <MudTd>@Dash(context.MotorModelSpec)</MudTd>
                    <MudTd>@Dash(context.Description)</MudTd>
                    <MudTd Class="mpl-stage-cell">
                        @* 与单据明细页 .mdsteps 同款圆点条，纯展示不可点；第四档为归档 *@
                        <div class="mdsteps mpl-steps" title="@StageTip(context)">
                            @for (var i = 0; i < StageLabels.Length; i++)
                            {
                                var idx = i;

                                if (idx > 0)
                                {
                                    <span class="mdsteps-line @(StageLineOn(context, idx) ? "mdsteps-line-on" : null)"></span>
                                }

                                <span class="mdsteps-step @StageClass(context, idx)">
                                    <span class="mdsteps-dot"></span>
                                    <span class="mdsteps-label">@StageLabels[idx]</span>
                                </span>
                            }
                        </div>
                    </MudTd>
                    <MudTd Class="mpl-pending-cell" title="@PendingTip(context)">@PendingDisplay(context)</MudTd>
                    <MudTd Class="mpl-owner-cell" title="@OwnerTip(context)">@OwnerText(context)</MudTd>
                    <MudTd Class="mpl-createtime-cell">@DateDisplay.Format(context.CreateTime, "-")</MudTd>
                    <MudTd Class="mpl-ops-cell">
                        <div class="mpl-ops-grid">
                            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.Article"
                                       Class="mpl-ops-btn"
                                       Disabled="_busy"
                                       OnClick="@(() => OpenDetailAsync(context))">明细</MudButton>
                            @if (CanDelete(context))
                            {
                                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error"
                                           StartIcon="@Icons.Material.Filled.Delete"
                                           Class="mpl-ops-btn"
                                           Disabled="_busy"
                                           OnClick="@(() => DeleteAsync(context))">删除</MudButton>
                            }
                        </div>
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Class="pa-4">@EmptyText</MudText>
                </NoRecordsContent>
                <PagerContent>
                    <MudTablePager PageSizeOptions="new int[] { 20, 50, 100 }"
                                   RowsPerPageString="每页行数："
                                   InfoFormat="显示第 {first_item} 到第 {last_item} 条，共 {all_items} 条"/>
                </PagerContent>
            </MudTable>
        }
    </MudPaper>
</div>

@if (_createDialogOpen)
{
    <div class="mpl-dialog-backdrop" @onclick="CloseCreateDialog">
        <div class="mpl-dialog" @onclick:stopPropagation="true">
            <div class="mpl-dialog-title">选择立项单类型</div>
            <div class="mpl-dialog-body">请选择要新建的产品立项单：</div>
            <div class="mpl-dialog-options">
                <button type="button" class="mpl-option-btn" @onclick="@(() => PickCreateType(ProjectTypes.Motor))">
                    <span class="mpl-option-icon">&#x1F4E6;</span>
                    <span>电机立项单</span>
                </button>
                <button type="button" class="mpl-option-btn" @onclick="@(() => PickCreateType(ProjectTypes.Remote))">
                    <span class="mpl-option-icon">&#x1F4F1;</span>
                    <span>遥控器立项单</span>
                </button>
            </div>
            <div class="mpl-dialog-actions">
                <button type="button" class="mpl-cancel-btn" @onclick="CloseCreateDialog">取消</button>
            </div>
        </div>
    </div>
}

<style>
    .mpl-dialog-backdrop {
        position: fixed; inset: 0; background: rgba(0,0,0,.45);
        display: flex; align-items: center; justify-content: center; z-index: 9999;
    }
    .mpl-dialog {
        background: #fff; border-radius: 8px; width: 420px; max-width: 92vw;
        box-shadow: 0 12px 40px rgba(0,0,0,.25); padding: 24px;
    }
    .mpl-dialog-title { font-size: 18px; font-weight: 600; margin-bottom: 10px; }
    .mpl-dialog-body { font-size: 14px; color: #666; margin-bottom: 20px; }
    .mpl-dialog-options { display: flex; flex-direction: column; gap: 12px; }
    .mpl-option-btn {
        display: flex; align-items: center; gap: 12px; width: 100%;
        padding: 16px; border: 1px solid #1976d2; border-radius: 6px;
        background: #fff; color: #1976d2; font-size: 15px; font-weight: 600; cursor: pointer;
    }
    .mpl-option-btn:hover { background: #e3f2fd; }
    .mpl-option-icon { font-size: 22px; }
    .mpl-dialog-actions { display: flex; justify-content: flex-end; margin-top: 20px; }
    .mpl-cancel-btn {
        padding: 8px 20px; border: 1px solid #ccc; border-radius: 4px;
        background: #fff; color: #555; cursor: pointer;
    }
    .mpl-cancel-btn:hover { background: #f5f5f5; }
    .motor-project-page {
        flex: 1 1 0;
        display: flex;
        flex-direction: column;
        height: 100%;
        min-height: 0;
        gap: 12px;
    }

    .mpl-toolbar-grid {
        display: grid;
        grid-template-columns: 7fr 5fr;
        gap: 8px;
        align-items: center;
        width: 100%;
        min-width: 0;
    }

    .mpl-toolbar-left,
    .mpl-toolbar-right {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
        min-width: 0;
    }

    .mpl-toolbar-left { justify-content: flex-start; }
    .mpl-toolbar-right { justify-content: flex-end; }

    .mpl-toolbar-left > *,
    .mpl-toolbar-right > * { flex: 0 0 auto; }

    .mpl-type-select { width: 140px; }
    .mpl-filter-select { width: 140px; }
    .mpl-filter-input { width: 200px; }
    .mpl-filter-input .mud-input-control { width: 100%; margin-top: 0 !important; }

    /* 我的待办：工具栏右侧计数徽标 */
    .mpl-todo-badge {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        height: 30px;
        padding: 0 10px;
        border-radius: 15px;
        border: 1px solid #f3bcbc;
        background: #fdeeee;
        color: #c0392b;
        font-size: 13px;
        font-weight: 600;
        white-space: nowrap;
    }

    /* 产品类型：电机 / 遥控器，一眼分辨 */
    .motor-project-table .mud-table-cell.mpl-type-cell {
        width: 92px;
        min-width: 92px;
        max-width: 92px;
        text-align: center;
        padding: 6px 8px !important;
    }

    .mpl-type-tag {
        display: inline-block;
        padding: 0 8px;
        height: 20px;
        line-height: 20px;
        border-radius: 10px;
        font-size: 12px;
        font-weight: 600;
        white-space: nowrap;
        border: 1px solid #cfd8dc;
        background: #eceff1;
        color: #546e7a;
    }

    .mpl-type-tag.is-motor { border-color: #bbdefb; background: #e3f2fd; color: #1565c0; }
    .mpl-type-tag.is-remote { border-color: #c8e6c9; background: #e8f5e9; color: #2e7d32; }

    /* 我的待办：整行淡红（覆盖斑马纹与 hover） */
    .motor-project-table .mud-table-body tr.mpl-row-todo > td,
    .motor-project-table .mud-table-body tr.mpl-row-todo.mud-table-row-striped > td {
        background-color: #fdeeee !important;
    }

    .motor-project-table .mud-table-body tr.mpl-row-todo:hover > td {
        background-color: #fbdcdc !important;
    }

    .motor-project-table .mud-table-body tr.mpl-row-todo > td:first-child {
        box-shadow: inset 3px 0 0 #e74c3c;
    }

    @@media (max-width: 960px) {
        .mpl-toolbar-grid { grid-template-columns: 1fr; }
        .mpl-toolbar-right { justify-content: flex-start; }
    }

    .motor-project-table-wrap {
        flex: 1 1 0;
        min-height: 0;
        overflow: hidden;
        display: flex;
        flex-direction: column;
    }

    .motor-project-table {
        height: 100%;
        display: flex;
        flex-direction: column;
    }

    .motor-project-table .mud-table-container {
        flex: 1 1 0 !important;
        min-height: 0 !important;
        overflow: auto !important;
    }

    .motor-project-table .mud-table-pagination {
        flex: 0 0 auto !important;
        margin-top: auto;
        border-top: 1px solid var(--mud-palette-lines-default);
    }

    .motor-project-table .mud-table-head .mud-table-cell:not(.mpl-ops-cell):not(.mpl-createtime-cell):not(.mpl-no-cell):not(:first-child),
    .motor-project-table .mud-table-body .mud-table-cell:not(.mpl-ops-cell):not(.mpl-createtime-cell):not(.mpl-no-cell):not(:first-child) {
        white-space: nowrap;
        min-width: 92px;
        vertical-align: middle;
    }

    /* 左侧固定：勾选列 + 序号 */
    .motor-project-table .mud-table-cell:first-child,
    .motor-project-table .mud-table-cell.mpl-no-cell {
        position: sticky;
        z-index: 4;
        box-sizing: border-box;
        background-color: #fff !important;
        vertical-align: middle !important;
    }

    .motor-project-table .mud-table-head .mud-table-cell:first-child,
    .motor-project-table .mud-table-head .mud-table-cell.mpl-no-cell { z-index: 6; }

    .motor-project-table .mud-table-cell:first-child {
        left: 0;
        width: 42px !important;
        min-width: 42px !important;
        max-width: 42px !important;
        padding: 0 !important;
        text-align: center !important;
        white-space: nowrap !important;
    }

    .motor-project-table .mud-table-cell:first-child .mud-input-control,
    .motor-project-table .mud-table-cell:first-child .mud-checkbox {
        margin: 0 auto !important;
        padding: 0 !important;
        display: inline-flex !important;
        align-items: center !important;
        justify-content: center !important;
    }

    .motor-project-table .mud-table-cell.mpl-no-cell {
        left: 42px;
        width: 48px !important;
        min-width: 48px !important;
        max-width: 48px !important;
        padding: 0 2px !important;
        text-align: center;
        border-right: 1px solid #e0e0e0;
    }

    /* 右侧固定：创建时间 | 操作 */
    .motor-project-table .mud-table-cell.mpl-createtime-cell,
    .motor-project-table .mud-table-cell.mpl-ops-cell {
        position: sticky;
        z-index: 4;
        box-sizing: border-box;
        vertical-align: middle;
        overflow: hidden;
        background-color: #fff !important;
        white-space: nowrap;
        border-left: 1px solid #e0e0e0;
    }

    .motor-project-table .mud-table-cell.mpl-ops-cell {
        right: 0;
        width: 148px;
        min-width: 148px;
        max-width: 148px;
        padding: 4px 6px !important;
    }

    .motor-project-table .mud-table-cell.mpl-createtime-cell {
        right: 148px;
        width: 156px;
        min-width: 156px;
        max-width: 156px;
        padding: 6px 8px !important;
    }

    /* 当前处理人：姓名 + （审批中/编写中）要完整显示，长名字允许换行 */
    .motor-project-table .mud-table-cell.mpl-pending-cell {
        width: 140px;
        min-width: 140px;
        max-width: 140px;
        padding: 6px 8px !important;
        white-space: normal;
        overflow-wrap: anywhere;
        word-break: break-word;
        vertical-align: middle;
    }

    .motor-project-table .mud-table-cell.mpl-owner-cell {
        width: 88px;
        min-width: 88px;
        max-width: 88px;
        padding: 6px 8px !important;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .motor-project-table .mud-table-head .mud-table-cell.mpl-createtime-cell,
    .motor-project-table .mud-table-head .mud-table-cell.mpl-ops-cell {
        z-index: 6;
        background-color: #fff !important;
    }

    .motor-project-table.mud-table-striped .mud-table-body .mud-table-row:nth-of-type(odd) .mud-table-cell:first-child,
    .motor-project-table.mud-table-striped .mud-table-body .mud-table-row:nth-of-type(odd) .mud-table-cell.mpl-no-cell,
    .motor-project-table.mud-table-striped .mud-table-body .mud-table-row:nth-of-type(odd) .mud-table-cell.mpl-createtime-cell,
    .motor-project-table.mud-table-striped .mud-table-body .mud-table-row:nth-of-type(odd) .mud-table-cell.mpl-ops-cell {
        background-color: #f5f5f5 !important;
    }

    .motor-project-table .mud-table-body .mud-table-row:hover .mud-table-cell:first-child,
    .motor-project-table .mud-table-body .mud-table-row:hover .mud-table-cell.mpl-no-cell,
    .motor-project-table .mud-table-body .mud-table-row:hover .mud-table-cell.mpl-createtime-cell,
    .motor-project-table .mud-table-body .mud-table-row:hover .mud-table-cell.mpl-ops-cell {
        background-color: #eeeeee !important;
    }

    .mpl-ops-grid {
        display: flex;
        flex-direction: row;
        flex-wrap: nowrap;
        align-items: center;
        justify-content: center;
        gap: 4px;
        width: 100%;
    }

    .mpl-ops-grid .mpl-ops-btn.mud-button-root {
        width: auto;
        flex: 0 0 auto;
        min-width: auto !important;
        height: 28px;
        padding: 0 4px !important;
        margin: 0;
        font-size: 12px;
        line-height: 28px;
        white-space: nowrap;
    }

    .mpl-ops-grid .mpl-ops-btn .mud-button-label {
        font-size: 12px !important;
        white-space: nowrap !important;
    }

    .mpl-ops-grid .mpl-ops-btn .mud-icon-root {
        font-size: 16px !important;
        margin-right: 2px !important;
        flex-shrink: 0;
    }

    /* ===== 阶段流程条（复用单据明细页 .mdsteps，表格行内紧凑版） ===== */
    .motor-project-table .mud-table-cell.mpl-stage-cell {
        width: 340px !important;
        min-width: 340px !important;
        max-width: 340px !important;
        padding: 2px 10px !important;
        vertical-align: middle;
    }

    /* .mdsteps 原样式是给明细页工具栏用的，这里把宽度和间距收回来 */
    .mpl-steps {
        width: auto;
        max-width: none;
        margin: 0;
        padding: 0;
    }

    .mpl-steps .mdsteps-step {
        padding: 1px 3px;
        font-size: 12px;
        cursor: default;
    }

    /* 纯展示，不要鼠标悬停底色 */
    .mpl-steps .mdsteps-step:hover,
    .mpl-steps .mdsteps-step:hover:not(:disabled) {
        background: none !important;
    }

    .mpl-steps .mdsteps-dot {
        width: 8px;
        height: 8px;
    }

    /* 还没生成的那一档，文字也跟着变灰（明细页是 disabled 按钮，效果一致） */
    .mpl-steps .mdsteps-step.is-off { color: #c0c4cc; }

    .mpl-steps .mdsteps-step.is-current .mdsteps-dot {
        box-shadow: 0 0 0 2px #dbe7ff;
    }

    .mpl-steps .mdsteps-line {
        width: 14px;
        margin: 0 2px;
    }

    .motor-project-table .mud-table-body .mud-table-row {
        cursor: pointer;
    }
</style>

@code {
    private const string AllLabel = "全部";
    private static readonly string[] ProductTypes = [AllLabel, "电机", "遥控器", "控制盒", "推杆"];

    private MudTable<MotorLxListDto>? _table;
    private bool _ready;
    private bool _busy;
    private string _productType = AllLabel;
    private string _filterColumn = MotorLxFilterColumns.Customer;
    private string? _keyword;
    private List<MotorLxListDto> _rows = [];
    private HashSet<MotorLxListDto> _selected = [];
    private int _skip;
    private int _total;
    private int _currentPage;
    private int _rowsPerPage = 20;

    /// <summary>登录人工号 / 角色，用于「我的待办」判定。</summary>
    private string? _myEmpNo;
    private string? _myRole;
    private int _todoCount;

    /// <summary>当前页出现的工号 → 人员名片（姓名 / 部门 / 岗位），悬停提示用。</summary>
    private readonly Dictionary<string, UserDirectoryCard> _people = new(StringComparer.OrdinalIgnoreCase);

    /// <summary>目前电机、遥控器两类落了库，控制盒/推杆先占位；「全部」只显示这两类。</summary>
    private bool IsSupported => string.Equals(_productType, AllLabel, StringComparison.Ordinal)
                             || string.Equals(_productType, "电机", StringComparison.Ordinal)
                             || string.Equals(_productType, "遥控器", StringComparison.Ordinal);
    private bool IsUnsupported => !IsSupported;

    /// <summary>
    /// 遥控器立项单行映射成列表视图行（两者显示字段一致，仅库表/服务独立）。
    /// 注意：这里必须把 <see cref="MotorLxListDto"/> 的字段逐个带过来，
    /// 之前只拷了一部分，导致遥控器行的阶段条、当前处理人、负责人全显示不出来
    /// （Stage 恒为 0、StepLxDone 恒为 false、PendingName/OwnerName 为空）。
    /// </summary>
    private static MotorLxListDto ToView(ZYQDManager.DataDtos.RemoteLxListDto x) => new()
    {
        Id = x.Id,
        ProjectGuid = x.ProjectGuid,
        DocGuid = x.DocGuid,
        ProductType = ProjectTypes.Remote,
        VersionNo = x.VersionNo,
        Status = x.Status,
        IsDraft = x.IsDraft,

        // 流程口径：节点 / 阶段 / 四档完成标记（漏一个阶段条就会画错）
        Node = x.Node,
        NodeText = x.NodeText,
        Stage = x.Stage,
        StageText = x.StageText,
        StepLxDone = x.StepLxDone,
        StepGgDone = x.StepGgDone,
        StepCrDone = x.StepCrDone,
        StepArchived = x.StepArchived,
        StageTime = x.StageTime,

        // 当前版本的规格书 / 承认书
        GgDocGuid = x.GgDocGuid,
        GgStatus = x.GgStatus,
        CrDocGuid = x.CrDocGuid,
