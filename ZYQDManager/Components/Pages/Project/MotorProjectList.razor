    private async Task ArchiveAsync(MotorLxListDto row)
    {
        var who = string.IsNullOrWhiteSpace(row.Customer) ? "该项目" : row.Customer;
        var ok = await DialogService.ShowMessageBoxAsync(
            "确认归档",
            $"归档后版本 {row.VersionNo} 将冻结，不能再修改，也不能在此基础上新建版本。确定归档 {who} 吗？",
            yesText: "归档",
            cancelText: "取消");
        if (ok != true) return;

        var (askOk, remark) = await MotorRemarkDialog.AskAsync(
            DialogService, "归档备注", "可注明归档依据，会写进流程记录的备注列。", "submit");
        if (!askOk) return;

        _busy = true;
        try
        {
            var auth = await Auth.GetStoredAsync();
            var empNo = auth?.EmpNo;
            var empName = await ResolveNameAsync(empNo);
            var (success, msg) = await FlowSvc.ArchiveAsync(
                row.ProjectGuid, row.VersionNo, empNo, empName, comment: remark);
            Notify.Show(msg, success ? Severity.Success : Severity.Warning);
            if (success && _table is not null)
                await _table.ReloadServerData();
        }
        catch (Exception ex)
        {
            Notify.Show("归档失败：" + ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

