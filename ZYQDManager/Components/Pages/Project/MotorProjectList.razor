               && string.Equals((row.OwnerEmpNo ?? "").Trim(), empNo.Trim(),
                   StringComparison.OrdinalIgnoreCase);
    }

    /// <summary>
    /// 「全部」视图的全局排序：电机与遥控器的行合在一起按同一字段排，
    /// 字段口径与服务端 ApplyProjectSort 一致，同值时用立项单 Id 兜底保证顺序稳定。
    /// </summary>
    private static List<MotorLxListDto> SortMerged(
        List<MotorLxListDto> rows, string sortLabel, bool descending)
    {
        Comparison<MotorLxListDto> compare = sortLabel switch
        {
            "Customer" => (a, b) => TextCmp(a.Customer, b.Customer),
            "DemandPerson" => (a, b) => TextCmp(a.DemandPerson, b.DemandPerson),
            "CustomerPartCode" => (a, b) => TextCmp(a.CustomerPartCode, b.CustomerPartCode),
            "MotorModelSpec" => (a, b) => TextCmp(a.MotorModelSpec, b.MotorModelSpec),
            "Status" => (a, b) => TextCmp(a.Status, b.Status),
            "UpdateTime" => (a, b) => Nullable.Compare(a.UpdateTime, b.UpdateTime),
            _ => (a, b) => Nullable.Compare(a.CreateTime, b.CreateTime)
        };

        rows.Sort((a, b) =>
        {
            var result = compare(a, b);
            if (result == 0) result = a.Id.CompareTo(b.Id);
            return descending ? -result : result;
        });
        return rows;
    }

    private static int TextCmp(string? a, string? b)
        => string.Compare(a ?? "", b ?? "", StringComparison.OrdinalIgnoreCase);

    /// <summary>产品类型列：项目表 ProductType（Motor/Remote/...）翻成中文。</summary>
    private static string TypeText(MotorLxListDto row)
        => ProjectTypes.Name(row.ProductType) is { Length: > 0 } name ? name : Dash(row.ProductType);

    private static string TypeClass(MotorLxListDto row)
        => string.Equals(row.ProductType, ProjectTypes.Remote, StringComparison.OrdinalIgnoreCase) ? "is-remote"
            : string.Equals(row.ProductType, ProjectTypes.Motor, StringComparison.OrdinalIgnoreCase) ? "is-motor"
            : "";

    /// <summary>待办项目整行标淡红（样式见下方 mpl-row-todo）。</summary>
    private static string RowCssClass(MotorLxListDto row, int _)
        => row.IsMyTodo ? "mpl-row-todo" : "";

    /// <summary>阶段流程条的四个档位，与单据明细页的圆点条同一套口径，末档为归档。</summary>
    private static readonly string[] StageLabels = ["立项单", "规格书", "承认书", "归档"];

    private static bool StageDone(MotorLxListDto row, int index) => index switch
    {
        0 => row.StepLxDone,
        1 => row.StepGgDone,
        2 => row.StepCrDone,
        _ => row.StepArchived
    };

    /// <summary>该档是否已存在：立项单总是有，归档只有真正归档后才有。</summary>
    private static bool StageExists(MotorLxListDto row, int index) => index switch
    {
        0 => true,
        1 => !string.IsNullOrWhiteSpace(row.GgDocGuid),
        2 => !string.IsNullOrWhiteSpace(row.CrDocGuid),
        _ => row.StepArchived
    };

    private static string StageClass(MotorLxListDto row, int index)
    {
        // 已归档：流程闭合，不再留蓝色「当前」点，四档统一绿色
        if (row.StepArchived) return StageExists(row, index) ? "is-done" : "is-off";

        var current = Math.Clamp(row.Stage, MotorFlow.StageLx, MotorFlow.StageArchive);

        // 承认书阶段允许在单据还没生成时高亮：节点 4 签字版一上传就算进入承认书环节
        if (index == current
            && (StageExists(row, index) || index == MotorFlow.StageLx || index == MotorFlow.StageCr))
            return "is-current";

        if (!StageExists(row, index)) return "is-off";
        return StageDone(row, index) ? "is-done" : "is-open";
    }

    /// <summary>连接线走到当前档为止；已归档则整条全亮。</summary>
    private static bool StageLineOn(MotorLxListDto row, int index)
        => row.StepArchived
           || index <= Math.Clamp(row.Stage, MotorFlow.StageLx, MotorFlow.StageArchive);

    private static string StageTip(MotorLxListDto row)
    {
        var stage = MotorFlow.StageTitle(row.Stage);
        var node = string.IsNullOrWhiteSpace(row.StageText) ? "" : $"，{row.StageText}";
        var time = DateDisplay.Format(row.StageTime, "");
        return $"阶段：{stage}{node}" + (time.Length == 0 ? "" : $"（{time}）");
    }

    /// <summary>
    /// 把当前页出现的工号一次性换成名片（负责人 + 当前处理人）。
    /// 查不到也不报错，列上仍显示库里带出来的姓名或工号。
    /// </summary>
    private async Task ResolvePeopleAsync(List<MotorLxListDto> rows, CancellationToken ct)
    {
        var empNos = rows
            .SelectMany(x => new[] { x.OwnerEmpNo, x.PendingEmpNo })
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Select(x => x!.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

        var map = await People.GetManyAsync(empNos, ct);
        foreach (var (empNo, card) in map)
            _people[empNo] = card;
    }

    private UserDirectoryCard? Person(string? empNo)
    {
        var key = (empNo ?? "").Trim();
        return key.Length > 0 && _people.TryGetValue(key, out var card) ? card : null;
    }

    /// <summary>负责人列：优先显示账号中心/项目表上的姓名，取不到才退回工号。</summary>
    private string OwnerText(MotorLxListDto row)
    {
        var card = Person(row.OwnerEmpNo);
        if (!string.IsNullOrWhiteSpace(card?.Name)) return card!.Name;

        return Dash(!string.IsNullOrWhiteSpace(row.OwnerName) ? row.OwnerName : row.OwnerEmpNo);
    }

    /// <summary>负责人悬停：工号 / 姓名 / 部门 / 岗位（查不到人时只显示工号）。</summary>
    private string OwnerTip(MotorLxListDto row)
    {
        var empNo = (row.OwnerEmpNo ?? "").Trim();
        if (empNo.Length == 0) return "未指定负责人";

        var card = Person(empNo);
        if (card is null) return $"工号：{empNo}";

        var name = string.IsNullOrWhiteSpace(card.Name) ? Dash(row.OwnerName) : card.Name;
        return $"工号：{empNo}\n姓名：{name}\n部门：{Dash(card.Department)}\n岗位：{card.Position}";
    }

    /// <summary>
    /// 「当前处理人」列：姓名后面按节点标明是在审批还是在编写。
    /// 3/5/6 是研发经理或销售经理的审批节点，其余 1/2/4/7 是业务员或研发工程师的填写节点。
    /// </summary>
    private static string PendingDisplay(MotorLxListDto row)
    {
        if (row.StepArchived || row.Node == MotorNode.Archived) return "已归档";

        var name = Dash(row.PendingName);
        if (string.IsNullOrWhiteSpace(row.PendingName)) return name;

        var approving = row.Node is MotorNode.GgApprove or MotorNode.CrApprove or MotorNode.CrFinal
                        || (!string.IsNullOrWhiteSpace(row.PendingRole)
                            && (AppRoleService.RoleMatches(row.PendingRole, MotorFlow.RoleRdManager)
                                || AppRoleService.RoleMatches(row.PendingRole, MotorFlow.RoleFinalApprover)));

        return name + (approving ? "（审批中）" : "（编写中）");
    }

    /// <summary>
    /// 「当前处理人」列的悬停提示：说清流程停在哪一步、在等谁（角色节点补上角色名），
    /// 再带上处理人的部门 / 岗位。
    /// </summary>
    private string PendingTip(MotorLxListDto row)
    {
        if (row.StepArchived) return "流程已走完，整版归档";

        var node = string.IsNullOrWhiteSpace(row.NodeText) ? MotorNode.Title(row.Node) : row.NodeText!;
        var who = string.IsNullOrWhiteSpace(row.PendingName) ? "—" : row.PendingName!;
        var role = string.IsNullOrWhiteSpace(row.PendingRole) ? "" : $"（{MotorFlow.RoleName(row.PendingRole)}）";
        var emp = string.IsNullOrWhiteSpace(row.PendingEmpNo) ? "" : $"\n工号：{row.PendingEmpNo}";

        var card = Person(row.PendingEmpNo);
        var dept = card is null ? "" : $"\n部门：{Dash(card.Department)}\n岗位：{card.Position}";

        return $"当前节点：{node}\n处理人：{who}{role}{emp}{dept}";
    }
}
