    private async Task DeleteCoreAsync(IReadOnlyList<MotorLxListDto> rows)
    {
        _busy = true;
        try
        {
            var auth = await Auth.GetStoredAsync();
            var role = auth?.Role;
            var empNo = auth?.EmpNo;

            // 双保险：行内按钮按权限显示，真正删除时按当前 stored auth 再判一次，
            // 避免首屏缓存的角色过期（例如刚被设为管理员）导致管理员删不掉。
            var allowed = rows.Where(x => !IsUnsupported && CanDeleteCore(x, role, empNo)).ToList();
            if (allowed.Count == 0)
            {
                Notify.Show("没有可删除的项目（仅负责人或管理员可删除）", Severity.Warning);
                return;
            }

            var isRemote = (MotorLxListDto x) => string.Equals(RoutePrefixOf(x.ProductType), "remote", StringComparison.Ordinal);
            var motorRows = allowed.Where(x => !isRemote(x)).ToList();
            var remoteRows = allowed.Where(isRemote).ToList();

            var count = 0;
            // 同时传 ProjectGuid：立项单缺失（DocGuid 为空）的历史项目也能软删除。
            if (motorRows.Count > 0)
                count += await LxSvc.SoftDeleteAsync(
                    motorRows.Select(x => x.DocGuid), empNo,
                    motorRows.Select(x => x.ProjectGuid));
            if (remoteRows.Count > 0)
                count += await RemoteLxSvc.SoftDeleteAsync(
                    remoteRows.Select(x => x.DocGuid), empNo,
                    remoteRows.Select(x => x.ProjectGuid));

            if (count == 0)
            {
                Notify.Show("没有可删除的记录", Severity.Warning);
                return;
            }

            Notify.Show($"已删除 {count} 条", Severity.Success);
            _selected.Clear();
            await ReloadAsync(resetPage: false);
        }
        catch (Exception ex)
        {
            Notify.Show("删除失败：" + ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private int RowNo(MotorLxListDto row) => _skip + _rows.IndexOf(row) + 1;

    /// <summary>
    /// 点进项目时打开的地址：按版本表上的流程节点决定落到哪份单据
    /// （工程师/研发经理在规格书阶段直接落到规格书，蒋经理落到承认书）。
    /// 规格书还在编写/审批时，非研发侧（业务员等）落回立项单，见 MotorNode.EntryHref。
    /// 规则集中在 MotorNode.EntryHref，列表行与双击走同一套。
    /// </summary>
    private string EditHref(MotorLxListDto row)
    {
        var href = MotorNode.EntryHref(
            row.Node, row.DocGuid, row.GgDocGuid, row.GgStatus, row.CrDocGuid,
            row.IsMyTodo, _myRole, row.Status);

        var prefix = RoutePrefixOf(row.ProductType);
        if (href.Length == 0)
            href = $"/project/motor/lx/{Uri.EscapeDataString((row.DocGuid ?? "").Trim())}";

        return string.Equals(prefix, "remote", StringComparison.Ordinal)
            ? href.Replace("/project/motor/", "/project/remote/")
            : href;
    }

