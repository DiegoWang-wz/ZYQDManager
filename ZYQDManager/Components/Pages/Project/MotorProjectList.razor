    /// <summary>按产品的库类型码决定三单路由前缀。</summary>
    private static string RoutePrefixOf(string? productType)
        => string.Equals(productType, ProjectTypes.Remote, StringComparison.OrdinalIgnoreCase)
            ? "remote" : "motor";

    /// <summary>当前下拉选中的产品类型对应的路由前缀（「全部」时按行决定，这里只给默认电机）。</summary>
    private string RoutePrefix => string.Equals(_productType, "遥控器", StringComparison.Ordinal)
        ? "remote" : "motor";

    private string EmptyText => _busy
        ? "加载中…"
        : IsUnsupported
            ? $"{_productType}立项单功能开发中"
            : "暂无项目，点击「新建」创建";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _ready) return;
        RestoreFromReturn();

        // 待办判定要用登录人的工号与角色，取一次缓存起来，避免每次分页都回读 localStorage
        var auth = await Auth.GetStoredAsync();
        _myEmpNo = auth?.EmpNo;
        _myRole = auth?.Role;

        _ready = true;
        StateHasChanged();
    }

    private void RestoreFromReturn()
    {
        var snap = ListUiStateStore.Take(LastListReturn, ListUiStateStore.Keys.MotorProject);
        if (snap is null) return;
        if (!string.IsNullOrWhiteSpace(snap.FilterColumn) && MotorLxFilterColumns.IsValid(snap.FilterColumn))
            _filterColumn = snap.FilterColumn!;
        _keyword = snap.Keyword;
        _rowsPerPage = snap.PageSize > 0 ? snap.PageSize : 20;
        _currentPage = snap.Page < 0 ? 0 : snap.Page;
    }

    private void Persist(int page, int pageSize)
        => ListUiStateStore.Capture(LastListReturn, ListUiStateStore.Keys.MotorProject, new PagedListUiState
        {
            Page = page < 0 ? 0 : page,
            PageSize = pageSize > 0 ? pageSize : 20,
            FilterColumn = _filterColumn,
            Keyword = _keyword,
        });

    private async Task<TableData<MotorLxListDto>> LoadServerData(TableState state, CancellationToken ct)
    {
        if (!_ready || IsUnsupported)
        {
            _rows = [];
            _total = 0;
            _skip = 0;
            return new TableData<MotorLxListDto> { Items = [], TotalItems = 0 };
        }

        _busy = true;
        try
        {
            var take = state.PageSize <= 0 ? 20 : state.PageSize;
            _skip = Math.Max(0, state.Page) * take;

            var sortLabel = string.IsNullOrWhiteSpace(state.SortLabel) ? "CreateTime" : state.SortLabel;
            var descending = state.SortDirection != SortDirection.Ascending;
            if (string.IsNullOrWhiteSpace(state.SortLabel))
                descending = true;

            var isRemote = string.Equals(_productType, "遥控器", StringComparison.Ordinal);
            var isAll = string.Equals(_productType, AllLabel, StringComparison.Ordinal);
            var mq = new MotorLxQueryDto { FilterColumn = _filterColumn, Keyword = _keyword };
            var rq = new ZYQDManager.DataDtos.RemoteLxQueryDto { FilterColumn = _filterColumn, Keyword = _keyword };

            // 电机与遥控器是完全独立的产品：各自查自己的立项单表，绝不混查。
            List<MotorLxListDto> rows;
            int total;
            if (isRemote)
            {
                var (r, t) = await RemoteLxSvc.QueryPageAsync(rq, _skip, take, sortLabel, descending, ct,
                    ProjectTypes.Remote, _myEmpNo, _myRole);
                rows = r.Select(ToView).ToList();
                total = t;
            }
            else if (isAll)
            {
                // 「全部」要真正全局排序：两类各自取全集，按同一字段统一排序后再分页。
                // 之前是各自 skip/take 再拼接，导致创建时间看起来乱序、翻页也不对。
                const int allTake = 100_000;
                var (mr, mt) = await LxSvc.QueryPageAsync(mq, 0, allTake, sortLabel, descending, ct,
                    ProjectTypes.Motor, _myEmpNo, _myRole);
                var (rr, rt) = await RemoteLxSvc.QueryPageAsync(rq, 0, allTake, sortLabel, descending, ct,
                    ProjectTypes.Remote, _myEmpNo, _myRole);
                total = mt + rt;
                rows = SortMerged(mr.Concat(rr.Select(ToView)).ToList(), sortLabel, descending)
                    .Skip(_skip)
                    .Take(take)
                    .ToList();
            }
            else
            {
                var (r, t) = await LxSvc.QueryPageAsync(mq, _skip, take, sortLabel, descending, ct,
                    ProjectTypes.Motor, _myEmpNo, _myRole);
                rows = r;
                total = t;
            }

            // 顶部徽标：跨页统计当前登录人的待办项目数。
            try
            {
                var motorTodo = isRemote ? 0 : await LxSvc.CountMyTodoAsync(_myEmpNo, _myRole, ProjectTypes.Motor, ct);
                var remoteTodo = (isAll || isRemote) ? await RemoteLxSvc.CountMyTodoAsync(_myEmpNo, _myRole, ProjectTypes.Remote, ct) : 0;
                _todoCount = motorTodo + remoteTodo;
            }
            catch (Exception ex) when (ex is not OperationCanceledException)
            {
                // 徽标算不出来不该影响列表本身
                _todoCount = 0;
            }

            // 先把当前页出现的工号换成名片（姓名 / 部门 / 岗位），悬停提示才有内容
            await ResolvePeopleAsync(rows, ct);

            _rows = rows;
            _total = total;
            _currentPage = state.Page;
            _rowsPerPage = take;
            Persist(state.Page, take);

            return new TableData<MotorLxListDto> { Items = rows, TotalItems = total };
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested)
        {
            return new TableData<MotorLxListDto> { Items = _rows, TotalItems = _total };
        }
        catch (Exception ex)
        {
            if (ct.IsCancellationRequested)
                return new TableData<MotorLxListDto> { Items = _rows, TotalItems = _total };

            Notify.Show("加载失败：" + ex.Message, Severity.Error);
            return new TableData<MotorLxListDto> { Items = [], TotalItems = 0 };
        }
        finally
        {
            _busy = false;
            // 必须在 _busy 复位后刷新：原来在 try 里（_busy=true 时）刷新，
            // 会把「搜索 / 清空」按钮渲染成禁用态且不再恢复，按钮一直是灰的。
            await InvokeAsync(StateHasChanged);
        }
    }

