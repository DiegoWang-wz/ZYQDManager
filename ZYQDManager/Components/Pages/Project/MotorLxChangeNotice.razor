@*
    立项单修改点提醒：研发工程师打开规格书时自动弹出，
    直到这一版规格书编写完成（提交审批）为止。
    数据来自版本表的 ChangeReason + ChangeDiff，不查库。
*@
<MudDialog Class="motor-lx-change-dialog">
    <TitleContent>
        <MudText Typo="Typo.h6">立项单有修改，请按最新要求编写规格书</MudText>
    </TitleContent>

    <DialogContent>
        <MudText Typo="Typo.subtitle2">修改说明</MudText>
        <MudText Typo="Typo.body2" Class="mb-3">@(string.IsNullOrWhiteSpace(Reason) ? "（未填写）" : Reason)</MudText>

        <MudText Typo="Typo.subtitle2" Class="mb-1">修改点（@Changes.Count 项）</MudText>
        <MudTable Items="Changes" Dense="true" Hover="true" Elevation="0" MaxHeight="320px">
            <HeaderContent>
                <MudTh>字段</MudTh>
                <MudTh>修改前</MudTh>
                <MudTh>修改后</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.Field</MudTd>
                <MudTd Class="mlx-old">@context.OldText</MudTd>
                <MudTd Class="mlx-new">@context.NewText</MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Class="pa-3">本次只更新了说明，没有字段级改动记录</MudText>
            </NoRecordsContent>
        </MudTable>
    </DialogContent>

    <DialogActions>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Close">我知道了</MudButton>
    </DialogActions>
</MudDialog>

<style>
    .mlx-old { color: #c0392b; text-decoration: line-through; }
    .mlx-new { color: #15803d; font-weight: 600; }
    .mud-dialog.motor-lx-change-dialog .mud-dialog-content {
        max-height: 70vh;
        overflow-y: auto;
        scrollbar-width: none;
        -ms-overflow-style: none;
    }
    .mud-dialog.motor-lx-change-dialog .mud-dialog-content::-webkit-scrollbar { display: none; }
</style>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    /// <summary>业务员填的修改说明。</summary>
    [Parameter] public string? Reason { get; set; }

    /// <summary>逐字段修改点（从版本表 ChangeDiff 反序列化而来）。</summary>
    [Parameter] public List<MotorLxChange> Changes { get; set; } = [];

    private void Close() => MudDialog.Close(DialogResult.Ok(true));
}
