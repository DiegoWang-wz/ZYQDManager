    /// <summary>取当前登录人姓名写入审计列；取不到就退回工号，不阻断保存。</summary>
    private async Task<string?> ResolveEmpNameAsync(string? empNo)
    {
        if (string.IsNullOrWhiteSpace(empNo)) return null;
        try
        {
            var (ok, displayName, _, _) = await UserInfo.GetAsync(empNo);
            return ok && !string.IsNullOrWhiteSpace(displayName) ? displayName : empNo;
        }
        catch
        {
            return empNo;
        }
    }

    /// <summary>
    /// 「点击此处修改立项单」的落点：单据锁定后，业务员想回去改内容就走这里。
    /// 现在只给提示占位——修改流程（撤回 / 重开编辑 / 顺带把下游规格书、承认书标记失效）
    /// 定下来以后，把真正的动作接在这个方法里，界面不用再改。
    /// </summary>
    private async Task ModifyLxAsync()
    {
        if (IsNew) return;

        if (_archived)
        {
            Notify.Show("该版本已归档，整版冻结，不能修改", Severity.Warning);
            return;
        }

        if (!IsLatestVersion)
        {
            Notify.Show($"只能修改最新版本（当前 {_currentVersionNo}）的立项单", Severity.Warning);
            return;
        }

        if (!IsLxOwner)
        {
            Notify.Show("只有项目负责人本人可以修改立项单", Severity.Warning);
            return;
        }

        _modifyBase = RemoteLxDiff.Snapshot(_m);
        _modifyMode = true;
        Notify.Show("已进入修改状态：保存或提交时会自动生成新版本", Severity.Info);
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>退出修改：丢掉页面上的改动，重新按库里内容加载。</summary>
    private async Task CancelModifyAsync()
    {
        _modifyMode = false;
        _modifyBase = null;
        await LoadAsync(_m.DocGuid!);
    }

    /// <summary>
    /// 「保存 / 提交」在修改模式下的走法：
    /// 比出字段差异 → 弹窗写修改说明 → 建新版本 → 把内容写进新版本的立项单 → 跳过去。
    /// </summary>
    private async Task SaveModifyAsync(bool wantSubmit)
    {
        if (!CheckRequired()) return;
        if (_modifyBase is null)
        {
            Notify.Show("修改状态已失效，请重新点击「修改立项单」", Severity.Warning);
            return;
        }

        // 日期控件的值在本地字段里，先回写到模型再比差异
        _m.TimeToRequest = _timeToRequest;
        _m.RequiredCompletionTime = _requiredCompletion;

        var changes = RemoteLxDiff.Compare(_modifyBase, _m);
        if (changes.Count == 0)
        {
            Notify.Show("内容没有变化，不需要生成新版本", Severity.Info);
            return;
        }

        var dialog = await DialogService.ShowAsync<RemoteLxModifyDialog>(
            "修改立项单",
            new DialogParameters { ["Changes"] = changes },
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseOnEscapeKey = true });

        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not string reason || reason.Length == 0) return;

        _busy = true;
        try
        {
            var empName = await ResolveEmpNameAsync(_empNo);

            // 1. 以当前版本为底派生新版本。立项单是另外两张的源头，
            //    所以三份都列入改动范围一起重走：规格书要按新参数重编，承认书随后重做，
            //    否则新版本会出现「立项单改了、规格书还是旧参数」的错位。
            var (ok, msg, newVersionNo) = await FlowSvc.CreateVersionAsync(
                _m.ProjectGuid!,
                _m.VersionNo!,
                reason,
                [RemoteFlow.DocLx, RemoteFlow.DocGg, RemoteFlow.DocCr],
                _empNo, empName);

            if (!ok || string.IsNullOrWhiteSpace(newVersionNo))
            {
                Notify.Show(msg, Severity.Warning);
                return;
            }

            // 2. 把页面上的内容写进新版本的立项单，同时落「修改说明 + 修改点」
            var (saved, saveMsg, docGuid) = await LxDb.SaveRevisionAsync(
                _m.ProjectGuid!, newVersionNo, _m, reason,
                RemoteLxDiff.ToJson(changes), _empNo, empName);

            if (!saved || string.IsNullOrWhiteSpace(docGuid))
            {
                Notify.Show(saveMsg, Severity.Warning);
                return;
            }

            _modifyMode = false;
            _modifyBase = null;

            Notify.Show($"已生成版本 {newVersionNo}，修改内容与说明已记录", Severity.Success);

            // 3. 跳到新版本的立项单：新单据是草稿，提交入口就在上面
            var url = $"/project/remote/lx/{Uri.EscapeDataString(docGuid!)}?ver={Uri.EscapeDataString(newVersionNo)}";
            if (wantSubmit) url += "&submit=1";
            Nav.NavigateTo(url);
        }
        catch (Exception ex)
        {
            Notify.Show("修改失败：" + ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>
    /// 提交：先弹窗选「部门 + 研发工程师」（人员数据来自 JcCommonApi 的账号库），
    /// 选完再走原来的提交流程（落库 → 锁单 → 生成规格书草稿）。
    /// </summary>
    private async Task OpenSubmitDialogAsync()
    {
        if (!_editable)
        {
            Notify.Show("当前没有提交权限：立项单只有项目负责人本人可以提交", Severity.Warning);
            return;
        }

        // 修改模式下「提交」= 先派生新版本并落库，再由新单据去提交
        if (_modifyMode)
        {
            await SaveModifyAsync(wantSubmit: true);
            return;
        }

        if (!CheckRequired()) return;

        if (IsNew && string.IsNullOrWhiteSpace(_m.Customer))
        {
            Notify.Show("请先填写客户并保存后再提交", Severity.Warning);
            return;
        }

        var dialog = await DialogService.ShowAsync<RemoteSubmitDialog>(
            "提交立项单",
            new DialogParameters(),
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true });

        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not MotorSubmitPick pick) return;

        await SubmitAsync(pick);
    }

    private async Task SubmitAsync(MotorSubmitPick pick)
    {
        if (string.IsNullOrWhiteSpace(pick.EmpNo))
        {
            Notify.Show("请选择研发工程师", Severity.Warning);
            return;
        }

        // 先落库，保证提交的是页面上的最新内容
        if (!await SaveCoreAsync()) return;

        _busy = true;
        try
        {
            var empName = await ResolveEmpNameAsync(_empNo);
            var (ok, msg) = await FlowSvc.SubmitLxAsync(
                _m.DocGuid!,
                pick.EmpNo.Trim(),
                string.IsNullOrWhiteSpace(pick.Name) ? null : pick.Name.Trim(),
                _empNo, empName, comment: pick.Comment);
            Notify.Show(msg, ok ? Severity.Success : Severity.Warning);

            if (ok)
            {
                // 提交后留在立项单页（已锁成只读），不再自动跳进规格书：
                // 「编写规格书」是研发工程师的活，业务员不该被带进别人的草稿里。
                // 规格书草稿已经由服务端建好并推送，工程师登录后在待办里就能打开。
                await LoadAsync(_m.DocGuid!);
            }
        }
        catch (Exception ex)
        {
            Notify.Show("提交失败：" + ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>
    /// 模板里字段名标红的必填项（导出的 Excel 里就是红色字），保存与提交前必须填完。
    /// 顺序和页面 / 模板一致，提示缺项时按这个顺序列出。
    /// </summary>
    private static readonly (string Name, Func<RemoteLxModel, bool> Filled)[] RequiredFields =
    [
        ("客户", m => !string.IsNullOrWhiteSpace(m.Customer)),
        ("型号 Model No.", m => !string.IsNullOrWhiteSpace(m.MotorModelSpec)),
        ("描述 Description", m => !string.IsNullOrWhiteSpace(m.Description)),
        ("遥控器尺寸", m => !string.IsNullOrWhiteSpace(m.RemoteSize)),
        ("支架尺寸", m => !string.IsNullOrWhiteSpace(m.BracketSize)),
        ("遥控器重量", m => !string.IsNullOrWhiteSpace(m.RemoteWeight)),
        ("遥控器颜色", m => !string.IsNullOrWhiteSpace(m.RemoteColor)),
        ("电池型号", m => !string.IsNullOrWhiteSpace(m.BatteryType)),
        ("充电口要求", m => !string.IsNullOrWhiteSpace(m.ChargingMethod) || !string.IsNullOrWhiteSpace(m.ChargingMethodNo)),
        ("发射功率", m => !string.IsNullOrWhiteSpace(m.TransmitPower)),
        ("频率", m => !string.IsNullOrWhiteSpace(m.RemoteFrequency) || !string.IsNullOrWhiteSpace(m.RemoteFrequencyOther)),
        ("遥控技术", m => !string.IsNullOrWhiteSpace(m.RemoteTechnology)),
        ("遥控协议", m => !string.IsNullOrWhiteSpace(m.RemoteProtocol) || !string.IsNullOrWhiteSpace(m.RemoteProtocolOther)),
        ("通道数量", m => !string.IsNullOrWhiteSpace(m.ChannelQuantity)),
        ("工作温度", m => !string.IsNullOrWhiteSpace(m.WorkingTemperature)),
        ("传输距离", m => !string.IsNullOrWhiteSpace(m.RemoteDistanceIndoor) || !string.IsNullOrWhiteSpace(m.RemoteDistanceOutdoor)),
        ("应用场景", m => !string.IsNullOrWhiteSpace(m.Application)),
        ("防水等级", m => !string.IsNullOrWhiteSpace(m.IpLevel) || !string.IsNullOrWhiteSpace(m.IpLevelOther))
    ];

    /// <summary>必填项没填全时提示缺哪些，并拦住保存 / 提交。</summary>
    private bool CheckRequired()
    {
        var missing = RequiredFields.Where(f => !f.Filled(_m)).Select(f => f.Name).ToList();
        if (missing.Count == 0) return true;

        Notify.Show("请先填写必填项：" + string.Join("、", missing), Severity.Warning);
        return false;
    }

    /// <summary>保存主体逻辑，供按钮和提交前复用。</summary>
    private async Task<bool> SaveCoreAsync()
    {
        if (!CheckRequired()) return false;

        _busy = true;
        try
        {
            _m.TimeToRequest = _timeToRequest;
            _m.RequiredCompletionTime = _requiredCompletion;

            var (projectGuid, docGuid, created) = await LxDb.SaveDraftAsync(
                _m, _empNo, await ResolveEmpNameAsync(_empNo));
            _m.ProjectGuid = projectGuid;
            _m.DocGuid = docGuid;
            _m.CreateTime ??= DateTime.Now;
            _m.UpdateTime = DateTime.Now;
            if (string.IsNullOrWhiteSpace(_m.Status))
                _m.Status = RemoteFlow.LxDraft;

            Notify.Show(created ? "已保存，项目已建立" : "已保存", Severity.Success);

            if (created)
                Nav.NavigateTo($"/project/remote/lx/{docGuid}", replace: true);

            return true;
        }
        catch (Exception ex)
        {
            Notify.Show("保存失败：" + ex.Message, Severity.Error);
            return false;
        }
        finally
        {
            _busy = false;
        }
    }

    private string ExcelName(string ext)
        => SheetExport.FileName("立项单", _m.Customer, _m.MotorModelSpec ?? _m.Description, _m.VersionNo, ext);

    private async Task ExportExcelAsync()
    {
        if (!IsLatestVersion)
        {
            Notify.Show("历史版本只能查看，不能导出", Severity.Warning);
            return;
        }

        _busy = true;
        try
        {
            var bytes = SheetExport.BuildLx(_m);
            await JS.InvokeVoidAsync("downloadFileFromBase64", ExcelName("xlsx"),
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
                Convert.ToBase64String(bytes));
            Notify.Show("Excel 已导出", Severity.Success);
        }
        catch (Exception ex)
        {
            Notify.Show("导出失败：" + ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ExportPdfAsync()
    {
        if (!IsLatestVersion)
        {
            Notify.Show("历史版本只能查看，不能导出", Severity.Warning);
            return;
        }

        _busy = true;
        try
        {
            Notify.Show("正在生成 PDF，请稍候…", Severity.Info);
            var xlsx = SheetExport.BuildLx(_m);
            var pdf = await LibreOffice.ConvertXlsxToPdfAsync(xlsx);
            await JS.InvokeVoidAsync("downloadFileFromBase64", ExcelName("pdf"),
                "application/pdf", Convert.ToBase64String(pdf));
            Notify.Show("PDF 已导出", Severity.Success);
        }
        catch (Exception ex)
        {
            Notify.Show("导出 PDF 失败：" + ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }
}

