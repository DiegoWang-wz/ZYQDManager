    private static bool Has(string? value, string option)
    {
        if (string.IsNullOrWhiteSpace(value)) return false;
        return value.Split(',', StringSplitOptions.RemoveEmptyEntries)
            .Select(x => x.Trim())
            .Any(x => string.Equals(x, option, StringComparison.OrdinalIgnoreCase));
    }

    private static string? Toggle(string? value, string option, bool on)
    {
        var set = (value ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries)
            .Select(x => x.Trim())
            .Where(x => x.Length > 0)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);
        if (on) set.Add(option); else set.Remove(option);
        return set.Count == 0 ? null : string.Join(",", set);
    }

    /// <summary>已经套用过的 bundle 实例：父组件换了新数据才重新套用，避免重复覆盖用户正在编辑的内容。</summary>
    private RemoteDocBundle? _appliedBundle;

    protected override async Task OnParametersSetAsync()
    {
        // 容器模式：数据由 RemoteDocPager 一次取好，这里只套用，不查库
        if (Bundle is not null && !ReferenceEquals(_appliedBundle, Bundle))
        {
            var bundleAuth = await Auth.GetStoredAsync();
            _empNo = bundleAuth?.EmpNo;
            _myRole = bundleAuth?.Role;
            await ApplyBundleAsync(Bundle);
            return;
        }

        if (_loaded && !IsNew && string.Equals(_m.DocGuid, DocGuid, StringComparison.OrdinalIgnoreCase))
            return;

        var auth = await Auth.GetStoredAsync();
        _empNo = auth?.EmpNo;
        _myRole = auth?.Role;

        if (IsNew)
        {
            await InitNewAsync();
            _loaded = true;
            return;
        }

        await LoadAsync(DocGuid!);
        _loaded = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // 修改立项单生成新版本后带 ?submit=1 跳过来：渲染完成再弹提交框，
        // 这样弹窗里的必填校验针对的是新版本的正式内容。
        if (!AutoSubmit || _autoSubmitDone || !_loaded || IsNew || !_editable) return;

        _autoSubmitDone = true;
        await OpenSubmitDialogAsync();
    }

    /// <summary>把父组件取好的整屏数据套到本页字段上（零查询）。</summary>
    private async Task ApplyBundleAsync(RemoteDocBundle bundle)
    {
        _appliedBundle = bundle;
        _vDocs = bundle.Docs;
        _versionNos = bundle.VersionNos;
        _versions = bundle.Versions;
        _currentVersionNo = bundle.CurrentVersionNo;

        _m = bundle.Lx ?? new RemoteLxModel();
        _lastReject = bundle.LatestReject;
        _lastRejectFromName = await ResolveEmpNameAsync(_lastReject?.FromUserCode);
        _timeToRequest = _m.TimeToRequest?.Date;
        _requiredCompletion = _m.RequiredCompletionTime?.Date;

        // 换了单据（切版本 / 修改后跳到新版本）：退出修改模式，避免把上一张的快照带过来
        _modifyMode = false;
        _modifyBase = null;

        _loaded = true;
    }

    private async Task InitNewAsync()
    {
        var auth = await Auth.GetStoredAsync();
        _m = new RemoteLxModel
        {
            VersionNo = RemoteLxService.FirstVersionNo,
            IsDraft = true,
            Status = RemoteFlow.LxDraft,
            DemandPerson = auth?.EmpNo,
            TimeToRequest = DateTime.Today
        };
        _timeToRequest = DateTime.Today;
        _requiredCompletion = null;
        _versionNos = [];
        _vDocs = new();
        _versions = [];
        _currentVersionNo = null;
    }

    private async Task LoadAsync(string docGuid)
    {
        _busy = true;
        try
        {
            var row = await LxDb.GetByDocGuidAsync(docGuid);
            if (row is null)
            {
                Notify.Show("未找到立项单", Severity.Warning);
                Nav.NavigateTo("/project");
                return;
            }

            _m = row;
            _lastReject = await FlowSvc.GetLatestRejectAsync(row.ProjectGuid, row.VersionNo);
            _lastRejectFromName = await ResolveEmpNameAsync(_lastReject?.FromUserCode);

            // 重新按库加载（退出修改 / 切单据）：退出修改模式
            _modifyMode = false;
            _modifyBase = null;

            // 进来先对齐项目表的当前版本：旧标签页 / 收藏的链接可能还指着上一个版本，
            // 直接切到最新版本的立项单，避免在老版本上看着还是「当前」。
            // 用户手动从版本下拉选过版本（带 ?ver=）时不跳，否则切旧版会被弹回来。
            if (string.IsNullOrWhiteSpace(VersionQuery))
            {
                var latestDocGuid = await ResolveLatestVersionDocAsync(row);
                if (!string.IsNullOrWhiteSpace(latestDocGuid))
                {
                    Nav.NavigateTo($"/project/remote/lx/{Uri.EscapeDataString(latestDocGuid)}", replace: true);
                    return;
                }
            }

            await LoadVersionsAsync(row.ProjectGuid);

            // 翻页箭头用：同版本三份单据的定位与流程节点
            _vDocs = await DocSvc.GetVersionDocsAsync(row.ProjectGuid, row.VersionNo);

            _timeToRequest = row.TimeToRequest?.Date;
            _requiredCompletion = row.RequiredCompletionTime?.Date;
        }
        catch (Exception ex)
        {
            Notify.Show("加载失败：" + ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>版本下拉的数据：同一项目的所有版本（最新在前）+ 项目表上的当前版本号。</summary>
    private async Task LoadVersionsAsync(string? projectGuid)
    {
        _versionNos = [];
        _versions = [];
        _currentVersionNo = null;
        if (string.IsNullOrWhiteSpace(projectGuid)) return;

        try
        {
            // 三页共用同一份口径，下拉框的选项与标注才能在三个页面上完全一致
            var (nos, versions, current) = await LxDb.GetVersionOptionsAsync(projectGuid);
            _versionNos = nos;
            _versions = versions;
            _currentVersionNo = current;

            // 当前正在看的这一版必须在列表里，否则下拉框显示不出它
            var showing = (_m.VersionNo ?? "").Trim();
            if (showing.Length > 0 && !_versionNos.Any(x => RemoteFlow.Same(x, showing)))
                _versionNos.Insert(0, showing);
        }
        catch
        {
            // 版本列表取不到不影响正文，下拉直接不显示
            _versionNos = [];
            _versions = [];
        }
    }

    /// <summary>
    /// 打开的不是项目当前版本的立项单时，返回当前版本立项单的 DocGuid（调用方跳转过去）；
    /// 已经是最新版本则返回 null。
    /// </summary>
    private async Task<string?> ResolveLatestVersionDocAsync(RemoteLxModel row)
    {
        if (string.IsNullOrWhiteSpace(row.ProjectGuid)) return null;

        try
        {
            var current = await LxDb.GetCurrentVersionNoAsync(row.ProjectGuid);
            if (string.IsNullOrWhiteSpace(current)
                || string.Equals(current.Trim(), (row.VersionNo ?? "").Trim(), StringComparison.OrdinalIgnoreCase))
                return null;

            var docGuid = await LxDb.GetLxDocGuidAsync(row.ProjectGuid, current.Trim());
            if (string.IsNullOrWhiteSpace(docGuid)) return null;

            return string.Equals(docGuid.Trim(), row.DocGuid, StringComparison.OrdinalIgnoreCase)
                ? null
                : docGuid.Trim();
        }
        catch
        {
            // 查版本失败不影响正常打开，按原单据展示
            return null;
        }
    }

    private Task SaveAsync()
    {
        if (!_editable)
        {
            Notify.Show(IsNew
                ? "只有项目业务员可以编制立项单"
                : "当前没有修改权限：立项单只有项目负责人本人可以修改", Severity.Warning);
            return Task.CompletedTask;
        }

        return _modifyMode ? SaveModifyAsync(wantSubmit: false) : SaveCoreAsync();
    }

