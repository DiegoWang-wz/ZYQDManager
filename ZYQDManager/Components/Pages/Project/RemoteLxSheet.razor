@inject RemoteLxService LxDb
@inject RemoteDocService DocSvc
@inject RemoteFlowService FlowSvc
@inject RemoteSheetExportService SheetExport
@inject LibreOfficePdfService LibreOffice
@inject NavigationManager Nav
@inject SnackbarHelper Notify

@if (!Embedded)
{
    <PageTitle>@(IsNew ? "新建遥控器立项单" : "遥控器立项单")</PageTitle>
}

<div class="msheet-page">
    @if (!Embedded)
    {
        <RemoteDocArrows Docs="@_vDocs" Kind="lx" GgVisible="GgVisible"/>
    }

    <div class="msheet-bar msheet-bar-tools">
        @* 工具栏顺序三页统一：返回列表 → 导出Excel → 导出PDF → 流程动作 →（靠右）右侧信息 → 流程状态 → 版本 *@
        <button type="button" class="msheet-btn msheet-btn-ghost" @onclick="BackAsync">
            <MudIcon Icon="@Icons.Material.Filled.ArrowBack"/>返回列表
        </button>
        @* 历史版本只留「看」：被新版本取代的老版本不给导出，免得旧参数的文件流出去 *@
        <button type="button" class="msheet-btn msheet-btn-excel"
                disabled="@(_busy || IsNew || !IsLatestVersion)"
                title="@ExportBlockedTip"
                @onclick="ExportExcelAsync">
            <MudIcon Icon="@Icons.Material.Filled.TableView"/>导出Excel
        </button>
        <button type="button" class="msheet-btn msheet-btn-pdf"
                disabled="@(_busy || IsNew || !IsLatestVersion)"
                title="@ExportBlockedTip"
                @onclick="ExportPdfAsync">
            <MudIcon Icon="@Icons.Material.Filled.PictureAsPdf"/>导出PDF
        </button>
        @if (_editable)
        {
            <button type="button" class="msheet-btn msheet-btn-save" disabled="@_busy" @onclick="SaveAsync">
                <MudIcon Icon="@Icons.Material.Filled.Save"/>@(_busy ? "处理中…" : "保存")
            </button>
            <button type="button" class="msheet-btn msheet-btn-submit" disabled="@_busy" @onclick="OpenSubmitDialogAsync">
                <MudIcon Icon="@Icons.Material.Filled.Send"/>提交
            </button>
        }
        @* 立项单不再显示「研发工程师」；留一个空的 meta 只负责把右边这组顶到最右 *@
        <div class="msheet-meta"></div>
        @* 流程状态与版本下拉一起靠右：状态在左，版本占最右角 *@
        <span class="msheet-tag @(_archived ? "msheet-tag-archived" : _editable ? "msheet-tag-draft" : null)">
            @StepText
        </span>
        <RemoteVersionPicker ProjectGuid="@_m.ProjectGuid"
                            DocKind="lx"
                            SelectedVersionNo="@_m.VersionNo"
                            CurrentVersionNo="@_currentVersionNo"
                            VersionNos="@_versionNos"
                            Versions="@_versions"/>
    </div>

    @if (ShowRejectNotice)
    {
        <div class="msheet-bar msheet-reject-notice">
            <MudIcon Icon="@Icons.Material.Filled.ReportProblem" Style="font-size:16px"/>
            <span><strong>从「@RemoteFlow.RejectFromTitle(_lastReject!.PrevStepCode)」退回：</strong>@_lastReject.FlowComment</span>
            <span class="msheet-reject-meta">退回人 @RejectFromDisplay · @_lastReject.ActionTime.ToString("yyyy-MM-dd HH:mm")</span>
        </div>
    }

    @if (!_editable && !IsNew)
    {
        <div class="msheet-bar msheet-readonly-hint">
            <MudIcon Icon="@Icons.Material.Filled.Lock" Style="font-size:16px"/>@LockedHintText
            @if (CanModifyLx)
            {
                @* 修改立项单的入口：进入修改模式，保存/提交时自动派生新版本 *@
                <button type="button" class="msheet-modify-link" disabled="@_busy" @onclick="ModifyLxAsync">点击此处修改立项单</button>
            }
        </div>
    }

    @if (_modifyMode)
    {
        <div class="msheet-bar msheet-modify-banner">
            <MudIcon Icon="@Icons.Material.Filled.EditNote" Style="font-size:16px"/>
            正在修改立项单：保存或提交时会自动生成新版本，并记录本次修改的字段与说明。
            <button type="button" class="msheet-btn msheet-btn-ghost" disabled="@_busy" @onclick="CancelModifyAsync">退出修改</button>
        </div>
    }

    <RemoteFlowRecords Docs="@_vDocs"/>

    @* 用 fieldset disabled 兜住整张表：提交后 / 归档后所有 input、textarea、checkbox
       都由浏览器原生禁用，不会出现「文字灰了但复选框还能点」的情况。 *@
    <fieldset class="msheet-wrap @(_editable ? null : "msheet-readonly")" disabled="@(!_editable)">
        <table class="msheet">
            <colgroup>
                <col style="width:5%"/>
                <col style="width:16%"/>
                <col style="width:29%"/>
                <col style="width:19%"/>
                <col style="width:14%"/>
                <col style="width:17%"/>
            </colgroup>
            <tbody>
            <tr>

                <td colspan="6" class="msheet-title">遮阳驱动立项申请输入项目清单</td>

            </tr>

            <tr>

                <td class="msheet-label">需求人:</td>

                <td><input class="msheet-input" placeholder="工号 / 姓名" @bind="_m.DemandPerson" @bind:event="oninput"/></td>

                <td class="msheet-label">提出需求日期：</td>

                <td>

                    <span class="motordate @(_timeToRequest is null ? "is-empty" : "")">

                        <input type="date" class="msheet-input motordate-input" value="@_timeToRequest?.ToString("yyyy-MM-dd")"

                               @onchange='e => { _timeToRequest = ParseDateInput(e); }'/>

                    </span>

                </td>

                <td class="msheet-label">要求完成日期：</td>

                <td>

                    <span class="motordate @(_requiredCompletion is null ? "is-empty" : "")">

                        <input type="date" class="msheet-input motordate-input" value="@_requiredCompletion?.ToString("yyyy-MM-dd")"

                               @onchange='e => { _requiredCompletion = ParseDateInput(e); }'/>

                    </span>

                </td>

            </tr>

            <tr>

                <td class="msheet-label is-required">客户:<span class="msheet-req">*</span></td>

                <td colspan="2"><input class="msheet-input" placeholder="客户名称" @bind="_m.Customer" @bind:event="oninput"/></td>

                <td class="msheet-label">客户产品编号：</td>

                <td colspan="2"><input class="msheet-input" placeholder="客户料号" @bind="_m.CustomerPartCode" @bind:event="oninput"/></td>

            </tr>

            <tr>

                <td class="msheet-idx">1</td>

                <td class="msheet-label is-required">型号 Model No.<span class="msheet-req">*</span></td>

                <td colspan="4"><input class="msheet-input" placeholder="遥控器型号" @bind="_m.MotorModelSpec" @bind:event="oninput"/></td>

            </tr>

            <tr>

                <td class="msheet-idx">2</td>

                <td class="msheet-label is-required">描述 Description<span class="msheet-req">*</span></td>

                <td colspan="4"><input class="msheet-input" placeholder="产品描述 / 用途简述" @bind="_m.Description" @bind:event="oninput"/></td>

            </tr>

            <tr>

                <td class="msheet-idx">3</td>

                <td class="msheet-label is-required">遥控器尺寸 Remote Size<span class="msheet-req">*</span></td>

                <td colspan="4"><input class="msheet-input" placeholder="长 x 宽 x 高 (mm)" @bind="_m.RemoteSize" @bind:event="oninput"/></td>

            </tr>

            <tr>

                <td class="msheet-idx">4</td>

                <td class="msheet-label is-required">支架尺寸 Bracket Size<span class="msheet-req">*</span></td>

                <td colspan="4"><input class="msheet-input" placeholder="支架尺寸 (mm)" @bind="_m.BracketSize" @bind:event="oninput"/></td>

            </tr>

            <tr>

                <td class="msheet-idx">5</td>

                <td class="msheet-label is-required">遥控器重量 Remote Weight<span class="msheet-req">*</span></td>

                <td colspan="4">

                    <div class="msheet-inline">

                        <input class="msheet-input msheet-boxed" placeholder="重量" @bind="_m.RemoteWeight" @bind:event="oninput"/>

                        <span class="msheet-unit">g</span>

                    </div>

                </td>

            </tr>

            <tr>

                <td class="msheet-idx">6</td>

                <td class="msheet-label is-required">遥控器颜色 Remote Color<span class="msheet-req">*</span></td>

                <td colspan="4"><input class="msheet-input" placeholder="颜色" @bind="_m.RemoteColor" @bind:event="oninput"/></td>

            </tr>

            <tr>

                <td class="msheet-idx">7</td>

                <td class="msheet-label is-required">电池型号 Battery Type<span class="msheet-req">*</span></td>

                <td colspan="4"><input class="msheet-input" placeholder="电池型号" @bind="_m.BatteryType" @bind:event="oninput"/></td>

            </tr>

            <tr>

                <td class="msheet-idx">8</td>

                <td class="msheet-label is-required">充电口要求 Charging port for chargable remote<span class="msheet-req">*</span></td>

                <td colspan="4">

                    <div class="msheet-chk">

                        @foreach (var v in ChargingPorts)

                        {

                            <label>

                                <input type="checkbox" checked="@Has(_m.ChargingMethod, v)"

                                       @onchange='e => _m.ChargingMethod = Toggle(_m.ChargingMethod, v, e.Value is true)'/>@v

                            </label>

                        }

                        <input class="msheet-input msheet-boxed" style="max-width:140px" placeholder="其它"

                               @bind="_m.ChargingMethodNo" @bind:event="oninput"/>

                    </div>

                </td>

            </tr>

            <tr>

                <td class="msheet-idx">9</td>

                <td class="msheet-label is-required">发射功率 Transmit Power<span class="msheet-req">*</span></td>

                <td colspan="4"><input class="msheet-input" placeholder="发射功率" @bind="_m.TransmitPower" @bind:event="oninput"/></td>

            </tr>

            <tr>

                <td class="msheet-idx">10</td>

                <td class="msheet-label is-required">频率 Radio Frequency<span class="msheet-req">*</span></td>

                <td colspan="4">

                    <div class="msheet-chk">

                        @foreach (var v in RadioFreqs)

                        {

                            <label>

                                <input type="checkbox" checked="@Has(_m.RemoteFrequency, v)"

                                       @onchange='e => _m.RemoteFrequency = Toggle(_m.RemoteFrequency, v, e.Value is true)'/>@v

                            </label>

                        }

                        <input class="msheet-input msheet-boxed" style="max-width:120px" placeholder="其它频率"

                               @bind="_m.RemoteFrequencyOther" @bind:event="oninput"/>

                        <span class="msheet-unit">MHz</span>

                    </div>

                </td>

            </tr>

            <tr>

                <td class="msheet-idx">11</td>

                <td class="msheet-label is-required">遥控技术 Radio Mode<span class="msheet-req">*</span></td>

                <td colspan="4">

                    <div class="msheet-chk">

                        @foreach (var v in RadioModes)

                        {

                            <label>

                                <input type="checkbox" checked="@Has(_m.RemoteTechnology, v)"

                                       @onchange='e => _m.RemoteTechnology = Toggle(_m.RemoteTechnology, v, e.Value is true)'/>@v

                            </label>

                        }

                    </div>

                </td>

            </tr>

            <tr>

                <td class="msheet-idx">12</td>

                <td class="msheet-label is-required">遥控协议 Protocol<span class="msheet-req">*</span></td>

                <td colspan="4">

                    <div class="msheet-chk">

                        <input class="msheet-input msheet-boxed" style="max-width:240px" placeholder="协议"

                               @bind="_m.RemoteProtocol" @bind:event="oninput"/>

                        <input class="msheet-input msheet-boxed" style="max-width:140px" placeholder="其它协议"

                               @bind="_m.RemoteProtocolOther" @bind:event="oninput"/>

                    </div>

                </td>

            </tr>

            <tr>

                <td class="msheet-idx">13</td>

                <td class="msheet-label is-required">通道数量 Channel Quantity<span class="msheet-req">*</span></td>

                <td colspan="4"><input class="msheet-input" placeholder="如 2 / 6 / 16" @bind="_m.ChannelQuantity" @bind:event="oninput"/></td>

            </tr>

            <tr>

                <td class="msheet-idx">14</td>

                <td class="msheet-label is-required">工作温度 Working Temperature<span class="msheet-req">*</span></td>

                <td colspan="4"><input class="msheet-input" placeholder="工作温度范围" @bind="_m.WorkingTemperature" @bind:event="oninput"/></td>

            </tr>

            <tr>

                <td class="msheet-idx">15</td>

                <td class="msheet-label is-required">传输距离 Transmit Distance<span class="msheet-req">*</span></td>

                <td colspan="4">

                    <div class="msheet-inline">

                        <span class="msheet-unit">室内 Indoor</span>

                        <input class="msheet-input msheet-boxed" style="max-width:100px" placeholder="室内" @bind="_m.RemoteDistanceIndoor" @bind:event="oninput"/>

                        <span class="msheet-unit">m</span>

                        <span class="msheet-unit">室外 Outdoor</span>

                        <input class="msheet-input msheet-boxed" style="max-width:100px" placeholder="室外" @bind="_m.RemoteDistanceOutdoor" @bind:event="oninput"/>

                        <span class="msheet-unit">m</span>

                    </div>

                </td>

            </tr>

            <tr>

                <td class="msheet-idx">16</td>

                <td class="msheet-label is-required">应用场景 Application<span class="msheet-req">*</span></td>

                <td colspan="4"><input class="msheet-input" placeholder="应用场景" @bind="_m.Application" @bind:event="oninput"/></td>

            </tr>

            <tr>

                <td class="msheet-idx">17</td>

                <td class="msheet-label is-required">防水等级 IP Degree<span class="msheet-req">*</span></td>

                <td colspan="4">

                    <div class="msheet-inline">

                        <input class="msheet-input msheet-boxed" style="max-width:160px" placeholder="如 IP44" @bind="_m.IpLevel" @bind:event="oninput"/>

                        <input class="msheet-input msheet-boxed" style="max-width:200px" placeholder="其它"

                               @bind="_m.IpLevelOther" @bind:event="oninput"/>

                    </div>

                </td>

            </tr>


            </tbody>
        </table>
    </fieldset>
</div>

@code {
    [Parameter] public string? DocGuid { get; set; }

    /// <summary>
    /// 由 RemoteDocPager 统一取数后传入的一屏三单数据。
    /// 非空时本组件不再自己查库，直接用这份数据渲染（避免三单各查一遍、也避免并发用同一个 DbContext）。
    /// </summary>
    [Parameter] public RemoteDocBundle? Bundle { get; set; }

    /// <summary>嵌入在三单容器里：不输出 PageTitle 与左右翻页箭头（容器统一渲染一份）。</summary>
    [Parameter] public bool Embedded { get; set; }

    /// <summary>
    /// 用户从版本下拉里主动选了某一版时才带这个参数。
    /// 带了就不再往「项目当前版本」上跳，否则切到旧版本会被立刻弹回来。
    /// </summary>
    /// <summary>由容器从 ?ver= 解析后传入（本组件已不是路由页，不再直接读查询串）。</summary>
    [Parameter] public string? VersionQuery { get; set; }

    /// <summary>规格书是否可点开：研发经理审批通过前对业务员关闭，由容器算好传入。</summary>
    [Parameter] public bool GgVisible { get; set; } = true;

    /// <summary>
    /// 修改立项单生成新版本后，希望接着提交 —— 容器从 ?submit=1 解析后传进来。
    /// 页面加载完成后自动弹一次提交弹窗，业务员不用再点一遍。
    /// </summary>
    [Parameter] public bool AutoSubmit { get; set; }

    private bool _autoSubmitDone;

    private RemoteLxModel _m = new();
    private DateTime? _timeToRequest;
    private DateTime? _requiredCompletion;
    private bool _busy;

    private static DateTime? ParseDateInput(ChangeEventArgs e)
    {
        var v = e.Value?.ToString()?.Trim();
        if (string.IsNullOrWhiteSpace(v)) return null;
        return DateTime.TryParse(v, out var d) ? d : null;
    }
    private ApprovalFlowModel? _lastReject;

    /// <summary>退回人姓名：流转记录只存工号，加载时从账号中心解析一次。</summary>
    private string? _lastRejectFromName;

    /// <summary>
    /// 退回人显示「姓名（工号）」：姓名优先取版本对应关系表 NodeNames（含流程日志里的操作人），
    /// 查不到再用账号中心解析的姓名兜底，最后才是工号本身。
    /// 用计算属性是因为个别加载路径里 NodeNames 赋值晚于 _lastRejectFromName。
    /// </summary>
    private string RejectFromDisplay
    {
        get
        {
            var empNo = _lastReject?.FromUserCode?.Trim();
            if (string.IsNullOrWhiteSpace(empNo)) return "—";
            var name = _vDocs.NodeNames.TryGetValue(empNo, out var n) && !string.IsNullOrWhiteSpace(n)
                ? n
                : _lastRejectFromName;
            return string.IsNullOrWhiteSpace(name) ? empNo! : $"{name}（{empNo}）";
        }
    }

    /// <summary>
    /// 规格书退回到立项单时，立项单就停在 LxDraft，正好等于退回记录的退回目标；
    /// 业务员重填并提交后状态离开 LxDraft，这条退回就算处理完，提示自动收起。
    /// </summary>
    private bool ShowRejectNotice => !string.IsNullOrWhiteSpace(_lastReject?.FlowComment)
        && (RemoteFlow.Same(_m.Status, _lastReject!.StepCode)
            // 老数据状态为空：只认规格书的退回（立项单自己不会产生退回）
            || (string.IsNullOrWhiteSpace(_m.Status)
                && RemoteFlow.Same(_lastReject.DocType, RemoteFlow.DocGg)));

    private bool _loaded;

    /// <summary>版本下拉的数据源：版本号（按立项单实际存在的版本，最新在前）+ 版本表里的归档信息。</summary>
    private List<string> _versionNos = [];

    /// <summary>当前版本三份单据的定位与状态，页面查一次，翻页箭头与流程判定共用。</summary>
    private RemoteVersionDocs _vDocs = new();
    private List<ProjectVersionModel> _versions = [];
    private string? _currentVersionNo;

    /// <summary>
    /// 顶部标签 = 流程当前停在哪一步（立项单填写中 / 规格书填写中 / 承认书审批中 / 已归档）。
    /// 流程图撤掉以后，这一处就是页面上唯一的进度提示。
    /// </summary>
    private string StepText
    {
        get
        {
            if (RemoteFlow.IsVersionArchived(_vDocs.VersionStatus, _vDocs.CurrentNode)) return "已归档";
            if (!RemoteNode.IsValid(_vDocs.CurrentNode))
                return RemoteFlow.StatusName(string.IsNullOrWhiteSpace(_m.Status) ? RemoteFlow.LxDraft : _m.Status);
            return RemoteNode.StepName(_vDocs.CurrentNode);
        }
    }

    private string? _empNo;

    /// <summary>登录人的本系统角色，判定「谁能改立项单」用（管理员放行）。</summary>
    private string? _myRole;

    private bool IsNew => string.IsNullOrWhiteSpace(DocGuid)
                          || string.Equals(DocGuid, "new", StringComparison.OrdinalIgnoreCase);

    /// <summary>整版已归档：状态标签改用「已归档」，页面整体冻结。</summary>
    private bool _archived => RemoteFlow.IsVersionArchived(_vDocs.VersionStatus, _vDocs.CurrentNode);

    /// <summary>
    /// 可编辑：草稿（或历史数据空状态）本来就能改；
    /// 锁单后点「点击此处修改立项单」进入修改模式，也临时打开编辑，
    /// 只是这种编辑保存时会生成新版本。归档一律锁定。
    /// </summary>
    private bool _editable => !_archived
                              && IsLatestVersion
                              && (_modifyMode || IsNew || IsLxOwner)
                              // 修改模式本来就是给「已完成的立项单」用的：进来后必须解开锁定，
                              // 保存/提交时再派生新版本，不能因为状态不是草稿又把字段禁掉。
                              && (_modifyMode
                                  || string.IsNullOrWhiteSpace(_m.Status)
                                  || RemoteFlow.Same(_m.Status, RemoteFlow.LxDraft));

    /// <summary>修改模式：单据已锁定，点修改后临时放开编辑，保存/提交时派生新版本。</summary>
    private bool _modifyMode;

    /// <summary>进入修改模式那一刻的业务字段快照，保存时拿它比出改了什么。</summary>
    private RemoteLxModel? _modifyBase;

    /// <summary>草稿之外（提交过 / 审批中 / 已完成）的单据，才需要「修改」入口。</summary>
    private bool IsLockedDoc => !IsNew
                                && !_archived
                                && !string.IsNullOrWhiteSpace(_m.Status)
                                && !RemoteFlow.Same(_m.Status, RemoteFlow.LxDraft);

    /// <summary>只能改最新版本：旧版本已经整版留档，改它没意义。</summary>
    private bool IsLatestVersion => string.IsNullOrWhiteSpace(_currentVersionNo)
                                    || RemoteFlow.Same(_m.VersionNo, _currentVersionNo);

    /// <summary>
    /// 谁能改立项单：项目负责人本人或管理员。
    /// 研发工程师、检测员也能打开这一页看内容（要照着做规格书），
    /// 但立项单是业务员的单据，不给「修改」入口，免得研发替客户改需求。
    /// </summary>
    private bool CanModifyLx => IsLockedDoc && IsLatestVersion && IsLxOwner;

    /// <summary>
    /// 当前登录人是不是这张立项单的主人：负责人本人（超级管理员 JcAdmin 除外，可全局维护）。
    /// 销售经理不算管理员 —— 他只在被指派终审时能审批承认书，其余单据一律只读。
    /// 项目没记负责人时谁都不能改，与服务端护栏一致。
    /// </summary>
    private bool IsLxOwner => AppRoles.IsStrictAdmin(_myRole, _empNo)
                              || (!string.IsNullOrWhiteSpace(_vDocs.OwnerEmpNo)
                                  && RemoteFlow.Same(_empNo, _vDocs.OwnerEmpNo));

    /// <summary>
    /// 只读提示文案：归档 / 老版本 / 不是本人单据 / 状态锁定，四种原因说清楚，
    /// 用户才知道该找谁、为什么按钮没了。
    /// </summary>
    private string LockedHintText => _archived
        ? "该版本已归档，内容已冻结，仅供查看与导出。"
        : !IsLatestVersion
            ? $"该版本不是最新版本（最新为 {_currentVersionNo}），仅供查看。"
            : !IsLxOwner
                ? "该立项单由业务员编制中，只有项目负责人可以编辑。"
