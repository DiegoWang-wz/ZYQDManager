@inject MotorDocService DocSvc
@inject MotorLxService LxSvc
@inject MotorFlowService FlowSvc
@inject MotorSignFileService SignFiles
@inject MotorSheetExportService SheetExport
@inject LibreOfficePdfService LibreOffice
@inject NavigationManager Nav
@inject IDialogService DialogService

@if (!Embedded)
{
    <PageTitle>@(IsNew ? "新建电机承认书" : "电机承认书")</PageTitle>
}

<div class="msheet-page">
    @if (!Embedded)
    {
        <MotorDocArrows Docs="@_vDocs" Kind="cr" GgVisible="GgVisible"/>
    }

    <div class="msheet-bar msheet-bar-tools">
        @* 工具栏顺序三页统一：返回列表 → 导出Excel → 导出PDF → 流程动作 →（靠右）右侧信息 → 流程状态 → 版本 *@
        <button type="button" class="msheet-btn msheet-btn-ghost" @onclick="BackAsync">
            <MudIcon Icon="@Icons.Material.Filled.ArrowBack"/>返回列表
        </button>
        @* 承认书要等蒋经理终审通过、定稿之后才能导出，避免中途版本流出去 *@
        <button type="button" class="msheet-btn msheet-btn-excel"
                disabled="@(_busy || !CanExport)"
                title="@(CanExport ? null : ExportBlockedTip)"
                @onclick="ExportExcelAsync">
            <MudIcon Icon="@Icons.Material.Filled.TableView"/>导出Excel
        </button>
        <button type="button" class="msheet-btn msheet-btn-pdf"
                disabled="@(_busy || !CanExport)"
                title="@(CanExport ? null : ExportBlockedTip)"
                @onclick="ExportPdfAsync">
            <MudIcon Icon="@Icons.Material.Filled.PictureAsPdf"/>导出PDF
        </button>
        @if (!string.IsNullOrWhiteSpace(_head.SignFileId))
        {
            <a href="@SignUrl" target="_blank" class="msheet-link" title="打开已回传的签字版 PDF">
                <MudIcon Icon="@Icons.Material.Filled.Visibility"/>查看签字版
            </a>
        }
        @if (_editable)
        {
            <button type="button" class="msheet-btn msheet-btn-save" disabled="@_busy" @onclick="SaveAsync">
                <MudIcon Icon="@Icons.Material.Filled.Save"/>@(_busy ? "处理中…" : "保存")
            </button>
        }
        @if (_editable && !IsNew)
        {
            <button type="button" class="msheet-btn msheet-btn-submit" disabled="@_busy" @onclick="SubmitAsync">
                <MudIcon Icon="@Icons.Material.Filled.Send"/>提交审批
            </button>
        }
        @if (_canApprove)
        {
            <button type="button" class="msheet-btn msheet-btn-approve" disabled="@_busy" @onclick="ApproveAsync">
                <MudIcon Icon="@Icons.Material.Filled.CheckCircle"/>审批通过
            </button>
            <button type="button" class="msheet-btn msheet-btn-reject" disabled="@_busy" @onclick="RejectAsync">
                <MudIcon Icon="@Icons.Material.Filled.Undo"/>退回
            </button>
        }
        @if (ShowSignUpload)
        {
            <label class="msheet-btn msheet-btn-upload" title="@(HasSignFile ? "重新上传会替换已回传的签字版 PDF" : "上传客户回传的签字版 PDF")">
                <MudIcon Icon="@Icons.Material.Filled.UploadFile"/>@(HasSignFile ? "重新上传签字版" : "上传签字版")
                <InputFile OnChange="OnSignFileAsync" accept=".pdf" style="display:none"/>
            </label>
        }
        @if (_editable && !string.IsNullOrWhiteSpace(_head.SourceGgDocGuid))
        {
            <button type="button" class="msheet-btn msheet-btn-ghost" disabled="@_busy" @onclick="ReloadFromGgAsync">
                <MudIcon Icon="@Icons.Material.Filled.Sync"/>重新抓取规格书
            </button>
        }
        @if (ShowArchiveButton)
        {
            <button type="button" class="msheet-btn msheet-btn-archive" disabled="@_busy" @onclick="ArchiveAsync">
                <MudIcon Icon="@Icons.Material.Filled.Archive"/>归档
            </button>
        }
        <div class="msheet-meta">
            @if (Same(_head.Status, MotorFlow.CrPendingManager) && !string.IsNullOrWhiteSpace(_managerName ?? _managerEmpNo))
            {
                <span>审批经理：@(_managerName ?? _managerEmpNo)</span>
            }
            @if (Same(_head.Status, MotorFlow.CrPendingJiang) && !string.IsNullOrWhiteSpace(_finalName ?? _finalEmpNo))
            {
                <span>终审人：@(_finalName ?? _finalEmpNo)</span>
            }
        </div>
        @* 流程状态与版本下拉一起靠右：状态在左，版本占最右角。
           原来那串「规格书版本：V1」静态文字由下拉取代，来源版本改挂在下拉的悬停提示上，信息不丢 *@
        <span class="msheet-tag @(IsArchived ? "msheet-tag-archived" : _editable ? "msheet-tag-draft" : null)">
            @StepText
        </span>
        <MotorVersionPicker ProjectGuid="@_head.ProjectGuid"
                            DocKind="cr"
                            SelectedVersionNo="@_head.VersionNo"
                            CurrentVersionNo="@_currentVersionNo"
                            VersionNos="@_versionNos"
                            Versions="@_versions"
                            SourceHint="@(string.IsNullOrWhiteSpace(_head.SourceGgDocGuid) ? null : $"来源规格书版本：{_sourceGgVersion}")"/>
    </div>

    @if (ShowRejectNotice)
    {
        <div class="msheet-bar msheet-reject-notice">
            <MudIcon Icon="@Icons.Material.Filled.ReportProblem" Style="font-size:16px"/>
            <span><strong>从「@MotorFlow.RejectFromTitle(_lastReject!.PrevStepCode)」退回：</strong>@_lastReject.FlowComment</span>
            <span class="msheet-reject-meta">退回人 @RejectFromDisplay · @_lastReject.ActionTime.ToString("yyyy-MM-dd HH:mm")</span>
        </div>
    }

    @if (!_editable)
    {
        <div class="msheet-bar msheet-readonly-hint">
            <MudIcon Icon="@Icons.Material.Filled.Lock" Style="font-size:16px"/>@(IsArchived
                ? "该版本已归档，内容已冻结，仅供查看与导出。"
                : !IsLatestVersion
                    ? $"该版本不是最新版本（最新为 {_currentVersionNo}），仅供查看。"
                    : !IsDocOwner
                        ? "该承认书由项目业务员编制：只有业务员本人可以修改。"
                        : CanExport
                            ? $"当前状态为「{MotorFlow.StatusName(_head.Status)}」，内容已锁定，仅供查看与导出。"
                            : $"当前状态为「{MotorFlow.StatusName(_head.Status)}」，内容已锁定，仅供查看。")
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(NoPermissionText))
    {
        <div class="msheet-bar msheet-readonly-hint">
            <MudIcon Icon="@Icons.Material.Filled.Info" Style="font-size:16px"/>@NoPermissionText
        </div>
    }

    <MotorFlowRecords Docs="@_vDocs"/>

    @* fieldset disabled：锁定后连复选框一起禁用，避免「文字变灰但勾选框还能点」 *@
    <fieldset class="msheet-wrap @(_editable ? null : "msheet-readonly")" disabled="@(!_editable)">
        <table class="msheet">
            <colgroup>
                <col style="width:16%"/>
                <col style="width:16%"/>
                <col style="width:21%"/>
                <col style="width:23%"/>
                <col style="width:24%"/>
            </colgroup>
            <tbody>
            <tr><td colspan="5" class="msheet-title">样品承认书</td></tr>
            <tr><td colspan="5" class="msheet-title-en">Sample Approval Sheet</td></tr>

            <tr>
                <td colspan="2" class="msheet-label">产品名称 Part name：</td>
                <td colspan="3"><input class="msheet-input" placeholder="产品名称" value="@G(MotorDocKeys.ProductName)" @onchange='e => S(MotorDocKeys.ProductName, e)'/></td>
            </tr>
            <tr>
                <td colspan="2" class="msheet-label">产品型号 Part code：</td>
                <td colspan="3"><input class="msheet-input" placeholder="如 JCD45" value="@G(MotorDocKeys.PartCode)" @onchange='e => S(MotorDocKeys.PartCode, e)'/></td>
            </tr>
            <tr>
                <td colspan="2" class="msheet-label">客户 Customer：</td>
                <td colspan="3"><input class="msheet-input" placeholder="客户名称" value="@G(MotorDocKeys.Customer)" @onchange='e => S(MotorDocKeys.Customer, e)'/></td>
            </tr>
            <tr>
                <td colspan="2" class="msheet-label">公司 Company：</td>
                <td colspan="3"><input class="msheet-input" value="@(G(MotorDocKeys.Company) ?? DefaultCompany)" @onchange='e => S(MotorDocKeys.Company, e)'/></td>
            </tr>

            <tr>
                <td colspan="2" rowspan="7" class="msheet-label msheet-center">
                    样品检验结果<br/>Sample Inspection Result
                </td>
                <td colspan="2" class="msheet-subsec msheet-center">检验项目 Inspection Item</td>
                <td class="msheet-subsec msheet-center">结论 Conclusion</td>
            </tr>
            @for (var i = 0; i < _extra.SampleChecks.Count; i++)
            {
                var row = _extra.SampleChecks[i];
                <tr>
                    <td colspan="2" class="msheet-label">@row.Name</td>
                    <td>
                        <div class="msheet-chk">
                            <label><input type="checkbox" checked="@IsResult(row, "PASS")"
                                          @onchange='e => row.Result = e.Value is true ? "PASS" : null'/>PASS</label>
                            <label><input type="checkbox" checked="@IsResult(row, "FAIL")"
                                          @onchange='e => row.Result = e.Value is true ? "FAIL" : null'/>FAIL</label>
                        </div>
                    </td>
                </tr>
            }

            <tr>
                <td colspan="2" class="msheet-sig">
                    <div class="msheet-sig-title">捷昌研发确认/日期：JC R&amp;D confirm</div>
                    <input class="msheet-input msheet-boxed" placeholder="签名" value="@G("signRdConfirm")" @onchange='e => S("signRdConfirm", e)'/>
                    <span class="motordate @(string.IsNullOrWhiteSpace(G("signRdConfirmDate")) ? "is-empty" : "")">
                        <input type="date" class="msheet-input msheet-boxed motordate-input" value="@G("signRdConfirmDate")"
                               @onchange='e => { S("signRdConfirmDate", e); }'/>
                    </span>
                </td>
                <td colspan="2" class="msheet-sig">
                    <div class="msheet-sig-title">客户确认/日期：Customer confirm</div>
                    <input class="msheet-input msheet-boxed" placeholder="签名" value="@G("signCustomer")" @onchange='e => S("signCustomer", e)'/>
                    <span class="motordate @(string.IsNullOrWhiteSpace(G("signCustomerDate")) ? "is-empty" : "")">
                        <input type="date" class="msheet-input msheet-boxed motordate-input" value="@G("signCustomerDate")"
                               @onchange='e => { S("signCustomerDate", e); }'/>
                    </span>
                </td>
                <td class="msheet-sig">
                    <div class="msheet-sig-title">捷昌销售确认/日期：JC Sale confirm</div>
                    <input class="msheet-input msheet-boxed" placeholder="签名" value="@G("signSaleConfirm")" @onchange='e => S("signSaleConfirm", e)'/>
                    <span class="motordate @(string.IsNullOrWhiteSpace(G("signSaleConfirmDate")) ? "is-empty" : "")">
                        <input type="date" class="msheet-input msheet-boxed motordate-input" value="@G("signSaleConfirmDate")"
                               @onchange='e => { S("signSaleConfirmDate", e); }'/>
                    </span>
                </td>
            </tr>
            </tbody>
        </table>

        <MotorSpecSections Extra="_extra" Editable="_editable"/>
    </fieldset>
</div>

@code {
    [Parameter] public string? DocGuid { get; set; }

    /// <summary>
    /// 由 MotorDocPager 统一取数后传入的一屏三单数据。
    /// 非空时本组件不再自己查库，直接用这份数据渲染。
    /// </summary>
    [Parameter] public MotorDocBundle? Bundle { get; set; }

    /// <summary>嵌入在三单容器里：不输出 PageTitle 与左右翻页箭头（容器统一渲染一份）。</summary>
    [Parameter] public bool Embedded { get; set; }

    /// <summary>新建时由容器从 ?projectGuid= / ?fromGg= / ?fromLx= / ?ver= 解析后传入。</summary>
    [Parameter] public string? ProjectGuid { get; set; }
    [Parameter] public string? FromGg { get; set; }
    [Parameter] public string? FromLx { get; set; }
    [Parameter] public string? VersionNo { get; set; }

    /// <summary>规格书是否可点开：研发经理审批通过前对业务员关闭，由容器算好传入。</summary>
    [Parameter] public bool GgVisible { get; set; } = true;

    private MotorCrModel _head = new();
    private MotorDocExtra _extra = MotorDocExtra.CreateDefault();
    private bool _busy;
    private bool _loaded;

    /// <summary>上次加载/保存时的表单快照，用来判断提交前有没有未保存的修改。</summary>
    private string _snapshot = "";

    /// <summary>
    /// 顶部标签 = 流程当前停在哪一步（承认书编制中 / 承认书审批中 / 待回传签字版 / 已归档）。
    /// 流程图撤掉以后，这一处就是页面上唯一的进度提示。
    /// </summary>
    private string StepText
    {
        get
        {
            if (IsArchived) return "已归档";
            return MotorNode.IsValid(_vDocs.CurrentNode)
                ? MotorNode.StepName(_vDocs.CurrentNode, crSheet: true)
                : MotorFlow.StatusName(_head.Status);
        }
    }

    private string? _sourceGgVersion;

    private string? _empNo;
    private string? _empName;
    private bool _canApprove;
    /// <summary>本版本指派的研发经理（规格书审批时指定，承认书审批沿用）。</summary>
    private string? _managerEmpNo;
    private string? _managerName;

    /// <summary>本版本的终审人（销售经理）：业务员提交承认书时选定。</summary>
    private string? _finalEmpNo;
    private string? _finalName;

    /// <summary>版本自身状态（InProgress / ReadyToArchive / Archived），与单据 Status 不是一回事。</summary>
    private string? _versionStatus;
    private string? _ownerEmpNo;
    private string? _lxStatus;
    private string? _ggStatus;
    private string? _myRole;

    /// <summary>当前版本三份单据的定位与状态，页面查一次，翻页箭头与流程判定共用。</summary>
    private MotorVersionDocs _vDocs = new();

    /// <summary>版本下拉的数据，三页共用同一份口径（见 MotorLxService.GetVersionOptionsAsync）。</summary>
    private List<string> _versionNos = [];
    private List<ProjectVersionModel> _versions = [];
    private string? _currentVersionNo;
    private ApprovalFlowModel? _lastReject;

    /// <summary>退回人姓名：流转记录只存工号，加载时解析一次。</summary>
    private string? _lastRejectFromName;

    /// <summary>
    /// 退回人显示「姓名（工号）」：姓名优先取版本对应关系表 NodeNames（含流程日志里的操作人），
    /// 查不到再用账号中心解析的姓名兜底，最后才是工号本身。
    /// 用计算属性是因为个别加载路径里 NodeNames 赋值晚于 _lastRejectFromName。
    /// </summary>
    private string RejectFromDisplay
    {
        get
        {
            var empNo = _lastReject?.FromUserCode?.Trim();
            if (string.IsNullOrWhiteSpace(empNo)) return "—";
            var name = _vDocs.NodeNames.TryGetValue(empNo, out var n) && !string.IsNullOrWhiteSpace(n)
                ? n
                : _lastRejectFromName;
            return string.IsNullOrWhiteSpace(name) ? empNo! : $"{name}（{empNo}）";
        }
    }

    /// <summary>
    /// 退回原因只在「承认书还停在被退回的那个节点」时显示（退回业务员 = CrDraft，退回研发经理 = CrPendingManager）。
    /// 退回本身也是一步，重新提交后这一步就算处理完毕，页头不再提示；
    /// 完整的退回记录会留在归档后的流程路径里。
    /// </summary>
    private bool ShowRejectNotice => !string.IsNullOrWhiteSpace(_lastReject?.FlowComment)
        && (Same(_head.Status, _lastReject!.StepCode)
            // 老数据状态为空：按单据类型兜底，避免把别的单据的退回显示出来
            || (string.IsNullOrWhiteSpace(_head.Status)
                && Same(_lastReject.DocType, MotorFlow.DocCr)));

    private const string DefaultCompany = "浙江捷昌线性驱动科技股份有限公司";

    private bool IsNew => string.IsNullOrWhiteSpace(DocGuid)
                          || string.Equals(DocGuid, "new", StringComparison.OrdinalIgnoreCase);

    /// <summary>单据是否指派给我：没有指派记录就一律不放行，与服务端校验保持一致。</summary>
    private bool IsAssignedToMe(string? assignedEmpNo)
        => !string.IsNullOrWhiteSpace(assignedEmpNo)
           && string.Equals(assignedEmpNo.Trim(), (_empNo ?? "").Trim(), StringComparison.OrdinalIgnoreCase);

    /// <summary>
    /// 是否是本版本的最终审批人：必须是版本上指定的那位销售经理，缺一不可。
    /// </summary>
    private async Task<bool> IsFinalApproverAsync()
        => IsAssignedToMe(_finalEmpNo)
           && await FlowSvc.HasRoleAsync(MotorFlow.RoleFinalApprover, _empNo);

    /// <summary>
    /// 谁能改承认书：项目业务员本人（超级管理员 JcAdmin 除外，可全局维护）。
    /// 研发经理、销售经理只审批（进页面时单据早已锁定），研发工程师只能看。
    /// 项目没记负责人时谁都不能改，与服务端护栏一致。
    /// </summary>
    private bool IsDocOwner => AppRoles.IsStrictAdmin(_myRole, _empNo)
                               || (!string.IsNullOrWhiteSpace(_ownerEmpNo) && Same(_empNo, _ownerEmpNo))
                               // 新建页还没带出项目信息时，按业务员角色放行（与服务端 SaveCrAsync 口径一致）
                               || (IsNew && string.IsNullOrWhiteSpace(_ownerEmpNo)
                                   && Same(_myRole, AppRoles.Operator));

    /// <summary>草稿（或历史数据空状态）、且是本项目业务员本人，才允许改内容。</summary>
    private bool _editable => !IsArchived
                              && IsLatestVersion
                              && IsDocOwner
                              && (string.IsNullOrWhiteSpace(_head.Status)
                                  || Same(_head.Status, MotorFlow.CrDraft));

    /// <summary>已经回传过签字版：按钮文案变「重新上传签字版」，上传前要求确认覆盖。</summary>
    private bool HasSignFile => !string.IsNullOrWhiteSpace(_head.SignFileId);

    /// <summary>
    /// 签字版回传是业务员的活：只有项目负责人本人或管理员能上传。
    /// 待回传签字版可以传，已完成也可以重新上传覆盖（归档后锁定）。
    /// </summary>
    private bool ShowSignUpload => !IsArchived
                                  && IsLatestVersion
                                  && IsDocOwner
                                  && (Same(_head.Status, MotorFlow.CrPendingSign)
                                      || Same(_head.Status, MotorFlow.CrCompleted));

    /// <summary>
    /// 承认书能否导出，两道门：
    /// 1. 必须是最新版本 —— 被取代的历史版本只留查看；
    /// 2. 销售经理终审通过（转「待回传签字版」）之后才开放，避免中途版本流出去。
    /// 归档但仍是当前版本的，允许导出留底。
    /// </summary>
    private bool CanExport => !IsNew
                              && _loaded
                              && IsLatestVersion
                              && (IsArchived
                                  || Same(_head.Status, MotorFlow.CrPendingSign)
                                  || Same(_head.Status, MotorFlow.CrCompleted));

    private string ExportBlockedTip => !IsLatestVersion
        ? "历史版本只能查看，不能导出"
        : $"终审通过后才能导出，当前状态：{MotorFlow.StatusName(_head.Status)}";

    /// <summary>版本已归档：状态标签改用「已归档」，页面全锁。</summary>
    private bool IsArchived => MotorFlow.IsVersionArchived(_versionStatus, _vDocs.CurrentNode);

    /// <summary>
    /// 是不是项目的最新版本。翻到老版本时整页只读：
    /// 老版本是留档用的，再改它 / 提交它会和最新版流程打架。
    /// </summary>
    private bool IsLatestVersion => string.IsNullOrWhiteSpace(_currentVersionNo)
                                    || MotorFlow.Same(_head.VersionNo, _currentVersionNo);

    /// <summary>
    /// 归档按钮的显示条件：承认书这一步已结束、三份单据都完成、版本还没归档且是最新版本，
    /// 且当前账号是项目业务员本人（或狭义管理员）。服务端 <c>ArchiveAsync</c> 会再校验一遍。
    /// </summary>
    private bool ShowArchiveButton
        => !IsNew
           && _loaded
           && !IsArchived
           && IsLatestVersion
           && MotorFlow.IsLxDone(_lxStatus)
           && MotorFlow.IsGgDone(_ggStatus)
           && MotorFlow.IsCrDone(_head.Status)
           && IsDocOwner;

    /// <summary>待审批但当前账号没权限时给出可操作提示，而不是让按钮静默消失。</summary>
    private string? NoPermissionText
    {
        get
        {
            if (_canApprove) return null;

            if (Same(_head.Status, MotorFlow.CrPendingManager))
            {
                if (!IsAssignedToMe(_managerEmpNo))
                    return string.IsNullOrWhiteSpace(_managerEmpNo)
                        ? "该版本还没有指定研发经理，请退回业务员重新提交时选定。"
                        : $"该承认书已指派给 {_managerName ?? _managerEmpNo} 审批。";

                return "当前状态为「待研发经理审批」，你的账号没有研发经理角色，看不到审批按钮。请让管理员在「用户管理」里把这个工号的本系统角色改为研发经理。";
            }

            if (Same(_head.Status, MotorFlow.CrPendingJiang))
            {
                var who = _finalName ?? _finalEmpNo;
                return string.IsNullOrWhiteSpace(who)
                    ? "当前状态为「待终审」，该版本还没有指定终审人，请联系业务员确认。"
                    : $"当前状态为「待终审」，该版本已指派给 {who} 审批。";
            }

            return null;
        }
    }

    private string? G(string key) => _extra.Fields.TryGetValue(key, out var v) ? v : null;

    /// <summary>
    /// 签字版 PDF 的浏览地址：新文件存在 3.240 的 /ZYQDManger/PDF 下，用老站域名还原；
    /// 历史数据里遗留的本地 /upLoad/... 保持相对路径，避免拼错域名打不开。
    /// </summary>
    private string SignUrl
    {
        get
        {
            var p = (_head.SignFileId ?? "").Trim();
            if (p.Length == 0) return "";
            return p.StartsWith("/upLoad/", StringComparison.OrdinalIgnoreCase)
                ? p
                : LegacyFileUrl.Resolve(p, Config["LegacyFiles:BaseUrl"]);
        }
    }

    private void S(string key, ChangeEventArgs e)
    {
        var v = e.Value?.ToString();
        if (string.IsNullOrWhiteSpace(v)) _extra.Fields.Remove(key);
        else _extra.Fields[key] = v!;
    }

    /// <summary>日期选择器统一显示「年/月/日」，库里仍按 yyyy-MM-dd 存。</summary>
    private static DateTime? DateOf(string? iso) => DateTime.TryParse(iso, out var d) ? d : null;

    private void SetIsoDate(string key, DateTime? value)
    {
        if (value is null) _extra.Fields.Remove(key);
        else _extra.Fields[key] = value.Value.ToString("yyyy-MM-dd");
    }

    private static bool IsResult(MotorSampleCheckRow row, string value)
        => string.Equals(row.Result, value, StringComparison.OrdinalIgnoreCase);

    /// <summary>已经套用过的 bundle 实例：父组件换了新数据才重新套用，避免覆盖正在编辑的内容。</summary>
    private MotorDocBundle? _appliedBundle;

    protected override async Task OnParametersSetAsync()
    {
        // 容器模式：数据由 MotorDocPager 一次取好，这里只套用，不查库
        if (Bundle is not null && !ReferenceEquals(_appliedBundle, Bundle))
        {
            var bundleAuth = await Auth.GetStoredAsync();
            _empNo = bundleAuth?.EmpNo;
            _myRole = bundleAuth?.Role;
            _empName = await ResolveNameAsync(_empNo);
            await ApplyBundleAsync(Bundle);
            return;
        }

        if (_loaded)
        {
            if (!IsNew && string.Equals(_head.DocGuid, DocGuid, StringComparison.OrdinalIgnoreCase))
                return;
            if (IsNew && string.IsNullOrWhiteSpace(_head.DocGuid))
                return;
        }

        var auth = await Auth.GetStoredAsync();
        _empNo = auth?.EmpNo;
        _myRole = auth?.Role;
        _empName = await ResolveNameAsync(_empNo);

        if (IsNew)
        {
            await InitNewAsync();
            _loaded = true;
            _snapshot = SnapshotNow();
            return;
        }

        await LoadAsync(DocGuid!);
        _loaded = true;
    }

    /// <summary>把父组件取好的整屏数据套到本页字段上（零查询）。</summary>
    private async Task ApplyBundleAsync(MotorDocBundle bundle)
    {
        _appliedBundle = bundle;
        _vDocs = bundle.Docs;
        _versionNos = bundle.VersionNos;
        _versions = bundle.Versions;
        _currentVersionNo = bundle.CurrentVersionNo;
        _managerEmpNo = bundle.Docs.ManagerEmpNo;
        _managerName = bundle.Docs.ManagerName;
        _finalEmpNo = bundle.Docs.Version?.FinalEmpNo;
        _finalName = await ResolveNameAsync(bundle.Docs.Version?.FinalEmpNo);

        _head = bundle.Cr ?? new MotorCrModel();
        _lastReject = bundle.LatestReject;
        _lastRejectFromName = await ResolveNameAsync(_lastReject?.FromUserCode);
        _extra = MotorDocExtra.FromJson(_head.ExtraJson);
        if (string.IsNullOrWhiteSpace(G(MotorDocKeys.Company)))
            _extra.Fields[MotorDocKeys.Company] = DefaultCompany;

        // 来源规格书的版本号用于页面提示，同版本规格书已在 bundle 里，不再单独查库
        _sourceGgVersion = bundle.Gg?.VersionNo;

        _versionStatus = _vDocs.VersionStatus;
        _lxStatus = _vDocs.LxStatus;
        _ggStatus = _vDocs.GgStatus;
        _ownerEmpNo = _vDocs.OwnerEmpNo;

        _canApprove = IsLatestVersion
                      && ((Same(_head.Status, MotorFlow.CrPendingManager)
                           && await FlowSvc.HasRoleAsync(MotorFlow.RoleRdManager, _empNo)
                           && IsAssignedToMe(_managerEmpNo))
                          || (Same(_head.Status, MotorFlow.CrPendingJiang)
                              && await IsFinalApproverAsync()));

        _loaded = true;
        _snapshot = SnapshotNow();
    }

    private async Task InitNewAsync()
    {
        _head = new MotorCrModel
        {
            ProjectGuid = ProjectGuid ?? "",
            VersionNo = string.IsNullOrWhiteSpace(VersionNo) ? MotorLxService.FirstVersionNo : VersionNo,
            IsDraft = true,
            Status = MotorFlow.CrDraft,
            SourceGgDocGuid = FromGg,
            SourceLxDocGuid = FromLx
        };
        _extra = MotorDocExtra.CreateDefault();

        if (!string.IsNullOrWhiteSpace(FromGg))
        {
            await FillFromGgAsync(FromGg!);
        }
        else if (!string.IsNullOrWhiteSpace(FromLx))
        {
            await FillFromLxAsync(FromLx!);
        }

        // 新建承认书时也要带出项目负责人/指派人，否则编辑权判定会误判成「不是本人」
        if (!string.IsNullOrWhiteSpace(_head.ProjectGuid))
        {
            _vDocs = await DocSvc.GetVersionDocsAsync(_head.ProjectGuid, _head.VersionNo);
            _ownerEmpNo = _vDocs.OwnerEmpNo;
            _managerEmpNo = _vDocs.ManagerEmpNo;
            _managerName = _vDocs.ManagerName;
            _finalEmpNo = _vDocs.Version?.FinalEmpNo;
            _finalName = await ResolveNameAsync(_vDocs.Version?.FinalEmpNo);
        }
        _lastReject = await FlowSvc.GetLatestRejectAsync(_head.ProjectGuid, _head.VersionNo);
        _lastRejectFromName = await ResolveNameAsync(_lastReject?.FromUserCode);

        if (string.IsNullOrWhiteSpace(G(MotorDocKeys.Company)))
            _extra.Fields[MotorDocKeys.Company] = DefaultCompany;
    }

    private async Task LoadAsync(string docGuid)
    {
        _busy = true;
        try
        {
            var row = await DocSvc.GetCrAsync(docGuid);
            if (row is null)
            {
                Notify.Show("未找到承认书", Severity.Warning);
                Nav.NavigateTo("/project");
                return;
            }

            _head = row;
            _lastReject = await FlowSvc.GetLatestRejectAsync(row.ProjectGuid, row.VersionNo);
            _lastRejectFromName = await ResolveNameAsync(_lastReject?.FromUserCode);
            _extra = MotorDocExtra.FromJson(row.ExtraJson);
            if (string.IsNullOrWhiteSpace(G(MotorDocKeys.Company)))
                _extra.Fields[MotorDocKeys.Company] = DefaultCompany;

            if (!string.IsNullOrWhiteSpace(row.SourceGgDocGuid))
            {
                var gg = await DocSvc.GetGgAsync(row.SourceGgDocGuid);
                _sourceGgVersion = gg?.VersionNo;
            }

            // 一次查回三份单据的定位与版本状态：翻页箭头、审批指派、归档按钮都用它
            _vDocs = await DocSvc.GetVersionDocsAsync(row.ProjectGuid, row.VersionNo);
            _managerEmpNo = _vDocs.ManagerEmpNo;
            _managerName = _vDocs.ManagerName;
            _finalEmpNo = _vDocs.Version?.FinalEmpNo;
            _finalName = await ResolveNameAsync(_vDocs.Version?.FinalEmpNo);

            // 版本下拉：与立项单/规格书同一套数据，切版本时跳到对应版本的承认书
            await LoadVersionOptionsAsync(row.ProjectGuid, row.VersionNo);

            _versionStatus = _vDocs.VersionStatus;
            _lxStatus = _vDocs.LxStatus;
            _ggStatus = _vDocs.GgStatus;
            _ownerEmpNo = _vDocs.OwnerEmpNo;

            _canApprove = IsLatestVersion
                          && ((Same(row.Status, MotorFlow.CrPendingManager)
                               && await FlowSvc.HasRoleAsync(MotorFlow.RoleRdManager, _empNo)
                               && IsAssignedToMe(_managerEmpNo))
                              || (Same(row.Status, MotorFlow.CrPendingJiang)
                                  && await IsFinalApproverAsync()));

            _snapshot = SnapshotNow();

        }
        catch (Exception ex)
        {
            Notify.Show("加载失败：" + ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ReloadFromGgAsync()
    {
        if (string.IsNullOrWhiteSpace(_head.SourceGgDocGuid)) return;

        if (!_editable)
        {
            Notify.Show("当前没有修改权限：承认书只有项目业务员本人可以修改", Severity.Warning);
            return;
        }

        var ok = await JS.InvokeAsync<bool>("confirm", "将用规格书的最新内容覆盖承认书的对应字段，已编辑的内容可能被覆盖，继续？");
        if (!ok) return;

        await FillFromGgAsync(_head.SourceGgDocGuid!);
        Notify.Show("已重新抓取规格书内容", Severity.Success);
    }

    /// <summary>规格书 → 承认书：默认抓取全部参数，业务可再编辑。</summary>
    private async Task FillFromGgAsync(string ggDocGuid)
    {
        var gg = await DocSvc.GetGgAsync(ggDocGuid);
        if (gg is null)
        {
            Notify.Show("未找到来源规格书，无法抓取", Severity.Warning);
            return;
        }

        _extra = MotorDocExtra.FromJson(gg.ExtraJson);

        _head.ProjectGuid = string.IsNullOrWhiteSpace(_head.ProjectGuid) ? gg.ProjectGuid : _head.ProjectGuid;
        if (string.IsNullOrWhiteSpace(_head.VersionNo) || _head.VersionNo == "vn")
            _head.VersionNo = gg.VersionNo;
        _head.SourceGgDocGuid = gg.DocGuid;
        if (string.IsNullOrWhiteSpace(_head.SourceLxDocGuid))
            _head.SourceLxDocGuid = gg.SourceLxDocGuid;
        _head.DemandPerson = gg.DemandPerson;
        _head.CustomerPartCode = gg.CustomerPartCode;
        _head.TimeToRequest = gg.TimeToRequest;
        _head.RequiredCompletionTime = gg.RequiredCompletionTime;
        _sourceGgVersion = gg.VersionNo;

        if (string.IsNullOrWhiteSpace(G(MotorDocKeys.Company)))
            _extra.Fields[MotorDocKeys.Company] = DefaultCompany;
    }

    private async Task FillFromLxAsync(string lxDocGuid)
    {
        var lx = await LxSvc.GetByDocGuidAsync(lxDocGuid);
        if (lx is null) return;

        _head.ProjectGuid = string.IsNullOrWhiteSpace(_head.ProjectGuid) ? lx.ProjectGuid : _head.ProjectGuid;
        if (string.IsNullOrWhiteSpace(_head.VersionNo) || _head.VersionNo == "vn")
            _head.VersionNo = lx.VersionNo;
        _head.DemandPerson = lx.DemandPerson;
        _head.CustomerPartCode = lx.CustomerPartCode;

        void Set(string key, string? value)
        {
            if (string.IsNullOrWhiteSpace(value)) return;
            if (!_extra.Fields.ContainsKey(key) || string.IsNullOrWhiteSpace(_extra.Fields[key]))
                _extra.Fields[key] = value!.Trim();
        }

        Set(MotorDocKeys.ProductName, lx.Description);
        Set(MotorDocKeys.PartCode, lx.MotorModelSpec);
        Set(MotorDocKeys.Customer, lx.Customer);
        Set(MotorDocKeys.InputVoltage, lx.InputVoltage);
        Set(MotorDocKeys.RatedTorque, lx.RatedTorque);
        Set(MotorDocKeys.RatedPower, lx.RatedPower);
        Set(MotorDocKeys.Noise, lx.OperatingNoise);
        Set(MotorDocKeys.ProtectionTime, lx.MaxRunningTime);
        Set(MotorDocKeys.SpecialFunction, lx.SpecialFunction);
        Set(MotorDocKeys.OtherRequirement, lx.OtherRequirement);
    }

    /// <summary>当前表单内容的快照（模型整体序列化，属性顺序稳定）。</summary>
    private string SnapshotNow() => FormSnapshot.Of(_head, _extra);

    /// <summary>页面上的内容是否还没保存：和加载/上次保存时的快照比字符串。</summary>
    private bool HasUnsavedChanges => _loaded && !FormSnapshot.Same(SnapshotNow(), _snapshot);

    /// <summary>
    /// 提交审批前先落一次库：有未保存的修改时先问一句「是否保存后提交」，
    /// 避免用户以为提交会带上页面上的改动。
    /// </summary>
    private async Task<bool> ConfirmAndSaveAsync()
    {
        if (HasUnsavedChanges)
        {
            var ok = await DialogService.ShowMessageBoxAsync(
                "提交审批",
                "表单有未保存的修改，是否先保存再提交？",
                yesText: "保存并提交",
                cancelText: "取消");
            if (ok != true) return false;
        }

        try
        {
            await DocSvc.SaveCrAsync(_head, _extra, _empNo, _empName);
            _snapshot = SnapshotNow();
            return true;
        }
        catch (Exception ex)
        {
            Notify.Show("保存失败：" + ex.Message, Severity.Error);
            return false;
        }
    }

    private async Task SaveAsync()
    {
        if (!_editable)
        {
            Notify.Show(IsNew
                ? "只有项目业务员可以编制承认书"
                : "当前没有修改权限：承认书只有项目业务员本人可以修改", Severity.Warning);
            return;
        }

        _busy = true;
        try
        {
            var result = await DocSvc.SaveCrAsync(_head, _extra, _empNo, _empName);
            _head.ProjectGuid = result.ProjectGuid;
            _head.DocGuid = result.DocGuid;
            Notify.Show(result.Created ? "承认书已保存" : "已保存", Severity.Success);

            if (result.Created)
                Nav.NavigateTo($"/project/motor/cr/{result.DocGuid}", replace: true);
            else
                await LoadAsync(result.DocGuid);
        }
        catch (Exception ex)
        {
            Notify.Show("保存失败：" + ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SubmitAsync()
    {
        if (IsNew || string.IsNullOrWhiteSpace(_head.DocGuid)) return;

        if (!_editable)
        {
            Notify.Show("当前没有提交权限：承认书只有项目业务员本人可以提交审批", Severity.Warning);
            return;
        }

        if (!await ConfirmAndSaveAsync()) return;

        // 研发经理默认沿用规格书审批时指定的那位，但允许业务员重选
        string? managerEmpNo;
        string? managerName;

        var docs = await DocSvc.GetVersionDocsAsync(_head.ProjectGuid, _head.VersionNo);
        var dialog = await DialogService.ShowAsync<MotorSubmitDialog>(
            "提交研发经理审批",
            new DialogParameters
            {
                [nameof(MotorSubmitDialog.Title)] = "提交研发经理审批",
                [nameof(MotorSubmitDialog.Caption)] =
                    "默认选中规格书审批时的研发经理，如需更换可在这里重选；他审批通过后再自动流转到销售经理终审。",
                [nameof(MotorSubmitDialog.RoleCode)] = AppRoles.RdManager,
                [nameof(MotorSubmitDialog.PersonLabel)] = "研发经理",
                [nameof(MotorSubmitDialog.UseDepartment)] = false,
                [nameof(MotorSubmitDialog.DefaultEmpNo)] = docs.ManagerEmpNo,
                [nameof(MotorSubmitDialog.EmptyHint)] =
                    "暂无研发经理账号，请确认需要指派的人员是否创建了系统账号，且角色维护为「研发经理」。"
            },
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true });

        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not MotorSubmitPick pick) return;

        managerEmpNo = pick.EmpNo;
        managerName = pick.Name;

        // 终审人由服务端自动取销售经理（目前只有一位），研发经理通过后自动流转，不需要业务员在这里选。
        _busy = true;
        try
        {
            var (ok, msg) = await FlowSvc.SubmitCrAsync(
                _head.DocGuid!, _empNo, _empName, CancellationToken.None, managerEmpNo, managerName,
                comment: pick.Comment);
            Notify.Show(msg, ok ? Severity.Success : Severity.Warning);
            if (ok) await LoadAsync(_head.DocGuid!);
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>
    /// 归档：三份单据齐了以后由业务员点，整版冻结。
    /// 后端 <c>ArchiveAsync</c> 会再校验一遍三单状态，这里只做确认与提示。
    /// </summary>
    private async Task ArchiveAsync()
    {
        if (!_loaded || string.IsNullOrWhiteSpace(_head.ProjectGuid)) return;

        var ok = await DialogService.ShowMessageBoxAsync(
            "确认归档",
            $"归档后版本 {_head.VersionNo} 将冻结，不能再修改，也不能在此基础上新建版本。确定归档吗？",
            yesText: "归档",
            cancelText: "取消");
        if (ok != true) return;

        var (askOk, remark) = await MotorRemarkDialog.AskAsync(
            DialogService, "归档备注", "可注明归档依据，会写进流程记录的备注列。", "submit");
        if (!askOk) return;

        _busy = true;
        try
        {
            var (success, msg) = await FlowSvc.ArchiveAsync(
                _head.ProjectGuid, _head.VersionNo, _empNo, _empName, comment: remark);
            Notify.Show(msg, success ? Severity.Success : Severity.Warning);
            if (success && !string.IsNullOrWhiteSpace(_head.DocGuid))
                await LoadAsync(_head.DocGuid!);
        }
        catch (Exception ex)
        {
            Notify.Show("归档失败：" + ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ApproveAsync()
    {
        var (askOk, remark) = await MotorRemarkDialog.AskAsync(
            DialogService, "审批备注", "可以写明审批依据，会写进流程记录的备注列。");
        if (!askOk) return;

        _busy = true;
        try
        {
            var (ok, msg) = await FlowSvc.ApproveCrAsync(_head.DocGuid!, _empNo, _empName, remark);
            Notify.Show(msg, ok ? Severity.Success : Severity.Warning);
            if (ok) await LoadAsync(_head.DocGuid!);
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>
    /// 退回：弹窗列出当前节点之前的全部步骤，可任选一步退回（包括规格书环节）。
    /// </summary>
    private async Task RejectAsync()
    {
        var current = MotorNode.Normalize(_vDocs.CurrentNode);
        var options = MotorNode.All
            .Where(x => x.Node < current)
            .Select(x => new MotorRejectOption(
                x.Node,
                MotorNode.OptionLabel(x.Node),
                MotorNode.AssigneeLabel(x.Node,
                    _vDocs.OwnerEmpNo, _vDocs.OwnerName,
                    _vDocs.EngineerEmpNo, _vDocs.EngineerName,
                    _managerEmpNo, _managerName,
                    _finalEmpNo, _finalName)))
            .ToList();
        if (options.Count == 0) return;

        var (askOk, pick) = await MotorRejectDialog.AskAsync(
            DialogService, "退回节点", options, current - 1);
        if (!askOk || pick is null) return;

        _busy = true;
        try
        {
            var (ok, msg) = await FlowSvc.RejectToNodeAsync(
                _head.ProjectGuid, _head.VersionNo, pick.TargetNode,
                _empNo, _empName, pick.Comment);
            Notify.Show(msg, ok ? Severity.Success : Severity.Warning);
            if (ok) await LoadAsync(_head.DocGuid!);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task OnSignFileAsync(InputFileChangeEventArgs e)
    {
        if (_busy) return;

        if (!ShowSignUpload)
        {
            Notify.Show("只有项目负责人可以回传承认书签字版", Severity.Warning);
            return;
        }

        var file = e.File;
        if (file is null) return;
        if (file.Size > 20 * 1024 * 1024)
        {
            Notify.Show("签字版不能超过 20MB", Severity.Warning);
            return;
        }

        var (askOk, remark) = await MotorRemarkDialog.AskAsync(
            DialogService, "回传签字版备注", "可注明客户回传时间、签字人等，会写进流程记录的备注列。", "submit");
        if (!askOk) return;

        // 已有签字版：先确认覆盖，避免手滑把正式的那份换掉
        if (HasSignFile)
        {
            var replace = await DialogService.ShowMessageBoxAsync(
                "重新上传签字版",
                "该承认书已经回传过签字版，重新上传会覆盖原来的 PDF，是否继续？",
                yesText: "重新上传",
                cancelText: "取消");
            if (replace != true) return;
        }

        _busy = true;
        try
        {
            await using var stream = file.OpenReadStream(20 * 1024 * 1024);
            var (url, name) = await SignFiles.SavePdfAsync(stream, file.Name);
            var (ok, msg) = await FlowSvc.UploadSignAsync(
                MotorFlow.DocCr, _head.DocGuid!, url, name, _empNo, _empName, comment: remark);
            Notify.Show(msg, ok ? Severity.Success : Severity.Warning);
            if (ok) await LoadAsync(_head.DocGuid!);
        }
        catch (Exception ex)
        {
            Notify.Show("上传失败：" + ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private Task BackAsync()
    {
        Nav.NavigateTo("/project");
        return Task.CompletedTask;
    }

    /// <summary>版本下拉数据；取不到就隐藏下拉，不影响正文加载。</summary>
    private async Task LoadVersionOptionsAsync(string? projectGuid, string? showingVersion)
    {
        try
        {
            var (nos, versions, current) = await LxSvc.GetVersionOptionsAsync(projectGuid);
            _versionNos = nos;
            _versions = versions;
            _currentVersionNo = current;

            // 正在看的这一版必须在选项里，否则下拉框显示不出它
            var showing = (showingVersion ?? "").Trim();
            if (showing.Length > 0 && !_versionNos.Any(x => MotorFlow.Same(x, showing)))
                _versionNos.Insert(0, showing);
        }
        catch
        {
            _versionNos = [];
            _versions = [];
        }
    }

