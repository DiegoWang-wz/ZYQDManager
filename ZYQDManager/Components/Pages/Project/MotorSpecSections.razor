@code {
    [Parameter, EditorRequired] public MotorDocExtra Extra { get; set; } = MotorDocExtra.CreateDefault();

    /// <summary>是否可编辑：只读页不渲染上传/删除按钮，没图的位置直接留空。</summary>
    [Parameter] public bool Editable { get; set; } = true;

    private string? G(string key) => Extra.Fields.TryGetValue(key, out var v) ? v : null;

    private void S(string key, ChangeEventArgs e) => SetValue(key, e.Value?.ToString());

    private void SetValue(string key, string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) Extra.Fields.Remove(key);
        else Extra.Fields[key] = value!;
    }

    /// <summary>图片先落盘，URL 写回 Extra；点页面「保存」后随 ExtraJson 一起入库。</summary>
    private async Task UploadImageAsync(InputFileChangeEventArgs e, Action<string?> setUrl)
    {
        var file = e.File;
        if (file is null) return;
        if (file.Size > 10 * 1024 * 1024)
        {
            Notify.Show("图片不能超过 10MB", Severity.Warning);
            return;
        }

        try
        {
            await using var stream = file.OpenReadStream(10 * 1024 * 1024);
            var url = await Images.SaveAsync(stream, file.Name);
            setUrl(url);
            Notify.Show("图片已上传，点「保存」后写入单据", Severity.Success);
        }
        catch (Exception ex)
        {
            Notify.Show("图片上传失败：" + ex.Message, Severity.Error);
        }
    }

    private void RemoveImage(string? url, Action<string?> clear)
    {
        Images.TryDelete(url);
        clear(null);
    }

    private bool Has(string key, string option)
    {
        var v = G(key);
        if (string.IsNullOrWhiteSpace(v)) return false;
        return v.Split(',', StringSplitOptions.RemoveEmptyEntries)
            .Select(x => x.Trim())
            .Any(x => string.Equals(x, option, StringComparison.OrdinalIgnoreCase));
    }

    private void Toggle(string key, string option, bool on)
    {
        var set = (G(key) ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries)
            .Select(x => x.Trim())
            .Where(x => x.Length > 0)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);
        if (on) set.Add(option); else set.Remove(option);
        SetValue(key, set.Count == 0 ? null : string.Join(",", set));
    }

    private string? O(string code) => Extra.Operations.TryGetValue(code, out var v) ? v : null;

    private void SetOp(string code, ChangeEventArgs e)
    {
        var v = e.Value?.ToString();
        if (string.IsNullOrWhiteSpace(v)) Extra.Operations.Remove(code);
        else Extra.Operations[code] = v!;
    }

