@* 规格书 / 承认书共用：一~七节（参数表、工况、配件、尺寸图、附件、包装、操作说明） *@
@using ZYQDManager.DataDtos
@inject MotorImageService Images

<div class="msheet-lines">
    <table class="msheet">
        <colgroup>
            <col style="width:16%"/>
            <col style="width:16%"/>
            <col style="width:21%"/>
            <col style="width:23%"/>
            <col style="width:24%"/>
        </colgroup>
        <tbody>
        <tr><td colspan="5" class="msheet-sec">一、产品功性能要求及参数规格表 Product Functional - Performance Requirements &amp; Parameter Specification Sheet</td></tr>
        <tr>
            <td colspan="2" class="msheet-subsec msheet-center">参数名称 Parameter</td>
            <td colspan="3" class="msheet-subsec msheet-center">参数说明 Parameter Description</td>
        </tr>

        <tr>
            <td colspan="2" class="msheet-label">输入电压Input Voltage(V)</td>
            <td colspan="3">
                <div class="msheet-chk">
                    @foreach (var o in Voltages)
                    {
                        <label><input type="checkbox" checked="@Has(MotorDocKeys.InputVoltage, o)"
                                      @onchange='e => Toggle(MotorDocKeys.InputVoltage, o, e.Value is true)'/>@o</label>
                    }
                    <input class="msheet-input msheet-boxed" style="max-width:180px" placeholder="其它电压"
                           value="@G(MotorDocKeys.InputVoltage + "Other")" @onchange='e => S(MotorDocKeys.InputVoltage + "Other", e)'/>
                </div>
            </td>
        </tr>
        <tr>
            <td colspan="2" class="msheet-label">额定扭矩Rated Torque(N.m)</td>
            <td colspan="3"><input class="msheet-input" placeholder="如 1.2" value="@G(MotorDocKeys.RatedTorque)" @onchange='e => S(MotorDocKeys.RatedTorque, e)'/></td>
        </tr>
        <tr>
            <td colspan="2" class="msheet-label">运行速度Speed(rpm&amp;cm/s)</td>
            <td colspan="3">
                <div class="msheet-inline">
                    <span class="msheet-unit">出厂默认</span>
                    <input class="msheet-input msheet-boxed" placeholder="28rpm" value="@G(MotorDocKeys.Speed)" @onchange='e => S(MotorDocKeys.Speed, e)'/>
                    <span class="msheet-hint">factory default</span>
                    <span class="msheet-unit">其它挡位</span>
                    <input class="msheet-input msheet-boxed" placeholder="选填" value="@G("speedLevels")" @onchange='e => S("speedLevels", e)'/>
                </div>
            </td>
        </tr>
        <tr>
            <td colspan="2" class="msheet-label">额定功率Rated Power(W)</td>
            <td colspan="3"><input class="msheet-input" placeholder="如 120" value="@G(MotorDocKeys.RatedPower)" @onchange='e => S(MotorDocKeys.RatedPower, e)'/></td>
        </tr>
        <tr>
            <td colspan="2" class="msheet-label">运行噪音Operation Noise Based On ISO3745(dBA)</td>
            <td colspan="3"><input class="msheet-input" placeholder="如 37" value="@G(MotorDocKeys.Noise)" @onchange='e => S(MotorDocKeys.Noise, e)'/></td>
        </tr>
        <tr>
            <td colspan="2" class="msheet-label">遥控频率Radio Frequency</td>
            <td colspan="3">
                <div class="msheet-chk">
                    @foreach (var o in RadioFreqs)
                    {
                        <label><input type="checkbox" checked="@Has(MotorDocKeys.RadioFrequency, o)"
                                      @onchange='e => Toggle(MotorDocKeys.RadioFrequency, o, e.Value is true)'/>@o</label>
                    }
                    <span class="msheet-unit">距离</span>
                    <input class="msheet-input msheet-boxed" style="max-width:90px" placeholder="米"
                           value="@G(MotorDocKeys.RfDistance)" @onchange='e => S(MotorDocKeys.RfDistance, e)'/>
                </div>
            </td>
        </tr>
        <tr>
            <td colspan="2" class="msheet-label">遥控协议Protocol</td>
            <td colspan="3">
                <div class="msheet-chk">
                    @foreach (var o in Protocols)
                    {
                        <label><input type="checkbox" checked="@Has(MotorDocKeys.Protocol, o)"
                                      @onchange='e => Toggle(MotorDocKeys.Protocol, o, e.Value is true)'/>@o</label>
                    }
                </div>
            </td>
        </tr>
        <tr>
            <td colspan="2" class="msheet-label">遥控技术Radio Mode</td>
            <td colspan="3">
                <div class="msheet-chk">
                    @foreach (var o in RadioModes)
                    {
                        <label><input type="checkbox" checked="@Has(MotorDocKeys.RadioMode, o)"
                                      @onchange='e => Toggle(MotorDocKeys.RadioMode, o, e.Value is true)'/>@o</label>
                    }
                </div>
            </td>
        </tr>
        <tr>
            <td colspan="2" class="msheet-label">RF信号 Smart Module signal receiving distance requirements</td>
            <td colspan="3">
                <div class="msheet-inline">
                    <span class="msheet-unit">距离distance</span>
                    <input class="msheet-input msheet-boxed" placeholder="米" value="@G(MotorDocKeys.RfDistance)" @onchange='e => S(MotorDocKeys.RfDistance, e)'/>
                </div>
            </td>
        </tr>
        <tr>
            <td colspan="2" class="msheet-label">智能模块Smart Module</td>
            <td colspan="3">
                <div class="msheet-chk">
                    @foreach (var o in SmartModules)
                    {
                        <label><input type="checkbox" checked="@Has(MotorDocKeys.SmartModule, o)"
                                      @onchange='e => Toggle(MotorDocKeys.SmartModule, o, e.Value is true)'/>@o</label>
                    }
                </div>
            </td>
        </tr>
        <tr>
            <td colspan="2" class="msheet-label">功能 Function</td>
            <td colspan="3">
                <div class="msheet-chk">
                    @foreach (var o in Functions)
                    {
                        <label><input type="checkbox" checked="@Has(MotorDocKeys.Function, o)"
                                      @onchange='e => Toggle(MotorDocKeys.Function, o, e.Value is true)'/>@o</label>
                    }
                    <input class="msheet-input msheet-boxed" style="max-width:220px" placeholder="其它说明"
                           value="@G("functionOther")" @onchange='e => S("functionOther", e)'/>
                </div>
            </td>
        </tr>
        <tr>
            <td colspan="2" class="msheet-label">输入电源Power Supply</td>
            <td colspan="3">
                <div class="msheet-chk">
                    @foreach (var o in PowerSupplies)
                    {
                        <label><input type="checkbox" checked="@Has(MotorDocKeys.PowerSupply, o)"
                                      @onchange='e => Toggle(MotorDocKeys.PowerSupply, o, e.Value is true)'/>@o</label>
                    }
                </div>
            </td>
        </tr>
        <tr>
            <td colspan="2" class="msheet-label">内置锂电Internal Lithium Battery</td>
            <td colspan="3">
                <div class="msheet-chk">
                    <label><input type="checkbox" checked="@Has(MotorDocKeys.InternalBattery, "是 Yes")"
                                  @onchange='e => Toggle(MotorDocKeys.InternalBattery, "是 Yes", e.Value is true)'/>是 Yes</label>
                    <label><input type="checkbox" checked="@Has(MotorDocKeys.InternalBattery, "否 No")"
                                  @onchange='e => Toggle(MotorDocKeys.InternalBattery, "否 No", e.Value is true)'/>否 No</label>
                    <input class="msheet-input msheet-boxed" style="max-width:90px" placeholder="节数 cell"
                           value="@G("batteryCells")" @onchange='e => S("batteryCells", e)'/>
                    <input class="msheet-input msheet-boxed" style="max-width:120px" placeholder="容量 mAh"
                           value="@G("batteryMah")" @onchange='e => S("batteryMah", e)'/>
                </div>
            </td>
        </tr>
        <tr>
            <td colspan="2" class="msheet-label">电池续航性能Battery Endurance Performance</td>
            <td colspan="3">
                <textarea class="msheet-input" placeholder="当输入电源包含 Battery 时填写"
                          value="@G(MotorDocKeys.BatteryEndurance)" @onchange='e => S(MotorDocKeys.BatteryEndurance, e)'></textarea>
            </td>
        </tr>
        <tr>
            <td colspan="2" class="msheet-label">电池类型Battery Type</td>
            <td colspan="3">
                <div class="msheet-chk">
                    @foreach (var o in BatteryTypes)
                    {
                        <label><input type="checkbox" checked="@Has(MotorDocKeys.BatteryType, o)"
                                      @onchange='e => Toggle(MotorDocKeys.BatteryType, o, e.Value is true)'/>@o</label>
                    }
                    <input class="msheet-input msheet-boxed" style="max-width:180px" placeholder="其它电池"
                           value="@G("batteryTypeOther")" @onchange='e => S("batteryTypeOther", e)'/>
                </div>
            </td>
        </tr>
        <tr>
            <td colspan="2" class="msheet-label">电池额定容量Battery Rated Capacity</td>
            <td colspan="3">
                <div class="msheet-inline">
                    <input class="msheet-input msheet-boxed" placeholder="2600" value="@G(MotorDocKeys.BatteryCapacity)" @onchange='e => S(MotorDocKeys.BatteryCapacity, e)'/>
                    <span class="msheet-unit">mAh</span>
                </div>
            </td>
        </tr>

        <tr><td colspan="5" class="msheet-subsec">成品电机电池续航测试 Battery Endurance Test of Finished Motor</td></tr>
        <tr>
            <td colspan="2" class="msheet-label">负载Load</td>
            <td colspan="3"><input class="msheet-input" placeholder="如 70% Rated Load；3.2kg" value="@G("batteryTestLoad")" @onchange='e => S("batteryTestLoad", e)'/></td>
        </tr>
        <tr>
            <td colspan="2" class="msheet-label">工作制Duty Cycle</td>
            <td colspan="3"><input class="msheet-input" placeholder="上行 2 分钟，下降 2 分钟" value="@G("batteryTestDuty")" @onchange='e => S("batteryTestDuty", e)'/></td>
        </tr>
        <tr>
            <td colspan="2" class="msheet-label">运行高度Travel Height</td>
            <td colspan="3"><input class="msheet-input" placeholder="如 2M" value="@G("batteryTestHeight")" @onchange='e => S("batteryTestHeight", e)'/></td>
        </tr>
        <tr>
            <td colspan="2" class="msheet-label">充电可使用次数Operation Cycles</td>
            <td colspan="3">
                <div class="msheet-inline">
                    <input class="msheet-input msheet-boxed" placeholder="如 322" value="@G("batteryTestCycles")" @onchange='e => S("batteryTestCycles", e)'/>
                    <span class="msheet-unit">Cycles 次</span>
                </div>
            </td>
        </tr>

        <tr>
            <td colspan="2" class="msheet-label">充电方式Recharge port</td>
            <td colspan="3">
                <div class="msheet-chk">
                    @foreach (var o in RechargePorts)
                    {
                        <label><input type="checkbox" checked="@Has(MotorDocKeys.RechargePort, o)"
                                      @onchange='e => Toggle(MotorDocKeys.RechargePort, o, e.Value is true)'/>@o</label>
                    }
                </div>
            </td>
        </tr>
        <tr>
            <td colspan="2" class="msheet-label">兼容QC协议快充Compatible with QC fast charge</td>
            <td colspan="3">
                <div class="msheet-chk">
                    <label><input type="checkbox" checked="@Has(MotorDocKeys.FastCharge, "是 YES")"
                                  @onchange='e => Toggle(MotorDocKeys.FastCharge, "是 YES", e.Value is true)'/>是 YES</label>
                    <label><input type="checkbox" checked="@Has(MotorDocKeys.FastCharge, "否 No")"
                                  @onchange='e => Toggle(MotorDocKeys.FastCharge, "否 No", e.Value is true)'/>否 No</label>
                </div>
            </td>
        </tr>
        <tr>
            <td colspan="2" class="msheet-label">行程头Motor Head</td>
            <td colspan="3"><input class="msheet-input" placeholder="型号 / 供电接口" value="@G(MotorDocKeys.MotorHead)" @onchange='e => S(MotorDocKeys.MotorHead, e)'/></td>
        </tr>
        <tr>
            <td colspan="2" class="msheet-label">输出轴Shaft</td>
            <td colspan="3"><input class="msheet-input" placeholder="规格" value="@G(MotorDocKeys.Shaft)" @onchange='e => S(MotorDocKeys.Shaft, e)'/></td>
        </tr>

        <tr><td colspan="5" class="msheet-subsec">电机引出电线规格 Power Cord</td></tr>
        <tr>
            <td colspan="2" class="msheet-label">线材型号 / 规格</td>
            <td colspan="3"><input class="msheet-input" placeholder="型号" value="@G(MotorDocKeys.Cord)" @onchange='e => S(MotorDocKeys.Cord, e)'/></td>
        </tr>
        <tr>
            <td colspan="2" class="msheet-label">线材认证Cord Certified</td>
            <td colspan="3">
                <div class="msheet-chk">
                    @foreach (var o in CordCerts)
                    {
                        <label><input type="checkbox" checked="@Has(MotorDocKeys.CordCertified, o)"
                                      @onchange='e => Toggle(MotorDocKeys.CordCertified, o, e.Value is true)'/>@o</label>
                    }
                </div>
            </td>
        </tr>
        <tr>
            <td colspan="2" class="msheet-label">线材颜色Color</td>
            <td colspan="3">
                <div class="msheet-chk">
                    @foreach (var o in CordColors)
                    {
                        <label><input type="checkbox" checked="@Has(MotorDocKeys.CordColor, o)"
                                      @onchange='e => Toggle(MotorDocKeys.CordColor, o, e.Value is true)'/>@o</label>
                    }
                    <input class="msheet-input msheet-boxed" style="max-width:160px" placeholder="其它颜色"
                           value="@G("cordColorOther")" @onchange='e => S("cordColorOther", e)'/>
                </div>
            </td>
        </tr>
        <tr>
            <td colspan="2" class="msheet-label">线材类型Cord Type</td>
            <td colspan="3">
                <div class="msheet-chk">
                    @foreach (var o in CordTypes)
                    {
                        <label><input type="checkbox" checked="@Has(MotorDocKeys.CordType, o)"
                                      @onchange='e => Toggle(MotorDocKeys.CordType, o, e.Value is true)'/>@o</label>
                    }
                    <input class="msheet-input msheet-boxed" style="max-width:160px" placeholder="其它类型"
                           value="@G("cordTypeOther")" @onchange='e => S("cordTypeOther", e)'/>
                </div>
            </td>
        </tr>
        <tr>
            <td colspan="2" class="msheet-label">线材是否带插头Cord plug</td>
            <td colspan="3">
                <div class="msheet-chk">
                    <label><input type="checkbox" checked="@Has(MotorDocKeys.CordPlug, "With Plug 有")"
                                  @onchange='e => Toggle(MotorDocKeys.CordPlug, "With Plug 有", e.Value is true)'/>With Plug 有</label>
                    <label><input type="checkbox" checked="@Has(MotorDocKeys.CordPlug, "Without Plug 无")"
                                  @onchange='e => Toggle(MotorDocKeys.CordPlug, "Without Plug 无", e.Value is true)'/>Without Plug 无</label>
                    <input class="msheet-input msheet-boxed" style="max-width:260px" placeholder="有无特殊要求"
                           value="@G("cordPlugOther")" @onchange='e => S("cordPlugOther", e)'/>
                </div>
            </td>
        </tr>
        <tr>
            <td colspan="2" class="msheet-label">线材长度Cord Length</td>
            <td colspan="3">
                <div class="msheet-inline">
                    <input class="msheet-input msheet-boxed" style="max-width:110px" placeholder="长度" value="@G(MotorDocKeys.CordLength)" @onchange='e => S(MotorDocKeys.CordLength, e)'/>
                    <span class="msheet-unit">米 M</span>
                    <input class="msheet-input msheet-boxed" placeholder="有无特殊要求" value="@G("cordLengthOther")" @onchange='e => S("cordLengthOther", e)'/>
                </div>
            </td>
        </tr>

        <tr>
            <td colspan="2" class="msheet-label">外管Motor Tube</td>
            <td colspan="3">
                <div class="msheet-inline">
                    <span class="msheet-unit">直径</span>
                    <input class="msheet-input msheet-boxed" style="max-width:80px" placeholder="25" value="@G("tubeDiameter")" @onchange='e => S("tubeDiameter", e)'/>
                    <span class="msheet-unit">mm，颜色</span>
                    <input class="msheet-input msheet-boxed" style="max-width:90px" placeholder="白" value="@G("tubeColor")" @onchange='e => S("tubeColor", e)'/>
                    <span class="msheet-unit">长度限制</span>
                    <input class="msheet-input msheet-boxed" style="max-width:90px" placeholder="585" value="@G("tubeLengthLimit")" @onchange='e => S("tubeLengthLimit", e)'/>
                    <span class="msheet-unit">mm</span>
                </div>
            </td>
        </tr>
        <tr>
            <td colspan="2" class="msheet-label">长度Motor Length(MM)</td>
            <td colspan="3"><input class="msheet-input" placeholder="mm" value="@G(MotorDocKeys.MotorLength)" @onchange='e => S(MotorDocKeys.MotorLength, e)'/></td>
        </tr>
        <tr>
            <td colspan="2" class="msheet-label">产品重量Motor Weight(KG)</td>
            <td colspan="3"><input class="msheet-input" placeholder="kg" value="@G(MotorDocKeys.MotorWeight)" @onchange='e => S(MotorDocKeys.MotorWeight, e)'/></td>
        </tr>
        <tr>
            <td colspan="2" class="msheet-label">持续运行时间Protection time of continuous operation</td>
            <td colspan="3">
                <textarea class="msheet-input" placeholder="最大连续运行时间，超过后自动停止"
                          value="@G(MotorDocKeys.ProtectionTime)" @onchange='e => S(MotorDocKeys.ProtectionTime, e)'></textarea>
            </td>
        </tr>
        <tr>
            <td colspan="2" class="msheet-label">产品应用场合Application Occasions</td>
            <td colspan="3">
                <div class="msheet-chk">
                    @foreach (var o in Applications)
                    {
                        <label><input type="checkbox" checked="@Has(MotorDocKeys.Applications, o)"
                                      @onchange='e => Toggle(MotorDocKeys.Applications, o, e.Value is true)'/>@o</label>
                    }
                </div>
            </td>
        </tr>
        <tr>
            <td colspan="2" class="msheet-label">丝印或镭雕图纸 Surface printing drawing</td>
            <td colspan="3">
                <div class="msheet-chk">
                    <label><input type="checkbox" checked="@Has(MotorDocKeys.SurfacePrint, "有 YES")"
                                  @onchange='e => Toggle(MotorDocKeys.SurfacePrint, "有 YES", e.Value is true)'/>有 YES</label>
                    <label><input type="checkbox" checked="@Has(MotorDocKeys.SurfacePrint, "无 None")"
                                  @onchange='e => Toggle(MotorDocKeys.SurfacePrint, "无 None", e.Value is true)'/>无 None</label>
                </div>
            </td>
        </tr>
        <tr>
            <td colspan="2" class="msheet-label">认证要求Certification Requirements</td>
            <td colspan="3">
                <div class="msheet-chk">
                    @foreach (var o in Certifications)
                    {
                        <label><input type="checkbox" checked="@Has(MotorDocKeys.Certification, o)"
                                      @onchange='e => Toggle(MotorDocKeys.Certification, o, e.Value is true)'/>@o</label>
                    }
                    <input class="msheet-input msheet-boxed" style="max-width:200px" placeholder="其它（注明具体要求）"
                           value="@G("certificationOther")" @onchange='e => S("certificationOther", e)'/>
                </div>
            </td>
        </tr>
        <tr>
            <td colspan="2" class="msheet-label">质保期限Warranty Period</td>
            <td colspan="3"><input class="msheet-input" placeholder="如 3 年" value="@G(MotorDocKeys.Warranty)" @onchange='e => S(MotorDocKeys.Warranty, e)'/></td>
        </tr>
        <tr>
            <td colspan="2" class="msheet-label">产品特殊功能Special function</td>
            <td colspan="3"><textarea class="msheet-input" value="@G(MotorDocKeys.SpecialFunction)" @onchange='e => S(MotorDocKeys.SpecialFunction, e)'></textarea></td>
        </tr>
        <tr>
            <td colspan="2" class="msheet-label">客户特殊要求OtherRequirement</td>
            <td colspan="3"><textarea class="msheet-input" value="@G(MotorDocKeys.OtherRequirement)" @onchange='e => S(MotorDocKeys.OtherRequirement, e)'></textarea></td>
        </tr>

        <tr><td colspan="5" class="msheet-sec">二、产品使用工况 Product Operating Conditions</td></tr>
        <tr>
            <td colspan="2" class="msheet-subsec msheet-center">参数名称 Parameter</td>
            <td colspan="3" class="msheet-subsec msheet-center">参数说明 Parameter Description</td>
        </tr>
        <tr>
            <td colspan="2" class="msheet-label">使用环境Application</td>
            <td colspan="3">
                <div class="msheet-chk">
                    @foreach (var o in UsageEnvs)
                    {
                        <label><input type="checkbox" checked="@Has(MotorDocKeys.UsageEnv, o)"
                                      @onchange='e => Toggle(MotorDocKeys.UsageEnv, o, e.Value is true)'/>@o</label>
                    }
                    <input class="msheet-input msheet-boxed" style="max-width:240px" placeholder="注明具体环境"
                           value="@G("usageOther")" @onchange='e => S("usageOther", e)'/>
                </div>
            </td>
        </tr>
        <tr>
            <td colspan="2" class="msheet-label">IP等级IP Degree</td>
            <td colspan="3">
                <div class="msheet-chk">
                    @foreach (var o in IpLevels)
                    {
                        <label><input type="checkbox" checked="@Has(MotorDocKeys.IpDegree, o)"
                                      @onchange='e => Toggle(MotorDocKeys.IpDegree, o, e.Value is true)'/>@o</label>
                    }
                    <input class="msheet-input msheet-boxed" style="max-width:180px" placeholder="其它等级"
                           value="@G("ipOther")" @onchange='e => S("ipOther", e)'/>
                </div>
            </td>
        </tr>
        <tr>
            <td colspan="2" class="msheet-label">工作温度 Working Temperature</td>
            <td colspan="3"><input class="msheet-input" placeholder="如 -10℃ ~ +55℃" value="@G(MotorDocKeys.WorkingTemp)" @onchange='e => S(MotorDocKeys.WorkingTemp, e)'/></td>
        </tr>
        <tr>
            <td colspan="2" class="msheet-label">静电防护等级 ESD Protection Level</td>
            <td colspan="3"><input class="msheet-input" value="@G(MotorDocKeys.Esd)" @onchange='e => S(MotorDocKeys.Esd, e)'/></td>
        </tr>
        <tr>
            <td colspan="2" class="msheet-label">客户配套件 customer matching parts</td>
            <td colspan="3"><input class="msheet-input" value="@G(MotorDocKeys.CustomerParts)" @onchange='e => S(MotorDocKeys.CustomerParts, e)'/></td>
        </tr>
        <tr>
            <td colspan="2" class="msheet-label">客户组装接口尺寸 Customer assembly interface dimensions</td>
            <td colspan="3"><input class="msheet-input" placeholder="可在第四部分附图" value="@G(MotorDocKeys.InterfaceDim)" @onchange='e => S(MotorDocKeys.InterfaceDim, e)'/></td>
        </tr>
        <tr>
            <td colspan="2" class="msheet-label">客户使用载荷 Customer usage load</td>
            <td colspan="3"><input class="msheet-input" value="@G(MotorDocKeys.CustomerLoad)" @onchange='e => S(MotorDocKeys.CustomerLoad, e)'/></td>
        </tr>

        <tr><td colspan="5" class="msheet-sec">三、选配配件 Optional Accessories</td></tr>
        <tr>
            <td class="msheet-subsec msheet-center">序号 No.</td>
            <td class="msheet-subsec msheet-center">零件 Component</td>
            <td class="msheet-subsec msheet-center">型号 Type</td>
            <td class="msheet-subsec msheet-center">示意图 Ref.Photo</td>
            <td class="msheet-subsec msheet-center">备注 Remark</td>
        </tr>
        @for (var i = 0; i < Extra.Accessories.Count; i++)
        {
