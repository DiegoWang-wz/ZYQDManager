@code {
    [Parameter] public string? DocGuid { get; set; }

    private bool IsNew => string.IsNullOrWhiteSpace(DocGuid)
                          || string.Equals(DocGuid, "new", StringComparison.OrdinalIgnoreCase);

    private MotorLxModel _model = new();
    private DateTime? _timeToRequest = DateTime.Today;
    private DateTime? _requiredCompletion;
    private DateTime? _prototypeProvided;
    private DateTime? _prototypeConfirm;
    private bool _busy;
    private string? _lastSavedText;
    private bool _loaded;

    private static readonly string[] _voltages =
    [
        "5V", "8.4V", "12V", "24V", "110V", "230V", "100-240V", "其它电压"
    ];

    private static readonly string[] _inputPowers =
    [
        "AC110V/60Hz", "AC230V/50Hz", "AC100-240V",
        "12V/2A适配器Adapter12V/2A", "12V/3A适配器Adapter12V/3A", "12V/4A适配器Adapter12V/4A",
        "8.4V/1A适配器Adapter8.4V/1A", "24V/1A适配器Adapter24V/1A",
        "两节锂电池Li-on Battery 2 cell", "三节锂电池Li-on Battery 3 cell", "四节锂电池Li-on Battery 4 cell"
    ];

    private static bool Flag(string? v) =>
        string.Equals(v, "True", StringComparison.OrdinalIgnoreCase)
        || v == "1"
        || string.Equals(v, "true", StringComparison.Ordinal);

    private static string? FlagStr(bool v) => v ? "True" : null;

    protected override async Task OnParametersSetAsync()
    {
        if (_loaded && !IsNew && string.Equals(_model.DocGuid, DocGuid, StringComparison.OrdinalIgnoreCase))
            return;

        if (IsNew)
        {
            await InitNewAsync();
            _loaded = true;
            return;
        }

        await LoadExistingAsync(DocGuid!);
        _loaded = true;
    }

    private async Task InitNewAsync()
    {
        var auth = await Auth.GetStoredAsync();
        _model = new MotorLxModel
        {
            VersionNo = "vn",
            IsDraft = true,
            Status = "草稿",
            DemandPerson = auth?.EmpNo,
            TimeToRequest = DateTime.Today
        };
        _timeToRequest = DateTime.Today;
        _requiredCompletion = null;
        _prototypeProvided = null;
        _prototypeConfirm = null;
        _lastSavedText = null;
    }

    private async Task LoadExistingAsync(string docGuid)
    {
        _busy = true;
        try
        {
            var row = await MotorLx.GetByDocGuidAsync(docGuid);
            if (row is null)
            {
                Notify.Show("未找到立项单", Severity.Warning);
                Nav.NavigateTo("/project-list");
                return;
            }

            _model = row;
            _timeToRequest = row.TimeToRequest?.Date;
            _requiredCompletion = row.RequiredCompletionTime?.Date;
            _prototypeProvided = row.PrototypeProvidedTime?.Date;
            _prototypeConfirm = row.ExpectedPrototypeConfirmTime?.Date;
            _lastSavedText = (row.UpdateTime ?? row.CreateTime)?.ToString("yyyy-MM-dd HH:mm");
        }
        catch (Exception ex)
        {
            Notify.Show("加载失败：" + ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_model.Customer))
        {
            Notify.Show("请填写客户", Severity.Warning);
            return;
        }

        _busy = true;
        try
        {
            var auth = await Auth.GetStoredAsync();
            _model.TimeToRequest = _timeToRequest;
            _model.RequiredCompletionTime = _requiredCompletion;
            _model.PrototypeProvidedTime = _prototypeProvided;
            _model.ExpectedPrototypeConfirmTime = _prototypeConfirm;

            var result = await MotorLx.SaveDraftAsync(_model, auth?.EmpNo, auth?.EmpNo);
            _model.ProjectGuid = result.ProjectGuid;
            _model.DocGuid = result.DocGuid;
            _lastSavedText = DateTime.Now.ToString("yyyy-MM-dd HH:mm");
            Notify.Show(result.Created ? "已保存，GUID 已生成" : "已保存", Severity.Success);

            if (result.Created)
                Nav.NavigateTo($"/project/motor/{result.DocGuid}?projectGuid={result.ProjectGuid}", replace: true);
        }
        catch (Exception ex)
        {
            Notify.Show("保存失败：" + ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }
}
