    private static class ResetCodeStore
    {
        private static readonly Dictionary<string, (string Email, string Code, DateTime Expires)> Map = new(StringComparer.OrdinalIgnoreCase);
        private static readonly object Gate = new();

        public static void Save(string empNo, string email, string code)
        {
            lock (Gate)
                Map[empNo] = (email, code, DateTime.UtcNow.AddMinutes(10));
        }

        public static bool Verify(string empNo, string email, string code)
        {
            lock (Gate)
            {
                if (!Map.TryGetValue(empNo, out var row))
                    return false;
                if (row.Expires < DateTime.UtcNow)
                    return false;
                return string.Equals(row.Email, email, StringComparison.OrdinalIgnoreCase)
                       && string.Equals(row.Code, code, StringComparison.Ordinal);
            }
        }

        public static void Consume(string empNo)
        {
            lock (Gate)
                Map.Remove(empNo);
        }
    }
