    private async Task ResetPasswordAsync()
    {
        _error = null;
        _info = null;
        if (!_emailVerified)
        {
            _error = "请先完成邮箱验证";
            return;
        }

        if (string.IsNullOrWhiteSpace(_fp.EmpNo))
        {
            _error = "请输入工号";
            return;
        }

        if (!IsEmail(_fp.Email))
        {
            _error = "请输入有效邮箱";
            return;
        }

        if (string.IsNullOrWhiteSpace(_fp.Code))
        {
            _error = "请输入邮箱验证码";
            return;
        }

        if (string.IsNullOrEmpty(_fp.NewPassword))
        {
            _error = "请输入新密码";
            return;
        }

        if (_fp.NewPassword != _fp.NewPasswordConfirm)
        {
            _error = "两次输入的新密码不一致";
            return;
        }

        if (!ResetCodeStore.Verify(_fp.EmpNo.Trim(), _fp.Email.Trim(), _fp.Code.Trim()))
        {
            _error = "验证码无效或已过期，请重新发送";
            return;
        }

        _busy = true;
        try
        {
            var (ok, msg) = await Auth.ResetPasswordAsync(_fp.EmpNo, _fp.Email, _fp.NewPassword);
            if (!ok)
            {
                _error = msg ?? "重置密码失败";
                Notify.Show(_error, Severity.Error);
                return;
            }

            ResetCodeStore.Consume(_fp.EmpNo.Trim());
            _emailVerified = false;
            var tip = "密码已重置，请使用新密码登录。";
            Notify.Show(tip, Severity.Success);
            _empNo = _fp.EmpNo.Trim();
            _password = "";
            GoTo(PanelLogin, tip);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            Notify.Show("找回密码异常：" + ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task StartCooldownAsync(int seconds)
    {
        _cooldownCts?.Cancel();
        _cooldownCts = new CancellationTokenSource();
        var token = _cooldownCts.Token;
        _codeCooldown = seconds;
        try
        {
            while (_codeCooldown > 0 && !token.IsCancellationRequested)
            {
                await Task.Delay(1000, token);
                _codeCooldown--;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (TaskCanceledException)
        {
        }
    }

    private static bool IsEmail(string? value)
    {
        var v = (value ?? "").Trim();
        return System.Text.RegularExpressions.Regex.IsMatch(
            v, @"^[^@\s]+@[^@\s]+\.[A-Za-z]{2,}$");
    }

    public void Dispose()
    {
        _cooldownCts?.Cancel();
        _cooldownCts?.Dispose();
    }

