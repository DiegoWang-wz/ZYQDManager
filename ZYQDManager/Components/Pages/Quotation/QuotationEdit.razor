@page "/quotation/new"
@page "/quotation/{DocumentGuid}"
@page "/quotation/{DocumentGuid}/detail"
@page "/quotation/{DocumentGuid}/copy"
@rendermode InteractiveServer
@using ZYQDManager.Components.Pages.Contract
@using System.Globalization
@inject QuotationService Quotation
@inject QuotationBaseService QuotationBase
@inject CrmCustomerService Crm
@inject CentralAuthService Auth
@inject CentralUserInformationService UserInfo

<PageTitle>@Title</PageTitle>

<div class="qe-page">
    <div class="qe-toolbar">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap">
            <MudText Typo="Typo.h6">@Title</MudText>
            <MudStack Row="true" Spacing="1">
                <MudButton Size="Size.Small" Variant="Variant.Outlined" Href="/quotation">返回列表</MudButton>
                @if (!IsDetail)
                {
                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy" OnClick="SaveAsync">
                        @(IsCopy ? "创建" : "保存")
                    </MudButton>
                }
            </MudStack>
        </MudStack>
    </div>

    <div class="qe-scroll">
        <fieldset class="qe-form" disabled="@IsDetail">
            <MudPaper Outlined="true" Class="pa-3 mb-3">
                <MudText Typo="Typo.subtitle2" Class="mb-2">开票抬头</MudText>
                <MudGrid Spacing="2">
                    <MudItem xs="12" sm="6" md="2">
                        <MudTooltip Text="@Tip(_main.ClientCode)" Arrow="true" Disabled="@NoTip(_main.ClientCode)" RootClass="qe-tip">
                            <MudTextField @bind-Value="_main.ClientCode"
                                          Label="客户编号"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Immediate="true"
                                          Class="qe-field"
                                          OnKeyUp="OnClientKey"/>
                        </MudTooltip>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="2">
                        <MudTooltip Text="@Tip(_main.ClientName)" Arrow="true" Disabled="@NoTip(_main.ClientName)" RootClass="qe-tip">
                            <MudTextField @bind-Value="_main.ClientName" Label="客户名称" Variant="Variant.Outlined" Margin="Margin.Dense" Class="qe-field"/>
                        </MudTooltip>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="2">
                        <MudTooltip Text="@Tip(_main.Address)" Arrow="true" Disabled="@NoTip(_main.Address)" RootClass="qe-tip">
                            <MudTextField @bind-Value="_main.Address" Label="地址" Variant="Variant.Outlined" Margin="Margin.Dense" Class="qe-field"/>
                        </MudTooltip>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="2">
                        <MudTooltip Text="@Tip(_main.Tel)" Arrow="true" Disabled="@NoTip(_main.Tel)" RootClass="qe-tip">
                            <MudTextField @bind-Value="_main.Tel" Label="电话" Variant="Variant.Outlined" Margin="Margin.Dense" Class="qe-field"/>
                        </MudTooltip>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="2">
                        <MudTooltip Text="@Tip(_main.Mail)" Arrow="true" Disabled="@NoTip(_main.Mail)" RootClass="qe-tip">
                            <MudTextField @bind-Value="_main.Mail" Label="邮箱" Variant="Variant.Outlined" Margin="Margin.Dense" Class="qe-field"/>
                        </MudTooltip>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="2">
                        <MudTooltip Text="@Tip(_main.Attn)" Arrow="true" Disabled="@NoTip(_main.Attn)" RootClass="qe-tip">
                            <MudTextField @bind-Value="_main.Attn" Label="联系人" Variant="Variant.Outlined" Margin="Margin.Dense" Class="qe-field"/>
                        </MudTooltip>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="2">
                        <MudTooltip Text="@Tip(_main.Quota_No)" Arrow="true" Disabled="@NoTip(_main.Quota_No)" RootClass="qe-tip">
                            <MudTextField @bind-Value="_main.Quota_No" Label="报价单号" Variant="Variant.Outlined" Margin="Margin.Dense" Required="true" Class="qe-field"/>
                        </MudTooltip>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="2">
                        <MudDatePicker @bind-Date="QuotaDate"
                                       Label="报价日期"
                                       DateFormat="yyyy-MM-dd"
                                       Culture="@(CultureInfo.InvariantCulture)"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense"
                                       Editable="true"
                                       Clearable="true"
                                       Class="qe-field"/>
                    </MudItem>
                </MudGrid>
            </MudPaper>

            @foreach (var type in QuotationBaseTypes.All)
            {
                var itemType = type.Key;
                var lines = LinesOf(itemType);
                <MudPaper Outlined="true" Class="pa-2 mb-3 qe-section">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="@($"px-1{(lines.Count > 0 ? " mb-2" : "")}")">
                        <MudChipSet T="string" ReadOnly="true" Class="qe-type-chips">
                            <MudChip T="string"
                                     Text="@type.Label"
                                     Icon="@ChipIconOf(itemType)"
                                     Color="@ChipColorOf(itemType)"
                                     Variant="Variant.Filled"
                                     Size="Size.Medium"/>
                        </MudChipSet>
                        @if (!IsDetail)
                        {
                            <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => AddLine(itemType))">新增</MudButton>
                        }
                    </MudStack>

                    @if (lines.Count > 0)
                    {
                        <MudTable T="QuotationDetailLineDto" Items="lines" Dense="true" Hover="true" Bordered="true"
                                  Breakpoint="Breakpoint.None" Class="qe-table" Elevation="0">
                            <HeaderContent>
                                @if (!IsDetail)
                                {
                                    <MudTh Style="width:72px">操作</MudTh>
                                }
                                <MudTh Style="min-width:180px">型号</MudTh>
                                <MudTh Style="width:80px">图片</MudTh>
                                @foreach (var col in SpecColumns(itemType))
                                {
                                    <MudTh Style="white-space:nowrap;min-width:5.5em">@col.Label</MudTh>
                                }
                                <MudTh Class="qe-num-col">数量</MudTh>
                                <MudTh Class="qe-num-col">单价</MudTh>
                                <MudTh Class="qe-num-col qe-num-col-sm">折扣%</MudTh>
                                <MudTh Class="qe-num-col qe-num-col-lg">金额</MudTh>
                                <MudTh Style="min-width:140px">备注</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                @{
                                    var row = context;
                                }
                                @if (!IsDetail)
                                {
                                    <MudTd>
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Default"
                                                       OnClick="@(() => RemoveLine(row))"/>
                                    </MudTd>
                                }
                                <MudTd>
                                    <MudSelect T="int?"
                                               Value="row.BaseId"
                                               ValueChanged="v => OnPartChangedAsync(row, v)"
                                               Dense="true"
                                               Margin="Margin.Dense"
                                               Variant="Variant.Outlined"
                                               Clearable="true"
                                               Disabled="IsDetail"
                                               Class="qe-part-select">
                                        @foreach (var p in PartsOf(itemType))
                                        {
                                            <MudSelectItem T="int?" Value="@((int?)p.Id)">@p.Part_No</MudSelectItem>
                                        }
                                    </MudSelect>
                                </MudTd>
                                <MudTd>
                                    <LegacyRemoteImg Path="@row.Quotation_logo" CssClass="qe-thumb"/>
                                </MudTd>
                                @foreach (var col in SpecColumns(itemType))
                                {
                                    <MudTd><span class="qe-spec">@SpecValue(row, col.Key)</span></MudTd>
                                }
                                <MudTd Class="qe-num-col">
                                    <MudNumericField T="decimal?" Value="row.Qty" ValueChanged="v => OnMoneyChanged(row, qty: v)"
                                                     Margin="Margin.Dense" Variant="Variant.Outlined" HideSpinButtons="true"
                                                     Disabled="IsDetail" Class="qe-num"
                                                     Culture="@NumCulture" Format="N0"/>
                                </MudTd>
                                <MudTd Class="qe-num-col">
                                    <MudNumericField T="decimal?" Value="row.Price" ValueChanged="v => OnMoneyChanged(row, price: v)"
                                                     Margin="Margin.Dense" Variant="Variant.Outlined" HideSpinButtons="true"
                                                     Disabled="IsDetail" Class="qe-num"
                                                     Culture="@NumCulture" Format="N2"/>
                                </MudTd>
                                <MudTd Class="qe-num-col qe-num-col-sm">
                                    <MudNumericField T="decimal?" Value="row.Discount" ValueChanged="v => OnMoneyChanged(row, discount: v)"
                                                     Margin="Margin.Dense" Variant="Variant.Outlined" HideSpinButtons="true"
                                                     Disabled="IsDetail" Class="qe-num"
                                                     Culture="@NumCulture" Format="N0"/>
                                </MudTd>
                                <MudTd Class="qe-num-col qe-num-col-lg">
                                    <MudNumericField T="decimal?" Value="row.Amount" ReadOnly="true"
                                                     Margin="Margin.Dense" Variant="Variant.Outlined" HideSpinButtons="true"
                                                     Class="qe-num"
                                                     Culture="@NumCulture" Format="N2"/>
                                </MudTd>
                                <MudTd>
                                    <MudTextField T="string"
                                                  Value="@(row.Note ?? "")"
                                                  ValueChanged="v => SetNote(row, v)"
                                                  Margin="Margin.Dense" Variant="Variant.Outlined" Placeholder="可选" Disabled="IsDetail"/>
                                </MudTd>
                            </RowTemplate>
                            <FooterContent>
                                <MudTd ColSpan="@(IsDetail ? SpecColumns(itemType).Length + 5 : SpecColumns(itemType).Length + 6)">
                                    <strong>小计：@FmtMoney(lines.Sum(x => x.Amount ?? 0m))</strong>
                                </MudTd>
                            </FooterContent>
                        </MudTable>
                    }
                </MudPaper>
            }

            <MudPaper Outlined="true" Class="pa-3 mb-3">
                <MudText Typo="Typo.subtitle2" Class="mb-2">签名 / 汇率</MudText>
                <div class="qe-sig-row">
                    <div class="qe-sig-col">
                        <MudTextField Value="@(_main.signature ?? "")"
                                      Label="签名"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      ReadOnly="true"
                                      Class="qe-field"/>
                        @if (!string.IsNullOrWhiteSpace(_main.signature_url))
                        {
                            <LegacyRemoteImg Path="@_main.signature_url" CssClass="qe-sig"/>
                        }
                        else
                        {
                            <MudText Typo="Typo.caption" Class="qe-sig-tip">未配置签名图片（可在个人信息维护）</MudText>
                        }
                    </div>
                    <div class="qe-sig-col">
                        <MudTextField @bind-Value="_main.rate" Label="汇率" Variant="Variant.Outlined" Margin="Margin.Dense" Class="qe-field"/>
                    </div>
                    <div class="qe-sig-col">
                        <MudSelect T="string" @bind-Value="_main.currencyUnit" Label="货币" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="IsDetail" Class="qe-field">
                            <MudSelectItem Value="@("$")">美元 $</MudSelectItem>
                            <MudSelectItem Value="@("¥")">人民币 ¥</MudSelectItem>
                            <MudSelectItem Value="@("€")">欧元 €</MudSelectItem>
                            <MudSelectItem Value="@("CAD")">加币 CAD</MudSelectItem>
                        </MudSelect>
                    </div>
                    <div class="qe-total-box">
                        <span class="qe-total-label">明细总额</span>
                        <span class="qe-total-amount">@FmtMoney(_doc.Details.Sum(x => x.Amount ?? 0m))</span>
                        <span class="qe-total-unit">@(_main.currencyUnit)</span>
                    </div>
                </div>
            </MudPaper>
        </fieldset>
    </div>
</div>

