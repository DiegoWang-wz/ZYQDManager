@code {
    [Parameter] public string? DocumentGuid { get; set; }

    private bool _busy;
    private string? _loadedKey;
    private QuotationDocumentDto _doc = new();
    private ZyqdQuotationMainModel _main = new();
    private readonly Dictionary<string, List<QuotationPartOptionDto>> _parts = new();

    private bool IsCopy => RelPath().Contains("/copy", StringComparison.OrdinalIgnoreCase);
    private bool IsDetail => RelPath().Contains("/detail", StringComparison.OrdinalIgnoreCase);
    private bool IsCreate => string.IsNullOrWhiteSpace(DocumentGuid) || IsCopy
                             || RelPath().StartsWith("quotation/new", StringComparison.OrdinalIgnoreCase);
    private string Title => IsDetail ? "报价详情" : IsCopy ? "复制报价" : IsCreate ? "报价录入" : "编辑报价";

    private string RelPath() => NavManager.ToBaseRelativePath(NavManager.Uri);

    protected override async Task OnParametersSetAsync()
    {
        var key = $"{DocumentGuid}|{IsCopy}|{IsDetail}|{IsCreate}";
        if (_loadedKey == key) return;
        _loadedKey = key;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _busy = true;
        try
        {
            await EnsurePartsAsync();

            var empNo = await Auth.GetCurrentEmpNoAsync();
            if (IsCreate && !IsCopy)
            {
                _doc = Quotation.CreateBlank(empNo);
                _main = _doc.Main;
                await ApplyMySignatureAsync(empNo);
                return;
            }

            var guid = (DocumentGuid ?? "").Trim();
            var doc = await Quotation.GetAsync(guid);
            if (doc is null)
            {
                Notify.Show("报价单不存在", Severity.Warning);
                NavManager.NavigateTo("/quotation");
                return;
            }

            if (IsCopy)
            {
                doc.Main.Id = 0;
                doc.Main.guid = Guid.NewGuid().ToString("N");
                doc.Main.createTime = DateTime.Now;
                doc.Main.personId = empNo ?? doc.Main.personId;
                var qn = (doc.Main.Quota_No ?? "").Trim();
                if (qn.Length > 0 && !qn.EndsWith("-COPY", StringComparison.OrdinalIgnoreCase))
                    doc.Main.Quota_No = qn + "-COPY";
                foreach (var d in doc.Details)
                {
                    d.Id = 0;
                    d.Uid = Guid.NewGuid().ToString("N");
                }
            }

            _doc = doc;
            _main = doc.Main;
            if (IsCopy || !IsDetail)
                await ApplyMySignatureAsync(empNo);
        }
        catch (Exception ex)
        {
            Notify.Show("加载失败：" + ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task EnsurePartsAsync()
    {
        foreach (var t in QuotationBaseTypes.All)
        {
            if (_parts.ContainsKey(t.Key)) continue;
            _parts[t.Key] = await QuotationBase.ListPartsAsync(t.Key);
        }
    }

    private async Task ApplyMySignatureAsync(string? empNo)
    {
        empNo = (empNo ?? "").Trim();
        if (empNo.Length == 0) return;

        var (ok, displayName, info, msg) = await UserInfo.GetAsync(empNo);
        if (!ok || info is null)
        {
            if (!string.IsNullOrWhiteSpace(msg))
                Notify.Show(msg, Severity.Warning);
            return;
        }

        var name = (info.Signature ?? "").Trim();
        if (name.Length == 0)
            name = (displayName ?? "").Trim();
        if (name.Length == 0)
            name = empNo;

        _main.signature = name;
        _main.signature_url = (info.SignatureUrl ?? "").Trim();
    }

    private List<QuotationDetailLineDto> LinesOf(string itemType)
        => _doc.Details.Where(x => QuotationBaseTypes.Normalize(x.ItemType) == itemType).ToList();

    private List<QuotationPartOptionDto> PartsOf(string itemType)
        => _parts.TryGetValue(itemType, out var list) ? list : [];

    private void AddLine(string itemType)
    {
        _doc.Details.Add(new QuotationDetailLineDto
        {
            ItemType = QuotationBaseTypes.Normalize(itemType),
            Discount = 0m,
            Qty = 0m,
            Price = 0m,
            Amount = 0m,
        });
    }

    private void RemoveLine(QuotationDetailLineDto row)
        => _doc.Details.Remove(row);

    private async Task OnPartChangedAsync(QuotationDetailLineDto row, int? baseId)
    {
        if (baseId is null or <= 0)
        {
            row.ApplyBase(null);
            return;
        }

        var b = await QuotationBase.GetAsync(row.ItemType, baseId.Value);
        row.ApplyBase(b);
    }

    private void OnMoneyChanged(QuotationDetailLineDto row, decimal? qty = null, decimal? price = null, decimal? discount = null)
    {
        if (qty.HasValue) row.Qty = qty;
        if (price.HasValue) row.Price = price;
        if (discount.HasValue) row.Discount = discount;
        row.RecalcAmount();
    }

    private static void SetNote(QuotationDetailLineDto row, string? note) => row.Note = note;

    private Task OnClientKey(KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or "NumpadEnter")
            return LookupClientAsync();
        return Task.CompletedTask;
    }

    private async Task LookupClientAsync()
    {
        try
        {
            var code = CotractPiTypes.NormalizeClientNo(_main.ClientCode);
            _main.ClientCode = code;
            if (code.Length == 0) return;

            var c = await Crm.GetBillToAsync(code);
            if (c is null)
            {
                Notify.Show("CRM 未找到该客户", Severity.Warning);
                return;
            }

            _main.ClientName = c.ClientName;
            _main.Address = string.IsNullOrWhiteSpace(c.CombinedAddress) ? c.Address : c.CombinedAddress;
            _main.Tel = c.Tel;
            _main.Mail = c.Mail;
            _main.Attn = c.FullName;
        }
        catch (Exception ex)
        {
            Notify.Show(ex.Message, Severity.Error);
        }
    }

    private async Task SaveAsync()
    {
        if (IsDetail) return;
        _busy = true;
        try
        {
            var empNo = await Auth.GetCurrentEmpNoAsync();
            await ApplyMySignatureAsync(empNo);
            _doc.Main = _main;
            var create = IsCreate;
            var (ok, msg, guid) = await Quotation.SaveAsync(_doc, empNo, create);
            if (!ok)
            {
                Notify.Show(msg ?? "保存失败", Severity.Error);
                return;
            }

            Notify.Show(IsCopy ? "创建成功" : "保存成功", Severity.Success);
            if (create)
                NavManager.NavigateTo($"/quotation/{guid}", replace: true);
        }
        catch (Exception ex)
        {
            Notify.Show("保存失败：" + ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private static readonly CultureInfo NumCulture = CultureInfo.GetCultureInfo("en-US");

    private DateTime? QuotaDate
    {
        get => DateTime.TryParse(_main.DATE, CultureInfo.InvariantCulture, DateTimeStyles.None, out var d) ? d : null;
        set => _main.DATE = value?.ToString("yyyy-MM-dd");
    }

    private static string Tip(string? value) => (value ?? "").Trim();
    private static bool NoTip(string? value) => Tip(value).Length == 0;
    private static string FmtMoney(decimal value) => value.ToString("N2", NumCulture);

    private static Color ChipColorOf(string itemType) => itemType switch
    {
        QuotationBaseTypes.Motor => Color.Primary,
        QuotationBaseTypes.Remote => Color.Info,
        QuotationBaseTypes.CB => Color.Warning,
        QuotationBaseTypes.PR => Color.Success,
        QuotationBaseTypes.Accessory => Color.Secondary,
        _ => Color.Default,
    };

    private static string ChipIconOf(string itemType) => itemType switch
    {
        QuotationBaseTypes.Motor => Icons.Material.Filled.Blinds,
        QuotationBaseTypes.Remote => Icons.Material.Filled.SettingsRemote,
        QuotationBaseTypes.CB => Icons.Material.Filled.DeveloperBoard,
        QuotationBaseTypes.PR => Icons.Material.Filled.SwapVert,
        QuotationBaseTypes.Accessory => Icons.Material.Filled.Extension,
        _ => Icons.Material.Filled.Label,
    };

    private static (string Key, string Label)[] SpecColumns(string itemType) => itemType switch
    {
        QuotationBaseTypes.Remote =>
        [
            ("Remote_controller_type", "遥控器型号"),
            ("Battery_Type", "电池型号"),
            ("Radio_Frequency", "频率"),
            ("Working_Temperature", "工作温度"),
            ("NoOfChannels", "通道数"),
        ],
