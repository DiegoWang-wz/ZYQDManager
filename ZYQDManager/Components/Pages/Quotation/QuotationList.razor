@page "/quotation"
@rendermode InteractiveServer
@inject QuotationService Quotation
@inject CentralAuthService Auth
@inject NavigationManager NavManager
@inject LastListReturnService LastListReturn

<PageTitle>报价列表</PageTitle>

<div class="qe-list-page">
    <MudPaper Class="pa-3" Outlined="true">
        <div class="qe-toolbar-grid">
            <div class="qe-toolbar-left">
                <MudSelect T="string"
                           @bind-Value="_filterColumn"
                           Label="条件"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Class="qe-filter-select">
                    @foreach (var field in QuotationFilterFields.All)
                    {
                        <MudSelectItem Value="@field.Key">@field.Label</MudSelectItem>
                    }
                </MudSelect>
                <MudTextField @bind-Value="_keyword"
                              Label="内容"
                              Placeholder="请输入查询内容"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Immediate="true"
                              Class="qe-filter-input"
                              OnKeyUp="OnKeyUp"/>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Search" OnClick="SearchAsync" Disabled="_busy">搜索</MudButton>
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Clear" OnClick="ClearAsync" Disabled="_busy">清空</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Href="/quotation/new">新建</MudButton>
            </div>
            <div class="qe-toolbar-right">
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Deselect" OnClick="ClearSelection" Disabled="_selected.Count == 0">取消选择</MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete" OnClick="DeleteSelectedAsync" Disabled="_selected.Count == 0 || _busy">删除</MudButton>
            </div>
        </div>
    </MudPaper>

    <MudPaper Class="qe-table-wrap pa-0" Outlined="true">
        @if (_ready)
        {
            <MudTable @ref="_table"
                      T="QuotationListItemDto"
                      ServerData="LoadServerData"
                      @bind-CurrentPage="_currentPage"
                      RowsPerPage="@_rowsPerPage"
                      Dense="true"
                      Hover="true"
                      Striped="true"
                      Bordered="true"
                      Loading="_busy"
                      MultiSelection="true"
                      SelectOnRowClick="false"
                      @bind-SelectedItems="_selected"
                      Breakpoint="Breakpoint.None"
                      FixedHeader="true"
                      SortMode="SortMode.Single"
                      OnRowClick="OnRowClick"
                      Class="qe-table">
                <HeaderContent>
                    <MudTh Class="qe-no-cell">序号</MudTh>
                    <MudTh><MudTableSortLabel T="QuotationListItemDto" SortLabel="Quota_No">报价单号</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel T="QuotationListItemDto" SortLabel="ClientCode">客户编号</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel T="QuotationListItemDto" SortLabel="ClientName">客户名称</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel T="QuotationListItemDto" SortLabel="DATE">日期</MudTableSortLabel></MudTh>
                    <MudTh>货币</MudTh>
                    <MudTh>签名</MudTh>
                    <MudTh><MudTableSortLabel T="QuotationListItemDto" SortLabel="personId">创建人</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel T="QuotationListItemDto" SortLabel="createTime" InitialDirection="SortDirection.Descending">创建时间</MudTableSortLabel></MudTh>
                    <MudTh Class="qe-ops-cell">操作</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd Class="qe-no-cell">@RowNo(context)</MudTd>
                    <MudTd>@Dash(context.Quota_No)</MudTd>
                    <MudTd>@Dash(context.ClientCode)</MudTd>
                    <MudTd>@Dash(context.ClientName)</MudTd>
                    <MudTd>@Dash(context.DATE)</MudTd>
                    <MudTd>@Dash(context.currencyUnit)</MudTd>
                    <MudTd>@Dash(context.signature)</MudTd>
                    <MudTd>@Dash(context.personId)</MudTd>
                    <MudTd>@DateDisplay.Format(context.createTime, "-")</MudTd>
                    <MudTd Class="qe-ops-cell">
                        <div class="qe-ops-grid">
                            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.Edit"
                                       Class="qe-ops-btn"
                                       Href="@EditHref(context)">编辑</MudButton>
                            <MudButton Size="Size.Small" Variant="Variant.Text"
                                       StartIcon="@Icons.Material.Filled.Visibility"
                                       Class="qe-ops-btn"
                                       Href="@DetailHref(context)">详情</MudButton>
                            <MudButton Size="Size.Small" Variant="Variant.Text"
                                       StartIcon="@Icons.Material.Filled.ContentCopy"
                                       Class="qe-ops-btn"
                                       Href="@CopyHref(context)">复制</MudButton>
                            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error"
                                       StartIcon="@Icons.Material.Filled.Delete"
                                       Class="qe-ops-btn"
                                       Disabled="_busy"
                                       OnClick="@(() => DeleteAsync(context))">删除</MudButton>
                        </div>
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Class="pa-4">@(_busy ? "加载中…" : "暂无数据")</MudText>
                </NoRecordsContent>
                <PagerContent>
                    <MudTablePager PageSizeOptions="new int[] { 20, 50, 100 }"
                                   RowsPerPageString="每页行数："
                                   InfoFormat="显示第 {first_item} 到第 {last_item} 条，共 {all_items} 条"/>
                </PagerContent>
            </MudTable>
        }
    </MudPaper>
</div>

<style>
    .qe-list-page {
        flex: 1 1 0;
        display: flex;
        flex-direction: column;
        height: 100%;
        min-height: 0;
        gap: 12px;
    }

    .qe-toolbar-grid {
        display: grid;
        grid-template-columns: 7fr 5fr;
        gap: 8px;
        align-items: center;
        width: 100%;
        min-width: 0;
    }
    .qe-toolbar-left,
    .qe-toolbar-right {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
        min-width: 0;
    }
    .qe-toolbar-left { justify-content: flex-start; }
    .qe-toolbar-right { justify-content: flex-end; }
    .qe-toolbar-left > *,
    .qe-toolbar-right > * {
        flex: 0 0 auto;
    }
    .qe-filter-select { width: 140px; }
    .qe-filter-input { width: 200px; }
    @@media (max-width: 960px) {
        .qe-toolbar-grid { grid-template-columns: 1fr; }
        .qe-toolbar-right { justify-content: flex-start; }
    }

    .qe-table-wrap {
        flex: 1 1 0;
        min-height: 0;
        overflow: hidden;
        display: flex;
        flex-direction: column;
    }

    .qe-table {
        height: 100%;
        display: flex;
        flex-direction: column;
    }

    .qe-table .mud-table-container {
        flex: 1 1 0 !important;
        min-height: 0 !important;
        overflow: auto !important;
    }

    .qe-table .mud-table-pagination {
        flex: 0 0 auto !important;
        margin-top: auto;
        border-top: 1px solid var(--mud-palette-lines-default);
    }

    .qe-table .mud-table-head .mud-table-cell:not(.qe-ops-cell):not(.qe-no-cell):not(:first-child),
    .qe-table .mud-table-body .mud-table-cell:not(.qe-ops-cell):not(.qe-no-cell):not(:first-child) {
        white-space: nowrap;
        min-width: 88px;
        vertical-align: middle;
    }

    .qe-table .mud-table-cell:first-child,
    .qe-table .mud-table-cell.qe-no-cell {
        position: sticky;
        z-index: 4;
        box-sizing: border-box;
        background-color: #fff !important;
        vertical-align: middle !important;
    }

    .qe-table .mud-table-head .mud-table-cell:first-child,
    .qe-table .mud-table-head .mud-table-cell.qe-no-cell { z-index: 6; }

    .qe-table .mud-table-cell:first-child {
        left: 0;
        width: 42px !important;
        min-width: 42px !important;
        max-width: 42px !important;
        padding: 0 !important;
        text-align: center !important;
        white-space: nowrap !important;
    }
    .qe-table .mud-table-cell:first-child .mud-input-control,
    .qe-table .mud-table-cell:first-child .mud-checkbox {
        margin: 0 auto !important;
        padding: 0 !important;
        display: inline-flex !important;
        align-items: center !important;
        justify-content: center !important;
    }

    .qe-table .mud-table-cell.qe-no-cell {
        left: 42px;
        width: 48px !important;
        min-width: 48px !important;
        max-width: 48px !important;
        padding: 0 2px !important;
        text-align: center;
        border-right: 1px solid #e0e0e0;
    }

    .qe-table.mud-table-striped .mud-table-body .mud-table-row:nth-of-type(odd) .mud-table-cell:first-child,
    .qe-table.mud-table-striped .mud-table-body .mud-table-row:nth-of-type(odd) .mud-table-cell.qe-no-cell {
        background-color: #f5f5f5 !important;
    }

    .qe-table .mud-table-body .mud-table-row:hover .mud-table-cell:first-child,
    .qe-table .mud-table-body .mud-table-row:hover .mud-table-cell.qe-no-cell {
        background-color: #eeeeee !important;
    }

    .qe-table .mud-table-cell.qe-ops-cell {
        position: sticky;
        right: 0;
        z-index: 4;
        width: 168px;
        min-width: 168px;
        max-width: 168px;
        box-sizing: border-box;
        padding: 6px 8px !important;
        white-space: normal;
        vertical-align: middle;
        overflow: hidden;
        background-color: #fff !important;
        border-left: 1px solid #e0e0e0;
    }

    .qe-table .mud-table-head .mud-table-cell.qe-ops-cell {
        z-index: 6;
        background-color: #fff !important;
    }

    .qe-table.mud-table-striped .mud-table-body .mud-table-row:nth-of-type(odd) .mud-table-cell.qe-ops-cell {
        background-color: #f5f5f5 !important;
    }

    .qe-table .mud-table-body .mud-table-row:hover .mud-table-cell.qe-ops-cell {
        background-color: #eeeeee !important;
    }

    .qe-ops-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        grid-template-rows: 28px 28px;
        gap: 2px 4px;
        width: 100%;
    }

    .qe-ops-grid .qe-ops-btn.mud-button-root {
        min-width: 0 !important;
        width: 100%;
        height: 28px;
        padding: 0 2px !important;
        margin: 0;
        font-size: 12px;
        line-height: 28px;
        justify-content: center;
    }

    .qe-ops-grid .qe-ops-btn .mud-button-label {
        font-size: 12px !important;
    }

    .qe-ops-grid .qe-ops-btn .mud-icon-root {
        font-size: 16px !important;
        margin-right: 2px !important;
    }

    .qe-table .mud-table-body .mud-table-row {
        cursor: pointer;
    }
</style>

@code {
    private MudTable<QuotationListItemDto>? _table;
    private bool _ready;
    private bool _busy;
    private string _filterColumn = "Quota_No";
    private string? _keyword;
    private HashSet<QuotationListItemDto> _selected = new();
    private List<QuotationListItemDto> _rows = [];
    private int _skip;
    private int _currentPage;
    private int _rowsPerPage = 20;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _ready) return;
        RestoreFromReturn();
        _ready = true;
        StateHasChanged();
    }

    private void RestoreFromReturn()
    {
        var snap = ListUiStateStore.Take(LastListReturn, ListUiStateStore.Keys.Quotation);
        if (snap is null) return;
        _filterColumn = string.IsNullOrWhiteSpace(snap.FilterColumn) ? "Quota_No" : snap.FilterColumn!;
        _keyword = snap.Keyword;
        _rowsPerPage = snap.PageSize > 0 ? snap.PageSize : 20;
        _currentPage = snap.Page < 0 ? 0 : snap.Page;
    }

    private void PersistAsync(int page, int pageSize)
        => ListUiStateStore.Capture(LastListReturn, ListUiStateStore.Keys.Quotation, new PagedListUiState
        {
            Page = page < 0 ? 0 : page,
            PageSize = pageSize > 0 ? pageSize : 20,
            FilterColumn = _filterColumn,
            Keyword = _keyword,
        });

    private int RowNo(QuotationListItemDto row)
    {
        var i = _rows.IndexOf(row);
        return i < 0 ? 0 : _skip + i + 1;
    }

    private static string Dash(string? s) => string.IsNullOrWhiteSpace(s) ? "-" : s;

    private static string EditHref(QuotationListItemDto row) => $"/quotation/{row.Guid}";
    private static string DetailHref(QuotationListItemDto row) => $"/quotation/{row.Guid}/detail";
    private static string CopyHref(QuotationListItemDto row) => $"/quotation/{row.Guid}/copy";

    private void OnRowClick(TableRowClickEventArgs<QuotationListItemDto> args)
    {
        if (args.MouseEventArgs.Detail != 2 || args.Item is null) return;
        NavManager.NavigateTo(DetailHref(args.Item));
    }

    private Task OnKeyUp(KeyboardEventArgs e)
        => e.Key is "Enter" or "NumpadEnter" ? SearchAsync() : Task.CompletedTask;

    private async Task SearchAsync() => await ReloadTableAsync(resetPage: true);

    private async Task ClearAsync()
    {
        _keyword = null;
        _filterColumn = "Quota_No";
        await ReloadTableAsync(resetPage: true);
    }

    private void ClearSelection() => _selected.Clear();

    private async Task ReloadTableAsync(bool resetPage)
    {
        if (_table is null) return;
        if (resetPage && _table.CurrentPage != 0)
        {
            _table.NavigateTo(Page.First);
            return;
        }

        await _table.ReloadServerData();
    }

    private async Task<TableData<QuotationListItemDto>> LoadServerData(TableState state, CancellationToken ct)
    {
        _busy = true;
        try
        {
            var query = new QuotationQueryDto
            {
                FilterColumn = _filterColumn,
                Keyword = _keyword,
                SortLabel = string.IsNullOrWhiteSpace(state.SortLabel) ? "createTime" : state.SortLabel,
                SortDescending = state.SortDirection != SortDirection.Ascending,
            };
            var skip = state.Page * state.PageSize;
            var (rows, total) = await Quotation.QueryPageAsync(query, skip, state.PageSize, ct);
            _rows = rows;
            _skip = skip;
            _currentPage = state.Page;
            _rowsPerPage = state.PageSize;
            PersistAsync(state.Page, state.PageSize);
            return new TableData<QuotationListItemDto> { Items = rows, TotalItems = total };
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DeleteAsync(QuotationListItemDto row)
    {
        var ok = await DialogService.ShowMessageBoxAsync(
            "确认删除",
            $"确定删除报价单 {Dash(row.Quota_No)}？",
            yesText: "删除", cancelText: "取消");
        if (ok != true) return;

        _busy = true;
        try
        {
            var (success, msg) = await Quotation.DeleteAsync(row.Guid);
            if (!success)
            {
                Notify.Show(msg ?? "删除失败", Severity.Error);
                return;
            }

            Notify.Show("已删除", Severity.Success);
            _selected.RemoveWhere(x => x.Guid == row.Guid);
            await ReloadTableAsync(resetPage: false);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DeleteSelectedAsync()
    {
        if (_selected.Count == 0) return;
        var ok = await DialogService.ShowMessageBoxAsync(
            "确认删除",
            $"确定删除选中的 {_selected.Count} 条报价单？",
            yesText: "删除", cancelText: "取消");
        if (ok != true) return;

        _busy = true;
        try
        {
            var (success, msg) = await Quotation.DeleteManyAsync(_selected.Select(x => x.Guid));
            if (!success)
            {
                Notify.Show(msg ?? "删除失败", Severity.Error);
                return;
            }

            Notify.Show("已删除", Severity.Success);
            _selected.Clear();
            await ReloadTableAsync(resetPage: false);
        }
        finally
        {
            _busy = false;
        }
    }
}
