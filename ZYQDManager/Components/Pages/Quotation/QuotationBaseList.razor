    private async Task ExportAsync()
    {
        var selectedIds = _selected.Count > 0 ? _selected.Select(x => x.Id).ToList() : null;
        if (selectedIds is null)
        {
            if (_total <= 0)
            {
                Notify.Show("没有可导出的数据", Severity.Warning);
                return;
