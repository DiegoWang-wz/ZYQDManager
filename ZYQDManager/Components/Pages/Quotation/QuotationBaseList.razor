@page "/quotation-base"
@rendermode InteractiveServer
@using ZYQDManager.Components.Pages.Contract
@using ZYQDManager.DataModels.Quotation
@inject QuotationBaseService QuotationBase
@inject QuotationBaseExcelService QuotationBaseExcel
@inject CentralAuthService Auth
@inject LastListReturnService LastListReturn

<PageTitle>报价基础数据</PageTitle>

<div class="qb-list-page">
    <MudPaper Class="pa-3" Outlined="true">
        <div class="qb-toolbar-grid">
            <div class="qb-toolbar-left">
                <MudSelect T="string"
                           Value="_itemType"
                           ValueChanged="OnItemTypeChangedAsync"
                           Label="类型"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Class="@($"qb-type-select qb-type-{TypeCss(_itemType)}")"
                           ToStringFunc="@(v => QuotationBaseTypes.LabelOf(v))"
                           Adornment="Adornment.Start"
                           AdornmentIcon="@ChipIconOf(_itemType)"
                           Disabled="_busy || _batchEditMode">
                    @foreach (var t in QuotationBaseTypes.All)
                    {
                        <MudSelectItem Value="@t.Key">
                            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="@($"qb-type-item qb-type-{TypeCss(t.Key)}")">
                                <MudIcon Icon="@ChipIconOf(t.Key)" Size="Size.Small"/>
                                <span>@t.Label</span>
                            </MudStack>
                        </MudSelectItem>
                    }
                </MudSelect>
                <MudSelect T="string"
                           @bind-Value="_filterColumn"
                           Label="条件"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Class="qb-filter-select"
                           Disabled="_batchEditMode">
                    @foreach (var field in QuotationBaseFilterFields.ForType(_itemType))
                    {
                        <MudSelectItem Value="@field.Key">@field.Label</MudSelectItem>
                    }
                </MudSelect>
                <MudTextField @bind-Value="_keyword"
                              Label="内容"
                              Placeholder="请输入查询内容"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Immediate="true"
                              Class="qb-filter-input"
                              OnKeyUp="OnKeyUp"
                              Disabled="_batchEditMode"/>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Search" OnClick="SearchAsync" Disabled="_busy || _batchEditMode">搜索</MudButton>
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Clear" OnClick="ClearAsync" Disabled="_busy || _batchEditMode">清空</MudButton>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add"
                           Href="@NewHref"
                           Disabled="_batchEditMode">新建</MudButton>
            </div>
            <div class="qb-toolbar-right">
                <MudButton Variant="Variant.Outlined"
                           StartIcon="@Icons.Material.Filled.Deselect"
                           OnClick="ClearSelection"
                           Disabled="_selected.Count == 0 || _batchEditMode">取消选择</MudButton>
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Error"
                           StartIcon="@Icons.Material.Filled.Delete"
                           OnClick="DeleteSelectedAsync"
                           Disabled="_selected.Count == 0 || _busy || _batchEditMode">删除</MudButton>
                @if (_batchEditMode)
                {
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Save"
                               OnClick="SaveBatchAsync"
                               Disabled="_busy || _pendingFields.Count == 0">
                        保存
                    </MudButton>
                    <MudButton Variant="Variant.Outlined"
                               StartIcon="@Icons.Material.Filled.Close"
                               OnClick="CancelBatchEditAsync"
                               Disabled="_busy">
                        取消修改
                    </MudButton>
                }
                else
                {
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Warning"
                               StartIcon="@Icons.Material.Filled.EditNote"
                               OnClick="EnterBatchEdit"
                               Disabled="_busy">
                        批量修改
                    </MudButton>
                }
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Download" OnClick="ExportAsync" Disabled="_busy || _batchEditMode">
                    @(_selected.Count > 0 ? $"导出({_selected.Count})" : "导出")
                </MudButton>
                <label class="qb-file-label">
                    <InputFile OnChange="OnImportFile" accept=".xlsx" disabled="@(_busy || _batchEditMode)"/>
                    <MudButton Variant="Variant.Outlined"
                               StartIcon="@Icons.Material.Filled.Upload"
                               Disabled="_busy || _batchEditMode"
                               HtmlTag="span">
                        上传
                    </MudButton>
                </label>
                <MudButton Variant="Variant.Outlined"
                           StartIcon="@Icons.Material.Filled.Description"
                           OnClick="DownloadTemplateAsync"
                           Disabled="_busy || _batchEditMode">
                    下载模板
                </MudButton>
            </div>
        </div>
    </MudPaper>

    <MudPaper Class="qb-table-wrap pa-0" Outlined="true">
        @if (_ready)
        {
            <MudTable @ref="_table"
                      T="QuotationBaseListItemDto"
                      ServerData="LoadServerData"
                      @bind-CurrentPage="_currentPage"
                      RowsPerPage="@_rowsPerPage"
                      Dense="true"
                      Hover="true"
                      Striped="true"
                      Bordered="true"
                      Loading="_busy"
                      MultiSelection="true"
                      SelectOnRowClick="false"
                      @bind-SelectedItems="_selected"
                      OnRowClick="OnRowClick"
                      Breakpoint="Breakpoint.None"
                      FixedHeader="true"
                      SortMode="SortMode.Single"
                      RowClassFunc="BatchRowClass"
                      Class="@(_batchEditMode ? "qb-table qb-batch-edit" : "qb-table")">
                <HeaderContent>
                    <MudTh Class="qb-no-cell">序号</MudTh>
                    <MudTh><MudTableSortLabel T="QuotationBaseListItemDto" SortLabel="Part_No">型号</MudTableSortLabel></MudTh>
                    <MudTh>图片</MudTh>
                    @if (_itemType == QuotationBaseTypes.Motor)
                    {
                        <MudTh><MudTableSortLabel T="QuotationBaseListItemDto" SortLabel="Rated_torque">额定扭矩</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel T="QuotationBaseListItemDto" SortLabel="Rated_speed">额定转速</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel T="QuotationBaseListItemDto" SortLabel="Power_supply">电源</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel T="QuotationBaseListItemDto" SortLabel="Rated_Power">额定功率</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel T="QuotationBaseListItemDto" SortLabel="Rated_Current">额定电流</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel T="QuotationBaseListItemDto" SortLabel="Noise_dBA">噪音</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel T="QuotationBaseListItemDto" SortLabel="Motor_Length">电机长度</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel T="QuotationBaseListItemDto" SortLabel="Tube_diameter">管径</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel T="QuotationBaseListItemDto" SortLabel="Battery_Capacity">电池容量</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel T="QuotationBaseListItemDto" SortLabel="Exclude_text">价格排除</MudTableSortLabel></MudTh>
                    }
                    else if (_itemType == QuotationBaseTypes.Remote)
                    {
                        <MudTh><MudTableSortLabel T="QuotationBaseListItemDto" SortLabel="Remote_controller_type">遥控器型号</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel T="QuotationBaseListItemDto" SortLabel="Battery_Type">电池型号</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel T="QuotationBaseListItemDto" SortLabel="Radio_Frequency">频率</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel T="QuotationBaseListItemDto" SortLabel="Working_Temperature">工作温度</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel T="QuotationBaseListItemDto" SortLabel="NoOfChannels">通道数</MudTableSortLabel></MudTh>
                    }
                    else if (_itemType == QuotationBaseTypes.Accessory)
                    {
                        <MudTh><MudTableSortLabel T="QuotationBaseListItemDto" SortLabel="adaptor">配件名</MudTableSortLabel></MudTh>
                    }
                    else if (_itemType == QuotationBaseTypes.CB)
                    {
                        <MudTh><MudTableSortLabel T="QuotationBaseListItemDto" SortLabel="Rated_Voltage">额定电压</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel T="QuotationBaseListItemDto" SortLabel="Size">尺寸</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel T="QuotationBaseListItemDto" SortLabel="Rated_Power">额定功率</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel T="QuotationBaseListItemDto" SortLabel="No_Of_Actuator">执行器数量</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel T="QuotationBaseListItemDto" SortLabel="Output_Control">输出控制</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel T="QuotationBaseListItemDto" SortLabel="Sensor">传感器</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel T="QuotationBaseListItemDto" SortLabel="Protection_Degree">防护等级</MudTableSortLabel></MudTh>
                    }
                    else if (_itemType == QuotationBaseTypes.PR)
                    {
                        <MudTh><MudTableSortLabel T="QuotationBaseListItemDto" SortLabel="Max_Loading">最大负载</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel T="QuotationBaseListItemDto" SortLabel="Max_Stroke">最大行程</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel T="QuotationBaseListItemDto" SortLabel="Protection_Degree2">防护等级</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel T="QuotationBaseListItemDto" SortLabel="Noise">噪音</MudTableSortLabel></MudTh>
                    }
                    <MudTh Class="qb-remark-cell"><MudTableSortLabel T="QuotationBaseListItemDto" SortLabel="Remark">备注</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel T="QuotationBaseListItemDto" SortLabel="UpdatePerson">修改人</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel T="QuotationBaseListItemDto" SortLabel="UpdateTime">修改时间</MudTableSortLabel></MudTh>
                    <MudTh Class="qb-creator-cell"><MudTableSortLabel T="QuotationBaseListItemDto" SortLabel="CreatePerson">创建人</MudTableSortLabel></MudTh>
                    <MudTh Class="qb-createtime-cell"><MudTableSortLabel T="QuotationBaseListItemDto" SortLabel="CreateTime" InitialDirection="SortDirection.Descending">创建时间</MudTableSortLabel></MudTh>
                    <MudTh Class="qb-ops-cell">操作</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd Class="qb-no-cell">@RowNo(context)</MudTd>
                    <MudTd>@Dash(context.Part_No)</MudTd>
                    <MudTd><LegacyRemoteImg Path="@context.Quotation_logo" CssClass="cotract-thumb"/></MudTd>
                    @if (_itemType == QuotationBaseTypes.Motor)
                    {
                        <MudTd Class="@BatchTdClass(context, "Rated_torque")">@BatchCell(context, "Rated_torque", context.Rated_torque)</MudTd>
                        <MudTd Class="@BatchTdClass(context, "Rated_speed")">@BatchCell(context, "Rated_speed", context.Rated_speed)</MudTd>
                        <MudTd Class="@BatchTdClass(context, "Power_supply")">@BatchCell(context, "Power_supply", context.Power_supply)</MudTd>
                        <MudTd Class="@BatchTdClass(context, "Rated_Power")">@BatchCell(context, "Rated_Power", context.Rated_Power)</MudTd>
                        <MudTd Class="@BatchTdClass(context, "Rated_Current")">@BatchCell(context, "Rated_Current", context.Rated_Current)</MudTd>
                        <MudTd Class="@BatchTdClass(context, "Noise_dBA")">@BatchCell(context, "Noise_dBA", context.Noise_dBA)</MudTd>
                        <MudTd Class="@BatchTdClass(context, "Motor_Length")">@BatchCell(context, "Motor_Length", context.Motor_Length)</MudTd>
                        <MudTd Class="@BatchTdClass(context, "Tube_diameter")">@BatchCell(context, "Tube_diameter", context.Tube_diameter)</MudTd>
                        <MudTd Class="@BatchTdClass(context, "Battery_Capacity")">@BatchCell(context, "Battery_Capacity", context.Battery_Capacity)</MudTd>
                        <MudTd Class="@BatchTdClass(context, "Exclude_text")">@BatchCell(context, "Exclude_text", context.Exclude_text)</MudTd>
                    }
                    else if (_itemType == QuotationBaseTypes.Remote)
                    {
                        <MudTd Class="@BatchTdClass(context, "Remote_controller_type")">@BatchCell(context, "Remote_controller_type", context.Remote_controller_type)</MudTd>
                        <MudTd Class="@BatchTdClass(context, "Battery_Type")">@BatchCell(context, "Battery_Type", context.Battery_Type)</MudTd>
                        <MudTd Class="@BatchTdClass(context, "Radio_Frequency")">@BatchCell(context, "Radio_Frequency", context.Radio_Frequency)</MudTd>
                        <MudTd Class="@BatchTdClass(context, "Working_Temperature")">@BatchCell(context, "Working_Temperature", context.Working_Temperature)</MudTd>
                        <MudTd Class="@BatchTdClass(context, "NoOfChannels")">@BatchCell(context, "NoOfChannels", context.NoOfChannels)</MudTd>
                    }
                    else if (_itemType == QuotationBaseTypes.Accessory)
                    {
                        <MudTd Class="@BatchTdClass(context, "adaptor")">@BatchCell(context, "adaptor", context.adaptor)</MudTd>
                    }
                    else if (_itemType == QuotationBaseTypes.CB)
                    {
                        <MudTd Class="@BatchTdClass(context, "Rated_Voltage")">@BatchCell(context, "Rated_Voltage", context.Rated_Voltage)</MudTd>
                        <MudTd Class="@BatchTdClass(context, "Size")">@BatchCell(context, "Size", context.Size)</MudTd>
                        <MudTd Class="@BatchTdClass(context, "Rated_Power")">@BatchCell(context, "Rated_Power", context.Rated_Power)</MudTd>
                        <MudTd Class="@BatchTdClass(context, "No_Of_Actuator")">@BatchCell(context, "No_Of_Actuator", context.No_Of_Actuator)</MudTd>
                        <MudTd Class="@BatchTdClass(context, "Output_Control")">@BatchCell(context, "Output_Control", context.Output_Control)</MudTd>
                        <MudTd Class="@BatchTdClass(context, "Sensor")">@BatchCell(context, "Sensor", context.Sensor)</MudTd>
                        <MudTd Class="@BatchTdClass(context, "Protection_Degree")">@BatchCell(context, "Protection_Degree", context.Protection_Degree)</MudTd>
                    }
                    else if (_itemType == QuotationBaseTypes.PR)
                    {
                        <MudTd Class="@BatchTdClass(context, "Max_Loading")">@BatchCell(context, "Max_Loading", context.Max_Loading)</MudTd>
                        <MudTd Class="@BatchTdClass(context, "Max_Stroke")">@BatchCell(context, "Max_Stroke", context.Max_Stroke)</MudTd>
                        <MudTd Class="@BatchTdClass(context, "Protection_Degree2")">@BatchCell(context, "Protection_Degree2", context.Protection_Degree2)</MudTd>
                        <MudTd Class="@BatchTdClass(context, "Noise")">@BatchCell(context, "Noise", context.Noise)</MudTd>
                    }
                    <MudTd Class="@($"{BatchTdClass(context, "Remark")} qb-remark-cell")">
                        @{
                            var remark = (context.Remark ?? "").Trim();
                        }
                        @if (CanBatchEdit(context))
                        {
                            @BatchCell(context, "Remark", context.Remark)
                        }
                        else if (remark.Length > 0)
                        {
                            <MudTooltip Text="@remark" Arrow="true">
                                <div class="qb-remark-text">@remark</div>
                            </MudTooltip>
                        }
                        else
                        {
                            <span>-</span>
                        }
                    </MudTd>
                    <MudTd>@Dash(context.UpdatePerson)</MudTd>
                    <MudTd>@FormatDate(context.UpdateTime)</MudTd>
                    <MudTd Class="qb-creator-cell">@Dash(context.CreatePerson)</MudTd>
                    <MudTd Class="qb-createtime-cell">@FormatDate(context.CreateTime)</MudTd>
                    <MudTd Class="qb-ops-cell">
                        <div class="qb-ops-grid">
                            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.Edit"
                                       Class="qb-ops-btn"
                                       Disabled="_batchEditMode"
                                       Href="@EditHref(context)">编辑</MudButton>
                            <MudButton Size="Size.Small" Variant="Variant.Text"
                                       StartIcon="@Icons.Material.Filled.Visibility"
                                       Class="qb-ops-btn"
                                       Disabled="_batchEditMode"
                                       Href="@DetailHref(context)">详情</MudButton>
                            <MudButton Size="Size.Small" Variant="Variant.Text"
                                       StartIcon="@Icons.Material.Filled.ContentCopy"
                                       Class="qb-ops-btn"
                                       Disabled="_batchEditMode"
                                       Href="@CopyHref(context)">复制</MudButton>
                            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error"
                                       StartIcon="@Icons.Material.Filled.Delete"
                                       Class="qb-ops-btn"
                                       Disabled="_busy || _batchEditMode"
                                       OnClick="@(() => DeleteAsync(context))">删除</MudButton>
                        </div>
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Class="pa-4">@(_busy ? "加载中…" : "暂无数据")</MudText>
                </NoRecordsContent>
                <PagerContent>
                    <MudTablePager PageSizeOptions="new int[] { 20, 50, 100 }"
                                   RowsPerPageString="每页行数："
                                   InfoFormat="显示第 {first_item} 到第 {last_item} 条，共 {all_items} 条"/>
                </PagerContent>
            </MudTable>
        }
    </MudPaper>
</div>

<style>
    .qb-list-page {
        flex: 1 1 0;
        display: flex;
        flex-direction: column;
        height: 100%;
        min-height: 0;
        gap: 12px;
    }
    .qb-toolbar-grid {
        display: grid;
        grid-template-columns: 7fr 5fr;
        gap: 8px;
        align-items: center;
        width: 100%;
        min-width: 0;
    }
    .qb-toolbar-left,
    .qb-toolbar-right {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
        min-width: 0;
    }
    .qb-toolbar-left { justify-content: flex-start; }
    .qb-toolbar-right { justify-content: flex-end; }
    .qb-toolbar-left > *,
    .qb-toolbar-right > * {
        flex: 0 0 auto;
    }
    @@media (max-width: 960px) {
        .qb-toolbar-grid { grid-template-columns: 1fr; }
        .qb-toolbar-right { justify-content: flex-start; }
    }
    .qb-file-label {
        position: relative;
        display: inline-flex;
        align-items: center;
        margin: 0;
        cursor: pointer;
    }
    .qb-file-label input[type=file] {
        position: absolute;
        width: 1px;
        height: 1px;
        opacity: 0;
        overflow: hidden;
        z-index: -1;
    }
    /* 批量勾选行整行高亮；须盖过 sticky 勾选/序号/创建/操作列的白底与斑马纹 */
    .qb-table.qb-batch-edit .mud-table-body .qb-batch-row > .mud-table-cell,
    .qb-table.qb-batch-edit .mud-table-body .qb-batch-row > .mud-table-cell:first-child,
    .qb-table.qb-batch-edit .mud-table-body .qb-batch-row > .mud-table-cell.qb-no-cell,
    .qb-table.qb-batch-edit .mud-table-body .qb-batch-row > .mud-table-cell.qb-creator-cell,
    .qb-table.qb-batch-edit .mud-table-body .qb-batch-row > .mud-table-cell.qb-createtime-cell,
    .qb-table.qb-batch-edit .mud-table-body .qb-batch-row > .mud-table-cell.qb-ops-cell,
    .qb-table.qb-batch-edit.mud-table-striped .mud-table-body .qb-batch-row:nth-of-type(odd) > .mud-table-cell:first-child,
    .qb-table.qb-batch-edit.mud-table-striped .mud-table-body .qb-batch-row:nth-of-type(odd) > .mud-table-cell.qb-no-cell,
    .qb-table.qb-batch-edit.mud-table-striped .mud-table-body .qb-batch-row:nth-of-type(odd) > .mud-table-cell.qb-creator-cell,
    .qb-table.qb-batch-edit.mud-table-striped .mud-table-body .qb-batch-row:nth-of-type(odd) > .mud-table-cell.qb-createtime-cell,
    .qb-table.qb-batch-edit.mud-table-striped .mud-table-body .qb-batch-row:nth-of-type(odd) > .mud-table-cell.qb-ops-cell,
    .qb-table.qb-batch-edit .mud-table-body .qb-batch-row:hover > .mud-table-cell.qb-creator-cell,
    .qb-table.qb-batch-edit .mud-table-body .qb-batch-row:hover > .mud-table-cell.qb-createtime-cell,
    .qb-table.qb-batch-edit .mud-table-body .qb-batch-row:hover > .mud-table-cell.qb-ops-cell {
        background-color: #fff8e1 !important;
        background-image: linear-gradient(#fff8e1, #fff8e1);
    }
    .qb-table.qb-batch-edit .mud-table-body .qb-batch-row > .mud-table-cell.qb-cell-dirty {
        outline: 1px dashed #ef6c00;
        outline-offset: -2px;
        background-color: #fff3e0 !important;
    }
    .qb-batch-input {
        min-width: 88px;
        max-width: 180px;
    }
    .qb-batch-input .mud-input-control,
    .qb-batch-input .mud-input {
        margin-top: 0 !important;
    }
    .qb-table.qb-batch-edit .qb-batch-input .mud-input-outlined,
    .qb-table.qb-batch-edit .qb-batch-input .mud-input-slot {
        background-color: #fffdf5 !important;
    }
    .qb-type-select { width: 168px; }
    .qb-type-select .mud-input-slot,
    .qb-type-select input.mud-select-input {
        font-weight: 600;
    }
    .qb-type-motor .mud-input-outlined-border { border-color: #1976d2 !important; }
    .qb-type-motor .mud-input-slot,
    .qb-type-motor input.mud-select-input,
    .qb-type-motor .mud-input-label,
    .qb-type-motor .mud-input-adornment .mud-icon-root { color: #1976d2 !important; }
    .qb-type-remote .mud-input-outlined-border { border-color: #0288d1 !important; }
    .qb-type-remote .mud-input-slot,
    .qb-type-remote input.mud-select-input,
    .qb-type-remote .mud-input-label,
    .qb-type-remote .mud-input-adornment .mud-icon-root { color: #0288d1 !important; }
    .qb-type-cb .mud-input-outlined-border { border-color: #ed6c02 !important; }
    .qb-type-cb .mud-input-slot,
    .qb-type-cb input.mud-select-input,
    .qb-type-cb .mud-input-label,
    .qb-type-cb .mud-input-adornment .mud-icon-root { color: #ed6c02 !important; }
    .qb-type-pr .mud-input-outlined-border { border-color: #2e7d32 !important; }
    .qb-type-pr .mud-input-slot,
    .qb-type-pr input.mud-select-input,
    .qb-type-pr .mud-input-label,
    .qb-type-pr .mud-input-adornment .mud-icon-root { color: #2e7d32 !important; }
