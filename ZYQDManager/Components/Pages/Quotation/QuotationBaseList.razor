            var typeLabel = QuotationBaseTypes.LabelOf(_itemType);
            var ok = await DialogService.ShowMessageBoxAsync(
                "确认导出",
                $"未勾选记录，将按当前筛选条件导出全部「{typeLabel}」数据，共 {_total} 条，是否继续？",
                yesText: "导出全部", cancelText: "取消");
            if (ok != true) return;
        }

        _busy = true;
        try
        {
            var bytes = await QuotationBaseExcel.ExportAsync(BuildQuery(), selectedIds);
            if (bytes.Length == 0)
            {
                Notify.Show("没有可导出的数据", Severity.Warning);
                return;
            }

            var typeLabel = QuotationBaseTypes.LabelOf(_itemType);
            await JS.InvokeVoidAsync(
                "downloadFileFromBase64",
                $"报价基础_{typeLabel}_{DateTime.Now:yyyyMMddHHmmss}.xlsx",
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
                Convert.ToBase64String(bytes));
            Notify.Show(
                selectedIds is { Count: > 0 } ? $"已导出选中的 {selectedIds.Count} 条" : $"已按当前条件导出全部 {_total} 条",
                Severity.Success);
        }
        catch (Exception ex)
        {
            Notify.Show("导出失败：" + ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DownloadTemplateAsync()
    {
        _busy = true;
        try
        {
            var bytes = await QuotationBaseExcel.GetTemplateBytesAsync(_itemType);
            await JS.InvokeVoidAsync(
                "downloadFileFromBase64",
                QuotationBaseExcelService.TemplateFileNameFor(_itemType),
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
                Convert.ToBase64String(bytes));
        }
        catch (Exception ex)
        {
            Notify.Show("下载模板失败：" + ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task OnImportFile(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null) return;

        if (!file.Name.EndsWith(".xlsx", StringComparison.OrdinalIgnoreCase))
        {
            Notify.Show("请上传 xlsx 文件（请先下载模板）", Severity.Warning);
            return;
        }

        if (file.Size > MaxImportBytes)
        {
            Notify.Show("文件超过 32MB，请拆分后再导入", Severity.Warning);
            return;
        }

        _busy = true;
        try
        {
            await using var stream = file.OpenReadStream(MaxImportBytes);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            ms.Position = 0;

            var empNo = await Auth.GetCurrentEmpNoAsync();
            if (string.IsNullOrWhiteSpace(empNo))
            {
                Notify.Show("无法获取当前登录工号，请重新登录后再导入", Severity.Error);
                return;
            }

            var result = await QuotationBaseExcel.ImportAsync(ms, empNo);
            if (!result.Ok)
            {
                await DialogService.ShowMessageBoxAsync(
                    "导入失败",
                    result.Message ?? "未知错误",
                    yesText: "知道了");
                return;
            }

            Notify.Show(result.Message, Severity.Success);
            _selected.Clear();
            await ReloadTableAsync(resetPage: true);
        }
        catch (Exception ex)
        {
            Notify.Show("导入失败：" + ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }
}
