@code {
    [SupplyParameterFromQuery(Name = "type")]
    public string? TypeFromQuery { get; set; }

    private MudTable<QuotationBaseListItemDto>? _table;
    private bool _ready;
    private bool _busy;
    private string _itemType = QuotationBaseTypes.Motor;
    private string _filterColumn = "Part_No";
    private string? _keyword;
    private List<QuotationBaseListItemDto> _rows = new();
    private HashSet<QuotationBaseListItemDto> _selected = new();
    private int _skip;
    private int _total;
    private int _currentPage;
    private int _rowsPerPage = 20;
    private string? _sortLabel = "CreateTime";
    private bool _sortDescending = true;
    private const long MaxImportBytes = 32L * 1024 * 1024;
    private bool _batchEditMode;
    private readonly Dictionary<string, string?> _pendingFields = new(StringComparer.OrdinalIgnoreCase);

    protected override void OnInitialized()
    {
        ApplyType(TypeFromQuery, resetKeyword: true);
    }

    protected override void OnParametersSet()
    {
        var next = QuotationBaseTypes.Normalize(TypeFromQuery);
        if (next == _itemType) return;
        ApplyType(next, resetKeyword: true);
        _currentPage = 0;
        _ = ReloadAfterTypeChangeAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _ready) return;
        RestoreFromReturn();
        _ready = true;
        StateHasChanged();
    }

    private void RestoreFromReturn()
    {
        var snap = ListUiStateStore.Take(LastListReturn, ListUiStateStore.Keys.QuotationBase);
        if (snap is null) return;
        _rowsPerPage = snap.PageSize > 0 ? snap.PageSize : 20;
        if (!string.Equals(snap.Extra, _itemType, StringComparison.Ordinal))
            return;
        if (!string.IsNullOrWhiteSpace(snap.FilterColumn))
            _filterColumn = snap.FilterColumn!;
        _keyword = snap.Keyword;
        _currentPage = snap.Page < 0 ? 0 : snap.Page;
    }

    private void PersistAsync(int page, int pageSize)
        => ListUiStateStore.Capture(LastListReturn, ListUiStateStore.Keys.QuotationBase, new PagedListUiState
        {
            Page = page < 0 ? 0 : page,
            PageSize = pageSize > 0 ? pageSize : 20,
            FilterColumn = _filterColumn,
            Keyword = _keyword,
            Extra = _itemType,
        });

    private void ApplyType(string? type, bool resetKeyword)
    {
        _itemType = QuotationBaseTypes.Normalize(type);
        _filterColumn = QuotationBaseFilterFields.ForType(_itemType)[0].Key;
        if (resetKeyword)
            _keyword = null;
        _selected.Clear();
        ExitBatchEdit();
    }

    private async Task OnItemTypeChangedAsync(string value)
    {
        var next = QuotationBaseTypes.Normalize(value);
        if (next == _itemType) return;
        if (!await ConfirmLeaveBatchAsync()) return;

        ApplyType(next, resetKeyword: true);
        NavManager.NavigateTo($"/quotation-base?type={Uri.EscapeDataString(next)}", replace: true);
        await ReloadAfterTypeChangeAsync();
    }

    private async Task ReloadAfterTypeChangeAsync()
    {
        // 列结构随类型变化，重建表格并立刻拉数
        _ready = false;
        StateHasChanged();
        await Task.Yield();
        _ready = true;
        StateHasChanged();
    }

    private int RowNo(QuotationBaseListItemDto row) => _skip + _rows.IndexOf(row) + 1;

    private static string Dash(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private static string FormatDate(DateTime? dt)
        => DateDisplay.Format(dt, "-");

    private async Task OnKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await SearchAsync();
    }

    private async Task ClearAsync()
    {
        _filterColumn = QuotationBaseFilterFields.ForType(_itemType)[0].Key;
        _keyword = null;
        await SearchAsync();
    }

    private async Task SearchAsync()
    {
        if (!await ConfirmLeaveBatchAsync()) return;
        _selected.Clear();
        await ReloadTableAsync(resetPage: true);
    }

    private void ClearSelection() => _selected.Clear();

    private void OnRowClick(TableRowClickEventArgs<QuotationBaseListItemDto> args)
    {
        if (_batchEditMode) return;
        if (args.MouseEventArgs.Detail != 2 || args.Item is null) return;
        NavManager.NavigateTo(DetailHref(args.Item));
    }

    private bool CanBatchEdit(QuotationBaseListItemDto row)
        => _batchEditMode && _selected.Contains(row);

    private string BatchRowClass(QuotationBaseListItemDto row, int _)
        => CanBatchEdit(row) ? "qb-batch-row" : string.Empty;

    private string BatchTdClass(QuotationBaseListItemDto row, string field)
        => CanBatchEdit(row) && _pendingFields.ContainsKey(field)
            ? "qb-batch-td qb-cell-dirty"
            : "qb-batch-td";

    private RenderFragment BatchCell(QuotationBaseListItemDto row, string field, string? value) => builder =>
    {
        if (CanBatchEdit(row))
        {
            builder.OpenComponent<MudTextField<string>>(0);
            builder.AddAttribute(1, "Value", value ?? "");
            builder.AddAttribute(2, "ValueChanged", EventCallback.Factory.Create<string>(this, v => OnBatchFieldChanged(field, v)));
            builder.AddAttribute(3, "Variant", Variant.Outlined);
            builder.AddAttribute(4, "Margin", Margin.Dense);
            builder.AddAttribute(5, "Immediate", false);
            builder.AddAttribute(6, "Class", "qb-batch-input");
            builder.AddAttribute(7, "Disabled", _busy);
            builder.CloseComponent();
        }
        else
        {
            builder.AddContent(10, Dash(value));
        }
    };

    private void OnBatchFieldChanged(string field, string? value)
    {
        if (!_batchEditMode) return;
        value ??= "";
        _pendingFields[field] = value;
        foreach (var row in _selected)
            SetRowField(row, field, value);
        StateHasChanged();
    }

    private static void SetRowField(QuotationBaseListItemDto row, string field, string value)
    {
        switch (field)
        {
            case "Rated_torque": row.Rated_torque = value; break;
            case "Rated_speed": row.Rated_speed = value; break;
            case "Power_supply": row.Power_supply = value; break;
            case "Rated_Power": row.Rated_Power = value; break;
            case "Rated_Current": row.Rated_Current = value; break;
            case "Noise_dBA": row.Noise_dBA = value; break;
            case "Motor_Length": row.Motor_Length = value; break;
            case "Tube_diameter": row.Tube_diameter = value; break;
            case "Battery_Capacity": row.Battery_Capacity = value; break;
            case "Exclude_text": row.Exclude_text = value; break;
            case "Remote_controller_type": row.Remote_controller_type = value; break;
            case "Battery_Type": row.Battery_Type = value; break;
            case "Radio_Frequency": row.Radio_Frequency = value; break;
            case "Working_Temperature": row.Working_Temperature = value; break;
            case "NoOfChannels": row.NoOfChannels = value; break;
            case "adaptor": row.adaptor = value; break;
            case "Rated_Voltage": row.Rated_Voltage = value; break;
            case "Size": row.Size = value; break;
            case "No_Of_Actuator": row.No_Of_Actuator = value; break;
            case "Output_Control": row.Output_Control = value; break;
            case "Sensor": row.Sensor = value; break;
            case "Protection_Degree": row.Protection_Degree = value; break;
            case "Max_Loading": row.Max_Loading = value; break;
            case "Max_Stroke": row.Max_Stroke = value; break;
            case "Protection_Degree2": row.Protection_Degree2 = value; break;
            case "Noise": row.Noise = value; break;
            case "Remark": row.Remark = value; break;
        }
    }

    private void EnterBatchEdit()
    {
        if (_selected.Count == 0)
        {
            Notify.Show("请先勾选要批量修改的记录", Severity.Warning);
            return;
        }

        _batchEditMode = true;
        _pendingFields.Clear();
        Notify.Show("已进入批量修改：编辑勾选行单元格，同列勾选行会同步，完成后点保存", Severity.Info);
    }

    private async Task CancelBatchEditAsync()
    {
        if (_pendingFields.Count > 0)
        {
            var ok = await DialogService.ShowMessageBoxAsync(
                "取消修改",
                "取消后未保存的修改将丢失，确定取消？",
                yesText: "确定取消", cancelText: "继续编辑");
            if (ok != true) return;
        }

        ExitBatchEdit();
        _selected.Clear();
        await ReloadTableAsync(resetPage: false);
    }

    private async Task SaveBatchAsync()
    {
        if (_selected.Count == 0)
        {
            Notify.Show("请先勾选要保存的记录", Severity.Warning);
            return;
        }

        if (_pendingFields.Count == 0)
        {
            Notify.Show("没有需要保存的修改，请先编辑单元格", Severity.Warning);
            return;
        }

        var ok = await DialogService.ShowMessageBoxAsync(
            "确认保存",
            $"将把修改同步到已勾选的 {_selected.Count} 条记录，确定保存？",
            yesText: "保存", cancelText: "取消");
        if (ok != true) return;

        _busy = true;
        try
        {
            var empNo = await Auth.GetCurrentEmpNoAsync() ?? "";
            var ids = _selected.Select(x => x.Id).ToList();
            var (success, msg) = await QuotationBase.BatchUpdateAsync(_itemType, ids, _pendingFields, empNo);
            if (!success)
            {
                Notify.Show(msg ?? "保存失败", Severity.Error);
                return;
            }

            Notify.Show(msg ?? "保存成功", Severity.Success);
            ExitBatchEdit();
            _selected.Clear();
            await ReloadTableAsync(resetPage: false);
        }
        finally
        {
            _busy = false;
        }
    }

    private void ExitBatchEdit()
    {
        _batchEditMode = false;
        _pendingFields.Clear();
    }

    private async Task<bool> ConfirmLeaveBatchAsync()
    {
        if (!_batchEditMode) return true;
        if (_pendingFields.Count > 0)
        {
            var ok = await DialogService.ShowMessageBoxAsync(
                "离开批量修改",
                "当前有未保存的批量修改，离开将丢失，确定继续？",
                yesText: "离开", cancelText: "留下");
            if (ok != true) return false;
        }

        ExitBatchEdit();
        return true;
    }

