@page "/contract"
@page "/contract-pi"
@rendermode InteractiveServer
@inject CotractPiService CotractPi
@inject CentralAuthService Auth
@inject CentralUserInformationService UserInfo
@inject LastListReturnService LastListReturn

<PageTitle>合同列表</PageTitle>

<div class="cotract-pi-page">
    <MudPaper Class="pa-3" Outlined="true">
        <div class="cpi-toolbar-grid">
            <div class="cpi-toolbar-left">
                <MudSelect T="string"
                           Value="_documentType"
                           ValueChanged="OnDocumentTypeChanged"
                           Label="单据类型"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Class="@($"cpi-doc-type-select cpi-doc-type-{DocKindCss(_documentType)}")">
                    @foreach (var kind in DocumentKinds)
                    {
                        <MudSelectItem Value="@kind">
                            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="@($"cpi-doc-type-item cpi-doc-type-{DocKindCss(kind)}")">
                                <MudIcon Icon="@DocKindIcon(kind)" Size="Size.Small"/>
                                <span>@kind</span>
                            </MudStack>
                        </MudSelectItem>
                    }
                </MudSelect>
                <MudSelect T="string"
                           Value="_filterColumn"
                           ValueChanged="OnFilterColumnChanged"
                           Label="条件"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Class="cpi-filter-select-wide">
                    @foreach (var field in CotractPiFilterFields.All)
                    {
                        <MudSelectItem Value="@field.Label">@field.Label</MudSelectItem>
                    }
                </MudSelect>
                @if (IsDateFilter)
                {
                    <MudDatePicker @bind-Date="_dateStart"
                                   Label="开始"
                                   DateFormat="yyyy-MM-dd"
                                   Culture="@(System.Globalization.CultureInfo.InvariantCulture)"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Editable="true"
                                   Clearable="true"
                                   Class="cpi-filter-date"/>
                    <MudDatePicker @bind-Date="_dateEnd"
                                   Label="结束"
                                   DateFormat="yyyy-MM-dd"
                                   Culture="@(System.Globalization.CultureInfo.InvariantCulture)"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Editable="true"
                                   Clearable="true"
                                   Class="cpi-filter-date"/>
                }
                else
                {
                    <MudTextField @bind-Value="_keyword"
                                  Label="内容"
                                  Placeholder="输入查询内容"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Immediate="true"
                                  Class="cpi-filter-input"
                                  OnKeyUp="OnKeyUp"/>
                }
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Search" OnClick="SearchAsync" Disabled="_busy">搜索</MudButton>
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Clear" OnClick="ClearAsync" Disabled="_busy">清空</MudButton>
                @if (IsCustomerPi)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Href="/contract-pi/new">新建</MudButton>
                }
                else
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                               OnClick="GoCustomerPiForCreateAsync">新建</MudButton>
                }
            </div>
            <div class="cpi-toolbar-right">
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Deselect" OnClick="ClearSelection" Disabled="_selected.Count == 0 || IsPackingList">取消选择</MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete" OnClick="DeleteSelectedAsync" Disabled="_selected.Count == 0 || _busy || IsPackingList">删除</MudButton>
            </div>
        </div>
    </MudPaper>

    <MudPaper Class="cotract-pi-table-wrap pa-0" Outlined="true">
        @if (_ready)
        {
            <MudTable @ref="_table"
                      T="ZyqdCotractPiModel"
                      ServerData="LoadServerData"
                      @bind-CurrentPage="_currentPage"
                      RowsPerPage="@_rowsPerPage"
                      Dense="true"
                      Hover="true"
                      Striped="true"
                      Bordered="true"
                      Loading="_busy"
                      MultiSelection="true"
                      SelectOnRowClick="false"
                      @bind-SelectedItems="_selected"
                      Breakpoint="Breakpoint.None"
                      FixedHeader="true"
                      SortMode="SortMode.Single"
                      OnRowClick="OnRowClick"
                      Class="cotract-pi-table">
                <HeaderContent>
                    <MudTh Class="cpi-no-cell">序号</MudTh>
                    <MudTh><MudTableSortLabel T="ZyqdCotractPiModel" SortLabel="ClientNo">客户编号</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel T="ZyqdCotractPiModel" SortLabel="ClientName">客户名称</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel T="ZyqdCotractPiModel" SortLabel="var6">订单类型</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel T="ZyqdCotractPiModel" SortLabel="Person">需求人</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel T="ZyqdCotractPiModel" SortLabel="INVOICE_NO">发票号</MudTableSortLabel></MudTh>
                    <MudTh Class="cpi-po-cell"><MudTableSortLabel T="ZyqdCotractPiModel" SortLabel="BILL_TO_PO_REF">PO号</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel T="ZyqdCotractPiModel" SortLabel="UpdatePerson">修改人</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel T="ZyqdCotractPiModel" SortLabel="UpdateTime">修改时间</MudTableSortLabel></MudTh>
                    <MudTh Class="cpi-creator-cell"><MudTableSortLabel T="ZyqdCotractPiModel" SortLabel="CreatePerson">创建人</MudTableSortLabel></MudTh>
                    <MudTh Class="cpi-createtime-cell"><MudTableSortLabel T="ZyqdCotractPiModel" SortLabel="CreateTime" InitialDirection="SortDirection.Descending">创建时间</MudTableSortLabel></MudTh>
                    <MudTh Class="@OpsCellClass">操作</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd Class="cpi-no-cell">@RowNo(context)</MudTd>
                    <MudTd>@context.ClientNo</MudTd>
                    <MudTd>@context.ClientName</MudTd>
                    <MudTd>@context.var6</MudTd>
                    <MudTd>@context.Person</MudTd>
                    <MudTd>@context.INVOICE_NO</MudTd>
                    <MudTd Class="cpi-po-cell">
                        @{
                            var po = (context.BILL_TO_PO_REF ?? "").Trim();
                        }
                        @if (po.Length > 0)
                        {
                            <MudTooltip Text="@po" Arrow="true">
                                <div class="cpi-po-text">@po</div>
                            </MudTooltip>
                        }
                        else
                        {
                            <text>-</text>
                        }
                    </MudTd>
                    <MudTd>@(string.IsNullOrWhiteSpace(context.UpdatePerson) ? "-" : context.UpdatePerson)</MudTd>
                    <MudTd>@FormatUpdateTime(context)</MudTd>
                    <MudTd Class="cpi-creator-cell">@(string.IsNullOrWhiteSpace(context.CreatePerson) ? "-" : context.CreatePerson)</MudTd>
                    <MudTd Class="cpi-createtime-cell">@FormatCreateTime(context)</MudTd>
                    <MudTd Class="@OpsCellClass">
                        <div class="@OpsGridClass">
                            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.Edit"
                                       Class="cpi-ops-btn"
                                       Href="@EditHref(context)">编辑</MudButton>
                            @if (IsCustomerPi)
                            {
                                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Secondary"
                                           StartIcon="@Icons.Material.Filled.AutoAwesome"
                                           Class="cpi-ops-btn"
                                           Disabled="_busy"
                                           OnClick="@(() => OpenGenerateAsync(context))">生成</MudButton>
                            }
                            else if (IsCustomsPi)
                            {
                                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Secondary"
                                           StartIcon="@Icons.Material.Filled.AutoAwesome"
                                           Class="cpi-ops-btn"
                                           Disabled="_busy"
                                           OnClick="@(() => GeneratePackingFromCustomsPi(context))">生成</MudButton>
                            }
                            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error"
                                       StartIcon="@Icons.Material.Filled.Delete"
                                       Class="cpi-ops-btn"
                                       Disabled="_busy"
                                       OnClick="@(() => DeleteAsync(context))">删除</MudButton>
                        </div>
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Class="pa-4">@EmptyText</MudText>
                </NoRecordsContent>
                <PagerContent>
                    <MudTablePager PageSizeOptions="new int[] { 20, 50, 100 }"
                                   RowsPerPageString="每页行数："
                                   InfoFormat="显示第 {first_item} 到第 {last_item} 条，共 {all_items} 条"/>
                </PagerContent>
            </MudTable>
        }
    </MudPaper>
</div>

<style>
    .cotract-pi-page {
        flex: 1 1 0;
        display: flex;
        flex-direction: column;
        height: 100%;
        min-height: 0;
        gap: 12px;
    }

    .cpi-toolbar-grid {
        display: grid;
        grid-template-columns: 7fr 5fr;
        gap: 8px;
        align-items: center;
        width: 100%;
        min-width: 0;
    }
    .cpi-toolbar-left,
    .cpi-toolbar-right {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
        min-width: 0;
    }
    .cpi-toolbar-left {
        justify-content: flex-start;
    }
    .cpi-toolbar-right {
        justify-content: flex-end;
    }
    .cpi-toolbar-left > *,
    .cpi-toolbar-right > * {
        flex: 0 0 auto;
    }
    .cpi-filter-select { width: 160px; }
    .cpi-filter-select-wide { width: 140px; }
    .cpi-doc-type-select { width: 160px; }
    .cpi-filter-input { width: 200px; }
    .cpi-filter-input .mud-input-control {
        width: 100%;
        margin-top: 0 !important;
    }
    .cpi-filter-date { width: 140px; }
    @@media (max-width: 960px) {
        .cpi-toolbar-grid { grid-template-columns: 1fr; }
        .cpi-toolbar-right { justify-content: flex-start; }
    }
    .cpi-doc-type-select .mud-input-slot,
    .cpi-doc-type-select input.mud-select-input {
        font-weight: 600;
    }
    .cpi-doc-type-pi .mud-input-outlined-border { border-color: #1976d2 !important; }
    .cpi-doc-type-pi .mud-input-slot,
    .cpi-doc-type-pi input.mud-select-input,
    .cpi-doc-type-pi .mud-input-label { color: #1976d2 !important; }
    .cpi-doc-type-bg .mud-input-outlined-border { border-color: #ed6c02 !important; }
    .cpi-doc-type-bg .mud-input-slot,
    .cpi-doc-type-bg input.mud-select-input,
    .cpi-doc-type-bg .mud-input-label { color: #ed6c02 !important; }
    .cpi-doc-type-ci .mud-input-outlined-border { border-color: #7b1fa2 !important; }
    .cpi-doc-type-ci .mud-input-slot,
    .cpi-doc-type-ci input.mud-select-input,
    .cpi-doc-type-ci .mud-input-label { color: #7b1fa2 !important; }
    .cpi-doc-type-pk .mud-input-outlined-border { border-color: #2e7d32 !important; }
    .cpi-doc-type-pk .mud-input-slot,
    .cpi-doc-type-pk input.mud-select-input,
    .cpi-doc-type-pk .mud-input-label { color: #2e7d32 !important; }
    .cpi-doc-type-item {
        font-weight: 600;
        min-width: 140px;
    }
    .cpi-doc-type-item.cpi-doc-type-pi { color: #1976d2; }
    .cpi-doc-type-item.cpi-doc-type-bg { color: #ed6c02; }
    .cpi-doc-type-item.cpi-doc-type-ci { color: #7b1fa2; }
    .cpi-doc-type-item.cpi-doc-type-pk { color: #2e7d32; }
    .cpi-filter-date .mud-input-control,
    .cpi-filter-date .mud-input {
        min-width: 0;
    }
    .cpi-filter-date input {
        min-width: 7.5em;
        white-space: nowrap;
    }

    .cotract-pi-table-wrap {
        flex: 1 1 0;
        min-height: 0;
        overflow: hidden;
        display: flex;
        flex-direction: column;
    }

    .cotract-pi-table {
        height: 100%;
        display: flex;
        flex-direction: column;
    }

    .cotract-pi-table .mud-table-container {
        flex: 1 1 0 !important;
        min-height: 0 !important;
        overflow: auto !important;
    }

    .cotract-pi-table .mud-table-pagination {
        flex: 0 0 auto !important;
        margin-top: auto;
        border-top: 1px solid var(--mud-palette-lines-default);
    }

    .cotract-pi-table .mud-table-head .mud-table-cell:not(.cpi-ops-cell):not(.cpi-creator-cell):not(.cpi-createtime-cell):not(.cpi-po-cell):not(.cpi-no-cell):not(:first-child),
    .cotract-pi-table .mud-table-body .mud-table-cell:not(.cpi-ops-cell):not(.cpi-creator-cell):not(.cpi-createtime-cell):not(.cpi-po-cell):not(.cpi-no-cell):not(:first-child) {
        white-space: nowrap;
        min-width: 88px;
        vertical-align: middle;
    }

    .cotract-pi-table .mud-table-cell.cpi-po-cell {
        max-width: 180px;
        min-width: 100px;
        width: 180px;
        white-space: nowrap !important;
        vertical-align: middle;
        overflow: hidden;
    }

    .cpi-po-text {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        max-width: 164px;
    }

    .cotract-pi-table .mud-table-cell:first-child,
    .cotract-pi-table .mud-table-cell.cpi-no-cell {
        position: sticky;
        z-index: 4;
        box-sizing: border-box;
        background-color: #fff !important;
        vertical-align: middle !important;
    }

    .cotract-pi-table .mud-table-head .mud-table-cell:first-child,
    .cotract-pi-table .mud-table-head .mud-table-cell.cpi-no-cell { z-index: 6; }

    .cotract-pi-table .mud-table-cell:first-child {
        left: 0;
        width: 42px !important;
        min-width: 42px !important;
        max-width: 42px !important;
        padding: 0 !important;
        text-align: center !important;
        white-space: nowrap !important;
    }
    .cotract-pi-table .mud-table-cell:first-child .mud-input-control,
    .cotract-pi-table .mud-table-cell:first-child .mud-checkbox {
        margin: 0 auto !important;
        padding: 0 !important;
        display: inline-flex !important;
        align-items: center !important;
        justify-content: center !important;
    }

    .cotract-pi-table .mud-table-cell.cpi-no-cell {
        left: 42px;
        width: 48px !important;
        min-width: 48px !important;
        max-width: 48px !important;
        padding: 0 2px !important;
        text-align: center;
        border-right: 1px solid #e0e0e0;
    }

    .cotract-pi-table.mud-table-striped .mud-table-body .mud-table-row:nth-of-type(odd) .mud-table-cell:first-child,
    .cotract-pi-table.mud-table-striped .mud-table-body .mud-table-row:nth-of-type(odd) .mud-table-cell.cpi-no-cell {
        background-color: #f5f5f5 !important;
    }

    .cotract-pi-table .mud-table-body .mud-table-row:hover .mud-table-cell:first-child,
    .cotract-pi-table .mud-table-body .mud-table-row:hover .mud-table-cell.cpi-no-cell {
        background-color: #eeeeee !important;
    }

    /* 右侧固定：创建人 | 创建时间 | 操作 */
    .cotract-pi-table .mud-table-cell.cpi-creator-cell,
    .cotract-pi-table .mud-table-cell.cpi-createtime-cell,
    .cotract-pi-table .mud-table-cell.cpi-ops-cell {
        position: sticky;
        z-index: 4;
        box-sizing: border-box;
        vertical-align: middle;
        overflow: hidden;
        background-color: #fff !important;
        white-space: nowrap;
        border-left: 1px solid #e0e0e0;
    }

    .cotract-pi-table .mud-table-cell.cpi-ops-cell {
        right: 0;
        width: 168px;
        min-width: 168px;
        max-width: 168px;
        padding: 6px 8px !important;
        white-space: normal;
    }

    /* 仅编辑+删除：单行横排，按内容收窄 */
    .cotract-pi-table .mud-table-cell.cpi-ops-cell.cpi-ops-cell--compact {
        width: 136px;
        min-width: 136px;
        max-width: 136px;
        padding: 4px 6px !important;
        white-space: nowrap;
    }

    .cotract-pi-table .mud-table-cell.cpi-createtime-cell {
        right: 168px;
        width: 156px;
        min-width: 156px;
        max-width: 156px;
        padding: 6px 8px !important;
    }

    .cotract-pi-table .mud-table-cell.cpi-creator-cell {
        right: 324px;
        width: 88px;
        min-width: 88px;
        max-width: 88px;
        padding: 6px 8px !important;
    }

    /* 操作列收窄时，左侧固定列同步右偏移 */
    .cotract-pi-table:has(.cpi-ops-cell--compact) .mud-table-cell.cpi-createtime-cell {
        right: 136px;
    }
    .cotract-pi-table:has(.cpi-ops-cell--compact) .mud-table-cell.cpi-creator-cell {
        right: 292px;
    }

    .cotract-pi-table .mud-table-head .mud-table-cell.cpi-creator-cell,
    .cotract-pi-table .mud-table-head .mud-table-cell.cpi-createtime-cell,
    .cotract-pi-table .mud-table-head .mud-table-cell.cpi-ops-cell {
        z-index: 6;
        background-color: #fff !important;
    }

    .cotract-pi-table.mud-table-striped .mud-table-body .mud-table-row:nth-of-type(odd) .mud-table-cell.cpi-creator-cell,
    .cotract-pi-table.mud-table-striped .mud-table-body .mud-table-row:nth-of-type(odd) .mud-table-cell.cpi-createtime-cell,
    .cotract-pi-table.mud-table-striped .mud-table-body .mud-table-row:nth-of-type(odd) .mud-table-cell.cpi-ops-cell {
        background-color: #f5f5f5 !important;
    }

    .cotract-pi-table .mud-table-body .mud-table-row:hover .mud-table-cell.cpi-creator-cell,
    .cotract-pi-table .mud-table-body .mud-table-row:hover .mud-table-cell.cpi-createtime-cell,
    .cotract-pi-table .mud-table-body .mud-table-row:hover .mud-table-cell.cpi-ops-cell {
        background-color: #eeeeee !important;
    }

    .cpi-ops-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        grid-template-rows: 28px 28px;
        gap: 2px 4px;
        width: 100%;
    }

    .cpi-ops-grid.cpi-ops-grid--compact {
        display: flex;
        flex-direction: row;
        flex-wrap: nowrap;
        align-items: center;
        justify-content: center;
        gap: 0;
        width: 100%;
    }

    .cpi-ops-grid .cpi-ops-btn.mud-button-root {
        min-width: 0 !important;
        width: 100%;
        height: 28px;
        padding: 0 2px !important;
        margin: 0;
        font-size: 12px;
        line-height: 28px;
        justify-content: center;
    }

    .cpi-ops-grid.cpi-ops-grid--compact .cpi-ops-btn.mud-button-root {
        width: auto;
        flex: 0 0 auto;
        min-width: auto !important;
        padding: 0 4px !important;
        white-space: nowrap;
    }

    .cpi-ops-grid .cpi-ops-btn .mud-button-label {
        font-size: 12px !important;
        white-space: nowrap !important;
    }

    .cpi-ops-grid .cpi-ops-btn .mud-icon-root {
        font-size: 16px !important;
        margin-right: 2px !important;
        flex-shrink: 0;
    }

    .cotract-pi-table .mud-table-body .mud-table-row {
        cursor: pointer;
    }
</style>

@code {
    private static readonly string[] DocumentKinds = ["客户PI", "报关PI", "客户CI", "装箱单"];

    [SupplyParameterFromQuery(Name = "type")] public string? TypeQuery { get; set; }
    [SupplyParameterFromQuery(Name = "hint")] public string? HintQuery { get; set; }

    private MudTable<ZyqdCotractPiModel>? _table;
    private bool _ready;
    private bool _busy;
    private string _documentType = "客户PI";
    private string? _appliedTypeQuery;
    private string _filterColumn = "客户编号";
    private string? _keyword;
    private DateTime? _dateStart;
    private DateTime? _dateEnd;
    private bool IsDateFilter => CotractPiFilterFields.IsDateFilter(_filterColumn);
    private List<ZyqdCotractPiModel> _rows = new();
    private HashSet<ZyqdCotractPiModel> _selected = new();
    private int _skip;
    private int _filteredTotal;
    private bool _infoFailed;
    private bool _infoWarned;
    private bool _pendingReload;
    private bool _pendingGenerateHint;
    private bool _generateHintConsumed;
    private int _currentPage;
    private int _rowsPerPage = 20;

    private bool IsCustomerPi => _documentType == "客户PI";
    private bool IsCustomsPi => _documentType == "报关PI";
    private bool IsPackingList => _documentType == "装箱单";
    private string OpsCellClass => IsCustomerPi || IsCustomsPi
        ? "cpi-ops-cell"
        : "cpi-ops-cell cpi-ops-cell--compact";
    private string OpsGridClass => IsCustomerPi || IsCustomsPi
        ? "cpi-ops-grid"
        : "cpi-ops-grid cpi-ops-grid--compact";
    private string EmptyText => _busy
        ? "加载中…"
        : IsPackingList
            ? "装箱单列表功能开发中"
            : IsCustomsPi
                ? "暂无报关PI，可从客户PI「生成」"
                : "暂无可见数据";

    private static string DocKindCss(string? kind) => kind switch
    {
        "报关PI" => "bg",
        "客户CI" => "ci",
        "装箱单" => "pk",
        _ => "pi"
    };

    private static string DocKindIcon(string? kind) => kind switch
    {
        "报关PI" => Icons.Material.Filled.LocalShipping,
        "客户CI" => Icons.Material.Filled.ReceiptLong,
        "装箱单" => Icons.Material.Filled.Inventory2,
        _ => Icons.Material.Filled.Description
    };

    protected override void OnParametersSet()
    {
        var q = (TypeQuery ?? "").Trim();
        if (q.Length == 0)
            q = "客户PI";
        if (!DocumentKinds.Contains(q, StringComparer.Ordinal))
            return;

        var queryChanged = !string.Equals(_appliedTypeQuery, q, StringComparison.Ordinal);
        _documentType = q;
        _appliedTypeQuery = q;

        var hasHint = string.Equals(HintQuery, "generate", StringComparison.OrdinalIgnoreCase);
        if (hasHint && !_generateHintConsumed)
        {
            _pendingGenerateHint = true;
            _generateHintConsumed = true;
        }
        else if (!hasHint)
        {
            _generateHintConsumed = false;
        }

        // 类型切换 / 从新建跳回：等渲染完成后再查，避免 NavigateTo 打断 ReloadServerData
        if (queryChanged || _pendingGenerateHint)
        {
            _selected.Clear();
            if (_ready || _pendingGenerateHint)
                _pendingReload = true;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_ready)
        {
            RestoreFromReturn();
            _ready = true;
            StateHasChanged();
            return;
        }

        if (!_ready || !_pendingReload)
            return;

        _pendingReload = false;
        var showHint = _pendingGenerateHint;
        _pendingGenerateHint = false;

        if (showHint)
        {
            Notify.Show(
                IsCustomsPi ? "请选择报关PI来生成装箱单" : "请选择客户PI来生成",
                Severity.Info);
        }

        await ReloadTableAsync(resetPage: true);
    }

    private void RestoreFromReturn()
    {
        var snap = ListUiStateStore.Take(LastListReturn, ListUiStateStore.Keys.CotractPi);
        if (snap is null) return;
        _rowsPerPage = snap.PageSize > 0 ? snap.PageSize : 20;
        // Extra 存单据类型；仅同类型时恢复筛选与页码
        if (!string.Equals(snap.Extra, _documentType, StringComparison.Ordinal))
            return;
        if (!string.IsNullOrWhiteSpace(snap.FilterColumn))
            _filterColumn = snap.FilterColumn!;
        _keyword = snap.Keyword;
        _dateStart = snap.DateStart;
        _dateEnd = snap.DateEnd;
        _currentPage = snap.Page < 0 ? 0 : snap.Page;
    }

    private void PersistAsync(int page, int pageSize)
        => ListUiStateStore.Capture(LastListReturn, ListUiStateStore.Keys.CotractPi, new PagedListUiState
        {
            Page = page < 0 ? 0 : page,
            PageSize = pageSize > 0 ? pageSize : 20,
            FilterColumn = _filterColumn,
            Keyword = _keyword,
            DateStart = _dateStart,
            DateEnd = _dateEnd,
            Extra = _documentType,
        });

    private void GoCustomerPiForCreateAsync()
    {
        _selected.Clear();
        _documentType = "客户PI";
        _pendingGenerateHint = true;
        _pendingReload = true;
        // 故意不写 hint 到 URL：同页切换只靠本地标记，避免二次导航打断查询
        NavManager.NavigateTo($"/contract?type={Uri.EscapeDataString("客户PI")}", replace: true);
    }

    private int RowNo(ZyqdCotractPiModel row) => _skip + _rows.IndexOf(row) + 1;

    private static string FormatCreateTime(ZyqdCotractPiModel row)
        => DateDisplay.Format(row.CreateTime, "-");

    private static string FormatUpdateTime(ZyqdCotractPiModel row)
        => DateDisplay.Format(row.UpdateTime, "-");

    private string EditHref(ZyqdCotractPiModel row)
    {
        var guid = Uri.EscapeDataString((row.DocumentGuid ?? "").Trim());
        return _documentType switch
        {
            "报关PI" => $"/contract-bg/{guid}",
            "客户CI" => $"/contract-ci/{guid}",
            _ => $"/contract-pi/{guid}"
        };
    }

    private static string Dash(string? value)
        => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private async Task OnKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await SearchAsync();
    }

    private async Task ClearAsync()
    {
        _filterColumn = "客户编号";
        _keyword = null;
        _dateStart = null;
        _dateEnd = null;
        await SearchAsync();
    }

    private void OnFilterColumnChanged(string value)
    {
        var wasDate = IsDateFilter;
        _filterColumn = value ?? "客户编号";
        if (IsDateFilter)
            _keyword = null;
        else if (wasDate)
            _dateStart = _dateEnd = null;
    }

    private async Task SearchAsync()
    {
        _selected.Clear();
        await ReloadTableAsync(resetPage: true);
    }

    private void OnDocumentTypeChanged(string value)
    {
        var next = string.IsNullOrWhiteSpace(value) ? "客户PI" : value.Trim();
        if (next == "装箱单")
        {
            NavManager.NavigateTo("/contract-pk");
            return;
        }
        if (string.Equals(_documentType, next, StringComparison.Ordinal))
            return;

        _selected.Clear();
        _documentType = next;
        _currentPage = 0;
        _pendingReload = true;
        NavManager.NavigateTo($"/contract?type={Uri.EscapeDataString(next)}", replace: true);
    }

    private void OnRowClick(TableRowClickEventArgs<ZyqdCotractPiModel> args)
    {
        if (IsPackingList || args.MouseEventArgs.Detail != 2 || args.Item is null) return;
        var guid = (args.Item.DocumentGuid ?? "").Trim();
        if (guid.Length == 0) return;
        NavManager.NavigateTo(EditHref(args.Item));
    }

    private void ClearSelection() => _selected.Clear();

    private async Task OpenGenerateAsync(ZyqdCotractPiModel row)
    {
        var guid = (row.DocumentGuid ?? "").Trim();
        if (guid.Length == 0)
        {
            Notify.Show("单据缺少编号，无法生成", Severity.Warning);
            return;
        }

        var parameters = new DialogParameters<CotractGenerateKindDialog>
        {
            { x => x.InvoiceNo, row.INVOICE_NO }
        };
        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            MaxWidth = MaxWidth.ExtraSmall,
            FullWidth = true
        };
        var dialog = await DialogService.ShowAsync<CotractGenerateKindDialog>("选择生成类型", parameters, options);
        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not string kind || kind.Length == 0)
            return;

        if (kind == "报关PI")
        {
            var type = Uri.EscapeDataString(CotractPiTypes.ToCustomsPiType(row.var6));
            NavManager.NavigateTo($"/contract-bg/new?from={Uri.EscapeDataString(guid)}&type={type}");
            return;
        }

        if (kind == "客户CI")
        {
            var type = Uri.EscapeDataString(CotractPiTypes.ToCustomerCiType(row.var6));
            NavManager.NavigateTo($"/contract-ci/new?from={Uri.EscapeDataString(guid)}&type={type}");
            return;
        }

        Notify.Show("未知的生成类型", Severity.Warning);
    }

    private void GeneratePackingFromCustomsPi(ZyqdCotractPiModel row)
    {
        var guid = (row.DocumentGuid ?? "").Trim();
        if (guid.Length == 0)
        {
            Notify.Show("单据缺少编号，无法生成装箱单", Severity.Warning);
            return;
        }

        NavManager.NavigateTo($"/contract-pk/new?from={Uri.EscapeDataString(guid)}");
    }

    private async Task ReloadTableAsync(bool resetPage)
    {
        if (_table is null) return;
        if (resetPage && _table.CurrentPage != 0)
        {
            _table.NavigateTo(MudBlazor.Page.First);
            return;
        }

        await _table.ReloadServerData();
    }

    private async Task<TableData<ZyqdCotractPiModel>> LoadServerData(TableState state, CancellationToken ct)
    {
        if (!_ready)
            return new TableData<ZyqdCotractPiModel> { Items = Array.Empty<ZyqdCotractPiModel>(), TotalItems = 0 };

        if (IsPackingList)
        {
            _rows = [];
            _filteredTotal = 0;
            _skip = 0;
            return new TableData<ZyqdCotractPiModel> { Items = Array.Empty<ZyqdCotractPiModel>(), TotalItems = 0 };
        }

        _busy = true;
        try
        {
            var query = await BuildQueryAsync();
            query.SortLabel = string.IsNullOrWhiteSpace(state.SortLabel) || state.SortDirection == SortDirection.None
                ? "CreateTime"
                : state.SortLabel;
            query.SortDescending = state.SortDirection != SortDirection.Ascending;
            var take = state.PageSize <= 0 ? 20 : state.PageSize;
            _skip = state.Page * take;
            var (rows, total) = await CotractPi.QueryPageAsync(query, _skip, take, ct);
            _rows = rows;
            _filteredTotal = total;
            _currentPage = state.Page;
            _rowsPerPage = take;
            PersistAsync(state.Page, take);
            if (_infoFailed && !_infoWarned)
            {
                _infoWarned = true;
                Notify.Show("读取人员档案失败，已按最小权限过滤", Severity.Warning);
            }
            return new TableData<ZyqdCotractPiModel> { Items = rows, TotalItems = total };
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested)
        {
            return new TableData<ZyqdCotractPiModel> { Items = _rows, TotalItems = _filteredTotal };
        }
        catch (Exception ex)
        {
            if (ct.IsCancellationRequested)
                return new TableData<ZyqdCotractPiModel> { Items = _rows, TotalItems = _filteredTotal };

            Notify.Show("加载失败：" + ex.Message, Severity.Error);
            return new TableData<ZyqdCotractPiModel> { Items = Array.Empty<ZyqdCotractPiModel>(), TotalItems = 0 };
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DeleteSelectedAsync()
    {
        if (_selected.Count == 0 || IsPackingList) return;
        var ok = await DialogService.ShowMessageBoxAsync(
            "确认删除",
            $"确定删除选中的 {_selected.Count} 张{_documentType}吗？",
            yesText: "删除",
            cancelText: "取消");
        if (ok != true) return;

        _busy = true;
        try
        {
            foreach (var row in _selected.ToList())
            {
                var (success, msg) = await CotractPi.DeleteByGuidAsync(row.DocumentGuid);
                if (!success)
                {
                    Notify.Show(msg ?? "删除失败", Severity.Error);
                    return;
                }
            }

            Notify.Show("已删除", Severity.Success);
            _selected.Clear();
            await ReloadTableAsync(resetPage: false);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DeleteAsync(ZyqdCotractPiModel row)
    {
        if (IsPackingList) return;
        var who = string.IsNullOrWhiteSpace(row.INVOICE_NO) ? (row.ClientNo ?? "该单据") : row.INVOICE_NO;
        var ok = await DialogService.ShowMessageBoxAsync(
            "确认删除",
            $"确定删除 {who} 这张{_documentType}吗？",
            yesText: "删除",
            cancelText: "取消");
        if (ok != true) return;

        _busy = true;
        try
        {
            var (success, msg) = await CotractPi.DeleteByGuidAsync(row.DocumentGuid);
            if (!success)
            {
                Notify.Show(msg ?? "删除失败", Severity.Error);
                return;
            }

            Notify.Show("已删除", Severity.Success);
            await ReloadTableAsync(resetPage: false);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task<CotractPiQueryDto> BuildQueryAsync()
    {
        var auth = await Auth.GetStoredAsync();
        var viewAll = Auth.CanManageUsers(auth);
        _infoFailed = false;
        if (!viewAll && auth is not null && !string.IsNullOrWhiteSpace(auth.EmpNo))
        {
            var (ok, _, info, _) = await UserInfo.GetAsync(auth.EmpNo);
            _infoFailed = !ok;
            viewAll = Auth.CanViewAllPiCi(auth, info);
        }

        return new CotractPiQueryDto
        {
            DocumentType = _documentType,
            FilterColumn = _filterColumn,
            Keyword = IsDateFilter ? null : _keyword,
            DateStart = IsDateFilter ? _dateStart : null,
            DateEnd = IsDateFilter ? _dateEnd : null,
            ViewAll = viewAll,
            ViewerEmpNo = auth?.EmpNo
        };
    }
}
