@code {
    [Parameter] public int Id { get; set; }
    [SupplyParameterFromQuery(Name = "edit")] public bool? EditQuery { get; set; }

    private bool _busy;
    private bool _editing;
    private string? _loadedKey;
    private ZyqdCotractBaseModel _model = new();

    private bool IsCopy => NavManager.ToBaseRelativePath(NavManager.Uri).Contains("/copy", StringComparison.OrdinalIgnoreCase);
    private bool IsCreate => Id == 0 || IsCopy;
    private bool IsReadOnly => !IsCreate && !_editing;
    private string Title => IsCopy ? "复制合同基础数据"
        : Id == 0 ? "新建合同基础数据"
        : _editing ? "编辑合同基础数据"
        : "合同基础数据详情";

    private string? HeroImagePath =>
        FirstImage(
            _model.nameplate_url,
            _model.nameplate_url2,
            _model.Customer_outer_box_logo,
            _model.Tuo_Mark_url,
            _model.Box_label_url);

    private bool HasHeroImage => !LegacyFileUrl.IsBlankOrPlaceholder(HeroImagePath);
    private bool HasNameplate1 => !LegacyFileUrl.IsBlankOrPlaceholder(_model.nameplate_url);
    private bool HasNameplate2 => !LegacyFileUrl.IsBlankOrPlaceholder(_model.nameplate_url2);

    private void OnNameplate1Changed(string? path)
    {
        if (LegacyFileUrl.IsBlankOrPlaceholder(path))
        {
            _model.nameplate_url = null;
            _model.nameplate_type = null;
        }
        else
        {
            _model.nameplate_url = path;
        }
    }

    private void OnNameplate2Changed(string? path)
    {
        if (LegacyFileUrl.IsBlankOrPlaceholder(path))
        {
            _model.nameplate_url2 = null;
            _model.nameplate_type2 = null;
        }
        else
        {
            _model.nameplate_url2 = path;
        }
    }

    /// <summary>铭牌 1/2 有图时优先显示 1，底部标注当前显示哪张。</summary>
    private string? HeroNameplateCaption
    {
        get
        {
            if (!LegacyFileUrl.IsBlankOrPlaceholder(_model.nameplate_url)
                && string.Equals(HeroImagePath, _model.nameplate_url, StringComparison.Ordinal))
                return "铭牌图片1";
            if (!LegacyFileUrl.IsBlankOrPlaceholder(_model.nameplate_url2)
                && string.Equals(HeroImagePath, _model.nameplate_url2, StringComparison.Ordinal))
                return "铭牌图片2";
            return null;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        var key = $"{Id}:{IsCopy}:{EditQuery == true}";
        if (_loadedKey == key) return;
        _loadedKey = key;
        await LoadAsync(enterEdit: IsCreate || EditQuery == true);
    }

    private async Task LoadAsync(bool enterEdit)
    {
        if (Id == 0)
        {
            _model = new ZyqdCotractBaseModel();
            var empNo = await Auth.GetCurrentEmpNoAsync();
            _model.Customer_Manager = empNo;
            _model.CreatePerson = empNo;
            _editing = true;
            return;
        }

        var row = await CotractBase.GetAsync(Id);
        if (row is null)
        {
            Notify.Show("记录不存在", Severity.Warning);
            NavManager.NavigateTo("/contract-base");
            return;
        }

        var scope = await BuildScopeAsync();
        if (!CotractBase.CanAccess(row, scope))
        {
            Notify.Show("没有这条数据的权限", Severity.Warning);
            NavManager.NavigateTo("/contract-base");
            return;
        }

        _model = row;
        SanitizeNameplates();
        if (IsCopy)
        {
            _model.Id = 0;
            _model.CreatePerson = await Auth.GetCurrentEmpNoAsync();
            _editing = true;
        }
        else
        {
            _editing = enterEdit;
        }
    }

    /// <summary>「无」等占位清成空；无图则清类型。</summary>
    private void SanitizeNameplates()
    {
        if (LegacyFileUrl.IsBlankOrPlaceholder(_model.nameplate_url))
        {
            _model.nameplate_url = null;
            _model.nameplate_type = null;
        }

        if (LegacyFileUrl.IsBlankOrPlaceholder(_model.nameplate_url2))
        {
            _model.nameplate_url2 = null;
            _model.nameplate_type2 = null;
        }
    }

    private void StartEdit() => _editing = true;

    private async Task CancelEditAsync()
    {
        if (IsCreate) return;
        _busy = true;
        try
        {
            await LoadAsync(enterEdit: false);
            if (EditQuery == true)
            {
                _loadedKey = null;
                NavManager.NavigateTo($"/contract-base/{Id}", replace: true);
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SaveAsync()
    {
        if (IsReadOnly) return;
        _busy = true;
        try
        {
            var empNo = await Auth.GetCurrentEmpNoAsync();
            var wasCreate = IsCreate;
            var (ok, msg, id) = await CotractBase.SaveAsync(_model, empNo, wasCreate);
            if (!ok)
            {
                Notify.Show(msg ?? "保存失败", Severity.Error);
                return;
            }

            Notify.Show(IsCopy ? "创建成功" : "保存成功", Severity.Success);
            if (IsCopy)
            {
            NavManager.NavigateTo("/contract-base");
                return;
            }

            if (wasCreate && id > 0)
            {
                _loadedKey = null;
                NavManager.NavigateTo($"/contract-base/{id}", replace: true);
                return;
            }

            _editing = false;
            if (EditQuery == true)
            {
                _loadedKey = null;
                NavManager.NavigateTo($"/contract-base/{Id}", replace: true);
            }
            else
            {
                await LoadAsync(enterEdit: false);
            }
        }
        catch (Exception ex)
        {
            Notify.Show("保存失败：" + ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task<CotractBaseQueryDto> BuildScopeAsync()
    {
        var auth = await Auth.GetStoredAsync();
        var viewAll = Auth.CanManageUsers(auth);
        var assigned = new List<string>();
        if (!viewAll && auth is not null && !string.IsNullOrWhiteSpace(auth.EmpNo))
        {
            var (_, _, info, _) = await UserInfo.GetAsync(auth.EmpNo);
            viewAll = Auth.CanViewAllCustomers(auth, info);
            if (!viewAll)
                assigned = await CustomerAssign.GetCodesByEmpNoAsync(auth.EmpNo);
        }

        return new CotractBaseQueryDto
        {
            ViewAllCustomers = viewAll,
            ViewerEmpNo = auth?.EmpNo,
            AssignedCustomerCodes = assigned
        };
    }

    private static string? FirstImage(params string?[] paths)
        => paths.FirstOrDefault(p => !LegacyFileUrl.IsBlankOrPlaceholder(p));

    private static bool IsBlank(string? value) => string.IsNullOrWhiteSpace(value);
    private static string Display(string? value) => IsBlank(value) ? "—" : value!.Trim();
    private static string FormatDate(DateTime? dt)
        => DateDisplay.Format(dt);
}
