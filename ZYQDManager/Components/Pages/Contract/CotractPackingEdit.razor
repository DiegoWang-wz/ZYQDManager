@code {
    [Parameter] public string? DocumentGuid { get; set; }
    [SupplyParameterFromQuery(Name = "from")] public string? FromPiGuid { get; set; }

    private bool _loading = true;
    private bool _busy;
    private bool _isCreate;
    private ZyqdCustomsAndPackingModel _header = new();
    private List<CustomsAndPackingLineDto> _lines = [];
    private int _tempSeq;
    private CustomsAndPackingLineDto? _splitLine;
    private double _splitQty;
    private bool _selectAll;
    private bool _mergeOpen;
    private List<CustomsAndPackingLineDto> _mergeCandidates = [];
    private int _mergePrimaryTempId;
    private string? _mergePalletCode;
    private string? _mergeTailSize;
    private double _mergeOffsetX;
    private double _mergeOffsetY;
    private bool _mergeDragging;
    private double _mergeDragStartX;
    private double _mergeDragStartY;
    private double _mergeDragOriginX;
    private double _mergeDragOriginY;

    private string MergeCardStyle
        => $"left:50%;top:18vh;transform:translate(calc(-50% + {_mergeOffsetX.ToString(System.Globalization.CultureInfo.InvariantCulture)}px), {_mergeOffsetY.ToString(System.Globalization.CultureInfo.InvariantCulture)}px);";
    private string? _productClientNo;
    private ZyqdCotractBaseModel? _selectedProduct;
    private List<ZyqdCotractBaseModel> _products = [];

    private bool CanConfirmMerge
        => _mergePrimaryTempId > 0
           && !string.IsNullOrWhiteSpace(_mergePalletCode)
           && !string.IsNullOrWhiteSpace(_mergeTailSize);

    private bool IsDirectCreate => _isCreate && string.IsNullOrWhiteSpace(FromPiGuid);
    private string Title => _isCreate
        ? (IsDirectCreate ? "新建装箱单（直接制作）" : "新建装箱单（来自报关PI）")
        : "编辑装箱单";

    private static readonly string[] TradeTermOptions = ["EXW", "FOB", "CIF", "DDP", "DAP", "DDU", "C&F"];
    private static readonly string[] EncasementMethodOptions = ["整箱", "拼箱"];
    private static readonly string[] BoxTypeOptions = ["20GP", "40GP", "40HQ", "20OT", "40OT"];
    private static readonly string[] ShippingMethodOptions = ["海运", "空运", "快递", "铁路"];
    private static readonly string[] ShippingHeadsOptions =
    [
        "浙江捷昌线性驱动科技股份有限公司",
        "新昌县捷昌进出口有限公司"
    ];

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        try
        {
            var pathGuid = (DocumentGuid ?? "").Trim();
            var from = (FromPiGuid ?? "").Trim();
            if (string.Equals(pathGuid, "new", StringComparison.OrdinalIgnoreCase) || pathGuid.Length == 0)
            {
                _isCreate = true;
                if (from.Length > 0)
                    await LoadFromPiAsync(from);
                else
                    await LoadBlankAsync();
            }
            else
            {
                _isCreate = false;
                await LoadExistingAsync(pathGuid);
            }
        }
        finally { _loading = false; }
    }

    private async Task LoadBlankAsync()
    {
        var empNo = await Auth.GetCurrentEmpNoAsync() ?? "";
        _header = Packing.CreateBlankHeader(empNo);
        _lines = [];
        _tempSeq = 0;
        _productClientNo = "";
        _selectedProduct = null;
        _products = [];
        RefreshSummary();
    }

    private async Task LoadFromPiAsync(string piGuid)
    {
        var rows = await Packing.LoadDraftFromCustomsPiAsync(piGuid);
        if (rows.Count == 0)
        {
            Notify.Show("未找到 PI 或明细为空", Severity.Warning);
            _header = new ZyqdCustomsAndPackingModel { var6 = "报关PI", packing_list_type = "总箱单" };
            _lines = [];
            _tempSeq = 0;
            SyncProductClientFromHeader();
            return;
        }
        ApplyRows(rows);
        await CotractBase.ApplyNameplateTypesAsync(_header.ClientNo, _lines);
        SyncProductClientFromHeader();
    }

    private async Task LoadExistingAsync(string guid)
    {
        var rows = await Packing.GetByGuidAsync(guid);
        if (rows.Count == 0)
        {
            Notify.Show("装箱单不存在", Severity.Warning);
            NavManager.NavigateTo("/contract-pk");
            return;
        }
        ApplyRows(rows);
        await CotractBase.ApplyNameplateTypesAsync(_header.ClientNo, _lines);
    }

    private void ApplyRows(List<ZyqdCustomsAndPackingModel> rows)
    {
        _header = rows[0];
        if (string.IsNullOrWhiteSpace(_header.packing_list_type))
            _header.packing_list_type = "总箱单";
        _tempSeq = 0;
        _lines = rows.Select(x => CustomsAndPackingService.ToLineDto(x, ++_tempSeq)).ToList();
        CustomsAndPackingCalc.RecalcAllLines(_lines);
        RefreshSummary();
        SyncProductClientFromHeader();
    }

    private void SyncProductClientFromHeader()
    {
        var no = CotractPiTypes.NormalizeClientNo(_header.ClientNo);
        if (no.Length > 0)
            _productClientNo = no;
    }

    private Task OnHeaderClientKey(KeyboardEventArgs e)
        => e.Key is "Enter" or "NumpadEnter" ? OnHeaderClientBlurAsync() : Task.CompletedTask;

    private async Task OnHeaderClientBlurAsync()
    {
        var no = CotractPiTypes.NormalizeClientNo(_header.ClientNo);
        _header.ClientNo = no;
        if (no.Length == 0) return;

        if (string.IsNullOrWhiteSpace(_productClientNo))
            _productClientNo = no;

        try
        {
            var bill = await Crm.GetBillToAsync(no);
            if (bill is not null)
            {
                if (string.IsNullOrWhiteSpace(_header.ClientName))
                    _header.ClientName = bill.ClientName;
                if (string.IsNullOrWhiteSpace(_header.Customer_destination_country)
                    && !string.IsNullOrWhiteSpace(bill.Country))
                    _header.Customer_destination_country = bill.Country;
            }
        }
        catch (Exception ex)
        {
            Notify.Show(ex.Message, Severity.Warning);
        }

        await LoadProductsAsync(showNotify: false);
    }

    private Task OnProductKey(KeyboardEventArgs e)
        => e.Key is "Enter" or "NumpadEnter" ? LoadProductsAsync(showNotify: true) : Task.CompletedTask;

    private async Task LoadProductsAsync(bool showNotify = true)
    {
        var no = CotractPiTypes.NormalizeClientNo(
            string.IsNullOrWhiteSpace(_productClientNo) ? _header.ClientNo : _productClientNo);
        _productClientNo = no;
        _selectedProduct = null;
        if (no.Length == 0)
        {
            _products = [];
            if (showNotify)
                Notify.Show("请先填写产品客户号", Severity.Warning);
            return;
        }

        _products = await CotractBase.ListByClientNoAsync(no);
        if (!showNotify) return;

        if (_products.Count == 0)
            Notify.Show($"未查到客户 {no} 的合同基础信息", Severity.Warning);
        else
            Notify.Show($"已查到客户 {no} 的合同基础信息，共 {_products.Count} 条", Severity.Success);
    }

    private Task<IEnumerable<ZyqdCotractBaseModel>> SearchProductsAsync(string? text, CancellationToken ct)
    {
        ct.ThrowIfCancellationRequested();
        if (_products.Count == 0)
            return Task.FromResult(Enumerable.Empty<ZyqdCotractBaseModel>());

        var k = (text ?? "").Trim();
        IEnumerable<ZyqdCotractBaseModel> q = _products;
        if (k.Length > 0)
        {
            q = _products.Where(p =>
                ContainsIgnoreCase(p.materialNo, k)
                || ContainsIgnoreCase(p.materialName, k)
                || ContainsIgnoreCase(p.materiaCust, k)
                || ContainsIgnoreCase(p.materialModel, k)
                || ProductLabel(p).Contains(k, StringComparison.OrdinalIgnoreCase));
        }

        return Task.FromResult(q.Take(80));
    }

    private static bool ContainsIgnoreCase(string? source, string keyword)
        => !string.IsNullOrWhiteSpace(source)
           && source.Contains(keyword, StringComparison.OrdinalIgnoreCase);

    private static string ProductLabel(ZyqdCotractBaseModel p)
    {
        var no = (p.materialNo ?? "").Trim();
        var name = (p.materialName ?? "").Trim();
        var cust = (p.materiaCust ?? "").Trim();
        if (cust.Length > 0)
            return $"{no} / {name} / {cust}";
        return $"{no} / {name}";
    }

    private async Task AddLineFromBaseAsync()
    {
        if (_selectedProduct is null || _selectedProduct.Id <= 0) return;
        // ListByClientNo 仅投影下拉展示字段，打包/打托等需按 Id 取完整基础数据
        var row = await CotractBase.GetAsync(_selectedProduct.Id);
        if (row is null)
        {
            Notify.Show("产品不存在", Severity.Warning);
            return;
        }

        if (string.IsNullOrWhiteSpace(_header.ClientNo))
            _header.ClientNo = CotractPiTypes.NormalizeClientNo(row.ClientNo);
        if (string.IsNullOrWhiteSpace(_header.ClientName))
            _header.ClientName = row.ClientName;
        if (string.IsNullOrWhiteSpace(_header.Customer_destination_country))
            _header.Customer_destination_country = row.Customer_destination_country;

        var line = new CustomsAndPackingLineDto
        {
            TempId = ++_tempSeq,
            var7 = "原始行",
            materialNo = row.materialNo,
            materialName = row.materialName,
            materialType = row.materialType,
            materialModel = row.materiaCust,
            materiaSpecs = row.materiaSpecs,
            materiaPowered = row.materiaPowered,
            materiaColor = row.materiaColor,
            materiaCust = row.materiaCust,
            price = row.price,
            qty = 0,
            currency_unit = row.currency_unit,
            Packing_method = row.Packing_method,
            Packing_method_unit = row.Packing_method_unit,
            Carton_Size = row.Carton_Size,
            Pallet_Size = row.Pallet_Size,
            palletizing_method = row.palletizing_method,
            palletizing_method_unit = row.palletizing_method_unit,
            Net_weight = row.Net_weight,
            gross_weight = row.gross_weight,
            var4 = row.var4,
            SAP_order_NO = row.SAP_order_NO,
            Client_poNo = row.Client_poNo,
            PI_Material_Name = row.materialName,
            Customer_outer_box_logo = row.Customer_outer_box_logo,
            Tuo_Mark = row.Tuo_Mark,
            Tuo_Mark_url = row.Tuo_Mark_url,
            Box_label = row.Box_label,
            Box_label_url = row.Box_label_url,
            Box_label2 = row.Box_label2,
            Box_label_url2 = row.Box_label_url2,
            nameplate_url = row.nameplate_url,
            nameplate_type = NameplateTypes.Normalize(row.nameplate_type),
            nameplate_url2 = row.nameplate_url2,
            nameplate_type2 = NameplateTypes.Normalize(row.nameplate_type2),
            Customer_destination_country = _header.Customer_destination_country
        };
        CustomsAndPackingCalc.RecalcLine(line);
        _lines.Add(line);
        _selectedProduct = null;
        RefreshSummary();
    }

    private void RemoveLine(CustomsAndPackingLineDto line)
    {
        // 删除拆分行：数量加回原行（本会话有 SplitFromTempId；否则同物料「原始行」）
        if (string.Equals(line.var7, "拆分行", StringComparison.Ordinal))
        {
            var origin = line.SplitFromTempId is int fromId and > 0
                ? _lines.FirstOrDefault(x => x.TempId == fromId && !ReferenceEquals(x, line))
                : null;
            origin ??= _lines.FirstOrDefault(x =>
                !ReferenceEquals(x, line)
                && string.Equals(LineMergeKey(x), LineMergeKey(line), StringComparison.OrdinalIgnoreCase)
                && (string.Equals(x.var7, "原始行", StringComparison.Ordinal)
                    || string.IsNullOrWhiteSpace(x.var7)));

            if (origin is not null)
            {
                var back = line.qty;
                origin.qty += back;
                CustomsAndPackingCalc.RecalcLine(origin);
                Notify.Show($"已删除拆分行，数量 {back.ToString("0.##")} 已加回原行", Severity.Success);
            }
        }

        _lines.Remove(line);
        RefreshSummary();
    }

    private void OnLineChanged(CustomsAndPackingLineDto line, Action apply)
    {
        apply();
        CustomsAndPackingCalc.RecalcLine(line);
        RefreshSummary();
    }

    private void RefreshSummary()
        => CustomsAndPackingCalc.ApplySummary(_header, _lines);

    private void OpenSplit(CustomsAndPackingLineDto line)
    {
        _splitLine = line;
        _splitQty = 0; // 不自动填，由用户输入
    }

    private void CloseSplit()
    {
        _splitLine = null;
        _splitQty = 0;
    }

    private void OnSelectAllChanged(bool value)
    {
        _selectAll = value;
        foreach (var line in _lines)
            line.Selected = value;
    }

    private void SyncSelectAll()
        => _selectAll = _lines.Count > 0 && _lines.All(x => x.Selected);

    private void OpenMergePallet()
    {
        _mergeCandidates = _lines.Where(x => x.Selected).ToList();
        if (_mergeCandidates.Count < 2)
        {
            Notify.Show("请至少勾选 2 行再拼托", Severity.Warning);
            return;
        }
        _mergePrimaryTempId = _mergeCandidates[0].TempId;
        _mergePalletCode = _mergeCandidates
            .Select(x => (x.Pallet_code ?? "").Trim())
            .FirstOrDefault(x => x.Length > 0);
        _mergeTailSize = _mergeCandidates
            .Select(x => (x.var2 ?? "").Trim())
            .FirstOrDefault(x => x.Length > 0);
        _mergeOffsetX = 0;
        _mergeOffsetY = 0;
        _mergeDragging = false;
        _mergeOpen = true;
    }

    private void CloseMergePallet()
    {
        _mergeOpen = false;
        _mergeDragging = false;
        _mergeCandidates = [];
        _mergePrimaryTempId = 0;
        _mergePalletCode = null;
        _mergeTailSize = null;
        _mergeOffsetX = 0;
        _mergeOffsetY = 0;
    }

    private void BeginMergeDrag(PointerEventArgs e)
    {
        _mergeDragging = true;
        _mergeDragStartX = e.ClientX;
        _mergeDragStartY = e.ClientY;
        _mergeDragOriginX = _mergeOffsetX;
        _mergeDragOriginY = _mergeOffsetY;
    }

    private void OnMergePointerMove(PointerEventArgs e)
    {
        if (!_mergeDragging) return;
        _mergeOffsetX = _mergeDragOriginX + (e.ClientX - _mergeDragStartX);
        _mergeOffsetY = _mergeDragOriginY + (e.ClientY - _mergeDragStartY);
    }

    private void EndMergeDrag(PointerEventArgs e) => _mergeDragging = false;

    private void ConfirmMergePallet()
    {
        var code = (_mergePalletCode ?? "").Trim();
        var tail = (_mergeTailSize ?? "").Trim();
        if (_mergePrimaryTempId <= 0)
        {
            Notify.Show("请选择托主物料", Severity.Warning);
            return;
        }
        if (code.Length == 0)
        {
            Notify.Show("请填写托盘编号", Severity.Warning);
            return;
        }
        if (tail.Length == 0)
        {
            Notify.Show("请填写尾托尺寸", Severity.Warning);
            return;
        }
        var primary = _mergeCandidates.FirstOrDefault(x => x.TempId == _mergePrimaryTempId);
        if (primary is null)
        {
            Notify.Show("请选择托主物料", Severity.Warning);
            return;
        }

        // 若编号已被其它组占用，先拆开旧组
        foreach (var line in _lines)
        {
            if (string.Equals((line.Pallet_code ?? "").Trim(), code, StringComparison.Ordinal)
                && !_mergeCandidates.Contains(line))
            {
                line.Pallet_code = null;
                line.var8 = null;
                line.var2 = null;
            }
        }

        foreach (var line in _mergeCandidates)
        {
            var isPrimary = line.TempId == primary.TempId;
            line.Pallet_code = code;
            line.var8 = isPrimary
                ? CustomsAndPackingCalc.MergeRolePrimary
                : CustomsAndPackingCalc.MergeRoleMember;
            // 尾托尺寸只落在托主上（拼托余量尺寸）
            line.var2 = isPrimary ? tail : null;
            line.Selected = false;
            CustomsAndPackingCalc.RecalcLine(line);
        }

        SyncSelectAll();
        RefreshSummary();
        CloseMergePallet();
        Notify.Show($"已拼托：编号 {code}，托主 {primary.materialNo}", Severity.Success);
    }

    private void CancelMergePallet()
    {
        var selected = _lines.Where(x => x.Selected).ToList();
        if (selected.Count == 0)
        {
            Notify.Show("请勾选要取消拼托的行", Severity.Warning);
            return;
        }

        var codes = selected
            .Select(x => (x.Pallet_code ?? "").Trim())
            .Where(x => x.Length > 0)
            .Distinct(StringComparer.Ordinal)
            .ToHashSet(StringComparer.Ordinal);

        if (codes.Count == 0 && selected.All(x => string.IsNullOrWhiteSpace(x.var8)))
        {
            Notify.Show("勾选行未处于拼托状态", Severity.Warning);
            return;
        }

        var n = 0;
        foreach (var line in _lines)
        {
            var code = (line.Pallet_code ?? "").Trim();
            var inGroup = codes.Contains(code)
                          || (selected.Contains(line) && !string.IsNullOrWhiteSpace(line.var8));
            if (!inGroup) continue;
            line.Pallet_code = null;
            line.var8 = null;
            line.var2 = null;
            line.var4 = null;
            line.Selected = false;
            CustomsAndPackingCalc.RecalcLine(line);
            n++;
        }

        SyncSelectAll();
        RefreshSummary();
        Notify.Show(n > 0 ? $"已取消 {n} 行拼托" : "没有可取消的拼托行", Severity.Success);
    }

    /// <summary>
    /// 合并勾选行（拆分的逆操作）：须同一物料号，数量加总到保留行，删除其余行。
    /// </summary>
    private void MergeSelectedLines()
    {
        var selected = _lines.Where(x => x.Selected).ToList();
        if (selected.Count < 2)
        {
            Notify.Show("请至少勾选 2 行再合并", Severity.Warning);
            return;
        }

        var keys = selected
            .Select(LineMergeKey)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
        if (keys.Count > 1 || keys[0].Length == 0)
        {
            Notify.Show("只能合并同一物料号的行", Severity.Warning);
            return;
        }

        var packingKeys = selected
            .Select(x => (x.Packing_method ?? "").Trim() + "|" + (x.palletizing_method ?? "").Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
        if (packingKeys.Count > 1)
        {
            Notify.Show("勾选行的打包/打托方式不一致，无法合并", Severity.Warning);
            return;
        }

        // 优先保留「原始行」，否则保留勾选中的第一行
        var keep = selected.FirstOrDefault(x =>
                       string.Equals(x.var7, "原始行", StringComparison.Ordinal)
                       || string.IsNullOrWhiteSpace(x.var7))
                   ?? selected[0];
        var others = selected.Where(x => x.TempId != keep.TempId).ToList();

        // 合并前解除这些行所在的拼托组，避免残留托主/挂靠
        var mergeCodes = selected
            .Select(x => (x.Pallet_code ?? "").Trim())
            .Where(x => x.Length > 0)
            .Distinct(StringComparer.Ordinal)
            .ToHashSet(StringComparer.Ordinal);
        if (mergeCodes.Count > 0 || selected.Any(x => !string.IsNullOrWhiteSpace(x.var8)))
        {
            foreach (var line in _lines)
            {
                var code = (line.Pallet_code ?? "").Trim();
                if (mergeCodes.Contains(code)
                    || (selected.Contains(line) && !string.IsNullOrWhiteSpace(line.var8)))
                {
                    line.Pallet_code = null;
                    line.var8 = null;
                    line.var2 = null;
                }
            }
        }

        keep.qty = selected.Sum(x => x.qty);
        keep.emit = FormatMergedEmit(selected);
        keep.var7 = "原始行";
        keep.Pallet_code = null;
        keep.var8 = null;
        keep.var2 = null;
        keep.Selected = false;
        CustomsAndPackingCalc.RecalcLine(keep);

        foreach (var line in others)
            _lines.Remove(line);

        SyncSelectAll();
        RefreshSummary();
        Notify.Show($"已合并为 1 行，数量 {keep.qty.ToString("0.##")}（{keep.materialNo}）", Severity.Success);
    }

    private static string LineMergeKey(CustomsAndPackingLineDto line)
    {
        var no = (line.materialNo ?? "").Trim();
        if (no.Length > 0) return no;
        return ((line.materialName ?? "").Trim() + "|" + (line.materialModel ?? "").Trim()).Trim('|');
    }

    private static string? FormatMergedEmit(IReadOnlyList<CustomsAndPackingLineDto> lines)
    {
        double sum = 0;
        var any = false;
        foreach (var line in lines)
        {
            if (string.IsNullOrWhiteSpace(line.emit)) continue;
            if (!double.TryParse(line.emit.Trim(), out var n)) continue;
            sum += n;
            any = true;
        }
        return any ? sum.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) : lines[0].emit;
    }

    private void ConfirmSplit()
    {
        if (_splitLine is null) return;
        var original = _splitLine.qty;
        if (_splitQty <= 0)
        {
            Notify.Show("拆分数量必须大于0", Severity.Warning);
            return;
        }
        if (_splitQty >= original)
        {
            Notify.Show("拆分数量必须小于原数量", Severity.Warning);
            return;
        }

        var idx = _lines.IndexOf(_splitLine);
        _splitLine.qty = original - _splitQty;
        CustomsAndPackingCalc.RecalcLine(_splitLine);
        var neu = CustomsAndPackingCalc.CloneForSplit(_splitLine, ++_tempSeq, _splitQty);
        if (idx >= 0 && idx < _lines.Count - 1)
            _lines.Insert(idx + 1, neu);
        else
            _lines.Add(neu);
        RefreshSummary();
        CloseSplit();
    }

    private async Task SaveAsync()
    {
        if (_lines.Count == 0)
        {
            Notify.Show("请至少保留一行明细", Severity.Warning);
            return;
        }

        foreach (var line in _lines.Where(x => CustomsAndPackingCalc.IsMergePrimary(x.var8)
                                               || CustomsAndPackingCalc.IsMergeMember(x.var8)))
        {
            if (string.IsNullOrWhiteSpace(line.Pallet_code))
            {
                Notify.Show($"物料 {line.materialNo} 已拼托但未填托盘编号，请补全后再保存", Severity.Warning);
                return;
            }
        }
        foreach (var primary in _lines.Where(x => CustomsAndPackingCalc.IsMergePrimary(x.var8)))
        {
            if (string.IsNullOrWhiteSpace(primary.var2))
            {
                Notify.Show($"托主 {primary.materialNo} 未填尾托尺寸，请补全后再保存", Severity.Warning);
                return;
            }
        }

        CustomsAndPackingCalc.RecalcAllLines(_lines);
        RefreshSummary();
        _busy = true;
        try
        {
            var auth = await Auth.GetStoredAsync();
            var (ok, msg, guid) = await Packing.SaveAsync(_header, _lines, auth?.EmpNo, _isCreate);
            if (!ok)
            {
                Notify.Show(msg ?? "保存失败", Severity.Error);
                return;
            }
            Notify.Show("保存成功", Severity.Success);
            if (_isCreate && !string.IsNullOrWhiteSpace(guid))
                NavManager.NavigateTo($"/contract-pk/{guid}", replace: true);
            else
                await LoadExistingAsync(guid ?? _header.DocumentGuid ?? "");
        }
        catch (Exception ex)
        {
            Notify.Show("保存失败：" + ex.Message, Severity.Error);
        }
        finally { _busy = false; }
    }

    private async Task ExportExcelAsync(string type)
    {
        if (_isCreate)
        {
            Notify.Show("请先保存再导出", Severity.Warning);
            return;
        }

        if (type is "报关" or "生产")
        {
            var issues = await PackingExcel.FindMissingNameplateTypesAsync(_header.DocumentGuid);
            if (issues.Count > 0)
            {
                var go = await DialogService.ShowMessageBoxAsync(
                    "无法导出",
                    CustomsAndPackingExcelService.FormatNameplateTypeIssues(issues)
                    + "\n\n点击「去维护」打开对应合同基础数据。",
                    yesText: "去维护",
                    cancelText: "关闭");
                if (go == true)
                {
                    var first = issues[0];
                    if (first.BaseId is int id and > 0)
                        NavManager.NavigateTo($"/contract-base/{id}?edit=true");
                    else
                        NavManager.NavigateTo("/contract-base");
                }

                return;
            }
        }

        _busy = true;
        Notify.Show($"正在生成 Excel（{type}）…", Severity.Info);
        await InvokeAsync(StateHasChanged);
        try
        {
            var xlsx = await PackingExcel.BuildAsync(_header.DocumentGuid, type);
            await JS.InvokeVoidAsync(
                "downloadFileFromBase64",
                CustomsAndPackingExcelService.DownloadExcelName(_header, type),
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
                Convert.ToBase64String(xlsx));
            Notify.Show("Excel 已导出", Severity.Success);
        }
        catch (Exception ex)
        {
            Notify.Show("导出 Excel 失败：" + ex.Message, Severity.Error);
        }
        finally { _busy = false; }
    }
