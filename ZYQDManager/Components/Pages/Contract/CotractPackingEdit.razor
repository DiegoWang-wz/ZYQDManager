@page "/contract-pk/new"
@page "/contract-pk/{DocumentGuid}"
@rendermode InteractiveServer
@inject CustomsAndPackingService Packing
@inject CustomsAndPackingExcelService PackingExcel
@inject CentralAuthService Auth
@inject IJSRuntime JS

<PageTitle>@Title</PageTitle>

<div class="cpk-edit-page">
    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary"/>
    }
    else
    {
        <MudPaper Class="pa-3 cpk-header-panel" Outlined="true">
            <div class="cpk-form-grid">
                <MudTextField @bind-Value="_header.ClientNo" Label="客户编号" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="_busy"/>
                <MudTextField @bind-Value="_header.ClientName" Label="客户名称" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="_busy"/>
                <MudTextField @bind-Value="_header.Customer_destination_country" Label="目的国" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="_busy"/>
                <MudTextField @bind-Value="_header.PIcotract_code" Label="PI合同号" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="_busy"/>
                <MudTextField @bind-Value="_header.Person" Label="需求人" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="_busy"/>
                <MudTextField @bind-Value="_header.Shipping_heads_up" Label="出运抬头" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="_busy"/>
                <MudTextField @bind-Value="_header.delivery_time" Label="货好时间" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="_busy"/>
                <MudTextField @bind-Value="_header.Trade_Term" Label="贸易术语" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="_busy"/>
                <MudTextField @bind-Value="_header.packing_list_type" Label="箱单类型" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="_busy"/>
                <MudTextField @bind-Value="_header.Shipping_method" Label="出货方式" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="_busy"/>
                <MudTextField @bind-Value="_header.encasement_method" Label="装箱方式" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="_busy"/>
                <MudTextField @bind-Value="_header.Box_type_quantity" Label="箱型箱量" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="_busy"/>
                <div class="cpk-form-actions">
                    <MudMenu Dense="true" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                        <ActivatorContent>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy || _isCreate"
                                       StartIcon="@Icons.Material.Filled.TableView"
                                       EndIcon="@Icons.Material.Filled.ArrowDropDown"
                                       OnClick="context.ToggleAsync">
                                导出Excel
                            </MudButton>
                        </ActivatorContent>
                        <ChildContent>
                            <MudMenuItem OnClick="@(() => ExportExcelAsync("报关"))">报关</MudMenuItem>
                            <MudMenuItem OnClick="@(() => ExportExcelAsync("生产"))">生产</MudMenuItem>
                            <MudMenuItem OnClick="@(() => ExportExcelAsync("客户"))">客户</MudMenuItem>
                        </ChildContent>
                    </MudMenu>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="zyqd-btn-save"
                               StartIcon="@Icons.Material.Filled.Save"
                               OnClick="SaveAsync" Disabled="_busy">
                        @(_busy ? "保存中…" : "保存")
                    </MudButton>
                </div>
            </div>
        </MudPaper>

        <MudPaper Class="pa-1 cpk-lines-panel" Outlined="true">
            <MudTable T="CustomsAndPackingLineDto" Items="_lines" Dense="true" Hover="true" Bordered="true"
                      Breakpoint="Breakpoint.None" Elevation="0" Class="cpk-line-table"
                      Height="100%">
                <HeaderContent>
                    <MudTh>客户外箱标识</MudTh>
                    <MudTh>客户PO号</MudTh>
                    <MudTh>客户型号</MudTh>
                    <MudTh>SAP订单</MudTh>
                    <MudTh>铭牌1</MudTh>
                    <MudTh>铭牌2</MudTh>
                    <MudTh>物料号</MudTh>
                    <MudTh>物料名</MudTh>
                    <MudTh>数量</MudTh>
                    <MudTh>打包方式</MudTh>
                    <MudTh>打包单位</MudTh>
                    <MudTh>箱数</MudTh>
                    <MudTh>尾箱量</MudTh>
                    <MudTh>打托方式</MudTh>
                    <MudTh>打托单位</MudTh>
                    <MudTh>整托数</MudTh>
                    <MudTh>不足托箱</MudTh>
                    <MudTh>尾托尺寸</MudTh>
                    <MudTh>尾托打托</MudTh>
                    <MudTh>纸箱尺寸</MudTh>
                    <MudTh>托盘尺寸</MudTh>
                    <MudTh>净重</MudTh>
                    <MudTh>毛重</MudTh>
                    <MudTh>总净重</MudTh>
                    <MudTh>总毛重</MudTh>
                    <MudTh>托重</MudTh>
                    <MudTh>体积</MudTh>
                    <MudTh>散发</MudTh>
                    <MudTh>行类型</MudTh>
                    <MudTh Style="width:120px">操作</MudTh>
                </HeaderContent>
                <RowTemplate>
                    @{
                        var line = context;
                    }
                    <MudTd Class="cpk-img-cell">
                        <CpkLineImg Label="客户外箱标识"
                                    Value="@line.Customer_outer_box_logo"
                                    ValueChanged="v => line.Customer_outer_box_logo = v"
                                    ReadOnly="_busy"/>
                    </MudTd>
                    <MudTd>
                        <CpkFitText Value="@line.Client_poNo" ValueChanged="v => line.Client_poNo = v" Disabled="_busy"/>
                    </MudTd>
                    <MudTd>
                        <CpkFitText Value="@line.materialModel" ValueChanged="v => line.materialModel = v" Disabled="_busy"/>
                    </MudTd>
                    <MudTd>
                        <CpkFitText Value="@line.SAP_order_NO" ValueChanged="v => line.SAP_order_NO = v" Disabled="_busy" MinChars="8"/>
                    </MudTd>
                    <MudTd Class="cpk-img-cell">
                        <CpkLineImg Label="铭牌1"
                                    Value="@line.nameplate_url"
                                    ValueChanged="v => line.nameplate_url = v"
                                    ReadOnly="_busy"/>
                    </MudTd>
                    <MudTd Class="cpk-img-cell">
                        <CpkLineImg Label="铭牌2"
                                    Value="@line.nameplate_url2"
                                    ValueChanged="v => line.nameplate_url2 = v"
                                    ReadOnly="_busy"/>
                    </MudTd>
                    <MudTd>
                        <CpkFitText Value="@line.materialNo" ValueChanged="v => line.materialNo = v" Disabled="_busy"/>
                    </MudTd>
                    <MudTd>
                        <CpkFitText Value="@line.materialName" ValueChanged="v => line.materialName = v" Disabled="_busy" MinChars="8"/>
                    </MudTd>
                    <MudTd>
                        <CpkFitNum Value="line.qty" ValueChanged="v => OnLineChanged(line, () => line.qty = v)" Disabled="_busy"/>
                    </MudTd>
                    <MudTd>
                        <CpkFitText Value="@line.Packing_method"
                                    ValueChanged="v => OnLineChanged(line, () => line.Packing_method = v)"
                                    Disabled="_busy"/>
                    </MudTd>
                    <MudTd>
                        <CpkFitText Value="@line.Packing_method_unit"
                                    ValueChanged="v => line.Packing_method_unit = v"
                                    Disabled="_busy"/>
                    </MudTd>
                    <MudTd>
                        <CpkFitNum Value="line.box_qty" ReadOnly="true"/>
                    </MudTd>
                    <MudTd>
                        <CpkFitText Value="@(line.var1 ?? "0")" ReadOnly="true"/>
                    </MudTd>
                    <MudTd>
                        <CpkFitText Value="@line.palletizing_method"
                                    ValueChanged="v => OnLineChanged(line, () => line.palletizing_method = v)"
                                    Disabled="_busy"/>
                    </MudTd>
                    <MudTd>
                        <CpkFitText Value="@line.palletizing_method_unit"
                                    ValueChanged="v => line.palletizing_method_unit = v"
                                    Disabled="_busy"/>
                    </MudTd>
                    <MudTd>
                        <CpkFitNum Value="line.Pallet_qty" ReadOnly="true"/>
                    </MudTd>
                    <MudTd>
                        <CpkFitText Value="@(line.var3 ?? "0")" ReadOnly="true"/>
                    </MudTd>
                    <MudTd>
                        <CpkFitText Value="@line.var2"
                                    ValueChanged="v => OnLineChanged(line, () => line.var2 = v)"
                                    Disabled="_busy" Placeholder="长*宽*高"/>
                    </MudTd>
                    <MudTd>
                        <CpkFitText Value="@line.var4" ValueChanged="v => line.var4 = v" Disabled="_busy"/>
                    </MudTd>
                    <MudTd>
                        <CpkFitText Value="@line.Carton_Size"
                                    ValueChanged="v => OnLineChanged(line, () => line.Carton_Size = v)"
                                    Disabled="_busy"/>
                    </MudTd>
                    <MudTd>
                        <CpkFitText Value="@line.Pallet_Size"
                                    ValueChanged="v => OnLineChanged(line, () => line.Pallet_Size = v)"
                                    Disabled="_busy"/>
                    </MudTd>
                    <MudTd>
                        <CpkFitNum Value="line.Net_weight" ValueChanged="v => OnLineChanged(line, () => line.Net_weight = v)" Disabled="_busy"/>
                    </MudTd>
                    <MudTd>
                        <CpkFitNum Value="line.gross_weight" ValueChanged="v => OnLineChanged(line, () => line.gross_weight = v)" Disabled="_busy"/>
                    </MudTd>
                    <MudTd>
                        <CpkFitNum Value="line.total_Net_weight" ReadOnly="true"/>
                    </MudTd>
                    <MudTd>
                        <CpkFitNum Value="line.total_gross_weight" ReadOnly="true"/>
                    </MudTd>
                    <MudTd>
                        <CpkFitNum Value="line.Pallet_weight" ReadOnly="true"/>
                    </MudTd>
                    <MudTd>
                        <CpkFitNum Value="line.volume" ReadOnly="true"/>
                    </MudTd>
                    <MudTd>
                        <CpkFitText Value="@line.emit"
                                    ValueChanged="v => OnLineChanged(line, () => line.emit = v)"
                                    Disabled="_busy"/>
                    </MudTd>
                    <MudTd>@(line.var7 ?? "原始行")</MudTd>
                    <MudTd>
                        <MudStack Row="true" Spacing="0">
                            @if (string.Equals(line.var7, "原始行", StringComparison.Ordinal) || string.IsNullOrWhiteSpace(line.var7))
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.CallSplit" Size="Size.Small" Color="Color.Primary"
                                               Title="拆分此行" Disabled="_busy || line.qty <= 1"
                                               OnClick="@(() => OpenSplit(line))"/>
                            }
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                           Disabled="_busy" OnClick="@(() => RemoveLine(line))"/>
                        </MudStack>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </MudPaper>

        <MudPaper Class="pa-3 cpk-summary-panel" Outlined="true">
            <MudStack Row="true" Spacing="3" Class="cpk-summary" Wrap="Wrap.Wrap">
                <MudText Typo="Typo.body2">总数量：@_header.all_qty.ToString("0.##")</MudText>
                <MudText Typo="Typo.body2">总箱数：@_header.all_box_qty.ToString("0.##")</MudText>
                <MudText Typo="Typo.body2">总托数：@_header.all_Pallet_qty.ToString("0.##")</MudText>
                <MudText Typo="Typo.body2">不足托箱：@(_header.var5 ?? "0")</MudText>
                <MudText Typo="Typo.body2">总净重：@_header.all_total_Net_weight.ToString("0.##")</MudText>
                <MudText Typo="Typo.body2">总毛重：@_header.all_total_gross_weight.ToString("0.##")</MudText>
                <MudText Typo="Typo.body2">总体积：@_header.all_volume.ToString("0.##")</MudText>
                <MudText Typo="Typo.body2">散发合计：@(_header.all_emit ?? "0")</MudText>
            </MudStack>
        </MudPaper>
    }
</div>

@if (_splitLine is not null)
{
    <div class="cpk-split-mask">
        <MudPaper Class="pa-4 cpk-split-card" Elevation="8">
            <MudText Typo="Typo.h6" Class="mb-2">拆分此行</MudText>
            <MudText Class="mb-3">原数量：@_splitLine.qty.ToString("0.##")</MudText>
            <MudNumericField T="double" @bind-Value="_splitQty" Label="拆出数量（须小于原数量）"
                             Margin="Margin.Dense" Variant="Variant.Outlined" Min="1" HideSpinButtons="true"/>
            <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="1" Class="mt-3">
                <MudButton OnClick="CloseSplit" Disabled="_busy">取消</MudButton>
                <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="ConfirmSplit" Disabled="_busy">确认拆分</MudButton>
            </MudStack>
        </MudPaper>
    </div>
}

<style>
    .cpk-edit-page {
        flex: 1 1 0;
        display: flex;
        flex-direction: column;
        height: 100%;
        min-height: 0;
        overflow: hidden;
        gap: 8px;
    }
    .cpk-header-panel,
    .cpk-summary-panel {
        flex: 0 0 auto;
    }
    .cpk-lines-panel {
        flex: 1 1 0;
        min-height: 0;
        overflow: hidden;
        display: flex;
        flex-direction: column;
    }
    .cpk-form-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
        gap: 8px 12px;
        align-items: end;
    }
    .cpk-form-actions {
        grid-column: auto / -1;
        display: flex !important;
        flex-direction: row !important;
        flex-wrap: nowrap !important;
        align-items: center;
        justify-content: flex-end;
        gap: 8px;
        min-height: 40px;
        width: 100%;
    }
    .cpk-form-actions > * {
        flex: 0 0 auto !important;
        width: auto !important;
        display: inline-flex !important;
    }
    .cpk-form-actions .mud-button-root {
        width: auto !important;
    }
    .cpk-line-table {
        flex: 1 1 0 !important;
        min-height: 0 !important;
        height: 100% !important;
        display: flex !important;
        flex-direction: column !important;
        overflow: hidden !important;
    }
    .cpk-line-table .mud-table-container {
        flex: 1 1 0 !important;
        min-height: 0 !important;
        max-height: none !important;
        overflow: auto !important;
    }
    .cpk-line-table .mud-table-head .mud-table-cell {
        position: sticky;
        top: 0;
        z-index: 5;
        background-color: var(--mud-palette-surface, #fff) !important;
        box-shadow: 0 1px 0 var(--mud-palette-lines-default, #e0e0e0);
        white-space: nowrap;
        text-align: center !important;
    }
    .cpk-line-table table {
        table-layout: auto !important;
        width: max-content !important;
        min-width: 100%;
    }
    .cpk-line-table .mud-table-body .mud-table-cell {
        white-space: nowrap;
        vertical-align: middle;
        text-align: center !important;
        width: 1%;
        padding: 4px 6px !important;
    }
    .cpk-line-table .mud-table-body .mud-table-cell > * {
        margin-left: auto;
        margin-right: auto;
    }
    .cpk-img-cell {
        min-width: 104px;
        width: auto !important;
        vertical-align: middle !important;
        white-space: normal !important;
        text-align: center !important;
    }
    .cpk-split-mask {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,.35);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1300;
    }
    .cpk-split-card { width: min(420px, 92vw); }
</style>

@code {
    [Parameter] public string? DocumentGuid { get; set; }
    [SupplyParameterFromQuery(Name = "from")] public string? FromPiGuid { get; set; }

    private bool _loading = true;
    private bool _busy;
    private bool _isCreate;
    private ZyqdCustomsAndPackingModel _header = new();
    private List<CustomsAndPackingLineDto> _lines = [];
    private int _tempSeq;
    private CustomsAndPackingLineDto? _splitLine;
    private double _splitQty;

    private string Title => _isCreate ? "新建装箱单" : "编辑装箱单";

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        try
        {
            var pathGuid = (DocumentGuid ?? "").Trim();
            var from = (FromPiGuid ?? "").Trim();
            if (string.Equals(pathGuid, "new", StringComparison.OrdinalIgnoreCase) || pathGuid.Length == 0)
            {
                _isCreate = true;
                if (from.Length > 0)
                    await LoadFromPiAsync(from);
                else
                {
                    Notify.Show("请先从客户PI列表选择要生成装箱单的单据", Severity.Warning);
                    NavManager.NavigateTo($"/contract?type={Uri.EscapeDataString("客户PI")}&hint=generate");
                    return;
                }
            }
            else
            {
                _isCreate = false;
                await LoadExistingAsync(pathGuid);
            }
        }
        finally { _loading = false; }
    }

    private async Task LoadFromPiAsync(string piGuid)
    {
        var rows = await Packing.LoadDraftFromCustomsPiAsync(piGuid);
        if (rows.Count == 0)
        {
            Notify.Show("未找到 PI 或明细为空", Severity.Warning);
            _header = new ZyqdCustomsAndPackingModel { var6 = "报关PI", packing_list_type = "总箱单" };
            _lines = [];
            return;
        }
        ApplyRows(rows);
    }

    private async Task LoadExistingAsync(string guid)
    {
        var rows = await Packing.GetByGuidAsync(guid);
        if (rows.Count == 0)
        {
            Notify.Show("装箱单不存在", Severity.Warning);
            NavManager.NavigateTo("/contract-pk");
            return;
        }
        ApplyRows(rows);
    }

    private void ApplyRows(List<ZyqdCustomsAndPackingModel> rows)
    {
        _header = rows[0];
        if (string.IsNullOrWhiteSpace(_header.packing_list_type))
            _header.packing_list_type = "总箱单";
        _tempSeq = 0;
        _lines = rows.Select(x => CustomsAndPackingService.ToLineDto(x, ++_tempSeq)).ToList();
        CustomsAndPackingCalc.RecalcAllLines(_lines);
        RefreshSummary();
    }

    private void AddLine()
    {
        _lines.Add(new CustomsAndPackingLineDto
        {
            TempId = ++_tempSeq,
            var7 = "原始行",
            Customer_destination_country = _header.Customer_destination_country
        });
        RefreshSummary();
    }

    private void RemoveLine(CustomsAndPackingLineDto line)
    {
        _lines.Remove(line);
        RefreshSummary();
    }

    private void OnLineChanged(CustomsAndPackingLineDto line, Action apply)
    {
        apply();
        CustomsAndPackingCalc.RecalcLine(line);
        RefreshSummary();
    }

    private void RefreshSummary()
        => CustomsAndPackingCalc.ApplySummary(_header, _lines);

    private void OpenSplit(CustomsAndPackingLineDto line)
    {
        _splitLine = line;
        _splitQty = Math.Floor(line.qty / 2);
        if (_splitQty < 1) _splitQty = 1;
    }

    private void CloseSplit()
    {
        _splitLine = null;
        _splitQty = 0;
    }

    private void ConfirmSplit()
    {
        if (_splitLine is null) return;
        var original = _splitLine.qty;
        if (_splitQty <= 0)
        {
            Notify.Show("拆分数量必须大于0", Severity.Warning);
            return;
        }
        if (_splitQty >= original)
        {
            Notify.Show("拆分数量必须小于原数量", Severity.Warning);
            return;
        }

        var idx = _lines.IndexOf(_splitLine);
        _splitLine.qty = original - _splitQty;
        CustomsAndPackingCalc.RecalcLine(_splitLine);
        var neu = CustomsAndPackingCalc.CloneForSplit(_splitLine, ++_tempSeq, _splitQty);
        if (idx >= 0 && idx < _lines.Count - 1)
            _lines.Insert(idx + 1, neu);
        else
            _lines.Add(neu);
        RefreshSummary();
        CloseSplit();
    }

    private async Task SaveAsync()
    {
        if (_lines.Count == 0)
        {
            Notify.Show("请至少保留一行明细", Severity.Warning);
            return;
        }
        CustomsAndPackingCalc.RecalcAllLines(_lines);
        RefreshSummary();
        _busy = true;
        try
        {
            var auth = await Auth.GetStoredAsync();
            var (ok, msg, guid) = await Packing.SaveAsync(_header, _lines, auth?.EmpNo, _isCreate);
            if (!ok)
            {
                Notify.Show(msg ?? "保存失败", Severity.Error);
                return;
            }
            Notify.Show("保存成功", Severity.Success);
            if (_isCreate && !string.IsNullOrWhiteSpace(guid))
                NavManager.NavigateTo($"/contract-pk/{guid}", replace: true);
            else
                await LoadExistingAsync(guid ?? _header.DocumentGuid ?? "");
        }
        catch (Exception ex)
        {
            Notify.Show("保存失败：" + ex.Message, Severity.Error);
        }
        finally { _busy = false; }
    }

    private async Task ExportExcelAsync(string type)
    {
        if (_isCreate)
        {
            Notify.Show("请先保存再导出", Severity.Warning);
            return;
        }
        _busy = true;
        Notify.Show($"正在生成 Excel（{type}）…", Severity.Info);
        await InvokeAsync(StateHasChanged);
        try
        {
            var xlsx = await PackingExcel.BuildAsync(_header.DocumentGuid, type);
            await JS.InvokeVoidAsync(
                "downloadFileFromBase64",
                CustomsAndPackingExcelService.DownloadExcelName(_header, type),
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
                Convert.ToBase64String(xlsx));
            Notify.Show("Excel 已导出", Severity.Success);
        }
        catch (Exception ex)
        {
            Notify.Show("导出 Excel 失败：" + ex.Message, Severity.Error);
        }
        finally { _busy = false; }
    }
}
