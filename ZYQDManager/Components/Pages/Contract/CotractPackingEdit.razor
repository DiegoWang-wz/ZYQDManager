@page "/contract-pk/new"
@page "/contract-pk/{DocumentGuid}"
@rendermode InteractiveServer
@inject CustomsAndPackingService Packing
@inject CustomsAndPackingExcelService PackingExcel
@inject CotractBaseService CotractBase
@inject CrmCustomerService Crm
@inject CentralAuthService Auth
@inject IJSRuntime JS

<PageTitle>@Title</PageTitle>

<div class="cpk-edit-page">
    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary"/>
    }
    else
    {
        <MudPaper Class="pa-3 cpk-header-panel" Outlined="true">
            <div class="cpk-form-grid">
                <MudTextField @bind-Value="_header.ClientNo"
                              Label="客户编号"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Disabled="_busy"
                              Immediate="true"
                              OnKeyUp="OnHeaderClientKey"
                              OnBlur="OnHeaderClientBlurAsync"/>
                <MudTextField @bind-Value="_header.ClientName" Label="客户名称" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="_busy"/>
                <MudTextField @bind-Value="_header.Customer_destination_country" Label="目的国" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="_busy"/>
                <MudTextField @bind-Value="_header.PIcotract_code" Label="PI合同号" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="_busy"
                              Placeholder="@(IsDirectCreate ? "可选（直接制作可不填）" : null)"/>
                <MudTextField @bind-Value="_header.CreatePerson" Label="创建人" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="_busy" ReadOnly="true"/>
                <MudSelect T="string" @bind-Value="_header.Shipping_heads_up" Label="出运抬头" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Disabled="_busy">
                    @foreach (var o in ShippingHeadsOptions)
                    {
                        <MudSelectItem Value="@o">@o</MudSelectItem>
                    }
                </MudSelect>
                <MudTextField @bind-Value="_header.delivery_time" Label="货好时间" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="_busy"/>
                <MudSelect T="string" @bind-Value="_header.Trade_Term" Label="贸易术语" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Disabled="_busy">
                    @foreach (var o in TradeTermOptions)
                    {
                        <MudSelectItem Value="@o">@o</MudSelectItem>
                    }
                </MudSelect>
                <MudTextField @bind-Value="_header.packing_list_type" Label="箱单类型" Variant="Variant.Outlined" Margin="Margin.Dense" ReadOnly="true" Disabled="_busy"/>
                <MudSelect T="string" @bind-Value="_header.Shipping_method" Label="出货方式" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Disabled="_busy">
                    @foreach (var o in ShippingMethodOptions)
                    {
                        <MudSelectItem Value="@o">@o</MudSelectItem>
                    }
                </MudSelect>
                <MudSelect T="string" @bind-Value="_header.encasement_method" Label="装箱方式" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Disabled="_busy">
                    @foreach (var o in EncasementMethodOptions)
                    {
                        <MudSelectItem Value="@o">@o</MudSelectItem>
                    }
                </MudSelect>
                <MudSelect T="string" @bind-Value="_header.Box_type_quantity" Label="箱型箱量" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Clearable="true" Disabled="_busy">
                    @foreach (var o in BoxTypeOptions)
                    {
                        <MudSelectItem Value="@o">@o</MudSelectItem>
                    }
                </MudSelect>
                <div class="cpk-form-actions">
                    <MudMenu Dense="true" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                        <ActivatorContent>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy || _isCreate"
                                       StartIcon="@Icons.Material.Filled.TableView"
                                       EndIcon="@Icons.Material.Filled.ArrowDropDown"
                                       OnClick="context.ToggleAsync">
                                导出Excel
                            </MudButton>
                        </ActivatorContent>
                        <ChildContent>
                            <MudMenuItem OnClick="@(() => ExportExcelAsync("报关"))">报关</MudMenuItem>
                            <MudMenuItem OnClick="@(() => ExportExcelAsync("生产"))">生产</MudMenuItem>
                            <MudMenuItem OnClick="@(() => ExportExcelAsync("客户"))">客户</MudMenuItem>
                        </ChildContent>
                    </MudMenu>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="zyqd-btn-save"
                               StartIcon="@Icons.Material.Filled.Save"
                               OnClick="SaveAsync" Disabled="_busy">
                        @(_busy ? "保存中…" : "保存")
                    </MudButton>
                </div>
            </div>
        </MudPaper>

        <MudPaper Class="pa-2 cpk-picker-panel" Outlined="true">
            <MudGrid Spacing="2" Class="cpk-picker-grid align-center">
                <MudItem xs="12" md="7" Class="cpk-picker-left-col">
                    <div class="cpk-picker-left">
                        <MudTextField @bind-Value="_productClientNo"
                                      Label="产品客户号"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Dense="true"
                                      Immediate="true"
                                      Class="cpk-picker-client"
                                      Disabled="_busy"
                                      OnKeyUp="OnProductKey"
                                      OnBlur="@(() => LoadProductsAsync(showNotify: false))"
                                      Placeholder="回车查询"/>
                        <MudAutocomplete T="ZyqdCotractBaseModel"
                                         @bind-Value="_selectedProduct"
                                         Label="选择产品"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         Dense="true"
                                         Class="cpk-picker-product"
                                         Disabled="_busy"
                                         Clearable="true"
                                         ResetValueOnEmptyText="true"
                                         MaxItems="80"
                                         SearchFunc="SearchProductsAsync"
                                         ToStringFunc="@(p => p is null ? "" : ProductLabel(p))"
                                         Placeholder="@(_products.Count == 0 ? "先填客户号回车" : "输入物料号/名称/型号筛选")"/>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Add"
                                   Class="cpk-picker-add"
                                   Disabled="_busy || _selectedProduct is null"
                                   OnClick="AddLineFromBaseAsync">
                            添加
                        </MudButton>
                    </div>
                </MudItem>
                <MudItem xs="12" md="5" Class="cpk-picker-right-col">
                    <div class="cpk-picker-ops">
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.MergeType"
                                   OnClick="OpenMergePallet" Disabled="_busy">
                            拼托
                        </MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Default"
                                   StartIcon="@Icons.Material.Filled.LinkOff"
                                   OnClick="CancelMergePallet" Disabled="_busy">
                            取消拼托
                        </MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Secondary"
                                   StartIcon="@Icons.Material.Filled.CallMerge"
                                   Class="cpk-icon-dir-right"
                                   OnClick="MergeSelectedLines" Disabled="_busy">
                            合并
                        </MudButton>
                    </div>
                </MudItem>
            </MudGrid>
        </MudPaper>

        <MudPaper Class="pa-1 cpk-lines-panel" Outlined="true">
            <MudTable T="CustomsAndPackingLineDto" Items="_lines" Dense="true" Hover="true" Bordered="true"
                      Breakpoint="Breakpoint.None" Elevation="0" Class="cpk-line-table"
                      Height="100%">
                <HeaderContent>
                    <MudTh Style="width:40px">
                        <MudCheckBox T="bool" Dense="true" Value="_selectAll" ValueChanged="OnSelectAllChanged"
                                     Disabled="_busy"/>
                    </MudTh>
                    <MudTh>客户外箱标识</MudTh>
                    <MudTh>客户PO号</MudTh>
                    <MudTh>客户型号</MudTh>
                    <MudTh>SAP订单</MudTh>
                    <MudTh>铭牌1</MudTh>
                    <MudTh>铭牌1类型</MudTh>
                    <MudTh>铭牌2</MudTh>
                    <MudTh>铭牌2类型</MudTh>
                    <MudTh Class="cpk-sticky-l1">物料号</MudTh>
                    <MudTh Class="cpk-sticky-l2">物料名</MudTh>
                    <MudTh Class="cpk-sticky-l3">数量</MudTh>
                    <MudTh>打包方式</MudTh>
                    <MudTh>打包单位</MudTh>
                    <MudTh>箱数</MudTh>
                    <MudTh>尾箱量</MudTh>
                    <MudTh>纸箱尺寸</MudTh>
                    <MudTh>托盘尺寸</MudTh>
                    <MudTh>打托方式</MudTh>
                    <MudTh>打托单位</MudTh>
                    <MudTh>整托数</MudTh>
                    <MudTh>不足托箱</MudTh>
                    <MudTh>尾托尺寸</MudTh>
                    <MudTh>尾托打托</MudTh>
                    <MudTh>净重</MudTh>
                    <MudTh>毛重</MudTh>
                    <MudTh>总净重</MudTh>
                    <MudTh>总毛重</MudTh>
                    <MudTh>托重</MudTh>
                    <MudTh>体积</MudTh>
                    <MudTh>托盘编号</MudTh>
                    <MudTh>散发</MudTh>
                    <MudTh>行类型</MudTh>
                    <MudTh Class="cpk-sticky-ops">操作</MudTh>
                </HeaderContent>
                <RowTemplate>
                    @{
                        var line = context;
                        var mergeMember = CustomsAndPackingCalc.IsMergeMember(line.var8);
                    }
                    <MudTd>
                        <MudCheckBox T="bool" Dense="true" Value="line.Selected"
                                     ValueChanged="v => { line.Selected = v; SyncSelectAll(); }"
                                     Disabled="_busy"/>
                    </MudTd>
                    <MudTd Class="cpk-img-cell">
                        <CpkLineImg Label="客户外箱标识"
                                    Value="@line.Customer_outer_box_logo"
                                    ReadOnly="true"/>
                    </MudTd>
                    <MudTd>
                        <CpkFitText Value="@line.Client_poNo" ValueChanged="v => line.Client_poNo = v" Disabled="_busy"/>
                    </MudTd>
                    <MudTd>
                        <CpkFitText Value="@line.materialModel" ReadOnly="true" MinChars="6"/>
                    </MudTd>
                    <MudTd>
                        <CpkFitText Value="@line.SAP_order_NO" ValueChanged="v => line.SAP_order_NO = v" Disabled="_busy" MinChars="8"/>
                    </MudTd>
                    <MudTd Class="cpk-img-cell">
                        <CpkLineImg Label="铭牌1" Value="@line.nameplate_url" ReadOnly="true"/>
                    </MudTd>
                    <MudTd>
                        <CpkFitText Value="@line.nameplate_type" ReadOnly="true" MinChars="4"/>
                    </MudTd>
                    <MudTd Class="cpk-img-cell">
                        <CpkLineImg Label="铭牌2" Value="@line.nameplate_url2" ReadOnly="true"/>
                    </MudTd>
                    <MudTd>
                        <CpkFitText Value="@line.nameplate_type2" ReadOnly="true" MinChars="4"/>
                    </MudTd>
                    <MudTd Class="cpk-sticky-l1">
                        <div class="cpk-sticky-clip">
                            <CpkFitText Value="@line.materialNo" ReadOnly="true"/>
                        </div>
                    </MudTd>
                    <MudTd Class="cpk-sticky-l2">
                        <div class="cpk-sticky-clip">
                            <CpkFitText Value="@line.materialName" ReadOnly="true" MinChars="8"/>
                        </div>
                    </MudTd>
                    <MudTd Class="cpk-sticky-l3">
                        <div class="cpk-sticky-clip">
                            <CpkFitNum Value="line.qty" ValueChanged="v => OnLineChanged(line, () => line.qty = v)" Disabled="_busy"/>
                        </div>
                    </MudTd>
                    <MudTd>
                        <CpkFitText Value="@line.Packing_method" ReadOnly="true"/>
                    </MudTd>
                    <MudTd>
                        <CpkFitText Value="@line.Packing_method_unit" ReadOnly="true"/>
                    </MudTd>
                    <MudTd>
                        <CpkFitNum Value="line.box_qty" ReadOnly="true"/>
                    </MudTd>
                    <MudTd>
                        <CpkFitText Value="@(line.var1 ?? "0")" ReadOnly="true"/>
                    </MudTd>
                    <MudTd>
                        <CpkFitText Value="@line.Carton_Size" ReadOnly="true"/>
                    </MudTd>
                    <MudTd>
                        @if (mergeMember)
                        {
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">拼托（见主行）</MudText>
                        }
                        else
                        {
                            <CpkFitText Value="@line.Pallet_Size"
                                        ValueChanged="v => OnLineChanged(line, () => line.Pallet_Size = v)"
                                        Disabled="_busy"/>
                        }
                    </MudTd>
                    <MudTd>
                        <CpkFitText Value="@line.palletizing_method"
                                    ValueChanged="v => OnLineChanged(line, () => line.palletizing_method = v)"
                                    Disabled="_busy"/>
                    </MudTd>
                    <MudTd>
                        <CpkFitText Value="@line.palletizing_method_unit"
                                    ValueChanged="v => line.palletizing_method_unit = v"
                                    Disabled="_busy"/>
                    </MudTd>
                    <MudTd>
                        <CpkFitNum Value="line.Pallet_qty" ReadOnly="true"/>
                    </MudTd>
                    <MudTd>
                        <CpkFitText Value="@(line.var3 ?? "0")" ReadOnly="true"/>
                    </MudTd>
                    <MudTd>
                        @if (mergeMember)
                        {
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">—</MudText>
                        }
                        else
                        {
                            <CpkFitText Value="@line.var2"
                                        ValueChanged="v => OnLineChanged(line, () => line.var2 = v)"
                                        Disabled="_busy" Placeholder="长*宽*高"/>
                        }
                    </MudTd>
                    <MudTd>
                        <CpkFitText Value="@line.var4" ValueChanged="v => line.var4 = v" Disabled="_busy"/>
                    </MudTd>
                    <MudTd>
                        <CpkFitNum Value="line.Net_weight" ReadOnly="true"/>
                    </MudTd>
                    <MudTd>
                        <CpkFitNum Value="line.gross_weight" ReadOnly="true"/>
                    </MudTd>
                    <MudTd>
                        <CpkFitNum Value="line.total_Net_weight" ReadOnly="true"/>
                    </MudTd>
                    <MudTd>
                        <CpkFitNum Value="line.total_gross_weight" ReadOnly="true"/>
                    </MudTd>
                    <MudTd>
                        <CpkFitNum Value="line.Pallet_weight" ReadOnly="true"/>
                    </MudTd>
                    <MudTd>
                        <CpkFitNum Value="line.volume" ReadOnly="true"/>
                    </MudTd>
                    <MudTd>
                        <CpkFitText Value="@line.Pallet_code"
                                    ValueChanged="v => line.Pallet_code = v"
                                    Disabled="_busy"
                                    MinChars="6"/>
                    </MudTd>
                    <MudTd>
                        <CpkFitText Value="@line.emit"
                                    ValueChanged="v => OnLineChanged(line, () => line.emit = v)"
                                    Disabled="_busy"/>
                    </MudTd>
                    <MudTd>
                        @(line.var7 ?? "原始行")
                        @if (!string.IsNullOrWhiteSpace(line.var8))
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Info" Class="ml-1">@line.var8</MudChip>
                        }
                    </MudTd>
                    <MudTd Class="cpk-sticky-ops">
                        <div class="cpk-sticky-clip cpk-ops-clip">
                            <MudStack Row="true" Spacing="0" Class="cpk-ops-stack">
                                @if (string.Equals(line.var7, "原始行", StringComparison.Ordinal) || string.IsNullOrWhiteSpace(line.var7))
                                {
                                    <MudIconButton Icon="@Icons.Material.Filled.CallSplit" Size="Size.Small" Color="Color.Primary"
                                                   Class="cpk-icon-dir-right"
                                                   Title="拆分此行" Disabled="_busy || line.qty <= 1"
                                                   OnClick="@(() => OpenSplit(line))"/>
                                }
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                               Disabled="_busy" OnClick="@(() => RemoveLine(line))"/>
                            </MudStack>
                        </div>
                    </MudTd>
                </RowTemplate>
                <FooterContent>
                    <MudTd></MudTd>
                    <MudTd Class="cpk-summary-label">数据汇总</MudTd>
                    <MudTd></MudTd>
                    <MudTd></MudTd>
                    <MudTd></MudTd>
                    <MudTd></MudTd>
                    <MudTd></MudTd>
                    <MudTd></MudTd>
                    <MudTd></MudTd>
                    <MudTd Class="cpk-sticky-l1"></MudTd>
                    <MudTd Class="cpk-sticky-l2"></MudTd>
                    <MudTd Class="cpk-sticky-l3">
                        <div class="cpk-sticky-clip">
                            <CpkFitNum Value="_header.all_qty" ReadOnly="true"/>
                        </div>
                    </MudTd>
                    <MudTd></MudTd>
                    <MudTd></MudTd>
                    <MudTd><CpkFitNum Value="_header.all_box_qty" ReadOnly="true"/></MudTd>
                    <MudTd></MudTd>
                    <MudTd></MudTd>
                    <MudTd></MudTd>
                    <MudTd></MudTd>
                    <MudTd></MudTd>
                    <MudTd><CpkFitNum Value="_header.all_Pallet_qty" ReadOnly="true"/></MudTd>
                    <MudTd><CpkFitText Value="@(_header.var5 ?? "0")" ReadOnly="true"/></MudTd>
                    <MudTd></MudTd>
                    <MudTd></MudTd>
                    <MudTd></MudTd>
                    <MudTd></MudTd>
                    <MudTd><CpkFitNum Value="_header.all_total_Net_weight" ReadOnly="true"/></MudTd>
                    <MudTd><CpkFitNum Value="_header.all_total_gross_weight" ReadOnly="true"/></MudTd>
                    <MudTd></MudTd>
                    <MudTd><CpkFitNum Value="_header.all_volume" ReadOnly="true"/></MudTd>
                    <MudTd></MudTd>
                    <MudTd><CpkFitText Value="@(_header.all_emit ?? "0")" ReadOnly="true"/></MudTd>
                    <MudTd></MudTd>
                    <MudTd Class="cpk-sticky-ops"></MudTd>
                </FooterContent>
            </MudTable>
        </MudPaper>
    }
</div>

@if (_splitLine is not null)
{
    <div class="cpk-split-mask">
        <MudPaper Class="pa-4 cpk-split-card" Elevation="8">
            <MudText Typo="Typo.h6" Class="mb-2">拆分此行</MudText>
            <MudText Class="mb-3">原数量：@_splitLine.qty.ToString("0.##")</MudText>
            <MudNumericField T="double" @bind-Value="_splitQty" Label="拆出数量（须大于0且小于原数量）"
                             Margin="Margin.Dense" Variant="Variant.Outlined" HideSpinButtons="true"/>
            <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="1" Class="mt-3">
                <MudButton OnClick="CloseSplit" Disabled="_busy">取消</MudButton>
                <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="ConfirmSplit" Disabled="_busy">确认拆分</MudButton>
            </MudStack>
        </MudPaper>
    </div>
}

@if (_mergeOpen)
{
    <div class="cpk-float-mask @(_mergeDragging ? "cpk-float-mask-drag" : null)"
         @onpointermove="OnMergePointerMove"
         @onpointerup="EndMergeDrag"
         @onpointercancel="EndMergeDrag"></div>
    <MudPaper Class="pa-4 cpk-merge-card cpk-float-card" Elevation="8" Style="@MergeCardStyle">
        <div class="cpk-float-title"
             @onpointerdown="BeginMergeDrag"
             @onpointermove="OnMergePointerMove"
             @onpointerup="EndMergeDrag">
            <MudText Typo="Typo.h6">拼托</MudText>
            <MudText Typo="Typo.caption" Class="cpk-float-tip">按住标题拖动，可对照表格尺寸</MudText>
        </div>
        <MudSelect T="int" @bind-Value="_mergePrimaryTempId" Label="拼入（托主物料）*"
                   Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Class="mb-3">
            @foreach (var c in _mergeCandidates)
            {
                <MudSelectItem Value="@c.TempId">
                    @(c.materialNo) / @(c.materialName) × @c.qty.ToString("0.##")
                    @if (!string.IsNullOrWhiteSpace(c.Pallet_Size))
                    {
                        <text> （@c.Pallet_Size）</text>
                    }
                </MudSelectItem>
            }
        </MudSelect>
        <MudTextField @bind-Value="_mergePalletCode" Label="托盘编号*" Variant="Variant.Outlined"
                      Margin="Margin.Dense" Class="mb-3" Required="true" Immediate="true"/>
        <MudTextField @bind-Value="_mergeTailSize" Label="尾托尺寸*" Variant="Variant.Outlined"
                      Margin="Margin.Dense" Class="mb-3" Required="true" Immediate="true" Placeholder="长*宽*高"/>
        <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="1">
            <MudButton OnClick="CloseMergePallet" Disabled="_busy">取消</MudButton>
            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="ConfirmMergePallet"
                       Disabled="_busy || !CanConfirmMerge">确认拼托</MudButton>
        </MudStack>
    </MudPaper>
}

<style>
    .cpk-edit-page {
        flex: 1 1 0;
        display: flex;
        flex-direction: column;
        height: 100%;
        min-height: 0;
        overflow: hidden;
        gap: 8px;
    }
    .cpk-header-panel {
        flex: 0 0 auto;
    }
    .cpk-picker-panel { flex: 0 0 auto; }
    .cpk-picker-grid { width: 100%; margin: 0 !important; }
    .cpk-picker-left-col,
    .cpk-picker-right-col {
        display: flex !important;
        align-items: center;
        min-width: 0;
    }
    .cpk-picker-left {
        display: flex;
        align-items: center;
        gap: 8px;
        width: 100%;
        min-width: 0;
    }
    /* 客户号、添加固定宽；产品选择器吃掉左侧剩余 */
    .cpk-picker-client { width: 120px; flex: 0 0 120px; }
    .cpk-picker-product {
        flex: 1 1 auto !important;
        min-width: 0 !important;
        width: auto !important;
        max-width: none !important;
    }
    .cpk-picker-left > .mud-input-control {
        margin-top: 0 !important;
        margin-bottom: 0 !important;
    }
    .cpk-picker-product.mud-input-control,
    .cpk-picker-product .mud-input-control {
        width: 100% !important;
        max-width: none !important;
    }
    .cpk-picker-add {
        flex: 0 0 auto;
        white-space: nowrap;
    }
    .cpk-picker-right-col { justify-content: flex-end; }
    .cpk-picker-ops {
        display: flex;
        align-items: center;
        gap: 8px;
        flex: 0 0 auto;
        flex-wrap: wrap;
        justify-content: flex-end;
    }
    /* 汇总行钉在滚动区底部，纵向滚动时始终可见 */
    .cpk-line-table .mud-table-foot .mud-table-cell {
        position: sticky;
        bottom: 0;
        z-index: 5;
        background-color: var(--mud-palette-background-grey, #f5f5f5) !important;
        font-weight: 600;
        white-space: nowrap;
        vertical-align: middle;
        text-align: center !important;
        padding: 4px 6px !important;
        box-shadow: 0 -1px 0 var(--mud-palette-lines-default, #e0e0e0);
    }
