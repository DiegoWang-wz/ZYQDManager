@page "/contract-base"
@rendermode InteractiveServer
@inject CotractBaseService CotractBase
@inject CentralAuthService Auth
@inject CentralUserInformationService UserInfo
@inject UserCustomerAssignService CustomerAssign
@inject IConfiguration Config
@inject IJSRuntime JS
@inject LastListReturnService LastListReturn

<PageTitle>合同基础数据</PageTitle>

<div class="cotract-base-page">
    <MudPaper Class="pa-3" Outlined="true">
        <div class="cb-toolbar-grid">
            <div class="cb-toolbar-left">
                <MudSelect T="string"
                           Value="_filterColumn"
                           ValueChanged="OnFilterColumnChanged"
                           Label="条件"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Class="cb-filter-select"
                           MaxHeight="420">
                    @foreach (var field in CotractBaseFilterFields.All)
                    {
                        <MudSelectItem Value="@field.Key">@field.Label</MudSelectItem>
                    }
                </MudSelect>
                @if (IsDateFilter)
                {
                    <MudDatePicker @bind-Date="_dateStart"
                                   Label="开始"
                                   DateFormat="yyyy-MM-dd"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Editable="true"
                                   Clearable="true"
                                   Class="cb-filter-date"/>
                    <MudDatePicker @bind-Date="_dateEnd"
                                   Label="结束"
                                   DateFormat="yyyy-MM-dd"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Editable="true"
                                   Clearable="true"
                                   Class="cb-filter-date"/>
                }
                else
                {
                    <MudTextField @bind-Value="_keyword"
                                  Label="内容"
                                  Placeholder="输入查询内容"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Immediate="true"
                                  Class="cb-filter-input"
                                  OnKeyUp="OnKeyUp"/>
                }
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Search" OnClick="SearchAsync" Disabled="_busy">搜索</MudButton>
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Clear" OnClick="ClearAsync" Disabled="_busy">清空</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Href="/contract-base/new">新建</MudButton>
            </div>
            <div class="cb-toolbar-right">
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Deselect" OnClick="ClearSelection" Disabled="_selected.Count == 0">取消选择</MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete" OnClick="DeleteSelectedAsync" Disabled="_selected.Count == 0 || _busy">删除</MudButton>
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Download" OnClick="ExportAsync" Disabled="_busy">
                    @(_selected.Count > 0 ? $"导出({_selected.Count})" : "导出")
                </MudButton>
                <label class="cb-file-label">
                    <InputFile OnChange="OnImportFile" accept=".xlsx" disabled="@_busy"/>
                    <MudButton Variant="Variant.Outlined"
                               StartIcon="@Icons.Material.Filled.Upload"
                               Disabled="_busy"
                               HtmlTag="span">
                        上传
                    </MudButton>
                </label>
                <MudButton Variant="Variant.Outlined"
                           StartIcon="@Icons.Material.Filled.Description"
                           OnClick="DownloadTemplateAsync"
                           Disabled="_busy">
                    下载模板
                </MudButton>
            </div>
        </div>
    </MudPaper>

    <MudPaper Class="cotract-base-table-wrap pa-0" Outlined="true">
        @if (_ready)
        {
        <MudTable @ref="_table"
                  T="ZyqdCotractBaseModel"
                  ServerData="LoadServerData"
                  @bind-CurrentPage="_currentPage"
                  RowsPerPage="@_rowsPerPage"
                  Dense="true"
                  Hover="true"
                  Striped="true"
                  Bordered="true"
                  Loading="_busy"
                  MultiSelection="true"
                  SelectOnRowClick="false"
                  @bind-SelectedItems="_selected"
                  OnRowClick="OnRowClick"
                  Breakpoint="Breakpoint.None"
                  FixedHeader="true"
                  SortMode="SortMode.Single"
                  Class="cotract-base-table">
            <HeaderContent>
                <MudTh Class="cb-no-cell">序号</MudTh>
                <MudTh>客户外箱标志</MudTh>
                <MudTh><MudTableSortLabel T="ZyqdCotractBaseModel" SortLabel="Tuo_Mark">托唛</MudTableSortLabel></MudTh>
                <MudTh>托唛（图片）</MudTh>
                <MudTh><MudTableSortLabel T="ZyqdCotractBaseModel" SortLabel="Customer_destination_country">客户目的国</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel T="ZyqdCotractBaseModel" SortLabel="ClientNo">客户编号</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel T="ZyqdCotractBaseModel" SortLabel="ClientName">客户名称</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel T="ZyqdCotractBaseModel" SortLabel="materialNo">物料编号</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel T="ZyqdCotractBaseModel" SortLabel="materialName">物料名称</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel T="ZyqdCotractBaseModel" SortLabel="materialType">物料类型</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel T="ZyqdCotractBaseModel" SortLabel="materialModel">物料model</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel T="ZyqdCotractBaseModel" SortLabel="materiaSpecs">物料specs</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel T="ZyqdCotractBaseModel" SortLabel="materiaPowered">物料Powered</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel T="ZyqdCotractBaseModel" SortLabel="materiaCust">物料Cust</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel T="ZyqdCotractBaseModel" SortLabel="Notes">备注Notes</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel T="ZyqdCotractBaseModel" SortLabel="Quantity_unit">数量单位</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel T="ZyqdCotractBaseModel" SortLabel="currency_unit">货币单位</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel T="ZyqdCotractBaseModel" SortLabel="price">单价</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel T="ZyqdCotractBaseModel" SortLabel="price_unit">单价单位</MudTableSortLabel></MudTh>
                <MudTh Class="cb-box-label-cell"><MudTableSortLabel T="ZyqdCotractBaseModel" SortLabel="Box_label">箱唛1</MudTableSortLabel></MudTh>
                <MudTh>箱唛1图片</MudTh>
                <MudTh><MudTableSortLabel T="ZyqdCotractBaseModel" SortLabel="Box_label2">箱唛2</MudTableSortLabel></MudTh>
                <MudTh>箱唛2图片</MudTh>
                <MudTh><MudTableSortLabel T="ZyqdCotractBaseModel" SortLabel="Client_poNo">客户po号</MudTableSortLabel></MudTh>
                <MudTh>铭牌1图片</MudTh>
                <MudTh>铭牌1类型</MudTh>
                <MudTh>铭牌2图片</MudTh>
                <MudTh>铭牌2类型</MudTh>
                <MudTh><MudTableSortLabel T="ZyqdCotractBaseModel" SortLabel="SAP_order_NO">sap单号</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel T="ZyqdCotractBaseModel" SortLabel="Packing_method">打包方式</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel T="ZyqdCotractBaseModel" SortLabel="Packing_method_unit">打包方式（单位）</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel T="ZyqdCotractBaseModel" SortLabel="Carton_Size">纸箱尺寸</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel T="ZyqdCotractBaseModel" SortLabel="Pallet_Size">托盘尺寸</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel T="ZyqdCotractBaseModel" SortLabel="palletizing_method">打托方式</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel T="ZyqdCotractBaseModel" SortLabel="palletizing_method_unit">打托方式（单位）</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel T="ZyqdCotractBaseModel" SortLabel="Net_weight">净重（KG）</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel T="ZyqdCotractBaseModel" SortLabel="gross_weight">毛重（KG）</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel T="ZyqdCotractBaseModel" SortLabel="Customer_Manager">客户负责人</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel T="ZyqdCotractBaseModel" SortLabel="UpdatePerson">更新人员</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel T="ZyqdCotractBaseModel" SortLabel="UpdateTime">更新时间</MudTableSortLabel></MudTh>
                <MudTh Class="cb-creator-cell"><MudTableSortLabel T="ZyqdCotractBaseModel" SortLabel="CreatePerson">创建人</MudTableSortLabel></MudTh>
                <MudTh Class="cb-createtime-cell"><MudTableSortLabel T="ZyqdCotractBaseModel" SortLabel="CreateTime" InitialDirection="SortDirection.Descending">创建时间</MudTableSortLabel></MudTh>
                <MudTh Class="cb-ops-cell">操作</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd Class="cb-no-cell">@RowNo(context)</MudTd>
                <MudTd><LegacyRemoteImg Path="@context.Customer_outer_box_logo"/></MudTd>
                <MudTd>@context.Tuo_Mark</MudTd>
                <MudTd><LegacyRemoteImg Path="@context.Tuo_Mark_url"/></MudTd>
                <MudTd>@context.Customer_destination_country</MudTd>
                <MudTd>@context.ClientNo</MudTd>
                <MudTd>@context.ClientName</MudTd>
                <MudTd>@context.materialNo</MudTd>
                <MudTd>@context.materialName</MudTd>
                <MudTd>@context.materialType</MudTd>
                <MudTd>@context.materialModel</MudTd>
                <MudTd>@context.materiaSpecs</MudTd>
                <MudTd>@context.materiaPowered</MudTd>
                <MudTd>@context.materiaCust</MudTd>
                <MudTd>@context.Notes</MudTd>
                <MudTd>@context.Quantity_unit</MudTd>
                <MudTd>@context.currency_unit</MudTd>
                <MudTd>@context.price</MudTd>
                <MudTd>@context.price_unit</MudTd>
                <MudTd Class="cb-box-label-cell">
                    @if (!string.IsNullOrWhiteSpace(context.Box_label))
                    {
                        <MudTooltip Text="@context.Box_label" Arrow="true">
                            <div class="cb-box-label-text">@context.Box_label</div>
                        </MudTooltip>
                    }
                </MudTd>
                <MudTd><LegacyRemoteImg Path="@context.Box_label_url"/></MudTd>
                <MudTd>@context.Box_label2</MudTd>
                <MudTd><LegacyRemoteImg Path="@context.Box_label_url2"/></MudTd>
                <MudTd>@context.Client_poNo</MudTd>
                <MudTd><LegacyRemoteImg Path="@context.nameplate_url"/></MudTd>
                <MudTd>@context.nameplate_type</MudTd>
                <MudTd><LegacyRemoteImg Path="@context.nameplate_url2"/></MudTd>
                <MudTd>@context.nameplate_type2</MudTd>
                <MudTd>@context.SAP_order_NO</MudTd>
                <MudTd>@context.Packing_method</MudTd>
                <MudTd>@context.Packing_method_unit</MudTd>
                <MudTd>@context.Carton_Size</MudTd>
                <MudTd>@context.Pallet_Size</MudTd>
                <MudTd>@context.palletizing_method</MudTd>
                <MudTd>@context.palletizing_method_unit</MudTd>
                <MudTd>@context.Net_weight</MudTd>
                <MudTd>@context.gross_weight</MudTd>
                <MudTd Class="cb-manager-cell">
                    @{
                        var managers = SplitManagers(context.Customer_Manager);
                    }
                    @if (managers.Count > 0)
                    {
                        <MudChipSet T="string" ReadOnly="true" Class="cb-manager-chipset">
                            @foreach (var m in managers)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined"
                                         Text="@m"/>
                            }
                        </MudChipSet>
                    }
                </MudTd>
                <MudTd>@(string.IsNullOrWhiteSpace(context.UpdatePerson) ? "—" : context.UpdatePerson)</MudTd>
                <MudTd>@DateDisplay.Format(context.UpdateTime)</MudTd>
                <MudTd Class="cb-creator-cell">@(string.IsNullOrWhiteSpace(context.CreatePerson) ? "—" : context.CreatePerson)</MudTd>
                <MudTd Class="cb-createtime-cell">@DateDisplay.Format(context.CreateTime)</MudTd>
                <MudTd Class="cb-ops-cell">
                    <div class="cb-ops-grid">
                        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Edit"
                                   Class="cb-ops-btn"
                                   Href="@($"/contract-base/{context.Id}?edit=true")">编辑</MudButton>
                        <MudButton Size="Size.Small" Variant="Variant.Text"
                                   StartIcon="@Icons.Material.Filled.Visibility"
                                   Class="cb-ops-btn"
                                   Href="@($"/contract-base/{context.Id}")">详情</MudButton>
                        <MudButton Size="Size.Small" Variant="Variant.Text"
                                   StartIcon="@Icons.Material.Filled.ContentCopy"
                                   Class="cb-ops-btn"
                                   Href="@($"/contract-base/{context.Id}/copy")">复制</MudButton>
                        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error"
                                   StartIcon="@Icons.Material.Filled.Delete"
                                   Class="cb-ops-btn"
                                   Disabled="_busy"
                                   OnClick="@(() => DeleteAsync(context))">删除</MudButton>
                    </div>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Class="pa-4">@(_busy ? "加载中…" : "暂无可见数据")</MudText>
            </NoRecordsContent>
            <PagerContent>
                <MudTablePager PageSizeOptions="new int[] { 10, 20, 50 }"
                               RowsPerPageString="每页行数："
                               InfoFormat="显示第 {first_item} 到第 {last_item} 条，共 {all_items} 条"/>
            </PagerContent>
        </MudTable>
        }
    </MudPaper>
</div>

<style>
    .cotract-base-page {
        flex: 1 1 0;
        display: flex;
        flex-direction: column;
        height: 100%;
        min-height: 0;
        gap: 12px;
    }

    .cb-toolbar-grid {
        display: grid;
        grid-template-columns: 7fr 5fr;
        gap: 8px;
        align-items: center;
        width: 100%;
        min-width: 0;
    }
    .cb-toolbar-left,
    .cb-toolbar-right {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
        min-width: 0;
    }
    .cb-toolbar-left { justify-content: flex-start; }
    .cb-toolbar-right { justify-content: flex-end; }
    .cb-toolbar-left > *,
    .cb-toolbar-right > * {
        flex: 0 0 auto;
    }
    .cb-filter-select { width: 180px; }
    .cb-filter-input { width: 200px; }
    .cb-filter-date { width: 140px; }
    @@media (max-width: 960px) {
        .cb-toolbar-grid { grid-template-columns: 1fr; }
        .cb-toolbar-right { justify-content: flex-start; }
    }

    .cb-file-label {
        position: relative;
        display: inline-flex;
        align-items: center;
        margin: 0;
        cursor: pointer;
    }

    .cb-file-label input[type=file] {
        position: absolute;
        width: 1px;
        height: 1px;
        opacity: 0;
        overflow: hidden;
        z-index: -1;
    }

    .cotract-base-table-wrap {
        flex: 1 1 0;
        min-height: 0;
        overflow: hidden;
        display: flex;
        flex-direction: column;
    }

    .cotract-base-table {
        height: 100%;
        display: flex;
        flex-direction: column;
    }

    .cotract-base-table .mud-table-container {
        flex: 1 1 0 !important;
        min-height: 0 !important;
        overflow: auto !important;
    }

    .cotract-base-table .mud-table-pagination {
        flex: 0 0 auto !important;
        margin-top: auto;
        border-top: 1px solid var(--mud-palette-lines-default);
    }

    .cotract-base-table .mud-table-root {
        border-collapse: separate !important;
        border-spacing: 0;
    }

    .cotract-base-table .mud-table-head .mud-table-cell:not(.cb-ops-cell):not(.cb-creator-cell):not(.cb-createtime-cell):not(.cb-no-cell):not(:first-child),
    .cotract-base-table .mud-table-body .mud-table-cell:not(.cb-ops-cell):not(.cb-creator-cell):not(.cb-createtime-cell):not(.cb-no-cell):not(:first-child) {
        white-space: nowrap;
        min-width: 88px;
        vertical-align: middle;
    }

    .cotract-base-table .mud-table-head .mud-table-sort-label {
        white-space: nowrap;
    }

    .cotract-base-table .mud-table-cell:first-child,
    .cotract-base-table .mud-table-cell.cb-no-cell {
        position: sticky;
        z-index: 5;
        box-sizing: border-box;
        vertical-align: middle !important;
        overflow: hidden;
        /* 必须用不透明底，半透明斑马色会导致横向滚动时文字叠在固定列上 */
        background-color: #fff !important;
        background-image: linear-gradient(#fff, #fff);
    }

    .cotract-base-table .mud-table-head .mud-table-cell:first-child,
    .cotract-base-table .mud-table-head .mud-table-cell.cb-no-cell {
        z-index: 7;
        background-color: #fff !important;
        background-image: linear-gradient(#fff, #fff);
    }

    .cotract-base-table .mud-table-cell:first-child {
        left: 0;
        width: 42px !important;
        min-width: 42px !important;
        max-width: 42px !important;
        padding: 0 !important;
        text-align: center !important;
        white-space: nowrap !important;
    }

    .cotract-base-table .mud-table-cell:first-child .mud-input-control,
    .cotract-base-table .mud-table-cell:first-child .mud-checkbox {
        margin: 0 auto !important;
        padding: 0 !important;
        display: inline-flex !important;
        align-items: center !important;
        justify-content: center !important;
    }

    .cotract-base-table .mud-table-cell.cb-no-cell {
        left: 42px;
        width: 48px !important;
        min-width: 48px !important;
        max-width: 48px !important;
        padding: 0 2px !important;
        text-align: center;
        white-space: nowrap;
        border-right: 1px solid #e0e0e0;
    }

    .cotract-base-table.mud-table-striped .mud-table-body .mud-table-row:nth-of-type(odd) .mud-table-cell:first-child,
    .cotract-base-table.mud-table-striped .mud-table-body .mud-table-row:nth-of-type(odd) .mud-table-cell.cb-no-cell {
        background-color: #f5f5f5 !important;
        background-image: linear-gradient(#f5f5f5, #f5f5f5);
    }

    .cotract-base-table .mud-table-body .mud-table-row:hover .mud-table-cell:first-child,
    .cotract-base-table .mud-table-body .mud-table-row:hover .mud-table-cell.cb-no-cell {
        background-color: #eeeeee !important;
        background-image: linear-gradient(#eeeeee, #eeeeee);
    }

    /* 右侧固定：创建人 | 创建时间 | 操作 */
    .cotract-base-table .mud-table-cell.cb-creator-cell,
    .cotract-base-table .mud-table-cell.cb-createtime-cell,
    .cotract-base-table .mud-table-cell.cb-ops-cell {
        position: sticky;
        z-index: 5;
        box-sizing: border-box;
        vertical-align: middle;
        overflow: hidden;
        background-color: #fff !important;
        background-image: linear-gradient(#fff, #fff);
        white-space: nowrap;
    }

    .cotract-base-table .mud-table-cell.cb-ops-cell {
        right: 0;
        width: 168px;
        min-width: 168px;
        max-width: 168px;
        padding: 6px 8px !important;
        white-space: normal;
        border-left: 1px solid #e0e0e0;
    }

    .cotract-base-table .mud-table-cell.cb-createtime-cell {
        right: 168px;
        width: 156px;
        min-width: 156px;
        max-width: 156px;
        padding: 6px 8px !important;
        border-left: 1px solid #e0e0e0;
    }

    .cotract-base-table .mud-table-cell.cb-creator-cell {
        right: 324px;
        width: 88px;
        min-width: 88px;
        max-width: 88px;
        padding: 6px 8px !important;
        border-left: 1px solid #e0e0e0;
    }

    .cotract-base-table .mud-table-head .mud-table-cell.cb-creator-cell,
    .cotract-base-table .mud-table-head .mud-table-cell.cb-createtime-cell,
    .cotract-base-table .mud-table-head .mud-table-cell.cb-ops-cell {
        z-index: 7;
        background-color: #fff !important;
        background-image: linear-gradient(#fff, #fff);
    }

    .cotract-base-table.mud-table-striped .mud-table-body .mud-table-row:nth-of-type(odd) .mud-table-cell.cb-creator-cell,
    .cotract-base-table.mud-table-striped .mud-table-body .mud-table-row:nth-of-type(odd) .mud-table-cell.cb-createtime-cell,
    .cotract-base-table.mud-table-striped .mud-table-body .mud-table-row:nth-of-type(odd) .mud-table-cell.cb-ops-cell {
        background-color: #f5f5f5 !important;
        background-image: linear-gradient(#f5f5f5, #f5f5f5);
    }

    .cotract-base-table .mud-table-body .mud-table-row:hover .mud-table-cell.cb-creator-cell,
    .cotract-base-table .mud-table-body .mud-table-row:hover .mud-table-cell.cb-createtime-cell,
    .cotract-base-table .mud-table-body .mud-table-row:hover .mud-table-cell.cb-ops-cell {
        background-color: #eeeeee !important;
        background-image: linear-gradient(#eeeeee, #eeeeee);
    }

    .cb-ops-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        grid-template-rows: 28px 28px;
        gap: 2px 4px;
        width: 100%;
    }

    .cb-ops-grid .cb-ops-btn.mud-button-root {
        min-width: 0 !important;
        width: 100%;
        height: 28px;
        padding: 0 2px !important;
        margin: 0;
        font-size: 12px;
        line-height: 28px;
        justify-content: center;
    }

    .cb-ops-grid .cb-ops-btn .mud-button-label {
        font-size: 12px !important;
    }

    .cb-ops-grid .cb-ops-btn .mud-icon-root {
        font-size: 16px !important;
        margin-right: 2px !important;
    }

    .cotract-thumb {
        max-height: 64px;
        max-width: 96px;
        object-fit: contain;
        display: block;
    }

    .cotract-base-table .mud-table-cell.cb-box-label-cell {
