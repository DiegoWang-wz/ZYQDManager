@code {
    private MudTable<ZyqdCotractBaseModel>? _table;
    private bool _ready;
    private bool _busy;
    private string _filterColumn = "ClientNo";
    private string? _keyword;
    private DateTime? _dateStart;
    private DateTime? _dateEnd;
    private bool IsDateFilter =>
        string.Equals(_filterColumn, "CreateTime", StringComparison.Ordinal)
        || string.Equals(_filterColumn, "UpdateTime", StringComparison.Ordinal);
    private List<ZyqdCotractBaseModel> _rows = new();
    private HashSet<ZyqdCotractBaseModel> _selected = new();
    private int _skip;
    private int _filteredTotal;
    private bool _infoFailed;
    private bool _infoWarned;
    private string? _sortLabel;
    private bool _sortDescending = true;
    private int _currentPage;
    private int _rowsPerPage = 20;
    private const long MaxImportBytes = 32L * 1024 * 1024;
    private string ImageBase => Config["LegacyFiles:BaseUrl"] ?? LegacyFileUrl.DefaultBase;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _ready) return;
        RestoreFromReturn();
        _ready = true;
        StateHasChanged();
    }

    private void RestoreFromReturn()
    {
        var snap = ListUiStateStore.Take(LastListReturn, ListUiStateStore.Keys.CotractBase);
        if (snap is null) return;
        if (!string.IsNullOrWhiteSpace(snap.FilterColumn))
            _filterColumn = snap.FilterColumn!;
        _keyword = snap.Keyword;
        _dateStart = snap.DateStart;
        _dateEnd = snap.DateEnd;
        _rowsPerPage = snap.PageSize > 0 ? snap.PageSize : 20;
        _currentPage = snap.Page < 0 ? 0 : snap.Page;
    }

    private void PersistAsync(int page, int pageSize)
        => ListUiStateStore.Capture(LastListReturn, ListUiStateStore.Keys.CotractBase, new PagedListUiState
        {
            Page = page < 0 ? 0 : page,
            PageSize = pageSize > 0 ? pageSize : 20,
            FilterColumn = _filterColumn,
            Keyword = _keyword,
            DateStart = _dateStart,
            DateEnd = _dateEnd,
        });

    private int RowNo(ZyqdCotractBaseModel row) => _skip + _rows.IndexOf(row) + 1;

    private static List<string> SplitManagers(string? raw)
        => CustomerManagerText.Split(raw);

    private async Task OnKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await SearchAsync();
    }

    private async Task ClearAsync()
    {
        _filterColumn = "ClientNo";
        _keyword = null;
        _dateStart = null;
        _dateEnd = null;
        await SearchAsync();
    }

    private void OnFilterColumnChanged(string value)
    {
        var wasDate = IsDateFilter;
        _filterColumn = value ?? "ClientNo";
        if (IsDateFilter)
            _keyword = null;
        else if (wasDate)
            _dateStart = _dateEnd = null;
    }

    private async Task SearchAsync()
    {
        _selected.Clear();
        await ReloadTableAsync(resetPage: true);
    }

    private void ClearSelection() => _selected.Clear();

    private void OnRowClick(TableRowClickEventArgs<ZyqdCotractBaseModel> args)
    {
        if (args.MouseEventArgs.Detail != 2 || args.Item is null) return;
        NavManager.NavigateTo($"/contract-base/{args.Item.Id}");
    }

    private async Task DeleteSelectedAsync()
    {
        if (_selected.Count == 0) return;
        var ok = await DialogService.ShowMessageBoxAsync(
            "确认删除",
            $"确定删除选中的 {_selected.Count} 条合同基础数据吗？",
            yesText: "删除",
            cancelText: "取消");
        if (ok != true) return;

        _busy = true;
        try
        {
            foreach (var row in _selected.ToList())
            {
                var (success, msg) = await CotractBase.DeleteAsync(row.Id);
                if (!success)
                {
                    Notify.Show(msg ?? "删除失败", Severity.Error);
                    return;
                }
            }

            Notify.Show("已删除", Severity.Success);
            _selected.Clear();
            await ReloadTableAsync(resetPage: false);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ReloadTableAsync(bool resetPage)
    {
        if (_table is null) return;
        if (resetPage && _table.CurrentPage != 0)
        {
            _table.NavigateTo(MudBlazor.Page.First);
            return;
        }

        await _table.ReloadServerData();
    }

    private async Task<TableData<ZyqdCotractBaseModel>> LoadServerData(TableState state, CancellationToken ct)
    {
        if (!_ready)
            return new TableData<ZyqdCotractBaseModel> { Items = Array.Empty<ZyqdCotractBaseModel>(), TotalItems = 0 };

        _busy = true;
        try
        {
            var query = await BuildQueryAsync();
            query.SortLabel = string.IsNullOrWhiteSpace(state.SortLabel) || state.SortDirection == SortDirection.None
                ? null
                : state.SortLabel;
            query.SortDescending = state.SortDirection != SortDirection.Ascending;
            _sortLabel = query.SortLabel;
            _sortDescending = query.SortDescending;
            var take = state.PageSize <= 0 ? 20 : state.PageSize;
            _skip = state.Page * take;
            var (rows, total) = await CotractBase.QueryPageAsync(query, _skip, take, ct);
            _rows = rows;
            _filteredTotal = total;
            _currentPage = state.Page;
            _rowsPerPage = take;
            PersistAsync(state.Page, take);
            if (_infoFailed && !_infoWarned)
            {
                _infoWarned = true;
                Notify.Show("读取人员档案失败，已按最小权限过滤", Severity.Warning);
            }
            return new TableData<ZyqdCotractBaseModel> { Items = rows, TotalItems = total };
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested)
        {
            return new TableData<ZyqdCotractBaseModel> { Items = _rows, TotalItems = _filteredTotal };
        }
        catch (Exception ex)
        {
            if (ct.IsCancellationRequested)
                return new TableData<ZyqdCotractBaseModel> { Items = _rows, TotalItems = _filteredTotal };

            Notify.Show("加载失败：" + ex.Message, Severity.Error);
            return new TableData<ZyqdCotractBaseModel> { Items = Array.Empty<ZyqdCotractBaseModel>(), TotalItems = 0 };
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ExportAsync()
    {
        var selectedIds = _selected.Count > 0 ? _selected.Select(x => x.Id).ToList() : null;
        if (selectedIds is null)
        {
            if (_filteredTotal <= 0)
            {
                Notify.Show("没有可导出的数据", Severity.Warning);
                return;
            }

            var ok = await DialogService.ShowMessageBoxAsync(
                "确认导出",
                $"未勾选记录，将按当前筛选条件导出全部数据，共 {_filteredTotal} 条，是否继续？",
                yesText: "导出全部", cancelText: "取消");
            if (ok != true) return;
        }

        _busy = true;
        try
        {
            var query = await BuildQueryAsync();
            query.SortLabel = _sortLabel;
            query.SortDescending = _sortDescending;
            var bytes = await CotractBase.ExportAsync(query, ImageBase, selectedIds);
            if (bytes.Length == 0)
            {
                Notify.Show("没有可导出的数据", Severity.Warning);
                return;
            }

            await JS.InvokeVoidAsync(
                "downloadFileFromBase64",
                $"合同基础数据_{DateTime.Now:yyyyMMddHHmmss}.xlsx",
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
                Convert.ToBase64String(bytes));
            Notify.Show(
                selectedIds is { Count: > 0 } ? $"已导出选中的 {selectedIds.Count} 条" : $"已按当前条件导出全部 {_filteredTotal} 条",
                Severity.Success);
        }
        catch (Exception ex)
        {
            Notify.Show("导出失败：" + ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DownloadTemplateAsync()
    {
        _busy = true;
        try
        {
            var bytes = await CotractBase.GetTemplateBytesAsync();
            await JS.InvokeVoidAsync(
                "downloadFileFromBase64",
                CotractBaseService.TemplateFileName,
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
                Convert.ToBase64String(bytes));
        }
        catch (Exception ex)
        {
            Notify.Show("下载模板失败：" + ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task OnImportFile(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null) return;

        if (!file.Name.EndsWith(".xlsx", StringComparison.OrdinalIgnoreCase))
        {
            Notify.Show("请上传 xlsx 文件（请先下载模板）", Severity.Warning);
            return;
        }

        if (file.Size > MaxImportBytes)
        {
            Notify.Show("文件超过 32MB，请拆分后再导入", Severity.Warning);
            return;
        }

        _busy = true;
        try
        {
            await using var stream = file.OpenReadStream(MaxImportBytes);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            ms.Position = 0;

            var empNo = await Auth.GetCurrentEmpNoAsync();
            if (string.IsNullOrWhiteSpace(empNo))
            {
                Notify.Show("无法获取当前登录工号，请重新登录后再导入", Severity.Error);
                return;
            }

            var query = await BuildQueryAsync();
            var result = await CotractBase.ImportAsync(ms, empNo, query);
            if (!result.Ok)
            {
                Notify.Show(result.Message, Severity.Error);
                return;
            }

            Notify.Show(result.Message, Severity.Success);
            _selected.Clear();
            await ReloadTableAsync(resetPage: true);
        }
        catch (Exception ex)
        {
            Notify.Show("导入失败：" + ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DeleteAsync(ZyqdCotractBaseModel row)
    {
        var who = $"{row.ClientNo} / {row.materialNo}";
        var ok = await DialogService.ShowMessageBoxAsync(
            "确认删除",
            $"确定删除 {who} 这条合同基础数据吗？",
            yesText: "删除",
            cancelText: "取消");
        if (ok != true) return;

        _busy = true;
        try
        {
            var (success, msg) = await CotractBase.DeleteAsync(row.Id);
            if (!success)
            {
                Notify.Show(msg ?? "删除失败", Severity.Error);
                return;
            }

            Notify.Show("已删除", Severity.Success);
            await ReloadTableAsync(resetPage: false);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task<CotractBaseQueryDto> BuildQueryAsync()
    {
        var auth = await Auth.GetStoredAsync();
        var viewAll = Auth.CanManageUsers(auth);
        var assigned = new List<string>();
        _infoFailed = false;
        if (!viewAll && auth is not null && !string.IsNullOrWhiteSpace(auth.EmpNo))
        {
            var (ok, _, info, _) = await UserInfo.GetAsync(auth.EmpNo);
            _infoFailed = !ok;
            viewAll = Auth.CanViewAllCustomers(auth, info);
            if (!viewAll)
                assigned = await CustomerAssign.GetCodesByEmpNoAsync(auth.EmpNo);
        }

        return new CotractBaseQueryDto
        {
            FilterColumn = _filterColumn,
            Keyword = IsDateFilter ? null : _keyword,
            DateStart = IsDateFilter ? _dateStart : null,
            DateEnd = IsDateFilter ? _dateEnd : null,
            ViewAllCustomers = viewAll,
            ViewerEmpNo = auth?.EmpNo,
            AssignedCustomerCodes = assigned
        };
    }
}
