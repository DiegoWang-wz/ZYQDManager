<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">选择生成类型</MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-3" Style="color:var(--mud-palette-text-secondary)">
            基于客户 PI「@InvoiceNo」生成新单据，原 PI 不会删除。
        </MudText>
        <MudStack Spacing="2">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       FullWidth="true"
                       StartIcon="@Icons.Material.Filled.Assignment"
                       OnClick="@(() => Close("报关PI"))">
                生成报关PI
            </MudButton>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Secondary"
                       FullWidth="true"
                       StartIcon="@Icons.Material.Filled.ReceiptLong"
                       OnClick="@(() => Close("客户CI"))">
                生成客户CI
            </MudButton>
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">取消</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public string? InvoiceNo { get; set; }

    private void Close(string kind) => MudDialog.Close(DialogResult.Ok(kind));

    private void Cancel() => MudDialog.Cancel();
}
