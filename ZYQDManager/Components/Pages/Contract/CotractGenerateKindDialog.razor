<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@(CustomsOnly ? "生成报关PI" : "选择生成类型")</MudText>
    </TitleContent>
    <DialogContent>
        @if (CustomsOnly)
        {
            <MudText Typo="Typo.body2" Class="mb-3" Style="color:var(--mud-palette-text-secondary)">
                已选择 @InvoiceCount 张客户 PI（@InvoiceSummary）。将合并全部物料生成一张报关 PI，不生成客户 CI。原来的客户 PI 不会被修改。
            </MudText>
        }
        else
        {
            <MudText Typo="Typo.body2" Class="mb-3" Style="color:var(--mud-palette-text-secondary)">
                基于客户 PI「@InvoiceNo」生成新单据，原 PI 不会删除。
            </MudText>
        }
        <MudStack Spacing="2">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       FullWidth="true"
                       StartIcon="@Icons.Material.Filled.Assignment"
                       OnClick="@(() => Close("报关PI"))">
                生成报关PI
            </MudButton>
            @if (!CustomsOnly)
            {
                <MudButton Variant="Variant.Filled"
                           Color="Color.Secondary"
                           FullWidth="true"
                           StartIcon="@Icons.Material.Filled.ReceiptLong"
                           OnClick="@(() => Close("客户CI"))">
                    生成客户CI
                </MudButton>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">取消</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public string? InvoiceNo { get; set; }
    [Parameter] public IReadOnlyList<string>? InvoiceNos { get; set; }

    private bool CustomsOnly => InvoiceCount > 1;
    private int InvoiceCount => ListedInvoices.Count;

    private string InvoiceSummary
    {
        get
        {
            var list = ListedInvoices;
            if (list.Count == 0) return (InvoiceNo ?? "").Trim();
            const int show = 6;
            var head = string.Join("、", list.Take(show));
            return list.Count > show ? $"{head} 等" : head;
        }
    }

    private List<string> ListedInvoices =>
        (InvoiceNos ?? [])
        .Select(x => (x ?? "").Trim())
        .Where(x => x.Length > 0)
        .ToList();

    private void Close(string kind) => MudDialog.Close(DialogResult.Ok(kind));

    private void Cancel() => MudDialog.Cancel();
}
