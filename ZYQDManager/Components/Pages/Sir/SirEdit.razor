@page "/sir/new"
@page "/sir/{DocumentGuid}"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Rendering
@inject SirService Sir
@inject CrmCustomerService Crm
@inject CotractBaseService CotractBase
@inject NavigationManager Nav
@inject IConfiguration Config

<PageTitle>遮阳产品测试报告</PageTitle>

<div class="sir-edit-page">
    <MudPaper Class="sir-card pa-0" Elevation="0" Square="true">
        <div class="sir-toolbar">
            <div class="sir-toolbar-left">
                <MudText Typo="Typo.h6" Class="sir-page-title">遮阳产品测试报告</MudText>
                <span class="sir-label">测试类型：</span>
                <MudSelect T="string"
                           Value="_reportType"
                           ValueChanged="OnReportTypeChanged"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Dense="true"
                           Class="sir-type-select"
                           Disabled="_busy">
                    @foreach (var t in SirReportTypes.Tests)
                    {
                        <MudSelectItem Value="@t.Value">@t.Label</MudSelectItem>
                    }
                </MudSelect>
                <span class="sir-label">产品类型：</span>
                <MudSelect T="string"
                           Value="_productType"
                           ValueChanged="OnProductTypeChanged"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Dense="true"
                           Class="sir-product-select"
                           Disabled="_busy">
                    @foreach (var p in _productOptions)
                    {
                        <MudSelectItem Value="@p">@p</MudSelectItem>
                    }
                </MudSelect>
            </div>
            <div class="sir-toolbar-right">
                <MudButton Size="Size.Small" Variant="Variant.Outlined" Href="/sir">返回列表</MudButton>
                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Success"
                           StartIcon="@Icons.Material.Filled.Visibility"
                           OnClick="NotReadyPdf" Disabled="_busy">预览PDF</MudButton>
                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Info"
                           StartIcon="@Icons.Material.Filled.PictureAsPdf"
                           OnClick="NotReadyPdf" Disabled="_busy">导出PDF</MudButton>
                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                           Class="sir-save-btn"
                           StartIcon="@Icons.Material.Filled.Save"
                           OnClick="SaveAsync" Disabled="_busy || !_loaded">保存</MudButton>
            </div>
        </div>

        @if (!_loaded)
        {
            <MudProgressLinear Indeterminate="true"/>
        }
        else
        {
            <div class="sir-form-wrap">
                <table class="sir-form-table">
                    <colgroup>
                        <col style="width:7%"/><col style="width:8%"/><col style="width:12%"/><col style="width:8%"/>
                        <col style="width:10%"/><col style="width:8%"/><col style="width:10%"/><col style="width:7%"/>
                        <col style="width:7%"/><col style="width:5%"/><col style="width:5%"/><col style="width:5%"/>
                        <col style="width:4%"/><col style="width:4%"/>
                    </colgroup>
                    <tbody>
                    @* FROM / TO + 报告类型勾选；中间空白合并为一格，去掉竖线 *@
                    <tr>
                        <th rowspan="2" class="sir-th-side">由 FROM:</th>
                        <th>部门 Dept</th>
                        <td colspan="2"><MudTextField @bind-Value="_main.Department" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true"/></td>
                        <td rowspan="4" colspan="5" class="sir-mid-blank"></td>
                        <td colspan="5" class="sir-check-cell">
                            <MudCheckBox T="bool" @bind-Value="_main.Appearance_Approval_Report" Dense="true" Color="Color.Primary"
                                         Label="外观批准报告 Appearance Approval Report"/>
                        </td>
                    </tr>
                    <tr>
                        <th>业务员 Name</th>
                        <td colspan="2"><MudTextField @bind-Value="_main.SalesmanName" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true"/></td>
                        <td colspan="5" class="sir-check-cell">
                            <MudCheckBox T="bool" @bind-Value="_main.Dimension_Report" Dense="true" Color="Color.Primary"
                                         Label="尺寸检验报告 Dimension Report"/>
                        </td>
                    </tr>
                    <tr>
                        <th rowspan="3" class="sir-th-side">呈交 TO:</th>
                        <th>客户 Client</th>
                        <td colspan="2">
                            <MudTextField Value="_main.Client"
                                          ValueChanged="@(EventCallback.Factory.Create<string>(this, OnClientChanged))"
                                          Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Immediate="false"/>
                        </td>
                        <td colspan="5" class="sir-check-cell">
                            <MudCheckBox T="bool" @bind-Value="_main.Material_Report" Dense="true" Color="Color.Primary"
                                         Label="材料检验报告 Material Report"/>
                        </td>
                    </tr>
                    <tr>
                        <th>部门 Dept</th>
                        <td colspan="2"><MudTextField @bind-Value="_main.ClientDepartment" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true"/></td>
                        <td colspan="5" class="sir-check-cell">
                            <MudCheckBox T="bool" @bind-Value="_main.Function_Report" Dense="true" Color="Color.Primary"
                                         Label="性能检验报告 Function Report"/>
                        </td>
                    </tr>
                    <tr>
                        <th>联系人 Name</th>
                        <td colspan="2"><MudTextField @bind-Value="_main.ContactName" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true"/></td>
                        <td colspan="10" class="sir-mid-blank"></td>
                    </tr>

                    @* 产品信息 *@
                    <tr>
                        <th colspan="2">产品型号 Part No.</th>
                        <td colspan="2"><MudTextField @bind-Value="_main.Product_partNo" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true"/></td>
                        <th colspan="2">产品名称 Designation</th>
                        <td colspan="3">
                            <MudTextField Value="_main.ProductName"
                                          ValueChanged="@(EventCallback.Factory.Create<string>(this, OnProductNameChanged))"
                                          Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true"/>
                        </td>
                        <th colspan="2">软件版本 Firmware index</th>
                        <td colspan="3"><MudTextField @bind-Value="_main.SoftwareVersion" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true"/></td>
                    </tr>
                    <tr>
                        <th colspan="2">签发日期 Issue Date</th>
                        <td colspan="2">
                            <MudDatePicker Date="_issuanceDate"
                                           DateChanged="OnIssuanceDateChanged"
                                           DateFormat="yyyy-MM-dd"
                                           Variant="Variant.Outlined"
                                           Margin="Margin.Dense"
                                           Editable="true"
                                           Dense="true"/>
                        </td>
                        <th colspan="2">样品数量 Qty of Samples</th>
                        <td colspan="3"><MudNumericField @bind-Value="_main.SampleQuantity" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Min="0"/></td>
                        <th colspan="2">第几次送样 Samples delivery times</th>
                        <td colspan="3">
                            <MudNumericField T="int"
                                             Value="_main.DeliveryTimes"
                                             ValueChanged="@(EventCallback.Factory.Create<int>(this, OnDeliveryTimesChanged))"
                                             Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Min="0"/>
                        </td>
                    </tr>
                    <tr>
                        <th colspan="2">程序名称 program name</th>
                        <td colspan="2"><MudTextField @bind-Value="_main.program_name" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true"/></td>
                        <th colspan="2">程序代码 program code</th>
                        <td colspan="3"><MudTextField @bind-Value="_main.program_code" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true"/></td>
                        <th colspan="2">程序校验码 check code</th>
                        <td colspan="3"><MudTextField @bind-Value="_main.check_code" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true"/></td>
                    </tr>

                    @* 认证 + 签名 *@
                    <tr>
                        <th colspan="11" class="sir-section-title">
                            样品符合以下认证测试要求<br/>
                            <span class="sir-en">The sample is qualified for below certification test requirements</span>
                        </th>
                        <th colspan="3" class="sir-section-title">
                            样品测试<br/>
                            <span class="sir-en">Samples inspected by</span>
                        </th>
                    </tr>
                    <tr>
                        <td colspan="11" class="sir-cert-cell">
                            <div class="sir-cert-grid">
                                @CertTile("UL", _main.UL, v => _main.UL = v)
                                @CertTile("FCC", _main.FCC, v => _main.FCC = v)
                                @CertTile("CE", _main.CE, v => _main.CE = v)
                                @CertTile("RoHS", _main.RoHS, v => _main.RoHS = v)
                                @CertTile("REACH", _main.REACH, v => _main.REACH = v)
                                @CertTile("无 None", _main.Certification_None, v => _main.Certification_None = v)
                            </div>
                        </td>
                        <td colspan="3" class="sir-sign-cell">
                            <div class="sir-sign-row"><span>测试:</span><MudTextField @bind-Value="_main.Test_Engineer" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true"/></div>
                            <div class="sir-sign-row"><span>复核:</span><MudTextField @bind-Value="_main.Test_Checked_by" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true"/></div>
                            <div class="sir-sign-row"><span>批准:</span><MudTextField @bind-Value="_main.Test_Approved_By" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true"/></div>
                        </td>
                    </tr>
                    </tbody>
                </table>

                @* 明细：抬头单独 sticky 容器（div 吸顶可靠），样式对齐 Excel *@
                <div class="sir-detail-block">
                    <div class="sir-detail-sticky">
                        <table class="sir-form-table sir-detail-table sir-detail-head-table">
                            <colgroup>
                                <col style="width:5%"/>
                                <col style="width:12%"/>
                                <col style="width:32%"/>
                                <col style="width:4%"/><col style="width:4%"/><col style="width:4%"/>
                                <col style="width:4%"/><col style="width:4%"/><col style="width:4%"/>
                                <col style="width:4%"/><col style="width:4%"/><col style="width:4%"/><col style="width:4%"/>
                                <col style="width:11%"/>
                            </colgroup>
                            <thead>
                            <tr class="sir-detail-legend-row">
                                <td colspan="3" class="sir-legend-spacer"></td>
                                <td colspan="11" class="sir-legend-cell">
                                    A = 合格/Qualified &nbsp;|&nbsp;
                                    B = 不合格/Not Qualified &nbsp;|&nbsp;
                                    C = 可接受的偏差/Acceptable deviation &nbsp;|&nbsp;
                                    D = 无法测试/Unable to test
                                </td>
                            </tr>
                            <tr class="sir-detail-head">
                                <th rowspan="2" class="sir-head-span">序号</th>
                                <th rowspan="2" class="sir-head-span">规格要求</th>
                                <th rowspan="2" class="sir-head-span">判断标准</th>
                                <th colspan="6">测试结果 (actual results)</th>
                                <th colspan="4">测试结果 (Conclusion)</th>
                                <th rowspan="2" class="sir-head-span">备注</th>
                            </tr>
                            <tr class="sir-detail-colhead">
                                <th class="sir-num-th">1</th>
                                <th class="sir-num-th">2</th>
                                <th class="sir-num-th">3</th>
                                <th class="sir-num-th">4</th>
                                <th class="sir-num-th">5</th>
                                <th class="sir-num-th">6</th>
                                <th class="sir-num-th">A</th>
                                <th class="sir-num-th">B</th>
                                <th class="sir-num-th">C</th>
                                <th class="sir-num-th">D</th>
                            </tr>
                            </thead>
                        </table>
                    </div>

                    <table class="sir-form-table sir-detail-table sir-detail-body-table">
                        <colgroup>
                            <col style="width:5%"/>
                            <col style="width:12%"/>
                            <col style="width:32%"/>
                            <col style="width:4%"/><col style="width:4%"/><col style="width:4%"/>
                            <col style="width:4%"/><col style="width:4%"/><col style="width:4%"/>
                            <col style="width:4%"/><col style="width:4%"/><col style="width:4%"/><col style="width:4%"/>
                            <col style="width:11%"/>
                        </colgroup>
                        <tbody>
                        <tr class="sir-detail-subhead">
                            <td colspan="14" class="sir-group-title">成品外观要求 / Finished product appearance requirements</td>
                        </tr>

                        @foreach (var item in _details)
                        {
                            @if (ShouldShowGroupHeader(item.Specification_type, out var groupTitle))
                            {
                                <tr class="sir-detail-subhead">
                                    <td colspan="14" class="sir-group-title">@groupTitle</td>
                                </tr>
                            }
                            <tr class="sir-detail-row">
                                <td class="center">@item.Specification_type</td>
                                <td class="sir-spec-cell"><div class="sir-html">@((MarkupString)(item.Specification ?? ""))</div></td>
                                <td><div class="sir-html">@((MarkupString)(item.Criteria ?? ""))</div></td>
                                @for (var i = 1; i <= 6; i++)
                                {
                                    var idx = i;
                                    <td class="center sir-result-cell">@ResultEditor(item, idx)</td>
                                }
                                <td class="center sir-concl-cell">@ConclusionCheck(item, "A")</td>
                                <td class="center sir-concl-cell">@ConclusionCheck(item, "B")</td>
                                <td class="center sir-concl-cell">@ConclusionCheck(item, "C")</td>
                                <td class="center sir-concl-cell">@ConclusionCheck(item, "D")</td>
                                <td><MudTextField @bind-Value="item.Note" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true"/></td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>

                @if (ShowRemoteImages)
                {
                    <div class="sir-image-block">
                        <div class="sir-image-title">遥控器主控板正反面附图（最多5张）</div>
                        <div class="sir-image-area">
                            <label class="sir-upload-label">
                                <InputFile OnChange="OnRemoteImagesSelected"
                                           accept=".jpg,.jpeg,.png,.gif,.bmp,image/*"
                                           multiple
                                           disabled="@(_busy || _imgUploading)"/>
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Primary"
                                           Size="Size.Small"
                                           StartIcon="@Icons.Material.Filled.CloudUpload"
                                           Disabled="@(_busy || _imgUploading || _images.Count >= 5)"
                                           HtmlTag="span">
                                    @(_imgUploading ? "上传中…" : (_images.Count >= 5 ? "已达上限(5张)" : "选择图片"))
                                </MudButton>
                            </label>
                            <span class="sir-upload-hint">支持JPG、PNG格式，单张不超过5MB</span>
                        </div>
                        @if (_images.Count > 0)
                        {
                            <div class="sir-image-preview">
                                @for (var i = 0; i < _images.Count; i++)
                                {
                                    var idx = i;
                                    var url = ImageDisplayUrl(_images[idx]);
                                    <div class="sir-preview-item">
                                        <a href="@url" target="_blank" rel="noopener">
                                            <img src="@url" alt="附图"/>
                                        </a>
                                        <MudIconButton Icon="@Icons.Material.Filled.Close"
                                                       Size="Size.Small"
                                                       Color="Color.Error"
                                                       Class="sir-preview-remove"
                                                       Disabled="_busy"
                                                       OnClick="@(() => RemoveRemoteImage(idx))"/>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
                else if (ShowSampleFiling)
                {
                    <div class="sir-sample-block">
                        <div class="sir-sample-title">样品留样记录 / Sample Retention Records</div>
                        <table class="sir-form-table sir-sample-table">
                            <thead>
                            <tr class="sir-detail-head">
                                <th style="width:48px">序号</th>
                                <th style="width:120px">物料编号</th>
                                <th style="width:140px">物料名称</th>
                                <th>图片留底（最多5张）</th>
                                <th style="width:160px">样品部件</th>
                                <th style="width:200px">备注/要求</th>
                                <th style="width:72px">操作</th>
                            </tr>
                            </thead>
                            <tbody>
                            @for (var si = 0; si < _samples.Count; si++)
                            {
                                var s = _samples[si];
                                var sIndex = si;
                                var imgs = GetSampleImages(s);
                                <tr>
                                    <td class="center">@(si + 1)</td>
                                    <td><MudTextField @bind-Value="s.materialNo" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true"/></td>
                                    <td><MudTextField @bind-Value="s.materialName" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true"/></td>
                                    <td>
                                        <div class="sir-sample-imgs">
                                            <label class="sir-upload-label">
                                                <InputFile OnChange="@(e => OnSampleImagesSelected(e, sIndex))"
                                                           accept=".jpg,.jpeg,.png,.gif,.bmp,image/*"
                                                           multiple
                                                           disabled="@(_busy || _imgUploading || imgs.Count >= 5)"/>
                                                <MudButton Variant="Variant.Outlined"
                                                           Color="Color.Primary"
                                                           Size="Size.Small"
                                                           StartIcon="@Icons.Material.Filled.AddPhotoAlternate"
                                                           Disabled="@(_busy || _imgUploading || imgs.Count >= 5)"
                                                           HtmlTag="span">
                                                    @(imgs.Count >= 5 ? "已满5张" : "添加图片")
                                                </MudButton>
                                            </label>
                                            <div class="sir-image-preview sir-sample-preview">
                                                @for (var ii = 0; ii < imgs.Count; ii++)
                                                {
                                                    var imgIdx = ii;
                                                    var url = ImageDisplayUrl(imgs[imgIdx]);
                                                    <div class="sir-preview-item sir-preview-item-sm">
                                                        <a href="@url" target="_blank" rel="noopener"><img src="@url" alt="样品"/></a>
                                                        <MudIconButton Icon="@Icons.Material.Filled.Close"
                                                                       Size="Size.Small"
                                                                       Color="Color.Error"
                                                                       Class="sir-preview-remove"
                                                                       Disabled="_busy"
                                                                       OnClick="@(() => RemoveSampleImage(sIndex, imgIdx))"/>
                                                    </div>
                                                }
                                            </div>
                                            <div class="sir-upload-hint">JPG/PNG，单张≤5MB</div>
                                        </div>
                                    </td>
                                    <td>
                                        <MudTextField @bind-Value="s.Note" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Placeholder="样品部件"/>
                                    </td>
                                    <td><MudTextField @bind-Value="s.Note1" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Lines="2" Placeholder="留底要求"/></td>
                                    <td class="center">
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                       Color="Color.Error"
                                                       Size="Size.Small"
                                                       Disabled="_busy"
                                                       OnClick="@(() => RemoveSampleRow(sIndex))"/>
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                        <div class="sir-sample-actions">
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.Add"
                                       Disabled="_busy"
                                       OnClick="AddSampleRow">
                                添加样品记录
                            </MudButton>
                        </div>
                    </div>
                }

                <div class="sir-note-block">
                    <MudTextField @bind-Value="_main.Note" Label="备注 Note" Variant="Variant.Outlined" Margin="Margin.Dense" Lines="2"/>
                </div>
            </div>
        }
    </MudPaper>
</div>

<style>
    .sir-edit-page {
        flex: 1 1 0;
        min-height: 0;
        display: flex;
        flex-direction: column;
        /* 抵消 MainLayout .zyqd-main 的 16px 内边距，避免顶栏左右出现灰缝 */
        margin: 0 -16px -16px;
        overflow: hidden;
        background: #fff;
    }
    .sir-card {
        flex: 1 1 0;
        min-height: 0;
        display: flex !important;
        flex-direction: column;
        /* 顶部直角贴齐导航栏，底部保留一点圆角立体感 */
        border-radius: 0 0 10px 10px !important;
        overflow: hidden;
        background: #fff !important;
        box-shadow: none !important;
    }
    .sir-toolbar {
        flex: 0 0 auto;
        display: flex;
        flex-wrap: wrap;
        gap: 6px 10px;
        align-items: center;
        justify-content: space-between;
        padding: 6px 12px;
        min-height: 0;
        border-bottom: 1px solid #e5e7eb;
        background: #fff;
    }
    .sir-toolbar-left, .sir-toolbar-right {
        display: flex;
        flex-wrap: wrap;
        gap: 6px 8px;
        align-items: center;
    }
    .sir-page-title {
        margin: 0 4px 0 0 !important;
        color: #1f2937;
        font-weight: 700 !important;
        white-space: nowrap;
        font-size: 1rem !important;
        line-height: 1.2 !important;
    }
    .sir-label { color: #374151; font-weight: 500; white-space: nowrap; font-size: 13px; }
    .sir-type-select { width: 150px; min-width: 130px; }
    .sir-product-select { width: 300px; min-width: 200px; }
    .sir-toolbar .mud-input-control { margin-top: 0 !important; margin-bottom: 0 !important; }
    .sir-toolbar .mud-button-root { height: 32px; min-height: 32px; }
    .sir-save-btn { background: #1d4ed8 !important; }
    .sir-form-wrap {
        flex: 1 1 0;
        min-height: 0;
        /* 去掉顶部 padding，吸顶才能贴齐工具栏，避免露缝 */
        padding: 0 16px 16px;
        overflow: auto;
        background: #fff;
    }
    .sir-form-wrap > .sir-form-table:first-of-type {
        margin-top: 8px;
    }
    .sir-form-table {
        width: 100%;
        border-collapse: collapse;
        table-layout: fixed;
        font-size: 13px;
    }
    .sir-form-table th,
    .sir-form-table td {
        border: 1px solid #d1d5db;
        padding: 6px 8px;
        vertical-align: middle;
    }
    .sir-form-table th {
        background: #f9fafb;
        font-weight: 600;
        color: #374151;
        text-align: left;
        white-space: normal;
        word-break: break-word;
        line-height: 1.35;
    }
    .sir-th-side {
        text-align: center !important;
        writing-mode: horizontal-tb;
        background: #f3f4f6 !important;
        width: 72px;
    }
    .sir-check-cell { background: #fafafa; }
    .sir-mid-blank {
        background: #fff !important;
    }
    .sir-check-cell .mud-input-control { margin: 0; }
    .sir-check-cell .mud-typography,
    .sir-check-cell .mud-checkbox .mud-typography,
    .sir-check-cell label {
        white-space: normal !important;
        word-break: break-word;
        line-height: 1.3;
    }
    .sir-section-title {
        text-align: center !important;
        background: #f3f4f6 !important;
        line-height: 1.35;
    }
