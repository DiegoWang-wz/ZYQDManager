@code {
    [Parameter] public string? DocumentGuid { get; set; }
    [SupplyParameterFromQuery(Name = "rt")] public string? QueryReportType { get; set; }
    [SupplyParameterFromQuery(Name = "pt")] public string? QueryProductType { get; set; }

    private ZyqdSirMainModel _main = new();
    private List<ZyqdSirDetailModel> _details = [];
    private List<ZyqdSirSampleForFilingModel> _samples = [];
    private List<string> _images = [];
    private string _reportType = "remote";
    private string _productType = "基础版遥控器";
    private List<string> _productOptions = SirReportTypes.ProductsFor("remote").ToList();
    private DateTime? _issuanceDate = DateTime.Today;
    private bool _busy;
    private bool _loaded;
    private bool _imgUploading;
    private string _guid = "";
    private string ImageBase => Config["LegacyFile:ImageBaseUrl"] ?? LegacyFileUrl.DefaultBase;

    private bool ShowRemoteImages => SirService.IsRemoteWithoutSample(_reportType);
    private bool ShowSampleFiling => SirService.NeedsSampleFiling(_reportType);

    protected override async Task OnParametersSetAsync()
    {
        var guid = (DocumentGuid ?? "").Trim();
        if (guid.Length == 0 || string.Equals(guid, "new", StringComparison.OrdinalIgnoreCase))
            guid = Guid.NewGuid().ToString("N");

        _guid = guid;
        _reportType = string.IsNullOrWhiteSpace(QueryReportType) ? "remote" : QueryReportType.Trim();
        _productType = string.IsNullOrWhiteSpace(QueryProductType)
            ? SirReportTypes.DefaultProduct(_reportType)
            : QueryProductType.Trim();
        _productOptions = SirReportTypes.ProductsFor(_reportType).ToList();
        if (!_productOptions.Contains(_productType))
            _productType = SirReportTypes.DefaultProduct(_reportType);

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _busy = true;
        _loaded = false;
        try
        {
            var doc = await Sir.GetDocumentAsync(_guid, _reportType, _productType);
            _main = doc.Main;
            _details = doc.Details;
            _samples = ShowSampleFiling ? doc.Samples : [];
            _images = ShowRemoteImages ? ParseImageUrls(_main.ImageUrls) : [];
            if (ShowRemoteImages)
                _main.ImageUrls = string.Join(",", _images);
            _guid = _main.guid ?? _guid;
            _reportType = _main.Report_type ?? _reportType;
            _productType = _main.product_type ?? _productType;
            _productOptions = SirReportTypes.ProductsFor(_reportType).ToList();
            _issuanceDate = _main.IssuanceDate == default ? DateTime.Today : _main.IssuanceDate.Date;
            _loaded = true;
        }
        catch (Exception ex)
        {
            Notify.Show("加载失败：" + ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task OnReportTypeChanged(string value)
    {
        _reportType = value;
        _productType = SirReportTypes.DefaultProduct(value);
        _productOptions = SirReportTypes.ProductsFor(value).ToList();
        _main.Report_type = _reportType;
        _main.product_type = _productType;
        await LoadAsync();
    }

    private async Task OnProductTypeChanged(string value)
    {
        _productType = value;
        _main.product_type = value;
        await LoadAsync();
    }

    private async Task OnClientChanged(string value)
    {
        _main.Client = value;
        RefreshPartNo();
        var clientNo = (value ?? "").Trim();
        if (clientNo.Length == 0) return;
        try
        {
            var crm = await Crm.GetBillToAsync(clientNo);
            if (crm is null) return;
            if (!string.IsNullOrWhiteSpace(crm.FullName))
                _main.ContactName = crm.FullName;
            if (!string.IsNullOrWhiteSpace(crm.ClientName))
                _main.ClientDepartment = crm.ClientName;
        }
        catch
        {
            // ignore
        }
    }

    private void OnProductNameChanged(string value)
    {
        _main.ProductName = value;
        RefreshPartNo();
    }

    private void OnIssuanceDateChanged(DateTime? value)
    {
        _issuanceDate = value;
        _main.IssuanceDate = value?.Date ?? DateTime.Today;
        RefreshPartNo();
    }

    private void OnDeliveryTimesChanged(int value)
    {
        _main.DeliveryTimes = value;
        RefreshPartNo();
    }

    private void RefreshPartNo()
    {
        var client = (_main.Client ?? "").Trim();
        var name = (_main.ProductName ?? "").Trim();
        var date = (_issuanceDate ?? DateTime.Today).ToString("yyyyMMdd");
        if (client.Length == 0 || name.Length == 0) return;
        _main.Product_partNo = $"{client}-{name}-{date}-{_main.DeliveryTimes}";
    }

    private async Task SaveAsync()
    {
        _busy = true;
        try
        {
            _main.guid = _guid;
            _main.Report_type = _reportType;
            _main.product_type = _productType;
            _main.IssuanceDate = _issuanceDate?.Date ?? DateTime.Today;
            _main.ImageUrls = ShowRemoteImages
                ? string.Join(",", _images.Where(x => !string.IsNullOrWhiteSpace(x)))
                : (_main.ImageUrls ?? "");

            // 留样行图片写回 ImageUrls(JSON)
            if (ShowSampleFiling)
            {
                foreach (var s in _samples)
                    s.ImageUrls ??= "[]";
            }

            var doc = new SirDocumentDto
            {
                Main = _main,
                Details = _details,
                Samples = ShowSampleFiling ? _samples : [],
            };
            var (ok, msg) = await Sir.SaveAsync(doc);
            if (!ok)
            {
                Notify.Show(msg ?? "保存失败", Severity.Error);
                return;
            }

            Notify.Show("保存成功", Severity.Success);
            if (!Nav.Uri.Contains(_guid, StringComparison.OrdinalIgnoreCase))
            {
                var href = $"/sir/{Uri.EscapeDataString(_guid)}?rt={Uri.EscapeDataString(_reportType)}&pt={Uri.EscapeDataString(_productType)}";
                Nav.NavigateTo(href, replace: true);
            }
        }
        catch (Exception ex)
        {
            Notify.Show("保存失败：" + ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private void NotReadyPdf() => Notify.Show("PDF 预览/导出稍后移植", Severity.Info);

    private string ImageDisplayUrl(string? path) => LegacyFileUrl.Resolve(path, ImageBase);

    private static List<string> ParseImageUrls(string? raw)
        => (raw ?? "")
            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Where(x => !LegacyFileUrl.IsBlankOrPlaceholder(x))
            .ToList();

    private async Task OnRemoteImagesSelected(InputFileChangeEventArgs e)
    {
        var files = e.GetMultipleFiles(5).ToList();
        if (files.Count == 0) return;
        if (_images.Count + files.Count > 5)
        {
            Notify.Show("最多只能上传5张图片", Severity.Warning);
            return;
        }

        _imgUploading = true;
        try
        {
            foreach (var file in files)
            {
                var ext = Path.GetExtension(file.Name).ToLowerInvariant();
                if (ext is not (".jpg" or ".jpeg" or ".png" or ".gif" or ".bmp"))
                {
                    Notify.Show($"不支持的格式：{file.Name}", Severity.Warning);
                    continue;
                }

                if (file.Size > 5 * 1024 * 1024)
                {
                    Notify.Show($"{file.Name} 超过5MB", Severity.Warning);
                    continue;
                }

                await using var stream = file.OpenReadStream(5 * 1024 * 1024);
                var path = await CotractBase.UploadImageAsync(stream, file.Name);
                if (!string.IsNullOrWhiteSpace(path))
                    _images.Add(path.Trim());
            }

            Notify.Show("图片上传完成", Severity.Success);
        }
        catch (Exception ex)
        {
            Notify.Show("上传失败：" + ex.Message, Severity.Error);
        }
        finally
        {
            _imgUploading = false;
        }
    }

    private void RemoveRemoteImage(int index)
    {
        if (index < 0 || index >= _images.Count) return;
        _images.RemoveAt(index);
    }

    private static List<string> GetSampleImages(ZyqdSirSampleForFilingModel row)
    {
        var raw = (row.ImageUrls ?? "").Trim();
        if (raw.Length == 0 || raw == "[]")
            return [];
        try
        {
            if (raw.StartsWith('['))
            {
                using var doc = System.Text.Json.JsonDocument.Parse(raw);
                var list = new List<string>();
                foreach (var el in doc.RootElement.EnumerateArray())
                {
                    if (el.ValueKind == System.Text.Json.JsonValueKind.String)
                    {
                        var s = el.GetString();
                        if (!string.IsNullOrWhiteSpace(s)) list.Add(s);
                    }
                    else if (el.ValueKind == System.Text.Json.JsonValueKind.Object
                             && el.TryGetProperty("url", out var urlProp))
                    {
                        var s = urlProp.GetString();
                        if (!string.IsNullOrWhiteSpace(s)) list.Add(s);
                    }
                }
                return list;
            }
        }
        catch
        {
            // fall through
        }

        return ParseImageUrls(raw);
    }

    private static void SetSampleImages(ZyqdSirSampleForFilingModel row, List<string> urls)
    {
        row.ImageUrls = System.Text.Json.JsonSerializer.Serialize(urls);
    }

    private async Task OnSampleImagesSelected(InputFileChangeEventArgs e, int sampleIndex)
    {
        if (sampleIndex < 0 || sampleIndex >= _samples.Count) return;
        var row = _samples[sampleIndex];
        var imgs = GetSampleImages(row);
        var files = e.GetMultipleFiles(5).ToList();
        if (files.Count == 0) return;
        if (imgs.Count + files.Count > 5)
        {
            Notify.Show("每行最多上传5张图片", Severity.Warning);
            return;
        }

        _imgUploading = true;
        try
        {
            foreach (var file in files)
            {
                var ext = Path.GetExtension(file.Name).ToLowerInvariant();
                if (ext is not (".jpg" or ".jpeg" or ".png" or ".gif" or ".bmp"))
                {
                    Notify.Show($"不支持的格式：{file.Name}", Severity.Warning);
                    continue;
                }

                if (file.Size > 5 * 1024 * 1024)
                {
                    Notify.Show($"{file.Name} 超过5MB", Severity.Warning);
                    continue;
                }

                await using var stream = file.OpenReadStream(5 * 1024 * 1024);
                var path = await CotractBase.UploadImageAsync(stream, file.Name);
                if (!string.IsNullOrWhiteSpace(path))
                    imgs.Add(path.Trim());
            }

            SetSampleImages(row, imgs);
            Notify.Show("样品图片上传完成", Severity.Success);
        }
        catch (Exception ex)
        {
            Notify.Show("上传失败：" + ex.Message, Severity.Error);
        }
        finally
        {
            _imgUploading = false;
        }
    }

    private void RemoveSampleImage(int sampleIndex, int imgIndex)
    {
        if (sampleIndex < 0 || sampleIndex >= _samples.Count) return;
        var row = _samples[sampleIndex];
        var imgs = GetSampleImages(row);
        if (imgIndex < 0 || imgIndex >= imgs.Count) return;
        imgs.RemoveAt(imgIndex);
        SetSampleImages(row, imgs);
    }

    private void AddSampleRow()
    {
        var code = _samples.Count == 0 ? 1 : _samples.Max(x => x.code) + 1;
        _samples.Add(new ZyqdSirSampleForFilingModel
        {
            main_guid = _guid,
            Report_type = _reportType,
            Specification_type = $"S.{code}",
            Note = $"部件{code}",
            Note1 = "",
            code = code,
            createTime = DateTime.Now,
            ImageUrls = "[]",
        });
    }

    private void RemoveSampleRow(int index)
    {
        if (index < 0 || index >= _samples.Count) return;
        _samples.RemoveAt(index);
    }

    private RenderFragment CertTile(string label, bool active, Action<bool> set) => __builder =>
    {
        <div class="@($"sir-cert-tile{(active ? " active" : "")}")" @onclick="@(() => { set(!active); StateHasChanged(); })">
            <span class="sir-cert-box">@(active ? "✓" : "")</span>
            <span>@label</span>
        </div>
    };

    private bool ShouldShowGroupHeader(string? specType, out string title)
    {
        title = "";
        // 分组标题插在对应项之前（老系统是插在该项之后，这里按“下一组开始”更直观）
        if (specType == "2.1")
        {
            title = "成品性能要求 / Performance requirements for finished products";
            return true;
        }
        if (specType == "3.1")
        {
            title = "成品功能要求 / Functional requirements for finished products";
            return true;
        }
        if (specType == "4.1")
        {
            title = "其他要求 / Other requirements";
            return true;
        }
        // 遥控器：4.1 配件之后是半成品内部测试（序号 1~10），需单独成块
        if (specType == "1")
        {
            title = "半成品测试，不提供给客户，内部测试记录。";
            return true;
        }
        return false;
    }

    private RenderFragment ConclusionCheck(ZyqdSirDetailModel row, string which) => __builder =>
    {
        var raw = which switch
        {
            "A" => row.Conclusion_A,
            "B" => row.Conclusio_B,
            "C" => row.Conclusion_C,
            "D" => row.Conclusion_D,
            _ => null
        };
        var checkedVal = IsTick(raw);

        <MudCheckBox T="bool"
                     Value="@checkedVal"
                     ValueChanged="@(EventCallback.Factory.Create<bool>(this, v => SetConclusion(row, which, v ? "√" : "")))"
                     Dense="true"
                     Color="Color.Primary"/>
    };

    private static void SetConclusion(ZyqdSirDetailModel row, string which, string? value)
    {
        switch (which)
        {
            case "A": row.Conclusion_A = value; break;
            case "B": row.Conclusio_B = value; break;
            case "C": row.Conclusion_C = value; break;
            case "D": row.Conclusion_D = value; break;
        }
    }

    private RenderFragment ResultEditor(ZyqdSirDetailModel row, int index) => builder =>
    {
        var value = GetResult(row, index) ?? "";
        var filling = row.filling_type ?? "0";

        if (filling == "1")
        {
            // √/× 类型：用勾选框，勾选存 √，取消存空
            var checkedVal = IsTick(value);
            builder.OpenComponent<MudCheckBox<bool>>(0);
            builder.AddAttribute(1, "Value", checkedVal);
            builder.AddAttribute(2, "ValueChanged", EventCallback.Factory.Create<bool>(this, v => SetResult(row, index, v ? "√" : "")));
            builder.AddAttribute(3, "Dense", true);
            builder.AddAttribute(4, "Color", Color.Primary);
            builder.CloseComponent();
        }
        else if (filling == "2")
        {
            // OK/NG：点击在 - → OK → NG 间循环
            var display = string.IsNullOrWhiteSpace(value) ? "-" : value.Trim();
            var stateClass = display switch
            {
                "OK" => "sir-cycle-ok",
                "NG" => "sir-cycle-ng",
                _ => "sir-cycle-empty"
            };
            builder.OpenElement(0, "button");
            builder.AddAttribute(1, "type", "button");
            builder.AddAttribute(2, "class", $"sir-cycle-btn {stateClass}");
            builder.AddAttribute(3, "onclick", EventCallback.Factory.Create(this, () => CycleOkNg(row, index)));
            builder.AddContent(4, display);
            builder.CloseElement();
        }
        else
        {
            builder.OpenComponent<MudTextField<string>>(0);
            builder.AddAttribute(1, "Value", value);
            builder.AddAttribute(2, "ValueChanged", EventCallback.Factory.Create<string>(this, v => SetResult(row, index, v)));
            builder.AddAttribute(3, "Dense", true);
            builder.AddAttribute(4, "Margin", Margin.Dense);
            builder.AddAttribute(5, "Variant", Variant.Outlined);
            builder.CloseComponent();
        }
    };

    private void CycleOkNg(ZyqdSirDetailModel row, int index)
    {
        var cur = (GetResult(row, index) ?? "").Trim();
        var next = cur switch
        {
            "OK" => "NG",
            "NG" => "",
            _ => "OK"
        };
        SetResult(row, index, next);
    }

    private static bool IsTick(string? value)
    {
        var v = (value ?? "").Trim();
        return v is "√" or "✓" or "V" or "v" or "OK" or "ok" or "true" or "1";
    }

    private static void AddOption(RenderTreeBuilder b, string v)
    {
        b.OpenComponent<MudSelectItem<string>>(0);
        b.AddAttribute(1, "Value", v);
        b.AddAttribute(2, "ChildContent", (RenderFragment)(c => c.AddContent(0, string.IsNullOrEmpty(v) ? "-" : v)));
        b.CloseComponent();
    }

    private static string? GetResult(ZyqdSirDetailModel row, int index) => index switch
    {
        1 => row.Actual_Results1,
        2 => row.Actual_Results2,
        3 => row.Actual_Results3,
        4 => row.Actual_Results4,
        5 => row.Actual_Results5,
        6 => row.Actual_Results6,
        _ => null
    };

    private static void SetResult(ZyqdSirDetailModel row, int index, string? value)
    {
        switch (index)
        {
            case 1: row.Actual_Results1 = value; break;
            case 2: row.Actual_Results2 = value; break;
            case 3: row.Actual_Results3 = value; break;
            case 4: row.Actual_Results4 = value; break;
            case 5: row.Actual_Results5 = value; break;
            case 6: row.Actual_Results6 = value; break;
        }
    }
}
