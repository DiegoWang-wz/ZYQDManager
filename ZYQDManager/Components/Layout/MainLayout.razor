@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Nav
@inject CentralAuthService Auth
@inject NavigationHistoryService NavHistory

@if (!_authReady)
{
    <LayoutView Layout="typeof(InitLayout)">
    </LayoutView>
}
else
{
    <MudThemeProvider/>
    <MudPopoverProvider/>
    <MudDialogProvider/>
    <MudSnackbarProvider/>

    <MudLayout>
        <MudAppBar Elevation="0" Dense="true" Color="Color.Dark" Class="zyqd-appbar">
            <div class="zyqd-nav">
                <button type="button" class="zyqd-nav-btn" @onclick="@(() => GoTo("/"))">
                    <span>首页</span>
                </button>

                @if (_canSeeBusinessModules)
                {
                    <button type="button" class="zyqd-nav-btn" @onclick="@(() => GoTo("/project"))">
                        <span>项目管理</span>
                    </button>

                    <MudMenu Dense="true"
                             Class="zyqd-nav-menu"
                             AnchorOrigin="Origin.BottomLeft"
                             TransformOrigin="Origin.TopLeft">
                        <ActivatorContent>
                            <button type="button" class="zyqd-nav-btn" @onclick="context.ToggleAsync">
                                <span>合同管理</span>
                                <MudIcon Icon="@Icons.Material.Filled.ArrowDropDown" Class="zyqd-nav-caret"/>
                            </button>
                        </ActivatorContent>
                        <ChildContent>
                            <MudMenuItem OnClick="@(() => GoTo("/contract?type=" + Uri.EscapeDataString("客户PI")))">客户PI列表</MudMenuItem>
                            <MudMenuItem OnClick="@(() => GoTo("/contract?type=" + Uri.EscapeDataString("客户CI")))">客户CI列表</MudMenuItem>
                            <MudMenuItem OnClick="@(() => GoTo("/contract?type=" + Uri.EscapeDataString("报关PI")))">报关PI列表</MudMenuItem>
                            <MudMenuItem OnClick="@(() => GoTo("/contract-pk"))">装箱单列表</MudMenuItem>
                            <MudMenuItem OnClick="@(() => GoTo("/contract-base"))">合同基础数据</MudMenuItem>
                        </ChildContent>
                    </MudMenu>

                    <MudMenu Dense="true"
                             Class="zyqd-nav-menu"
                             AnchorOrigin="Origin.BottomLeft"
                             TransformOrigin="Origin.TopLeft">
                        <ActivatorContent>
                            <button type="button" class="zyqd-nav-btn" @onclick="context.ToggleAsync">
                                <span>报价</span>
                                <MudIcon Icon="@Icons.Material.Filled.ArrowDropDown" Class="zyqd-nav-caret"/>
                            </button>
                        </ActivatorContent>
                        <ChildContent>
                            <MudMenuItem OnClick="@(() => GoTo("/quotation"))">报价列表</MudMenuItem>
                            <MudMenuItem OnClick="@(() => GoTo("/quotation-base"))">基础数据维护</MudMenuItem>
                        </ChildContent>
                    </MudMenu>

                    @if (_canViewInvoiceKp)
                    {
                        <button type="button" class="zyqd-nav-btn" @onclick="@(() => GoTo("/invoice-kp"))">
                            <span>开票管理</span>
                        </button>
                    }
                }

                <button type="button" class="zyqd-nav-btn" @onclick="@(() => GoTo("/sir"))">
                    <span>检测报告管理</span>
                </button>
            </div>

            <div class="zyqd-page-title" title="@CurrentPageTitle">
                <span class="zyqd-page-title-badge">@CurrentPageTitle</span>
            </div>

            <MudSpacer/>
            <MudButton Size="Size.Small"
                       Variant="Variant.Filled"
                       Class="mr-2 zyqd-back-btn"
                       StartIcon="@Icons.Material.Filled.ArrowBack"
                       Disabled="!NavHistory.CanGoBack"
                       OnClick="GoBack">返回</MudButton>
            <MudMenu Dense="true"
                     Class="zyqd-nav-menu"
                     AnchorOrigin="Origin.BottomRight"
                     TransformOrigin="Origin.TopRight">
                <ActivatorContent>
                    <button type="button" class="zyqd-nav-btn" @onclick="context.ToggleAsync" aria-label="菜单">
                        <MudIcon Icon="@Icons.Material.Filled.Menu" Class="zyqd-nav-caret"/>
                        <span>菜单</span>
                    </button>
                </ActivatorContent>
                <ChildContent>
                    <MudMenuItem Label="首页" Icon="@Icons.Material.Filled.Home" OnClick="@(() => GoTo(_homePath))"/>
                    <MudMenuItem Label="个人信息" Icon="@Icons.Material.Filled.Person" OnClick="@(() => GoTo("/Profile"))"/>
                    @if (_canManageUsers)
                    {
                        <MudMenuItem Label="人员管理" Icon="@Icons.Material.Filled.ManageAccounts" OnClick="@(() => GoTo("/personnel"))"/>
                    }
                    <MudDivider/>
                    <MudMenuItem Label="登出" Icon="@Icons.Material.Filled.Logout" OnClick="LogoutAsync"/>
                </ChildContent>
            </MudMenu>
        </MudAppBar>

        <MudMainContent Class="zyqd-main">
            @Body
        </MudMainContent>
    </MudLayout>
}

<div id="blazor-error-ui" data-nosnippet>
    发生未处理错误。
    <a href="." class="reload">重新加载</a>
    <span class="dismiss">🗙</span>
</div>

<style>
    html, body {
        height: 100%;
        margin: 0;
        overflow: hidden;
    }

    .mud-layout {
        --zyqd-appbar-height: 45px;
        --mud-appbar-height: var(--zyqd-appbar-height);
        height: 100%;
        min-height: 100%;
    }

    /*
      MudAppBar 为 fixed，MudMainContent 需用 padding-top 避开顶栏。
      高度用 100dvh（含顶栏占位），避免再减一次 appbar 导致底部留白。
    */
    .mud-main-content.zyqd-main {
        display: flex;
        flex-direction: column;
        height: 100dvh;
        max-height: 100dvh;
        min-height: 0;
        overflow: hidden;
        box-sizing: border-box;
        /* 顶栏占位 + 与左右/底一致的 16px 间距，避免内容贴住菜单 */
        padding-top: calc(var(--zyqd-appbar-height) + 16px) !important;
        padding-left: 16px !important;
        padding-right: 16px !important;
        padding-bottom: 16px !important;
    }

    .zyqd-appbar.mud-appbar {
        --mud-appbar-height: var(--zyqd-appbar-height);
        height: var(--zyqd-appbar-height) !important;
        min-height: var(--zyqd-appbar-height) !important;
        background-color: #222 !important;
        color: #fff !important;
        border-bottom: 1px solid #111;
    }

    .zyqd-appbar .mud-toolbar {
        position: relative !important;
        display: flex !important;
        align-items: center !important;
        min-height: var(--zyqd-appbar-height) !important;
        height: var(--zyqd-appbar-height) !important;
        padding-top: 0 !important;
        padding-bottom: 0 !important;
        padding-left: 8px !important;
        padding-right: 8px !important;
    }

    .zyqd-nav {
        display: flex;
        align-items: center;
        height: 100%;
        min-width: 0;
        z-index: 1;
    }

    .zyqd-page-title {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        pointer-events: none;
        z-index: 0;
    }

    .zyqd-page-title-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        max-width: min(42vw, 360px);
        height: 28px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        padding: 0 16px;
        border-radius: 999px;
        border: 1px solid rgba(255, 255, 255, 0.28);
        background: linear-gradient(180deg, rgba(255, 255, 255, 0.16) 0%, rgba(255, 255, 255, 0.06) 100%);
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.18);
        color: #fff;
        font-size: 0.92rem;
        font-weight: 600;
        letter-spacing: 0.04em;
        line-height: 1;
        box-sizing: border-box;
    }

    .zyqd-appbar .mud-spacer,
    .zyqd-appbar .zyqd-emp-chip,
    .zyqd-appbar .zyqd-nav-menu:last-child {
        z-index: 1;
    }

    .zyqd-appbar .zyqd-nav-menu.mud-menu {
        display: inline-flex;
        align-items: center;
        height: 100%;
    }

    .zyqd-nav-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 1px;
        height: var(--zyqd-appbar-height);
        margin: 0;
        padding: 0 8px;
        border: 0;
        border-radius: 0;
        background: transparent;
        color: #fff;
        font-size: 0.95rem;
        font-weight: 500;
        letter-spacing: 0;
        line-height: 1;
        white-space: nowrap;
        cursor: pointer;
        box-sizing: border-box;
    }

    .zyqd-nav-btn:hover {
        background-color: #808080;
        color: #000;
    }

    .zyqd-nav-btn .zyqd-nav-caret {
        width: 16px;
        height: 16px;
        font-size: 16px;
        margin: 0;
        flex: 0 0 auto;
    }

    .zyqd-back-btn.mud-button-root {
        background-color: #fff !important;
        color: #000 !important;
        border: 1px solid #ddd;
        text-transform: none;
        min-height: 28px !important;
        height: 28px !important;
        padding: 0 12px !important;
        border-radius: 14px !important;
        box-shadow: none !important;
    }

    .zyqd-back-btn.mud-button-root:hover:not(:disabled) {
        background-color: #f0f0f0 !important;
    }

    .zyqd-back-btn.mud-button-root:disabled {
        opacity: 0.45;
    }

    .zyqd-back-btn .mud-button-label {
        font-size: 13px;
        font-weight: 500;
    }

    .zyqd-back-btn .mud-icon-root {
        font-size: 16px;
    }
</style>

@code {
    private bool _checked;
    private bool _authReady;
    private bool _canManageUsers;
    private bool _canViewInvoiceKp;
    private bool _canSeeBusinessModules = true;
    private bool _isInspector;
    private string _homePath = "/";

    protected override void OnInitialized()
    {
        NavHistory.EnsureStarted();
        NavHistory.Changed += OnNavHistoryChanged;
        Nav.LocationChanged += OnLocationChanged;
        if (IsPublicPath)
            _authReady = true;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        if (_isInspector && !IsPublicPath && !IsInspectorAllowedPath(CurrentPath))
        {
            Nav.NavigateTo("/sir", replace: true);
            return;
        }

        _ = InvokeAsync(StateHasChanged);
    }

    private void OnNavHistoryChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        NavHistory.Changed -= OnNavHistoryChanged;
        Nav.LocationChanged -= OnLocationChanged;
    }

    private void GoBack() => NavHistory.GoBack();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _checked) return;
        _checked = true;
        if (IsPublicPath) return;

        var loggedIn = false;
        try
        {
            loggedIn = await Auth.IsLoggedInAsync();
        }
        catch
        {
            loggedIn = false;
        }

        if (!loggedIn)
        {
            Nav.NavigateTo("/login", replace: true);
            return;
        }

        var auth = await Auth.GetStoredAsync();
        _canManageUsers = Auth.CanManageUsers(auth);
        try
        {
            await Auth.RefreshPermissionsAsync();
            auth = await Auth.GetStoredAsync();
            _canManageUsers = Auth.CanManageUsers(auth);
        }
        catch
        {
            // 刷新失败时沿用本地缓存
        }

        _isInspector = AppRoles.IsInspector(auth?.Role);
        _canSeeBusinessModules = !_isInspector;
        _homePath = AppRoles.HomePath(auth?.Role);
        _canViewInvoiceKp = !_isInspector && Auth.IsPageVisible(auth, CentralApiOptions.InvoiceKpRoute);

        if (_isInspector && !IsInspectorAllowedPath(CurrentPath))
        {
            Nav.NavigateTo("/sir", replace: true);
            return;
        }

        _authReady = true;
        StateHasChanged();
    }

    private static bool IsInspectorAllowedPath(string path)
    {
        if (path.Length == 0) return true; // 门户首页 /
        if (Starts(path, "home")) return true;
        if (Starts(path, "sir")) return true;
        if (Starts(path, "Profile")) return true;
        if (Starts(path, "login")) return true;
        if (Starts(path, "Error")) return true;
        return false;
    }

    private bool IsPublicPath
    {
        get
        {
            var path = CurrentPath;
            return path.Equals("login", StringComparison.OrdinalIgnoreCase)
                   || path.Equals("Error", StringComparison.OrdinalIgnoreCase);
        }
    }

    private string CurrentPath => Nav.ToBaseRelativePath(Nav.Uri).Split('?')[0].Trim('/');

    private string CurrentPageTitle
    {
        get
        {
            var path = CurrentPath;
            if (path.Length == 0 || Starts(path, "home")) return "首页";

            if (Starts(path, "quotation-base")) return path is "quotation-base" ? "报价基础数据" : "报价基础数据详情";
            if (Starts(path, "quotation")) return path is "quotation" ? "报价列表" : "报价详情";
            if (Starts(path, "contract-base")) return path is "contract-base" ? "合同基础数据" : "合同基础数据详情";
            if (Starts(path, "contract-pk")) return path is "contract-pk" ? "装箱单列表" : "装箱单编辑";
            if (Starts(path, "contract-ci")) return path is "contract-ci" ? "客户CI列表" : "客户CI详情";
            if (Starts(path, "contract-bg")) return path is "contract-bg" ? "报关PI列表" : "报关PI详情";
            if (Starts(path, "contract-pi") || path is "contract")
            {
                if (path is "contract" or "contract-pi")
                {
                    var type = GetQueryType();
                    return type switch
                    {
                        "客户CI" => "客户CI列表",
                        "报关PI" => "报关PI列表",
                        "装箱单" => "装箱单列表",
                        _ => "客户PI列表",
                    };
                }

                return "合同详情";
            }
            if (Starts(path, "invoice-kp")) return "开票管理";
            if (Starts(path, "sir")) return path is "sir" ? "检测报告管理" : "检测报告详情";
            if (path is "project" or "project-list") return "项目管理";
            if (Starts(path, "project/motor")) return "电机立项单";
            if (Starts(path, "project/")) return "立项单";
            if (Starts(path, "personnel") || Starts(path, "UserManagement")) return "人员管理";
            if (Starts(path, "Profile")) return "个人信息";
            if (Starts(path, "tools/decrypt")) return "文件解密";
            return "遮阳管理系统";
        }
    }

    private static bool Starts(string path, string prefix)
        => path.Equals(prefix, StringComparison.OrdinalIgnoreCase)
           || path.StartsWith(prefix + "/", StringComparison.OrdinalIgnoreCase);

    private string GetQueryType()
    {
        var relative = Nav.ToBaseRelativePath(Nav.Uri);
        var qi = relative.IndexOf('?');
        if (qi < 0) return "";
        foreach (var part in relative[(qi + 1)..].Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var eq = part.IndexOf('=');
            if (eq <= 0) continue;
            if (!part[..eq].Equals("type", StringComparison.OrdinalIgnoreCase)) continue;
            return Uri.UnescapeDataString(part[(eq + 1)..]).Trim();
        }

        return "";
    }

    private void GoTo(string url) => Nav.NavigateTo(url, forceLoad: false);

    private async Task LogoutAsync()
    {
        await Auth.LogoutAsync();
        Nav.NavigateTo("/login", replace: true);
    }
}
