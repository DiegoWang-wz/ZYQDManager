{
  "Serilog": {
    "Using": [ "Serilog.Sinks.File", "Serilog.Filters.Expressions" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.txt",
          "rollingInterval": "Day",
          "outputTemplate": "███████████████████████████████████████████████████████████████████████████████\n█ ⚡ LEVEL: {Level:u} \n███████████████████████████████████████████████████████████████████████████████\n█ 🕐 Timestamp: {Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz}\n█ 📝 Message:   {Message:lj}\n█ 📍 Source:    {SourceContext}\n█ 🔗 Trace:     {TraceId}\n█ 📍 Span:      {SpanId}\n█ 👤 User:      {UserName}\n█ 🏷️ Action:    {ActionName}\n█ 🌐 Path:      {RequestPath}\n█ 📡 Method:    {RequestMethod}\n█ 🎯 Status:    {StatusCode}\n█ ⚡ Time:      {Elapsed}ms\n█ 💾 Memory:    {MemoryUsageMB}MB\n█ 📋 Properties:\n█ {Properties}\n█  {Exception}\n███████████████████████████████████████████████████████████████████████████████\n\n"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId", "WithProcessId" ],
    "Filter": [
      { "Name": "ByExcluding", "Args": { "expression": "StartsWith(RequestPath, '/_blazor')" } },
      { "Name": "ByExcluding", "Args": { "expression": "EndsWith(RequestPath, '.js') or EndsWith(RequestPath, '.css') or EndsWith(RequestPath, '.png') or EndsWith(RequestPath, '.jpg') or EndsWith(RequestPath, '.ico') or EndsWith(RequestPath, '.map')" } }
    ]
  },

